{"ld": 2207, "paper": "HP1484", "session": "132", "title": "An Act Regarding the Statute of Limitations for Certain Sexual Offenses Committed Against Minors", "sponsor_id": "h-kuhn-amy", "cosponsor_ids": [], "committee_code": "JUD", "committee_name": "Judiciary", "summary": {"text": "This bill is reported out by the Joint Standing Committee on Judiciary pursuant to Public Law 2025, chapter 479, section 2. The committee has not taken a position on the substance of this bill. By reporting this bill out, the committee is not suggesting and does not intend to suggest that it agrees or disagrees with any aspect of this bill. The committee is reporting the bill out for the sole purpose of having a bill printed that can be referred to the committee for an appropriate public hearing and subsequent processing in the normal course. The committee is taking this action to ensure clarity and transparency in the legislative review of the proposals contained in the bill.\n\nThe bill eliminates the statute of limitations for prosecution of the crime of aggravated sex trafficking committed against a victim who had not attained the age of 18 years at the time of the crime and for prosecution of the crime of commercial sexual exploitation of a minor against a victim who had not attained the age of 18 years at the time of the crime. These changes do not apply to criminal conduct occurring prior to the effective date of this legislation or for which the prosecution has been barred by the statute of limitations in force immediately prior to the effective date of this legislation.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1484&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2026-04-03", "governor_action": "Signed", "governor_action_date": "2026-04-03"}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 2207)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1484&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-867)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1484&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-867)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1484&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN220702.pdf"}], "committee_actions": [{"date": "2026-02-26", "action": "Work Session Held", "result": null}, {"date": "2026-02-26", "action": "Voted", "result": "Divided Report"}, {"date": "2026-03-19", "action": "Reported Out", "result": "OTP-AM/ONTP"}, {"date": "2026-03-30", "action": "Reported Out", "result": "OTP-AM/ONTP"}], "committee_reports": [{"label": "Majority report", "recommendation": "Ought To Pass As Amended", "signer_count": 10, "signers": ["Senator Anne Carney (Chair)", "Representative Amy Kuhn (Chair)", "Representative Mark Babin", "Representative Elizabeth Caruso", "Representative Rachel Henderson", "Representative Adam Lee", "Representative Dani O'Halloran", "Representative Dylan Pugh", "Representative Ellie Sato", "Senator Rachel Talbot Ross"], "signer_ids": ["s-carney-anne", "h-kuhn-amy", "h-babin-mark", "h-caruso-elizabeth", "h-henderson-rachel", "h-lee-adam", "h-o-halloran-dani", "h-pugh-dylan", "h-sato-eleanor", "s-talbot-ross-rachel"]}, {"label": "Minority report", "recommendation": "Ought Not To Pass", "signer_count": 3, "signers": ["Senator David Haggan", "Representative Jennifer Poirier", "Representative David Sinclair"], "signer_ids": ["s-haggan-david", "h-poirier-jennifer", "h-sinclair-david"]}], "chamber_actions": [{"date": "2026-02-10", "chamber": "House", "action": "Representative KUHN for the Joint Standing Committee on Judiciary pursuant to Public Law 2025, chapter 479, section 2 reports that the Bill be REFERRED to the Committee on