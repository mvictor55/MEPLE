{"ld": 1081, "paper": "HP703", "session": "132", "title": "An Act to Support Access to General Assistance at Municipal General Assistance Offices and Designated Places", "sponsor_id": "h-sachs-melanie", "cosponsor_ids": ["h-bridgeo-william", "h-doudera-victoria", "h-graham-anne", "h-kuhn-amy", "h-mastraccio-anne-marie"], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This bill amends the law governing local offices where a person may apply for general assistance to require each municipality to designate daily hours when an application may be obtained, accepted and processed. These designated hours may not total less than 50% of the municipality's regular business hours. It also changes the information that must be posted at the local offices to reflect this amendment.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0703&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-05-29", "governor_action": "Signed", "governor_action_date": "2025-05-29"}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 1081)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0703&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-191)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0703&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-191)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0703&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN108102.pdf"}], "committee_actions": [{"date": "2025-04-16", "action": "Work Session Held", "result": null}, {"date": "2025-04-16", "action": "Voted", "result": "OTP-AM"}, {"date": "2025-05-16", "action": "Reported Out", "result": "OTP-AM"}], "comm