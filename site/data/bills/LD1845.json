{"ld": 1845, "paper": "HP1229", "session": "132", "title": "An Act to Establish the Working Waterfront Advisory Council", "sponsor_id": "h-rielly-morgan", "cosponsor_ids": ["s-bailey-donna", "s-duson-jill", "h-gere-traci", "h-golek-cheryl", "h-mingo-arthur", "s-moore-marianne", "s-reny-cameron", "h-simmons-abden", "h-strout-tiffany"], "committee_code": "HED", "committee_name": "Housing and Economic Development", "summary": {"text": "This bill creates the Working Waterfront Advisory Council to address issues affecting the State's working waterfronts and requires the council to submit a report by February 1, 2026 and annually thereafter to the joint standing committees of the Legislature having jurisdiction over economic and community development matters and marine resources matters on the status of the condition of, the current and future challenges concerning and recommendations related to working waterfronts in the State. The bill also requires the Director of the Maine Office of Community Affairs to submit a report by February 1, 2026 and annually thereafter to the joint standing committees of the Legislature having jurisdiction over initiatives proposed by the Maine Office of Community Affairs regarding working waterfronts, including information from coalitions, task forces and engagements with municipal and tribal governments.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1229&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-21", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "fiscal_note_url": null, "documents": [{"label": "Bill text (LD 1845)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1229&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-08", "a