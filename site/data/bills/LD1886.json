{"ld": 1886, "paper": "HP1257", "session": "132", "title": "An Act to Include Serious Bodily Injury in the Law Governing Motor Vehicle Violations Resulting in Death (TITLE CHANGE)", "sponsor_id": "h-lemelin-michael", "cosponsor_ids": [], "committee_code": "CJPS", "committee_name": "Criminal Justice and Public Safety", "summary": {"text": "This bill amends provisions of law relating to distracted driving by establishing specific penalties for committing the traffic infraction of failure to maintain control of a motor vehicle. If the State proves that a driver's commission of the traffic infraction caused a significant injury to another person, the court may order a suspension of the driver's license for a period of 180 days. If the State proves that a driver's commission of the traffic infraction caused the death of another person, the court may order a suspension of the driver's license for a period of one to 3 years. In either case, the court may order a suspension for a shorter period if the court finds that a shorter suspension is appropriate due to extenuating circumstances.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1257&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-12", "governor_action": "Signed", "governor_action_date": "2025-06-12"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1886)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1257&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-497)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1257&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-497)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1257&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills