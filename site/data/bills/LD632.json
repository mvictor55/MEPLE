{"ld": 632, "paper": "HP400", "session": "132", "title": "An Act to Allow a Local Option Sales Tax on Short-term Lodging to Fund Affordable Housing", "sponsor_id": "h-skold-charles", "cosponsor_ids": ["h-brennan-michael", "h-dodge-janice", "s-duson-jill", "h-fecteau-ryan", "h-friedmann-gary", "h-golek-cheryl", "h-hasenfus-tavis", "h-matlack-ann", "h-rana-ambureen"], "committee_code": "TAX", "committee_name": "Taxation", "summary": {"text": "This bill allows a municipality to impose a local option sales tax of 2% on short-term lodging that is subject to the state sales and use tax if approved by referendum of the voters in that municipality. The revenue from the local option sales tax must be distributed to the municipality imposing the local option sales tax. The distributed revenue must be used in municipal programs for affordable housing in that municipality, including rental assistance for lower income households or moderate income households or to support the costs to municipalities for providing general assistance. Revenue received by a municipality may not be used to reduce or eliminate funding otherwise due the municipality under other provisions of law. The local option sales tax may not take effect before January 1, 2026.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0400&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-04-08", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "fiscal_note_url": null, "documents": [{"label": "Bill text (LD 632)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0400&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-03-27", "action": "Work Session Held", "result": null}, {"date": "2025-03-27", "action": "Voted", "result": "ONTP"}