{"ld": 2118, "paper": "HP1433", "session": "132", "title": "An Act to Eliminate the Natural Areas Program and Reassign Certain Responsibilities Under the Program to the Department of Inland Fisheries and Wildlife and to Amend the Law Governing Administration of the Department of Inland Fisheries and Wildlife, Bureau of Resource Management", "sponsor_id": "h-dill-james", "cosponsor_ids": [], "committee_code": "ACF", "committee_name": "Agriculture, Conservation and Forestry", "summary": {"text": "This bill repeals the laws governing the Natural Areas Program administered by the Department of Agriculture, Conservation and Forestry and reassigns certain responsibilities under the program to the Department of Inland Fisheries and Wildlife. The bill updates relevant definitions in the Maine Revised Statutes, Title 12 and cross- references in Titles 36 and 38 to reflect these changes. The bill also reestablishes the Natural Areas Conservation Fund, which is administered by the Commissioner of Inland Fisheries and Wildlife.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1433&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2026-04-15", "governor_action": "Signed", "governor_action_date": "2026-04-15"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 2118)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1433&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-972)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1433&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-972)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1433&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN211802.pdf"}], "committee_actions": [{