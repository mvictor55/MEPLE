{"ld": 1978, "paper": "HP1321", "session": "132", "title": "An Act Regarding Government Liability Related to Sexual Acts Toward Minors", "sponsor_id": "h-gramlich-lori", "cosponsor_ids": [], "committee_code": "JUD", "committee_name": "Judiciary", "summary": {"text": "This bill adds an exception to immunity for governmental entities to provide that the State and a political subdivision of the State, including a city, town, county or school district, is liable for intentional and negligent acts or omissions relating to an employee or an agent of the governmental entity who commits a sexual act against a minor or engages in a sexual act with a minor while acting in or under the scope; description; authority whether actual, implied or apparent; mandate; directive; permission; or other indicia of the employer-employee relationship, whether on or off government premises.\n\nThis bill also removes the statute of limitations to allow actions against a governmental entity or an employee or agent of a governmental entity based upon sexual acts toward minors regardless of the date of the sexual act and regardless of whether the statute of limitations on such actions expired prior to the effective date of this legislation.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1321&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-06-05", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1978)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1321&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-27", "action": "Work Session Held", "result": "TABLED"}, {"date": "2025-05-29", "action": "Work Session Held", "result": null}, {"date": "2025-05-29", "ac