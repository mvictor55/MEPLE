{"ld": 576, "paper": "SP257", "session": "132", "title": "An Act Regarding Reciprocal Licensure for Professional Engineers", "sponsor_id": "s-tipping-michael", "cosponsor_ids": [], "committee_code": "LAB", "committee_name": "Labor", "summary": {"text": "This bill amends the provision of law regarding licensure as a professional engineer for a person holding an active national council record to make that provision consistent with other licensure provisions. It provides that an applicant for licensure as a professional engineer who meets the requirements of a mutual recognition agreement between this State and another state, territory or possession of the United States, the District of Columbia or any foreign country, whose licensure qualifications are, in the opinion of the State Board of Licensure for Professional Engineers and by the language of the agreement, substantially equivalent to the requirements of the laws of this State, may be licensed without further examination.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0257&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-05-23", "governor_action": "Signed", "governor_action_date": "2025-05-23"}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 576)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0257&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-03-18", "action": "Work Session Held", "result": null}, {"date": "2025-03-18", "action": "Voted", "result": "OTP"}, {"date": "2025-05-09", "action": "Reported Out", "result": "OTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-02-19", "chamber": "Senate", "action": "Received by the Secretary of the Senate on February 19, 202