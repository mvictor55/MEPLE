{"ld": 1174, "paper": "HP779", "session": "132", "title": "An Act to Limit the Liability of Gun Shops That Provide Firearm Hold Agreements (TITLE CHANGE)", "sponsor_id": "h-wood-stephen", "cosponsor_ids": ["h-ardell-donald", "h-greenwood-randall", "s-haggan-david", "s-harrington-matthew", "h-lajoie-michel", "h-perkins-chad", "h-pomerleau-kimberly", "h-white-james"], "committee_code": "JUD", "committee_name": "Judiciary", "summary": {"text": "This bill allows a gun shop to take possession of a firearm owned by a veteran of the United States Armed Forces or first responder if the gun shop enters into a firearm hold agreement with the owner, keeps the firearm separate from the gun shop inventory and contacts the owner every 6 months. The firearm hold agreement must indicate a family member or other individual who may lawfully possess a firearm and will take possession of the firearm upon proof of the death of the owner of the firearm during the pendency of the firearm hold agreement.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0779&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-18", "governor_action": "Signed", "governor_action_date": "2025-06-18"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1174)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0779&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-661)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0779&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-661)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0779&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN117402.pdf"}], "committee_actions": [{"date": "2025-05-07", "action": "Wor