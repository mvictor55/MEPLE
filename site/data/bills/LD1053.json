{"ld": 1053, "paper": "HP682", "session": "132", "title": "An Act to Ensure That Rebates from Prescription Drug Manufacturers Are Passed on to Patients at Pharmacies", "sponsor_id": "h-cloutier-kristen", "cosponsor_ids": ["h-beck-matthew", "s-grohoski-nicole", "h-kuhn-amy", "h-macias-rafael", "h-murphy-kelly", "s-rotundo-margaret", "h-salisbury-suzanne", "h-shagoury-daniel", "h-terry-parnell"], "committee_code": "HCIFS", "committee_name": "Health Coverage, Insurance and Financial Services", "summary": {"text": "This bill removes a provision that requires that compensation remitted by or on behalf of a pharmaceutical manufacturer, developer or labeler to a pharmacy benefits manager be remitted to the carrier if it is not remitted to the covered person. It retains the provision that requires that the compensation be remitted to the covered person to reduce the out-of- pocket costs associated with a prescription drug. It requires pharmacy benefits managers to annually report compliance with this requirement to the Superintendent of Insurance. It authorizes the superintendent to impose civil penalties and take enforcement action for noncompliance by a carrier or pharmacy benefits manager. It designates the information provided as confidential.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0682&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-04-17", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 1053)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0682&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-09", "action": "Work Session Held", "result": null}, {"date": "2025-04-09", "action": "Voted", "result": "ONTP"}, {"date": "2025-04-16", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-03-12", "chamber": "House", "action": "Received by the Clerk of the House on March 12, 2025."}, {"date": "2025-03-12", "chamber": "House", "action": "The Bill was REFERRED to the Committee on HEALTH COVERAGE, INSURANCE AND FINANCIAL SERVICES pursuant to Joint Rule 308.2 and ordered printed pursuant to Joint Rule 401."}, {"date": "2025-03-21", "chamber": "House", "action": "Carried over, in the same posture, to the next special or regular session of the 132nd Legislature, pursuant to Joint Order SP 519."}, {"date": "2025-04-09", "chamber": "J", "action": "Work Session Held"}, {"date": "2025-04-09", "chamber": "J", "action": "Voted: ONTP"}, {"date": "2025-04-16", "chamber": "J", "action": "Reported Out: ONTP"}, {"date": "2025-04-17", "chamber": "Senate", "action": "Pursuant to Joint Rule 310.3 Placed in Legislative Files (DEAD)"}], "roll_calls": [], "hearing": {"date": "2025-03-27", "time": "1:00 PM", "location": "Cross Building, Room 220", "committee_code": "HCIFS", "testimony_count": 25}, "tags": ["Prescription Drugs", "Affordability"], "affected_statutes": [], "testimony": [{"id": "10038261", "name": "Agata Pelka", "organization": "Patient Pocket Protector Coalition (PPPC)", "town": null, "position": null, "position_source": null, "date": "2025-03-27", "hearing_date": "2025-03-27", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=10038261", "has_text": true}, {"id": "10039408", "name": "Alan Minthorn", "organization": "Saco", "town": null, "position": null, "position_source": null, "date": "2025-03-27", "hearing_date": "2025-03-27", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=10039408", "has_text": true}, {"id": "187554", "name": "Celine Burrows", "organization": "Frannie Peabod