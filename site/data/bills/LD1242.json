{"ld": 1242, "paper": "HP817", "session": "132", "title": "An Act to Incentivize the Construction of Solar Carport Canopies and Solar Chargers at Highway Picnic Areas", "sponsor_id": "h-golek-cheryl", "cosponsor_ids": ["h-ankeles-daniel", "h-dodge-janice", "h-eaton-holly", "h-montell-karen", "s-pierce-teresa", "h-runte-walter", "h-warren-sophia", "h-webb-kilton"], "committee_code": "TRA", "committee_name": "Transportation", "summary": {"text": "This bill directs the Department of Transportation to enter into leases at no cost at all highway picnic areas for the installation of solar-powered electric vehicle charging stations. The bill also allows a person that builds or has built a solar carport canopy that houses at least 2 electric vehicle charging stations to amortize the sales and use tax assessed on materials and equipment spent to construct the solar carport canopy and any electric vehicle charging stations under the solar carport canopy.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0817&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2025-05-14", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 1242)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0817&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-116)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0817&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-116)", "description": null, "sponsor": null, "status": null, "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0817&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN124202.pdf"}], "committee_actions": [{"date": "2025-04-24", "action": "Work Session Held", "result": null}