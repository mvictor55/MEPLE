{"ld": 400, "paper": "HP254", "session": "132", "title": "Resolve, Directing the Department of Public Safety, Office of the State Fire Marshal to Compile a Statewide Inventory of Aqueous Film-forming Foam Concentrate", "sponsor_id": "h-ankeles-daniel", "cosponsor_ids": ["h-arford-poppy", "h-bell-arthur", "h-bridgeo-william", "s-larsen-daughtry-matthea", "h-doudera-victoria", "h-gramlich-lori", "h-osher-laurie", "h-soboleski-michael", "s-tepler-denise"], "committee_code": "ENR", "committee_name": "Environment and Natural Resources", "summary": {"text": "This resolve directs the Department of Public Safety, Office of the State Fire Marshal, beginning July 1, 2026, to compile an inventory of aqueous film-forming foam concentrate possessed by any public entity in the State in an amount of 5 gallons or more and to solicit similar information from private entities.\n\nThe inventory is a public record, and the office is directed to submit the inventory to the joint standing committees of the Legislature having jurisdiction over environment and natural resources matters and criminal justice and public safety matters no later than July 1, 2028.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0254&item=1&snum=132"}, "status": "enacted", "status_label": "Finally Passed", "final_disposition": {"label": "Finally Passed", "date": "2025-07-01", "governor_action": "Signed", "governor_action_date": "2025-07-01"}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 400)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0254&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-53)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0254&item=2&snum=132", "item": 2}, {"label": "Amendment S-A to C-A (S-455)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0254&item=4&snum=132", "item": 4}], "amendments": [{"id": "C-A (H-53)", "description": null,