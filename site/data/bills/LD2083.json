{"ld": 2083, "paper": "HP1398", "session": "132", "title": "An Act to Expand Access to Certified Residential Medication Aide Training", "sponsor_id": "h-meyer-michele", "cosponsor_ids": [], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This bill directs the Department of Health and Human Services to issue a certificate to an individual who has successfully completed a department-approved certified residential medication aide course that meets the medication administration training requirements for unlicensed assistive personnel in accordance with rules established by the department for certain facilities. The bill also requires the department to review the course curriculum at least every 5 years and allows the department to establish by rule certification fees and sanction fees for certified residential medication aides and instructors.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1398&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2026-03-19", "governor_action": "Signed", "governor_action_date": "2026-03-19"}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 2083)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1398&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-819)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1398&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-819)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1398&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN208302.pdf"}], "committee_actions": [{"date": "2026-02-11", "action": "Work Session Held", "result": null}, {"date": "2026-02-11", "action": "Voted", "result": "OTP-AM"}, {"date"