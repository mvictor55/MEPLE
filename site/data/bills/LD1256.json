{"ld": 1256, "paper": "HP831", "session": "132", "title": "An Act to Support Healthy Meal Programs in Maine Schools by Allowing the School Revolving Renovation Fund to Make Loans to Repair and Renovate School Kitchens and Cafeterias", "sponsor_id": "h-salisbury-suzanne", "cosponsor_ids": ["h-brennan-michael", "h-carlow-nathan", "h-crockett-edward", "h-murphy-kelly"], "committee_code": "EDU", "committee_name": "Education and Cultural Affairs", "summary": {"text": "This bill adds renovating school kitchens and cafeterias and replacing or adding kitchen equipment to facilitate the serving of meals to students to the purposes of the School Revolving Renovation Fund. The bill also removes from the School Meal Equipment and Program Improvement Fund reimbursement for food costs related to medically necessary 2103 dietary restrictions of students from the approved uses of grants provided by that fund. The 2114 bill also provides appropriations and allocations to the School Meal Equipment and 2125 Program Improvement Fund.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0831&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-06", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 1256)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0831&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-28", "action": "Work Session Held", "result": null}, {"date": "2025-04-28", "action": "Voted", "result": "ONTP"}, {"date": "2025-04-29", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date