{"ld": 1551, "paper": "SP635", "session": "132", "title": "An Act to Support Maine Eating and Drinking Establishments by Allowing Vendors to Operate on the Premises of an Establishment with a Liquor License (EMERGENCY)", "sponsor_id": "s-timberlake-jeffrey", "cosponsor_ids": ["s-bickford-bruce", "h-cray-dean", "s-cyrway-scott", "s-farrin-bradlee", "h-lyman-sheila", "h-mason-richard", "h-supica-laura"], "committee_code": "VLA", "committee_name": "Veterans and Legal Affairs", "summary": {"text": "Under current law, an establishment licensed with the Department of Administrative and Financial Services, Bureau of Alcoholic Beverages and Lottery Operations is prohibited from allowing outside licensed eating establishments to prepare or sell food or alcohol on its premises.\n\nThis bill establishes conditions under which a licensed eating establishment vendor may operate within a host establishment licensed with the bureau. It permits the vendor to sell food and alcoholic beverages, as long as the alcohol is supplied exclusively by the host establishment and served in compliance with state training requirements.\n\nThe bill also requires the vendor to adhere to all relevant health and safety rules and tax reporting obligations and requires the host establishment to maintain an operational schedule.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0635&item=1&snum=132"}, "status": "enacted", "status_label": "Emergency Enacted", "final_disposition": {"label": "Emergency Enacted", "date": "2025-06-09", "governor_action": "Emergency Signed", "governor_action_date": "2025-06-09"}, "fiscal_status": "Not Yet Determined", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN155102.pdf", "documents": [{"label": "Bill text (LD 1551)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0635&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-153)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0635&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-153)", "description": "Emergency", "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0635&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN155102.pdf"}], "committee_actions": [{"date": "2025-04-30", "action": "Work Session Held", "result": null}, {"date": "2025-04-30", "action": "Voted", "result": "OTP-AM"}, {"date": "2025-05-23", "action": "Reported Out", "result": "OTP-AM"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought to Pass as Amended", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-04-10", "chamber": "Senate", "action": "Committee on VETERANS AND LEGAL AFFAIRS suggested and ordered printed REFERENCE to the Committee on VETERANS AND LEGAL AFFAIRS Ordered sent down forthwith for concurrence"}, {"date": "2025-04-10", "chamber": "House", "action": "The Bill was REFERRED to the Committee on VETERANS AND LEGAL AFFAIRS."}, {"date": "2025-04-10", "chamber": "House", "action": "In concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-05-28", "chamber": "Senate", "action": "Report READ and ACCEPTED."}, {"date": "2025-05-28", "chamber": "Senate", "action": "READ ONCE."}, {"date": "2025-05-28", "chamber": "Senate", "action": "Committee Amendment \"A\" (S-153) READ and ADOPTED."}, {"date": "2025-05-28", "chamber": "Senate", "action": "Under suspension of the Rules, READ A SECOND TIME and PASSED TO BE ENGROSSED AS AMENDED BY Committee Amendment \"A\" (S-153)."}, {"date": "2025-05-28", "chamber": "Senate", "action": "Ordered sent down forthwith for concurrence."}, {"date": "2025-05-29", "chamber": "House", "action": "CONSENT CALENDAR - FIRST DAY"}, {"date": "2025-05-29", "chamber": "House", "action": "Under suspension of the rules CONSENT CALENDAR - SECOND DAY