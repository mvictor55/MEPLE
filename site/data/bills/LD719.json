{"ld": 719, "paper": "HP458", "session": "132", "title": "Resolve, to Direct the County Corrections Professional Standards Council to Examine Funding of and Compliance by County and Regional Jails (TITLE CHANGE)", "sponsor_id": "h-salisbury-suzanne", "cosponsor_ids": ["h-ducharme-john", "h-hasenfus-tavis", "h-lajoie-michel", "h-lookner-grayson", "s-stewart-harold"], "committee_code": "CJPS", "committee_name": "Criminal Justice and Public Safety", "summary": {"text": "This bill provides that state funding for the County Jail Operations Fund must be appropriated annually in an amount equal to 35% of the total cost of operations for county jails and the regional jail as necessary to meet the standards for county jails as established by the Commissioner of Corrections or otherwise required by law. The bill further provides that county jails and the regional jail may provide services that exceed the standards established by the commissioner or otherwise required by law, but the cost of providing such services must be funded by the counties or from other sources outside of the County Jail Operations Fund.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0458&item=1&snum=132"}, "status": "enacted", "status_label": "Finally Passed", "final_disposition": {"label": "Finally Passed", "date": "2025-06-12", "governor_action": "Signed", "governor_action_date": "2025-06-12"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 719)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0458&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-494)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0458&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-494)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0458&item=2&snum=132", "fiscal_note_url": "https:/