{"ld": 1279, "paper": "HP854", "session": "132", "title": "Resolve, Establishing the Biotoxin Testing of Cultured Scallops Pilot Program (TITLE CHANGE)", "sponsor_id": "h-eaton-holly", "cosponsor_ids": ["s-grohoski-nicole", "h-hepler-allison", "s-reny-cameron", "h-simmons-abden", "h-strout-tiffany", "h-webb-kilton"], "committee_code": "MAR", "committee_name": "Marine Resources", "summary": {"text": "This bill requires the Department of Marine Resources to conduct biotoxin testing of cultured scallops under the Marine Shellfish Toxins Monitoring Program. Testing requirements include using high-performance liquid chromatography testing and providing logistical support to commercial fisheries businesses engaged in scallop aquaculture, including providing transportation of samples for testing. Funds received by the department for the testing may be used only for biotoxin testing of cultured scallops, and the department is required to submit an annual report on the testing to the Legislature by January 1st of each year.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0854&item=1&snum=132"}, "status": "enacted", "status_label": "Finally Passed", "final_disposition": {"label": "Finally Passed", "date": "2025-07-01", "governor_action": "Signed", "governor_action_date": "2025-07-01"}, "fiscal_status": "Not Yet Determined", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN127902.pdf", "documents": [{"label": "Bill text (LD 1279)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0854&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-345)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0854&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-345)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0854&item=2&snum=132", "fiscal_note