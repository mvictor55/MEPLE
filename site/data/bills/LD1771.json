{"ld": 1771, "paper": "SP689", "session": "132", "title": "An Act to Strengthen Oversight of Kennels by Changing the Licensing Authority from Municipalities to the Department of Agriculture, Conservation and Forestry", "sponsor_id": "s-bailey-donna", "cosponsor_ids": ["h-arford-poppy", "h-cooper-mark", "h-dill-james", "h-hepler-allison", "s-ingwersen-henry", "h-roeder-amy"], "committee_code": "ACF", "committee_name": "Agriculture, Conservation and Forestry", "summary": {"text": "This bill moves the responsibility for the issuance of kennel licenses from municipalities to the Department of Agriculture, Conservation and Forestry. The bill enacts criteria regarding the department's authority to refuse to issue or renew, suspend or revoke a facility license for an animal shelter, kennel, boarding kennel, breeding kennel or pet shop. The bill also updates certain definitions, licensing and recording fees and cross- references related to facility licensing.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0689&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-22", "governor_action": "Unsigned", "governor_action_date": "2025-06-22"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1771)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0689&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-220)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0689&item=2&snum=132", "item": 2}, {"label": "Amendment H-A to C-A (H-488)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0689&item=4&snum=132", "item": 4}], "amendments": [{"id": "C-A (S-220)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0689&item=2&snum=132", "fiscal_note_url": "https://legislature.mai