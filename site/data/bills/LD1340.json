{"ld": 1340, "paper": "SP555", "session": "132", "title": "An Act to Establish the Municipal Stream Crossing Fund", "sponsor_id": "s-larsen-daughtry-matthea", "cosponsor_ids": ["h-crafts-lydia", "s-farrin-bradlee", "s-nangle-timothy", "s-tepler-denise"], "committee_code": "TRA", "committee_name": "Transportation", "summary": {"text": "This bill establishes the Municipal Stream Crossing Fund within the Department of Transportation to provide grants for culvert upgrades or replacements on municipal roads to eligible project sponsors, including local governments, municipal conservation commissions, soil and water conservation districts and private nonprofit organizations. The fund may accept funds from bonds, appropriations, allocations and contributions from other public and private sources. The department may award grants based on the extent to which the proposed project allows communities to more effectively prepare for storm and flood events and advances the goals of restoring habitat for fish, including sea-run fish and native brook trout, and wildlife. The bill also includes criteria to be used in evaluating the award of grants for proposed projects.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0555&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-05-30", "governor_action": "Signed", "governor_action_date": "2025-05-30"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1340)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0555&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-116)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0555&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-116)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0555&ite