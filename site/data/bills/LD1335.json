{"ld": 1335, "paper": "HP870", "session": "132", "title": "An Act to Prohibit Life Sentences", "sponsor_id": "h-milliken-nina", "cosponsor_ids": ["h-mathieson-kristi", "h-warren-sophia"], "committee_code": "JUD", "committee_name": "Judiciary", "summary": {"text": "This bill amends the sentencing provisions under the Maine Criminal Code to provide that, for a person convicted of any crime under that Code on or after January 1, 2026, in sentencing the person, a court may not set a term of imprisonment for life or for any term of years equivalent to imprisonment for life.\n\nThe bill defines \"term of years equivalent to imprisonment for life\" to mean a sentence of imprisonment for a term of years that, as determined by the court based on the age of the convicted person at the time of sentencing and other factors determined by the court, is reasonably expected to result in the imprisonment of the person for the remainder of the person's life.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0870&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-04-17", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 1335)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0870&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-09", "action": "Work Session Held", "result": null}, {"date": "2025-04-09", "action": "Voted", "result": "ONTP"}, {"date": "2025-04-15", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-03-27", "chamber": "House", "action": "Committee on Criminal Justice 