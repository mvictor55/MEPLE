{"ld": 559, "paper": "SP238", "session": "132", "title": "An Act to Provide Property Tax Stabilization for Older Maine Residents", "sponsor_id": "s-bailey-donna", "cosponsor_ids": ["s-curry-glenn", "h-doudera-victoria", "s-nangle-timothy", "s-rafferty-joseph", "s-reny-cameron", "h-stover-holly"], "committee_code": "TAX", "committee_name": "Taxation", "summary": {"text": "This bill allows a municipality to adopt by ordinance a property tax stabilization program for senior residents of that municipality. A municipality adopting such an ordinance sets a minimum age for participation by residents of the municipality of not less than 62 years of age. The person must also be a permanent resident of the State and have owned a homestead in the State for at least 10 years. A municipality may adopt stricter eligibility requirements.\n\nThe bill also allows a municipality, by referendum, to adopt a local option sales tax of 1% on the value of prepared food and rental of living quarters in any hotel, rooming house or tourist or trailer camp. The revenue generated by the local option sales tax may only be used to offset the loss of revenue from the property tax stabilization program for senior residents of that municipality.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0238&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-04-10", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 559)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0238&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-03", "action": "Work Session Held", "result": null}, {"date": "2025-04-03", "action": "Voted", "result": "ONTP"}, {"date": "2025-04-09", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-02-19", "chamber": "Senate", "action": "Received by the Secretary of the Senate on February 19, 2025 and REFERRED to the Committee on TAXATION pursuant to Joint Rule 308.2"}, {"date": "2025-03-21", "chamber": "Senate", "action": "CARRIED OVER, in the same posture, to the next special or regular session of the 132nd Legislature, pursuant to Joint Order SP 519."}, {"date": "2025-04-03", "chamber": "J", "action": "Work Session Held"}, {"date": "2025-04-03", "chamber": "J", "action": "Voted: ONTP"}, {"date": "2025-04-09", "chamber": "J", "action": "Reported Out: ONTP"}, {"date": "2025-04-10", "chamber": "Senate", "action": "Pursuant to Joint Rule 310.3 Placed in Legislative Files (DEAD)"}], "roll_calls": [], "hearing": {"date": "2025-03-19", "time": "9:30 AM", "location": "State House, Room 127", "committee_code": "TAX", "testimony_count": 12}, "heard_with": [7, 140, 570, 658, 934], "tags": ["Property Tax", "Relief"], "affected_statutes": [], "testimony": [{"id": "186364", "name": "Amanda Campbell", "organization": "Maine Municipal Association", "town": null, "position": "oppose", "position_source": "inferred", "date": "2025-03-19", "hearing_date": "2025-03-19", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=186364", "has_text": true, "shared_with": [], "person_profile_id": null, "org_profile_id": "org-maine-municipal-association"}, {"id": "10037930", "name": "Amanda Campbell", "organization": "Maine Municipal Association", "town": null, "position": "oppose", "position_source": "inferred", "date": "2025-03-19", "hearing_date": "2025-03-19", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=10037930", "has_text": true, "shared_with": [7, 570, 658, 934], "person_profile_id": null, "org_profile_id": "org-maine-municipa