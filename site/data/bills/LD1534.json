{"ld": 1534, "paper": "SP618", "session": "132", "title": "An Act Enabling Municipalities to Protect Tenants and Stabilize Rents", "sponsor_id": "s-bailey-donna", "cosponsor_ids": ["h-gere-traci", "h-golek-cheryl", "h-gramlich-lori", "h-julia-cassie", "h-malon-marc", "h-roberts-lovell-tiffany", "s-tipping-michael"], "committee_code": "HED", "committee_name": "Housing and Economic Development", "summary": {"text": "This bill permits a municipality to adopt an ordinance or bylaw; to amend or adopt a charter provision; or to adopt pursuant to a referendum rent increase limits and eviction protections. It requires such a municipality to submit an annual report to the Maine State Housing Authority and the Maine Office of Community Affairs. The bill establishes that a violation of the requirements established in the bill is an unfair method of competition or an unfair or deception act or practice pursuant to the Maine Unfair Trade Practices Act.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0618&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-27", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 1534)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0618&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-01", "action": "Work Session Held", "result": null}, {"date": "2025-05-01", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-22", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-04-08", "chamber": "Senate", "action": "Committee on HOUSING AND ECONO