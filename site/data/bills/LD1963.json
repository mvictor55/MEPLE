{"ld": 1963, "paper": "SP770", "session": "132", "title": "An Act to Protect and Compensate Public Utility Whistleblowers (EMERGENCY)", "sponsor_id": "s-tipping-michael", "cosponsor_ids": ["s-bennett-richard", "h-faircloth-sean", "h-friedmann-gary", "s-grohoski-nicole", "h-warren-sophia", "h-webb-kilton"], "committee_code": "EUT", "committee_name": "Energy, Utilities and Technology", "summary": {"text": "This bill increases protections for public utility whistleblowers and allows the Public Utilities Commission to provide financial compensation for information leading to an administrative penalty or savings to utility customers. It requires that public utilities, competitive electricity providers and their affiliated interests and contractors provide training to all employees at least once every 2 years on the rights and responsibilities of whistleblowers. It provides that the Public Utilities Commission may investigate a whistleblower report while protecting the whistleblower's anonymity. The bill does not permit penalty, rate reduction or the disallowance of cost recovery against a utility based on an anonymous report.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0770&item=1&snum=132"}, "status": "died", "status_label": "Died Between Houses", "final_disposition": {"label": "Died Between Houses", "date": "2025-06-18", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1963)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0770&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-417)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0770&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-417)", "description": null, "sponsor": null, "status": "Adopted by Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0770&item=2&snum=132", "fiscal_note_url"