{"ld": 397, "paper": "HP251", "session": "132", "title": "An Act to Require a Voter to Show Photographic Identification", "sponsor_id": "h-paul-reagan", "cosponsor_ids": ["h-ardell-donald", "h-bishop-steven", "s-harrington-matthew", "h-mingo-arthur", "h-smith-katrina", "h-white-james", "h-white-russell"], "committee_code": "VLA", "committee_name": "Veterans and Legal Affairs", "summary": {"text": "This bill requires the presentation of proof of identity in the form of a photograph identification document when voting in person or by absentee ballot and removes certain official documents from the list of forms of documentation accepted to verify the identity of an applicant who is registering to vote. Under the bill, acceptable photograph identification is a current and valid driver's license or nondriver identification card issued in this State, a United States passport, a military identification or a permit to carry a concealed handgun issued in this State if that permit includes a photograph. The bill provides that a student photograph identification document issued by a college or university in this State may not be accepted for voter identification when voting or when registering to vote. The bill also allows a person who does not possess a photograph identification document to request a free special voter photograph identification card from the Secretary of State.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0251&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-14", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 397)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0251&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-07", "action": "Work Session Held", "result": null}, {"date": "2025-05-07", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-12", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-02-04", "chamber": "House", "action": "Committee on Veterans and Legal Affairs suggested and ordered printed."}, {"date": "2025-02-04", "chamber": "House", "action": "The Bill was REFERRED to the Committee on VETERANS AND LEGAL AFFAIRS."}, {"date": "2025-02-04", "chamber": "House", "action": "Sent for concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-02-04", "chamber": "Senate", "action": "The Bill was REFERRED to the Committee on VETERANS AND LEGAL AFFAIRS  in concurrence"}, {"date": "2025-03-21", "chamber": "House", "action": "Carried over, in the same posture, to the next special or regular session of the 132nd Legislature, pursuant to Joint Order SP 519."}, {"date": "2025-05-07", "chamber": "J", "action": "Work Session Held"}, {"date": "2025-05-07", "chamber": "J", "action": "Voted: ONTP"}, {"date": "2025-05-12", "chamber": "J", "action": "Reported Out: ONTP"}, {"date": "2025-05-14", "chamber": "Senate", "action": "Pursuant to Joint Rule 310.3 Placed in Legislative Files (DEAD)"}], "roll_calls": [], "hearing": {"date": "2025-05-02", "time": "11:00 AM", "location": "State House, Room 437", "committee_code": "VLA", "testimony_count": 25}, "heard_with": [38, 1149], "tags": ["Elections", "Voting Procedures"], "affected_statutes": [], "testimony": [{"id": "10047938", "name": "Aaron Frey", "organization": "Office of the Attorney General", "town": null, "position": null, "position_source": null, "date": "2025-05-02", "hearing_date": "2025-05-02", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=10047938", "has_text": false, "shared_with": []}, {"id": "192818", "name": "Alf Anderson