{"ld": 315, "paper": "HP215", "session": "132", "title": "An Act to Add a Personal Finance Course to the State Graduation Requirements in High Schools", "sponsor_id": "h-crockett-edward", "cosponsor_ids": ["h-archer-marshall", "h-bell-arthur", "h-bridgeo-william", "h-carlow-nathan", "h-lyman-sheila", "h-montell-karen", "h-rollins-david"], "committee_code": "EDU", "committee_name": "Education and Cultural Affairs", "summary": {"text": "This bill requires that all secondary schools include one year of personal finance as part of the mathematics instruction required to obtain a high school diploma. It changes the minimum requirement for a high school diploma from 2 years of mathematics or the equivalent in standards achievement to 3 years of mathematics or the equivalent in standards achievement.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0215&item=1&snum=132"}, "status": "withdrawn", "status_label": "Leave to Withdraw", "final_disposition": {"label": "Leave to Withdraw", "date": "2025-04-15", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 315)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0215&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-10", "action": "LTW Approved by Chairs", "result": "LTW"}, {"date": "2025-04-10", "action": "Reported Out", "result": "LTW"}], "committee_reports": [{"label": "Committee report", "recommendation": "Leave to Withdraw", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-01-30", "chamber": "House", "action": "Received by the Clerk of the House on January 30, 2025."}, {"date": "2025-01-30", "chamber": "House", "action": "The Bill was REFERRED to the Committee on EDUCATION AND CULTURAL AFFAIRS pursuant to Joint Rule 308.2 and ordered printed pursuant to Joint Rule 401."}, {"date": "2025-03