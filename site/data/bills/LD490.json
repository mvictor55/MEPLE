{"ld": 490, "paper": "HP319", "session": "132", "title": "An Act to Provide for a 5-year Automatic Repeal of Agency Rules", "sponsor_id": "h-smith-katrina", "cosponsor_ids": ["h-collins-alicia", "h-haggan-kimberly", "h-mingo-arthur", "h-morris-joshua", "h-olsen-rolf", "h-perkins-chad", "h-soboleski-michael"], "committee_code": "SLG", "committee_name": "State and Local Government", "summary": {"text": "This bill amends the Maine Administrative Procedure Act to provide that any agency rule that is finally adopted or an amendment to which is finally adopted in accordance with the requirements of that Act after January 1, 2026 is automatically repealed 5 years from the date of final adoption. An agency that has adopted or has jurisdiction over a rule subject to automatic repeal may submit to the Legislature a request that the rule be renewed and not be subject to repeal for an additional period of up to 5 years. For any rule subject to automatic repeal, the bill requires the Secretary of State to provide to the agency that adopted or has jurisdiction over the rule a notice regarding the date of the automatic repeal no later than 18 months prior to the date on which the rule will be repealed.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0319&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2025-06-02", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 490)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0319&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-320)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0319&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-320)", "description": null, "sponsor": null, "status": null, "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0319&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN049002.pdf"}], "committee_actions": [{"date": "2025-05-07", "action": "Work Session Held", "result": null}, {"date": "2025-05-07", "action": "Voted", "result": "Divided Report"}, {"date": "2025-05-28", "action": "Reported Out", "result": "ONTP/OTP-AM"}], "committee_reports": [{"label": "Majority report", "recommendation": "Ought Not To Pass", "signer_count": 11, "signers": ["Senator Joseph Baldacci (Chair)", "Representative Suzanne Salisbury (Chair)", "Senator Anne Beebe-Center", "Representative Lynn Copeland", "Representative Wayne Farrin", "Representative Randall Greenwood", "Representative Ann Matlack", "Representative Kimberly Pomerleau", "Representative David Rollins", "Representative Will Tuell", "Representative Joseph Underwood"], "signer_ids": ["s-baldacci-joseph", "h-salisbury-suzanne", "s-beebe-center-anne", "h-copeland-lynn", "h-farrin-wayne", "h-greenwood-randall", "h-matlack-ann", "h-pomerleau-kimberly", "h-rollins-david", "h-tuell-william", "h-underwood-joseph"]}, {"label": "Minority report", "recommendation": "Ought To Pass As Amended", "signer_count": 1, "signers": ["Senator Joseph Martin"], "signer_ids": ["s-martin-joseph"]}], "chamber_actions": [{"date": "2025-02-06", "chamber": "House", "action": "Received by the Clerk of the House on February 6, 2025."}, {"date": "2025-02-06", "chamber": "House", "action": "The Bill was REFERRED to the Committee on STATE AND LOCAL GOVERNMENT pursuant to Joint Rule 308.2 and ordered printed pursuant to Joint Rule 401."}, {"date": "2025-03-21", "chamber": "House", "action": "Carried over, in the same posture, to the next special or regular session of the 132nd Legislature, pursuant to Joint Order SP 519."}, {"date": "2025-05-29", "chamber": "House", "action": "Reports READ."}, {"date": "2025-05-29", "chamber": "House", "action": "On motion of Representative SALISBURY of Westbrook, the Majority Ought Not to Pass Report was ACCEPTED."}, {"date": "2025-05-29", "chamber": "House", "action": "Sent for concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-06-02", "chamber": "Senate", "action": "Reports READ"}, {"date": "2025-06-02", "chamber": "Senate", "action": "On motion by Senator PIERCE of Cumberland The Majority Ought Not To Pass Report ACCEPTED in concurrence."}, {"date": "2025-06-02", "chamber": "Senate", "action": "Placed in Legislative Files (DEAD)"}], "roll_calls": [], "hearing": {"date": "2025-02-24", "time": "10:00 AM", "location": "Cross Building, Room 214", "committee_code": "SLG", "testimony_count": 11}, "heard_with": [], "tags": ["State Government", "Rulemaking"], "affected_statutes": [], "testimony": [{"id": "10033958", "name": "Barbara Archer Hirsch", "organization": "Maine Human Rights Commission", "town": null, "position": null, "position_source": null, "date": "2025-02-24", "hearing_date": "2025-02-24", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=10033958", "has_text": false, "shared_with": [], "person_profile_id": null, "org_profile_id": "a-mhrc"}, {"id": "184113", "name": "Cathy Breen", "organization": "Maine Conservation Voters", "town": null, "position": "oppose", "position_source": "inferred", "date": "2025-02-24", "hearing_date": "2025-02-24", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=184113", "has_text": true, "shared_with": [], "person_profile_id": null, "org_profile_id": "org-maine-conservation-voters"}, {"id": "184111", "name": "Emily Cook", "organization": "Department of the Secretary of State", "town": null, "position": "oppose", "position_source": "inferred", "date": "2025-02-24", "hearing_date": "2025-02-24", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=184111", "has_text": true, "shared_with": [], "person_profile_id": "o-emily-cook-sos", "org_profile_id": "a-sos"}, {"id": "10033439", "name": "Harris Van Pate", "organiza