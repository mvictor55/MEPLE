{"ld": 1129, "paper": "HP748", "session": "132", "title": "An Act to Clarify Standards for Defendants' Post-judgment Motions for Relief from Protection from Abuse Orders", "sponsor_id": "h-kuhn-amy", "cosponsor_ids": ["h-cloutier-kristen", "h-meyer-michele", "h-murphy-kelly", "h-pugh-dylan", "h-sinclair-david", "h-stover-holly"], "committee_code": "JUD", "committee_name": "Judiciary", "summary": {"text": "This bill clarifies that a defendant seeking relief from a protection from abuse order may file a motion to extinguish a final order only in accordance with the Maine Rules of Civil Procedure unless there are extraordinary circumstances. The bill further clarifies that motions to enforce an order and motions for contempt are unavailable remedies to those defendants. Under the bill, the court may dismiss without a hearing any motion filed by the defendant seeking post-judgment relief.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0748&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-05-30", "governor_action": "Signed", "governor_action_date": "2025-05-30"}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 1129)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0748&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-245)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0748&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-245)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0748&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN112902.pdf"}], "committee_actions": [{"date": "2025-04-08", "action": "Work Session Held", "result": null}, {"date": "2025-04-08", "action": "Voted", "result": "OTP-AM"}, {"d