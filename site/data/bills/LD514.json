{"ld": 514, "paper": "SP233", "session": "132", "title": "Resolve, to Raise MaineCare Reimbursement Rates for Detoxification Services for Substance Use Disorder Treatment", "sponsor_id": "s-baldacci-joseph", "cosponsor_ids": ["s-farrin-bradlee", "s-rafferty-joseph", "h-rana-ambureen", "h-stover-holly", "h-supica-laura"], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This resolve requires the Department of Health and Human Services to amend its rule Chapter 101: MaineCare Benefits Manual, Chapter III, Section 97, Private Non-Medical Institution Services, Appendix B to reimburse for non-hospital-based medically supervised withdrawal services at no less than $594.38 per day. The department must amend the rule no later than January 1, 2026.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0233&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-03-27", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "fiscal_note_url": null, "documents": [{"label": "Bill text (LD 514)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0233&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-03-19", "action": "Work Session Held", "result": null}, {"date": "2025-03-19", "action": "Voted", "result": "ONTP"}, {"date": "2025-03-25", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-02-07", "chamber": "Senate", "action": "Received by the Secretary of the Senate on February 7, 2025 and REFERRED to the Committee on HEALTH AND HUMAN SERVICES pursuant to Joint Rule 308.2"}, {"date": "20