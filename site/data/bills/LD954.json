{"ld": 954, "paper": "SP410", "session": "132", "title": "An Act to Amend the Law Governing the Membership of the Government Oversight Committee (EMERGENCY)", "sponsor_id": "s-hickman-craig", "cosponsor_ids": ["s-larsen-daughtry-matthea", "h-fecteau-ryan"], "committee_code": "SLG", "committee_name": "State and Local Government", "summary": {"text": "This bill removes the requirement that, beginning with the 132nd Legislature, at least one member of the Government Oversight Committee be a member of the joint standing committee of the Legislature having jurisdiction over taxation matters and at least one member be a member of the joint standing committee of the Legislature having jurisdiction over economic development matters. It also removes language that states that no 2 members of the committee may be members of the same joint standing committee of the Legislature and also members of the same political party.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0410&item=1&snum=132"}, "status": "enacted", "status_label": "Emergency Enacted", "final_disposition": {"label": "Emergency Enacted", "date": "2025-05-23", "governor_action": "Emergency Signed", "governor_action_date": "2025-05-23"}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 954)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0410&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-69)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0410&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-69)", "description": "Emergency", "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0410&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN095402.pdf"}], "committee_actions": [{"date": "2025-04-09", "action": "Work Session Held", "result": null}, {"date": "2025-04-09", "action": "Voted", "result": "OTP-AM"}, {"date": "2025-05-12", "action": "Reported Out", "result": "OTP-AM"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought to Pass as Amended", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-03-06", "chamber": "Senate", "action": "Received by the Secretary of the Senate on March 6, 2025 and REFERRED to the Committee on STATE AND LOCAL GOVERNMENT pursuant to Joint Rule 308.2"}, {"date": "2025-03-21", "chamber": "Senate", "action": "CARRIED OVER, in the same posture, to the next special or regular session of the 132nd Legislature, pursuant to Joint Order SP 519."}, {"date": "2025-05-13", "chamber": "Senate", "action": "Report READ and ACCEPTED."}, {"date": "2025-05-13", "chamber": "Senate", "action": "READ ONCE."}, {"date": "2025-05-13", "chamber": "Senate", "action": "Committee Amendment \"A\" (S-69) READ and ADOPTED."}, {"date": "2025-05-13", "chamber": "Senate", "action": "Under suspension of the Rules, READ A SECOND TIME and PASSED TO BE ENGROSSED AS AMENDED BY Committee Amendment \"A\" (S-69)."}, {"date": "2025-05-13", "chamber": "Senate", "action": "Ordered sent down forthwith for concurrence."}, {"date": "2025-05-14", "chamber": "House", "action": "CONSENT CALENDAR - FIRST DAY"}, {"date": "2025-05-14", "chamber": "House", "action": "Under suspension of the rules CONSENT CALENDAR - SECOND DAY."}, {"date": "2025-05-14", "chamber": "House", "action": "The Bill was PASSED TO BE ENGROSSED as Amended by Committee Amendment \"A\" (S-69)."}, {"date": "2025-05-14", "chamber": "House", "action": "In concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-05-20", "chamber": "House", "action": "This being an emergency measure, a two-thirds vote of all the members elected to the House was necessary."}, {"date": "2025-05-20", "chamber": "House", "action": "PASSED TO BE ENACTED."}, {"date": "2025-05-20", "chamber": "House", "action": "Sent for concurre