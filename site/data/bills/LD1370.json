{"ld": 1370, "paper": "HP893", "session": "132", "title": "Resolve, Requiring the Judicial Branch to Report on the Implementation and Operation of Its Electronic Filing System", "sponsor_id": "h-fredette-kenneth", "cosponsor_ids": [], "committee_code": "JUD", "committee_name": "Judiciary", "summary": {"text": "This resolve directs the judicial branch to submit a comprehensive report to the Joint Standing Committee on Judiciary regarding the implementation of the electronic filing system. The report must address costs, training, implementation progress, satisfaction among judges, clerks and other staff and alternative electronic filing software options and must include any recommendations for legislative or administrative action necessary to improve the electronic filing system. The judicial branch must complete the report with existing resources and must submit the report to the committee no later than December 3, 2025. The committee is authorized to report out legislation based on the report to the Second Regular Session of the 132nd Legislature.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0893&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2025-05-07", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 1370)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0893&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-15", "action": "Work Session Held", "result": null}, {"date": "2025-04-15", "action": "Voted", "result": "Divided Report"}, {"date": "2025-05-02", "action": "Reported Out", "result": "ONTP/OTP"}], "committee_reports": [{"label": "Majority report", "recommendation": "Ought Not To Pass", "signer_count": 13, "signers": ["Senator Anne Carney (Chair)",