{"ld": 1442, "paper": "SP583", "session": "132", "title": "Resolve, Regarding Personal Care Agency Licensing Rules", "sponsor_id": "s-baldacci-joseph", "cosponsor_ids": ["h-graham-anne", "h-hasenfus-tavis", "h-milliken-nina", "h-supica-laura", "h-terry-parnell"], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This resolve requires the Department of Health and Human Services, within 60 days of the effective date of this resolve, to make changes to its rule Chapter 129: Personal Care Agency Licensing Rule. These changes include removal of the requirement that a personal care agency have a physical site located in the State; additional options for required training of direct care staff; changes to supervision requirements and to reporting requirements; and changes to requirements for clients to sign certain changes to the clients' service plans.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0583&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 1442)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0583&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-16", "action": "Work Session Held", "result": "TABLED"}, {"date": "2025-05-22", "action": "Work Session Held", "result": null}, {"date": "2025-05-22", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-28", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-04-08", "chamber": "Senate", "action": "Committe