{"ld": 1299, "paper": "SP529", "session": "132", "title": "An Act to Prohibit the Unsecured Storage of Handguns in Motor Vehicles", "sponsor_id": "s-talbot-ross-rachel", "cosponsor_ids": ["h-abdi-mana", "s-carney-anne", "h-cloutier-kristen", "s-larsen-daughtry-matthea", "h-doudera-victoria", "h-fecteau-ryan", "h-kuhn-amy", "h-lee-adam", "s-rotundo-margaret"], "committee_code": "JUD", "committee_name": "Judiciary", "summary": {"text": "This bill prohibits a person from intentionally or knowingly storing a handgun in an unoccupied motor vehicle unless the handgun is stored out of plain view in a locked hard-sided container and the motor vehicle, including the trunk, is locked. The bill includes a number of exceptions to this prohibition. A person who violates this prohibition commits a civil violation for which a fine of not less than $200 and not more than $500 may be adjudged, except that a person who violates the prohibition after having previously been adjudicated as violating the prohibition may be adjudged a fine of not less than $500 and not more than $1,000.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0529&item=1&snum=132"}, "status": "died", "status_label": "Accepted Minority (ONTP) Report", "final_disposition": {"label": "Accepted Minority (ONTP) Report", "date": "2025-06-16", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1299)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0529&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-361)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0529&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-361)", "description": null, "sponsor": null, "status": "Adopted by Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0529&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/l