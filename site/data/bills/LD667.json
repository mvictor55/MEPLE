{"ld": 667, "paper": "HP435", "session": "132", "title": "An Act to Modernize the State Motor Vehicle Inspection Program and the Law Governing Inspection Fees", "sponsor_id": "h-parry-wayne", "cosponsor_ids": ["h-crafts-lydia"], "committee_code": "TRA", "committee_name": "Transportation", "summary": {"text": "This bill authorizes the Chief of the State Police to require the use of an electronic inspection program for the purpose of performing motor vehicle inspections and to exempt from this requirement an inspection station that demonstrates economic hardship as a result of using an electronic inspection program. It also authorizes an inspection station to charge a fee not more than 2 1/2 times the State's minimum wage for inspection regardless of the model year of the inspected vehicle and provides that an operator of an official school bus inspection station is entitled to a fee not more than 2 1/2 times the State's minimum wage for each school bus inspected.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0435&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-04-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 667)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0435&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-17", "action": "Work Session Held", "result": null}, {"date": "2025-04-17", "action": "Voted", "result": "ONTP"}, {"date": "2025-04-23", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-02-20", "chamber": "House", "action": "Receiv