{"ld": 1450, "paper": "SP591", "session": "132", "title": "An Act Regarding the Voluntary Municipal Farm Support Program", "sponsor_id": "s-tipping-michael", "cosponsor_ids": ["h-archer-marshall", "h-beck-matthew", "s-bickford-bruce", "s-brenner-stacy", "h-frost-sharon", "s-hickman-craig", "s-ingwersen-henry", "s-nangle-timothy", "s-talbot-ross-rachel"], "committee_code": "ACF", "committee_name": "Agriculture, Conservation and Forestry", "summary": {"text": "This bill changes the allocation of the Voluntary Municipal Farm Support Program from the Maine Revised Statutes, Title 7, which contains laws governing agriculture, to Title 36, which contains laws governing taxation. The program includes laws governing farm support arrangements. The bill also reduces the minimum term of a qualified easement from 20 years to 10 years and allows the municipal officers or a municipal employee or committee appointed by the municipal officers to review and approve farm support arrangements.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0591&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-09", "governor_action": "Signed", "governor_action_date": "2025-06-09"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1450)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0591&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-176)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0591&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-176)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0591&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN145002.pdf"}], "committee_actions": [{"date": "2025-05-13", "action": "Work Sess