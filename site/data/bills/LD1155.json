{"ld": 1155, "paper": "HP760", "session": "132", "title": "An Act to Ensure Appropriate County Government Operations Relating to the Position of Dedimus Justice", "sponsor_id": "h-flynn-paul", "cosponsor_ids": ["h-cimino-marygrace", "h-collins-alicia", "s-cyrway-scott", "h-griffin-abigail", "h-pomerleau-kimberly"], "committee_code": "SLG", "committee_name": "State and Local Government", "summary": {"text": "This bill amends the law governing dedimus justices by requiring the appointment of 2 county employees and one sheriff's department employee in each county to perform the duties of dedimus justice on behalf of county government and the county sheriff, respectively. The bill also requires the Secretary of State to maintain a roster of persons designated as dedimus justices and make the roster available on the Secretary of State's publicly accessible website.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0760&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-04-24", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "fiscal_note_url": null, "documents": [{"label": "Bill text (LD 1155)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0760&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-09", "action": "Work Session Held", "result": "TABLED"}, {"date": "2025-04-14", "action": "Work Session Held", "result": null}, {"date": "2025-04-14", "action": "Voted", "result": "ONTP"}, {"date": "2025-04-23", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-03-20", "chamber": "House", "action": "Committee on