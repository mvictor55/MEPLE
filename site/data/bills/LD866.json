{"ld": 866, "paper": "HP552", "session": "132", "title": "Resolve, Directing the Department of Inland Fisheries and Wildlife to Implement a Landowner Antlerless Deer Permit Gift Program (TITLE CHANGE)", "sponsor_id": "h-foster-steven", "cosponsor_ids": ["s-black-russell", "s-cyrway-scott", "h-dill-james", "h-flynn-paul", "s-haggan-david", "h-mason-richard", "h-perkins-chad", "h-thorne-james", "h-wood-stephen"], "committee_code": "IFW", "committee_name": "Inland Fisheries and Wildlife", "summary": {"text": "This bill amends the law governing the antlerless deer permit lottery to provide that a landowner who keeps the landowner's lands open to hunting by the public and applies for an antlerless deer permit and is successful in obtaining a permit is not charged for the permit. The bill also adds language to require that such a landowner who is unsuccessful in obtaining an antlerless deer permit through the special landowner drawing but is successful in obtaining a permit through other means is not charged for that permit.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0552&item=1&snum=132"}, "status": "enacted", "status_label": "Finally Passed", "final_disposition": {"label": "Finally Passed", "date": "2025-06-12", "governor_action": "Signed", "governor_action_date": "2025-06-12"}, "fiscal_status": "Fiscal Impact", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN086601.pdf", "documents": [{"label": "Bill text (LD 866)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0552&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-521)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0552&item=2&snum=132", "item": 2}, {"label": "Amendment C-B (H-522)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0552&item=3&snum=132", "item": 3}], "amendments": [{"id": "C-A (H-521)", "description": null, "sponsor": null, "statu