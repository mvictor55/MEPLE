{"ld": 1467, "paper": "HP959", "session": "132", "title": "An Act to Ensure Accountability for Repairs Conducted by Independent Repair Facilities on Motor Vehicles Under Warranty", "sponsor_id": "h-collamore-amanda", "cosponsor_ids": ["h-quint-tracy", "h-roberts-lovell-tiffany"], "committee_code": "HED", "committee_name": "Housing and Economic Development", "summary": {"text": "This bill requires independent motor vehicle repair facilities to cover consumer, motor vehicle manufacturer and motor vehicle dealership costs in correcting improper repairs performed by those facilities on motor vehicles that are covered by manufacturer's warranties. The bill provides that such a facility that fails to reimburse the costs to correct an improper repair commits an unfair trade practice under the Maine Unfair Trade Practices Act.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0959&item=1&snum=132"}, "status": "died", "status_label": "Died Between Houses", "final_disposition": {"label": "Died Between Houses", "date": "2025-06-11", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 1467)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0959&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-586)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0959&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-586)", "description": "Change Title", "sponsor": null, "status": "Adopted by House", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0959&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN146702.pdf"}], "committee_actions": [{"date": "2025-05-12", "action": "Work Session Held", "result": null}, {"date": "2025-05-12", "action": "Voted", "result": "Divided Report"}, {"date": "2025-06-09", "action": "Reported Out", "resul