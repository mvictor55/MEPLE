{"ld": 2204, "paper": "SP897", "session": "132", "title": "Resolve, Directing the Department of Education to Develop Guidance for School Leaders to Ensure Supportive Measures for Young Students Involved in Challenging, Disruptive or Unsafe Behaviors (EMERGENCY) (TITLE CHANGE)", "sponsor_id": "s-hickman-craig", "cosponsor_ids": [], "committee_code": "EDU", "committee_name": "Education and Cultural Affairs", "summary": {"text": "This bill requires school boards to adopt a policy for expelling a student enrolled in any grade who is determined to have committed sexual assault on school grounds or other school property and for referring the matter to the appropriate local law enforcement agency. The bill requires that, in accordance with the proper investigation and due process provisions, a student who is determined to have committed sexual assault must be expelled from school for a period of not less than one year, except that a school board may authorize the superintendent to modify in writing the requirement for expulsion of a student on a case-by-case basis.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0897&item=1&snum=132"}, "status": "died", "status_label": "Died On Adjournment", "final_disposition": {"label": "Died On Adjournment", "date": "2026-04-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN220401.pdf", "documents": [{"label": "Bill text (LD 2204)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0897&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-600)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0897&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-600)", "description": "Emergency", "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp