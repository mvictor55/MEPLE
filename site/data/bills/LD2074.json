{"ld": 2074, "paper": "HP1387", "session": "132", "title": "An Act to Update the Requirements for Social Worker Licensure (EMERGENCY)", "sponsor_id": "h-mastraccio-anne-marie", "cosponsor_ids": [], "committee_code": "HCIFS", "committee_name": "Health Coverage, Insurance and Financial Services", "summary": {"text": "This bill changes the licensure requirements for social workers. The bill enacts definitions of conditional licensure categories, identifies qualifying degrees for licensure, streamlines the qualifications for licensure specific to consultation and social work experience requirements, removes requirements for initial licensure that have created barriers to entering or re-entering the social work profession, clarifies the consultant eligibility, removes the 2-tiered system for eligibility for Department of Health and Human Services social workers and social workers who are not employees of the department and expands the State Board of Social Worker Licensure's authority to consider consultation and social work experience gained in this State or another jurisdiction when seeking initial licensure, late renewal or reinstatement of licensure.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1387&item=1&snum=132"}, "status": "enacted", "status_label": "Emergency Enacted", "final_disposition": {"label": "Emergency Enacted", "date": "2026-03-23", "governor_action": "Emergency Signed", "governor_action_date": "2026-03-23"}, "fiscal_status": "No Fiscal Impact", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN207401.pdf", "documents": [{"label": "Bill text (LD 2074)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1387&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-833)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1387&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-833)", "description": "Emergency", "s