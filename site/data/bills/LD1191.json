{"ld": 1191, "paper": "SP480", "session": "132", "title": "An Act to Ensure Timely Reimbursement for Providers of Child Care Services for Children in Foster Care", "sponsor_id": "s-baldacci-joseph", "cosponsor_ids": [], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This bill requires the Department of Health and Human Services to pay the invoice of a child care provider for child care services rendered to a family foster home within 15 days of receiving the invoice. The bill requires the department to establish procedures to ensure the timely processing of the reimbursement to the provider, to provide guidance to child care providers on requirements for submitting invoices and to issue an annual report to the Governor and the Legislature on the department's compliance with these provisions.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0480&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-04-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 1191)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0480&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-16", "action": "Work Session Held", "result": null}, {"date": "2025-04-16", "action": "Voted", "result": "ONTP"}, {"date": "2025-04-23", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-03-20", "chamber": "Senate", "action": "Committee on HEALTH AND HUMAN SERVICES suggested and ordered printed REFERENCE to the Committee on HEALTH AND HUMAN SERVICES Ordered