{"ld": 1237, "paper": "HP812", "session": "132", "title": "An Act to Support Adult Family Care Homes and Residential Care Facilities That Are Small or Located in Rural and Isolated Areas of the State", "sponsor_id": "h-mitchell-christina", "cosponsor_ids": ["h-daigle-lucien", "s-larsen-daughtry-matthea", "h-eaton-holly", "h-farrin-wayne", "h-graham-anne", "h-hasenfus-tavis", "h-mccabe-julia", "s-moore-marianne"], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This bill requires the Department of Health and Human Services to amend its rules in Chapter 101: MaineCare Benefits Manual, Chapters II and III, Section 2, Adult Family Care Services, and Chapter III, Section 97, Private Non-Medical Institution Services, Appendix C, to provide a supplemental payment of 10% to the MaineCare rates for facilities that have fewer than 10 beds or are at least 35 miles away from the nearest similar facility. The bill also requires the Department of Health and Human Services to determine the likely impact of proposed rule changes to reimbursement and staffing requirements to long-term care facilities on small, rural, isolated and island facilities to reduce impacts on the communities where those facilities are located as well as the impact on safety and quality of services.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0812&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-04-30", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 1237)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0812&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-25", "action": "Work Session Held", "result": null}, {"date": "2025-04-25", "action": "Voted", "result": "ONTP"}, {"date": "2025-04-28", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-03-25", "chamber": "House", "action": "Committee on Health and Human Services suggested and ordered printed."}, {"date": "2025-03-25", "chamber": "House", "action": "The Bill was REFERRED to the Committee on HEALTH AND HUMAN SERVICES."}, {"date": "2025-03-25", "chamber": "House", "action": "Sent for concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-03-25", "chamber": "Senate", "action": "The Bill was REFERRED to the Committee on HEALTH AND HUMAN SERVICES  in concurrence"}, {"date": "2025-04-30", "chamber": "Senate", "action": "Pursuant to Joint Rule 310.3 Placed in Legislative Files (DEAD)"}], "roll_calls": [], "hearing": {"date": "2025-04-11", "time": "10:00 AM", "location": "Cross Building, Room 209", "committee_code": "HHS", "testimony_count": 5}, "heard_with": [], "tags": ["Elderly", "Long-term Care"], "affected_statutes": [], "testimony": [{"id": "189588", "name": "Christina Mitchell", "organization": "Maine State Legislature", "town": null, "position": "support", "position_source": "inferred", "date": "2025-04-11", "hearing_date": "2025-04-11", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=189588", "has_text": true, "shared_with": [], "person_profile_id": null, "org_profile_id": null}, {"id": "189587", "name": "Holly Eaton", "organization": "Maine State Legislature", "town": null, "position": "support", "position_source": "inferred", "date": "2025-04-11", "hearing_date": "2025-04-11", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=189587", "has_text": true, "shared_with": [], "person_profile_id": null, "org_profile_id": null}, {"id": "10044218", "name": "Mattie Daughtry", "organization": null, "town": "Brun