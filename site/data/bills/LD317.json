{"ld": 317, "paper": "HP217", "session": "132", "title": "An Act to Enact the Safe Cosmetics Act", "sponsor_id": "h-warren-sophia", "cosponsor_ids": ["h-abdi-mana", "s-larsen-daughtry-matthea", "h-gramlich-lori", "h-rana-ambureen"], "committee_code": "ENR", "committee_name": "Environment and Natural Resources", "summary": {"text": "This bill enacts the Safe Cosmetics Act, which prohibits, beginning January 1, 2027, the distribution, sale or offering for sale in this State of cosmetic products containing certain intentionally added ingredients, including, but not limited to, lead, mercury or formaldehyde. A person distributing, selling or offering for sale a cosmetic product does not violate the Act if the cosmetic product contains only a technically unavoidable trace quantity of a prohibited ingredient due to impurities from a natural or synthetic ingredient used in the manufacture of the cosmetic product, from the manufacturing process or from storage of the cosmetic product or due to migration of the ingredient from the packaging of the cosmetic product.\n\nWhen a retailer purchases cosmetic products from a manufacturer and it is later determined that those cosmetic products contain ingredients that prohibit the retailer from distributing, selling or offering the product for sale pursuant to the Act, the retailer is entitled to a full refund from the manufacturer with respect to the product, including shipping and other related costs.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0217&item=1&snum=132"}, "status": "died", "status_label": "Died On Adjournment", "final_disposition": {"label": "Died On Adjournment", "date": "2026-04-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN031701.pdf", "documents": [{"label": "Bill text (LD 317)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0217&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-193)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0217&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-193)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0217&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN031702.pdf"}], "committee_actions": [{"date": "2025-02-26", "action": "Work Session Held", "result": null}, {"date": "2025-02-26", "action": "Voted", "result": "Divided Report"}, {"date": "2025-05-16", "action": "Reported Out", "result": "OTP-AM/ONTP"}], "committee_reports": [{"label": "Majority report", "recommendation": "Ought To Pass As Amended", "signer_count": 10, "signers": ["Representative Victoria Doudera (Chair)", "Senator Denise Tepler (Chair)", "Representative Dan Ankeles", "Representative Art Bell", "Senator Stacy Brenner", "Representative William Bridgeo", "Senator Joseph Martin", "Representative Laurie Osher", "Representative Morgan Rielly", "Representative David Woodsome"], "signer_ids": ["h-doudera-victoria", "s-tepler-denise", "h-ankeles-daniel", "h-bell-arthur", "s-brenner-stacy", "h-bridgeo-william", "s-martin-joseph", "h-osher-laurie", "h-rielly-morgan", "h-woodsome-david"]}, {"label": "Minority report", "recommendation": "Ought Not To Pass", "signer_count": 3, "signers": ["Representative Dick Campbell", "Representative Tammy Schmersal-Burgess", "Representative Mike Soboleski"], "signer_ids": ["h-campbell-richard", "h-schmersal-burgess-tammy", "h-soboleski-michael"]}], "chamber_actions": [{"date": "2025-01-30", "chamber": "House", "action": "Received by the Clerk of the House on January 30, 2025."}, {"date": "2025-01-30", "chamber": "House", "action": "The Bill was REFERRED to the Committee on ENVIRONMENT AND NATURAL RESOURCES pursuant to Joint Rule 308.2 and or