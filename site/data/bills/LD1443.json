{"ld": 1443, "paper": "SP584", "session": "132", "title": "An Act to Ensure the Financial Stability of Behavioral Health Service Providers and Housing Assistance Providers (EMERGENCY)", "sponsor_id": "s-bennett-richard", "cosponsor_ids": ["h-ankeles-daniel", "s-baldacci-joseph", "h-carlow-nathan", "h-crafts-lydia", "s-moore-marianne", "h-salisbury-suzanne", "h-shagoury-daniel", "s-talbot-ross-rachel", "s-timberlake-jeffrey"], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This bill requires the Department of Health and Human Services to continue payments to service providers, including, but not limited to, private or nonprofit behavioral health agencies, housing assistance providers and other nonprofit organizations, in good standing with the department at their previous contract rates when delays in new contract awarding, finalization or payment exceed 30 days. It also requires the department to pay administrative expenses and interest charged on lines of credit or loans accessed by a service provider when a delay in awarding, finalization or payment of a department contract requires the service provider to access the line of credit or loan.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0584&item=1&snum=132"}, "status": "died", "status_label": "Died On Adjournment", "final_disposition": {"label": "Died On Adjournment", "date": "2026-04-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1443)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0584&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-302)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0584&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-302)", "description": "Emergency", "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislatur