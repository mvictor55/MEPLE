{"ld": 2229, "paper": "SP911", "session": "132", "title": "An Act Regarding Municipal Inspection of the Electrical and Plumbing Components of a Manufactured Home (EMERGENCY)", "sponsor_id": "s-curry-glenn", "cosponsor_ids": [], "committee_code": "HED", "committee_name": "Housing and Economic Development", "summary": {"text": "This bill is reported out by the Joint Standing Committee on Housing and Economic Development pursuant to Resolve 2025, chapter 105. The committee has not taken a position on the substance of this bill. By reporting this bill out, the committee is not suggesting and does not intend to suggest that it agrees or disagrees with any aspect of this bill. The committee is reporting the bill out for the sole purpose of having a bill printed that can be referred to the committee for an appropriate public hearing and subsequent processing in the normal course.\n\nThe bill allows an individual to make an electrical installation or plumbing installation, without a license under the Maine Revised Statutes, Title 32, chapters 17 and 49, respectively, when the installation is made during the construction of manufactured housing in compliance with Title 10, chapter 951 and under the supervision of or inspection by a master electrician or master plumber, respectively. The bill eliminates duplicative inspections by municipalities of electrical and plumbing construction and installation within manufactured housing constructed and installed in compliance with the manufactured housing laws.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0911&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2026-03-25", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 2229)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0911&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2026-03-19", "action": "Work Session Held", "result": null}, {"date": "2026-03-19", "action": "Voted", "result": "ONTP"}, {"date": "2026-03-24", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2026-03-05", "chamber": "Senate", "action": "Report READ and ACCEPTED."}, {"date": "2026-03-05", "chamber": "Senate", "action": "Roll Call Ordered Roll Call Number 730 Yeas 20 - Nays 11 - Excused 4 - Absent 0"}, {"date": "2026-03-05", "chamber": "Senate", "action": "Bills and accompanying papers REFERRED to the Committee on HOUSING AND ECONOMIC DEVELOPMENT."}, {"date": "2026-03-05", "chamber": "Senate", "action": "Sent down for concurrence."}, {"date": "2026-03-05", "chamber": "House", "action": "Report was READ and ACCEPTED."}, {"date": "2026-03-05", "chamber": "House", "action": "The Bill was REFERRED to the Committee on HOUSING AND ECONOMIC DEVELOPMENT"}, {"date": "2026-03-05", "chamber": "House", "action": "In concurrence. ORDERED SENT FORTHWITH."}, {"date": "2026-03-19", "chamber": "J", "action": "Work Session Held"}, {"date": "2026-03-19", "chamber": "J", "action": "Voted: ONTP"}, {"date": "2026-03-24", "chamber": "J", "action": "Reported Out: ONTP"}, {"date": "2026-03-25", "chamber": "Senate", "action": "Pursuant to Joint Rule 310.3 Placed in Legislative Files (DEAD)"}], "roll_calls": [{"id": "1655356", "date": "2026-03-05", "chamber": "S", "motion": "Accept Report RC #730", "yea": 20, "nay": 11, "nv": 0, "absent": 4, "result": "Passed", "url": null, "votes": [{"id": "s-bickford-bruce", "vote": "Nay"}, {"id": "s-rotundo-margaret", "vote": "Yea"}, {"id": "s-black-russell", "vote": "Nay"}, {"id": "s-guerin-stacey", "vote": "Nay"}, {"id": "s-timberlake-jeffrey", "vote": "Nay"},