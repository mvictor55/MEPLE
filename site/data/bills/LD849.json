{"ld": 849, "paper": "HP535", "session": "132", "title": "An Act to Establish a Recall Process for Public School Board Members", "sponsor_id": "h-sayre-daniel", "cosponsor_ids": ["h-ankeles-daniel", "h-bridgeo-william", "s-ingwersen-henry", "s-rafferty-joseph", "h-rollins-david"], "committee_code": "SLG", "committee_name": "State and Local Government", "summary": {"text": "This bill provides that public school board members may be recalled only for specified behavior or misconduct and may not be recalled for the performance of a required duty or a discretionary duty. The petition to recall the school board member must be signed by at least 25% of the voters who voted in the last gubernatorial election in the municipality or, if the school board member was elected as a school board member-at-large, by at least 25% of the voters who voted in the school administrative unit in the last gubernatorial election. The recall must be approved by a majority of voters in an election in which the total number of ballots is at least 35% of the number of votes cast in the municipality or, if applicable, the school administrative unit in the last gubernatorial election.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0535&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2026-03-18", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 849)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0535&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-14", "action": "Work Session Held", "result": "TABLED"}, {"date": "2025-05-23", "action": "Carry Over Requested", "result": null}, {"date": "2025-06-25", "action": "Carry Over Approved", "result": null}, {"date": 