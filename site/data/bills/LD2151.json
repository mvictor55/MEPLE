{"ld": 2151, "paper": "SP872", "session": "132", "title": "Resolve, to Improve Access to Affordable Prescription Drugs in Underserved Areas (EMERGENCY) (TITLE CHANGE)", "sponsor_id": "s-reny-cameron", "cosponsor_ids": ["s-bailey-donna", "h-cluchey-sally", "s-larsen-daughtry-matthea", "h-ducharme-john", "h-foley-robert", "s-harrington-matthew", "s-moore-marianne", "h-morris-joshua", "s-rotundo-margaret"], "committee_code": "HCIFS", "committee_name": "Health Coverage, Insurance and Financial Services", "summary": {"text": "This bill directs the Department of Health and Human Services to provide support for federally qualified health centers to develop or expand the centers' capacity to provide access to affordably priced prescription drugs to patients by increasing the centers' ability to deliver pharmacy services to those patients. The bill provides one-time funding of $4,000,000 in fiscal year 2026-27 for that purpose. The bill provides that initial awards of funding must be made by December 15, 2026 and that the selection process must be performed by an evaluation team, the majority of whose members must be persons with training or experience in the operation and management of federally qualified health centers.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0872&item=1&snum=132"}, "status": "died", "status_label": "Died On Adjournment", "final_disposition": {"label": "Died On Adjournment", "date": "2026-04-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 2151)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0872&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-580)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0872&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-580)", "description": "Emergency", "sponsor": null, "status": "Adopted by House & Senate", "url"