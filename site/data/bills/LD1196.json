{"ld": 1196, "paper": "SP485", "session": "132", "title": "Resolve, to Require the Towns of Kittery and York to Develop a Boundary Description", "sponsor_id": "s-lawrence-mark", "cosponsor_ids": ["h-mathieson-kristi", "h-meyer-michele", "h-runte-walter", "h-sargent-holly"], "committee_code": "SLG", "committee_name": "State and Local Government", "summary": {"text": "This resolve requires the Town of Kittery and the Town of York to jointly develop a description, in metes and bounds, of the boundary between the 2 towns based on the assessing maps in each of the towns. The towns are required to jointly provide the description to the Joint Standing Committee on State and Local Government, which may report out a bill to the Second Regular Session of the 132nd Legislature establishing the boundary between the 2 towns.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0485&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 1196)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0485&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-16", "action": "Work Session Held", "result": "TABLED"}, {"date": "2025-05-19", "action": "Work Session Held", "result": null}, {"date": "2025-05-19", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-28", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-03-20", "chamber": "Senate", "action": "Committee on STATE AND LOCAL GOVERNMENT suggested and ordered printed REFERENCE to th