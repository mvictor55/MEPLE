{"ld": 353, "paper": "SP139", "session": "132", "title": "Resolve, to Establish the Commission to Recommend Methods for Preventing Deed Fraud in the State (EMERGENCY)", "sponsor_id": "s-ingwersen-henry", "cosponsor_ids": ["s-brenner-stacy", "s-carney-anne", "h-ducharme-john", "h-malon-marc", "s-pierce-teresa", "s-rafferty-joseph", "h-sato-eleanor"], "committee_code": "JUD", "committee_name": "Judiciary", "summary": {"text": "This resolve establishes the Commission to Recommend Methods for Preventing Deed Fraud in the State. The commission is required to make findings and recommendations for preventing deed fraud in the State, including recommendations for enhanced public awareness of deed fraud and any suggested legislation for enhancing identity verification requirements for real estate transactions in the State and for improving the civil and criminal remedies available in the State. The commission is required to report to the Joint Standing Committee on Judiciary by December 3, 2025 and the joint standing committee is authorized to report out legislation related to the report to the Second Regular Session of the 132nd Legislature.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0139&item=1&snum=132"}, "status": "enacted", "status_label": "Emergency Finally Passed", "final_disposition": {"label": "Emergency Finally Passed", "date": "2025-07-01", "governor_action": "Emergency Signed", "governor_action_date": "2025-07-01"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 353)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0139&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-129)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0139&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-129)", "description": "Emergency", "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0139&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN035302.pdf"}], "committee_actions": [{"date": "2025-02-26", "action": "Work Session Held", "result": "TABLED"}, {"date": "2025-03-12", "action": "Work Session Held", "result": null}, {"date": "2025-03-12", "action": "Voted", "result": "OTP-AM"}, {"date": "2025-05-21", "action": "Reported Out", "result": "OTP-AM"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought to Pass as Amended", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-01-30", "chamber": "Senate", "action": "Received by the Secretary of the Senate on January 30, 2025 and REFERRED to the Committee on JUDICIARY pursuant to Joint Rule 308.2"}, {"date": "2025-02-26", "chamber": "J", "action": "Work Session Held: TABLED"}, {"date": "2025-03-12", "chamber": "J", "action": "Work Session Held"}, {"date": "2025-03-12", "chamber": "J", "action": "Voted: OTP-AM"}, {"date": "2025-03-21", "chamber": "Senate", "action": "CARRIED OVER, in the same posture, to the next special or regular session of the 132nd Legislature, pursuant to Joint Order SP 519."}, {"date": "2025-05-21", "chamber": "J", "action": "Reported Out: OTP-AM"}, {"date": "2025-05-22", "chamber": "Senate", "action": "Report READ and ACCEPTED."}, {"date": "2025-05-22", "chamber": "Senate", "action": "READ ONCE."}, {"date": "2025-05-22", "chamber": "Senate", "action": "Committee Amendment \"A\" (S-129) READ and ADOPTED."}, {"date": "2025-05-22", "chamber": "Senate", "action": "Under suspension of the Rules, READ A SECOND TIME and PASSED TO BE ENGROSSED AS AMENDED BY Committee Amendment \"A\" (S-129)."}, {"date": "2025-05-22", "chamber": "Senate", "action": "Ordered sent down forthwith for concurrence."}, {"date": "2025-05-27", "chamber": "House", "action": "CONSENT CALENDAR - FIRST DAY"}, {"date": "2025-05-27", "chamber": "House", "action": "Under suspensio