{"ld": 1864, "paper": "SP734", "session": "132", "title": "An Act to Facilitate the Reconstruction of Storm-damaged Commercial Fisheries Facilities and Infrastructure (EMERGENCY)", "sponsor_id": "s-larsen-daughtry-matthea", "cosponsor_ids": ["h-golek-cheryl"], "committee_code": "HED", "committee_name": "Housing and Economic Development", "summary": {"text": "This bill allows an exception to the Maine Revised Statutes, Title 30-A, section 4353, subsection 4, paragraph A to allow an individual or business owner whose dock, pier or wharf was damaged by the severe storms and flooding that occurred from January 9, 2024 to January 13, 2024 to be granted a variance from the shoreland zoning ordinance and floodplain management ordinance of the town of Harpswell, even if the land was not damaged to such an extent that it yields no reasonable return, so that the individual or business owner may conduct repairs on those structures and to do so in time to take advantage of federal funds available pursuant to an emergency declaration.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0734&item=1&snum=132"}, "status": "enacted", "status_label": "Emergency Enacted", "final_disposition": {"label": "Emergency Enacted", "date": "2025-06-12", "governor_action": "Emergency Signed", "governor_action_date": "2025-06-12"}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 1864)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0734&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-246)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0734&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-246)", "description": "Emergency", "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0734&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs