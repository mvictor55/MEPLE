{"ld": 976, "paper": "HP636", "session": "132", "title": "Resolve, to Establish a Working Group to Facilitate Public Access and Resilience Planning for Swan Island (TITLE CHANGE)", "sponsor_id": "h-cluchey-sally", "cosponsor_ids": ["h-bridgeo-william", "h-hepler-allison", "h-lemelin-michael", "s-tepler-denise"], "committee_code": "IFW", "committee_name": "Inland Fisheries and Wildlife", "summary": {"text": "This resolve directs the Department of Inland Fisheries and Wildlife to develop a plan to ensure that accessible, regularly scheduled public transportation is available to Swan Island in Perkins Township in Sagadahoc County. It also requires the department to report on its plan, including any suggested legislation, to the Joint Standing Committee on Inland Fisheries and Wildlife, which is authorized to report out a bill to the Second Regular Session of the 132nd Legislature.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0636&item=1&snum=132"}, "status": "enacted", "status_label": "Finally Passed", "final_disposition": {"label": "Finally Passed", "date": "2025-06-22", "governor_action": "Unsigned", "governor_action_date": "2025-06-22"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 976)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0636&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-479)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0636&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-479)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0636&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN097602.pdf"}], "committee_actions": [{"date": "2025-05-12", "action": "Work Session Held", "result": null}, {"date": "2025-05-12", "action": "Voted", "result": "OTP