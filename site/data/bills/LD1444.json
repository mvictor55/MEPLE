{"ld": 1444, "paper": "SP585", "session": "132", "title": "An Act to Clarify the Application of Finch v. U.S. Bank, N.A. (TITLE CHANGE)", "sponsor_id": "s-carney-anne", "cosponsor_ids": ["h-bell-arthur", "h-fecteau-ryan", "h-gattine-andrew", "h-kuhn-amy", "h-moonen-matthew", "s-pierce-teresa", "s-reny-cameron", "s-rotundo-margaret"], "committee_code": "JUD", "committee_name": "Judiciary", "summary": {"text": "This bill requires a mortgagee of property that is occupied by the mortgagor to provide proof of strict compliance with the requirement that a mortgagee provide at least 35 days' notice before bringing a judicial action to foreclose on that property. Failure to provide such proof prevents the mortgagor from prevailing in the foreclosure action or from bringing a foreclosure action against that property in the future; this was the law prior to the decision of the Supreme Judicial Court in Finch v. U.S. Bank, N.A., 2024 Me. 2. The bill applies retroactively to all foreclosure judgments, orders or dismissals entered against a mortgagor.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0585&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2026-04-13", "governor_action": "Signed", "governor_action_date": "2026-04-13"}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 1444)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0585&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-379)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0585&item=2&snum=132", "item": 2}, {"label": "Amendment C-B (S-593)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0585&item=4&snum=132", "item": 4}], "amendments": [{"id": "C-A (S-379)", "description": "Change Title", "sponsor": null, "status": null, "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0