{"ld": 589, "paper": "SP273", "session": "132", "title": "An Act to Establish a State Minimum Hourly Wage for Agricultural Workers (TITLE CHANGE)", "sponsor_id": "s-talbot-ross-rachel", "cosponsor_ids": ["s-bennett-richard", "s-curry-glenn", "s-larsen-daughtry-matthea", "h-fecteau-ryan", "h-gere-traci", "s-hickman-craig", "h-roeder-amy", "s-rotundo-margaret", "s-tipping-michael"], "committee_code": "LAB", "committee_name": "Labor", "summary": {"text": "This bill provides that agricultural employees and seasonal farm employees are subject to the laws that place limits on mandatory overtime. It also provides that agricultural employees are subject to the laws that set a minimum wage and overtime rate. It provides that the laws that set an overtime rate apply to certain activities related to agricultural produce, meat and fish products and perishable foods. The bill phases in overtime pay for individuals employed in agriculture and certain activities related to agriculture.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0273&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-10", "governor_action": "Signed", "governor_action_date": "2025-06-10"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 589)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0273&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-196)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0273&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-196)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0273&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN058902.pdf"}], "committee_actions": [{"date": "2025-05-06", "action": "Work Session H