{"ld": 848, "paper": "HP534", "session": "132", "title": "An Act Regarding the Retired County and Municipal Law Enforcement Officers and Municipal Firefighters Health Insurance Program", "sponsor_id": "h-henderson-rachel", "cosponsor_ids": [], "committee_code": "LAB", "committee_name": "Labor", "summary": {"text": "This bill provides that a county or municipal law enforcement officer or a municipal firefighter who is employed in the position of a county or municipal law enforcement officer or a municipal firefighter and who previously elected not to enroll in the Retired County and Municipal Law Enforcement Officers and Municipal Firefighters Health Insurance Program may enroll from October 1, 2025 to November 30, 2025. The bill also requires the Department of Administrative and Financial Services, Bureau of Human Resources, Office of Employee Health and Wellness to provide electronic briefings regarding the program every 2 months to newly hired county or municipal law enforcement officers or municipal firefighters who are eligible to enroll in the program.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0534&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-05-29", "governor_action": "Signed", "governor_action_date": "2025-05-29"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 848)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0534&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-216)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0534&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-216)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0534&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs