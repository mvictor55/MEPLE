{"ld": 1580, "paper": "HP1038", "session": "132", "title": "An Act to Prohibit Carriers and Pharmacy Benefits Managers from Using Spread Pricing (TITLE CHANGE)", "sponsor_id": "h-nutting-robert", "cosponsor_ids": ["h-bridgeo-william", "h-cluchey-sally", "h-collamore-amanda", "h-ducharme-john", "h-foley-robert", "h-henderson-rachel", "h-morris-joshua", "h-olsen-rolf"], "committee_code": "HCIFS", "committee_name": "Health Coverage, Insurance and Financial Services", "summary": {"text": "This bill provides that a pharmacy benefits manager may not derive income from pharmacy benefits manager services provided to a carrier or health plan in this State except for income derived from a pharmacy benefits management fee. The pharmacy benefits management fee may not exceed the value of the services actually performed by the pharmacy benefits manager. The bill prohibits so-called spread pricing, which, under the bill, means amounts charged by a pharmacy benefits manager in excess of the ingredient cost for a dispensed prescription drug, the dispensing fee paid to the pharmacy or pharmacist and the pharmacy benefits management fee.\n\nThe bill establishes additional requirements related to what costs may not be included in the pharmacy benefits management fee. The amount of any pharmacy benefits management fees must be established in the agreement between the pharmacy benefits manager and the carrier or health plan.\n\nThe bill requires that pharmacy benefits managers annually certify to the Superintendent of Insurance that they are in compliance with the provisions of the bill. The superintendent may assess a civil penalty for violation of these provisions not to exceed $1,000 per violation.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1038&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-12", "governor_action": "Signed", "governor_action_date": "2025-06-12"}, "fiscal_status": "Not Yet Determined", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN158002.pdf", "documents": [{"label": "Bill text (LD 1580)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1038&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-543)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1038&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-543)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1038&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN158002.pdf"}], "committee_actions": [{"date": "2025-05-08", "action": "Work Session Held", "result": null}, {"date": "2025-05-08", "action": "Voted", "result": "OTP-AM"}, {"date": "2025-05-15", "action": "Work Session Held", "result": null}, {"date": "2025-05-15", "action": "Voted", "result": "OTP-AM"}, {"date": "2025-06-06", "action": "Reported Out", "result": "OTP-AM"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought to Pass as Amended", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-04-10", "chamber": "House", "action": "Committee on Health Coverage, Insurance and Financial Services suggested and ordered printed."}, {"date": "2025-04-10", "chamber": "House", "action": "The Bill was REFERRED to the Committee on HEALTH COVERAGE, INSURANCE AND FINANCIAL SERVICES."}, {"date": "2025-04-10", "chamber": "House", "action": "Sent for concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-04-10", "chamber": "Senate", "action": "The Bill was REFERRED to the Committee on HEALTH COVERAGE, INSURANCE AND FINANCIAL SERVICES  in concurrence"}, {"date": "2025-06-09", "chamber": "House", "action": "CONSENT CALENDAR - FIRST DAY"}, {"date": "2025-06-09", "chamber": "House", "action": 