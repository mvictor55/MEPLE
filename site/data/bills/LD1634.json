{"ld": 1634, "paper": "HP1088", "session": "132", "title": "An Act Regarding MaineCare Waiting Lists", "sponsor_id": "h-osher-laurie", "cosponsor_ids": ["h-debrito-flavia", "h-mccabe-julia", "h-sargent-holly", "h-shagoury-daniel"], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This bill directs the Department of Health and Human Services to require that for any service covered under the MaineCare program, an individual enrolled in the MaineCare program may not be required to wait for services longer than 6 months from the time the services are requested. If at any time a provider's waiting list exceeds the 6-month waiting limit for those individuals, the department must submit to the joint standing committee of the Legislature having jurisdiction over health and human services matters a corrective action plan to reduce waiting times within 3 months from the time the department becomes aware of this occurrence.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1088&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-13", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1634)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1088&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-01", "action": "Work Session Held", "result": null}, {"date": "2025-05-01", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-07", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-04-11", "chamber": "House", "action": "Received 