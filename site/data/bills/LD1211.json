{"ld": 1211, "paper": "SP500", "session": "132", "title": "An Act Regarding Certain Definitions in the Sales and Use Tax Laws Affecting Rental Equipment (TITLE CHANGE)", "sponsor_id": "s-farrin-bradlee", "cosponsor_ids": ["s-bickford-bruce", "h-perkins-chad", "h-rudnicki-shelley"], "committee_code": "TAX", "committee_name": "Taxation", "summary": {"text": "This bill changes the definition of \"automobile\" in the sales and use tax laws to provide that a pickup truck or van with a gross vehicle weight rating of 10,000 pounds or less is included only if it is not used primarily to transport goods or freight.\n\nThe bill also changes the definition of \"lease or rental\" to provide that it does not include a lease or rental of tangible personal property that is used only at the primary business location of the lessor.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0500&item=1&snum=132"}, "status": "died", "status_label": "Died On Adjournment", "final_disposition": {"label": "Died On Adjournment", "date": "2026-04-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1211)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0500&item=1&snum=132", "item": 1}, {"label": "Amendment C-B (S-432)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0500&item=2&snum=132", "item": 2}, {"label": "Amendment C-A (S-431)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0500&item=3&snum=132", "item": 3}], "amendments": [{"id": "C-B (S-432)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0500&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN121102.pdf"}, {"id": "C-A (S-431)", "description": null, "sponsor": null, "status": null, "url"