{"ld": 133, "paper": "SP69", "session": "132", "title": "An Act to Amend the Laws Regarding Nuisance Dogs", "sponsor_id": "s-bennett-richard", "cosponsor_ids": ["s-baldacci-joseph", "h-wadsworth-nathan", "h-woodsome-david"], "committee_code": "ACF", "committee_name": "Agriculture, Conservation and Forestry", "summary": {"text": "This bill amends the definition of \"nuisance dog\" to include a dog or wolf hybrid that disturbs the peace of an individual by excessive barking, howling or yelping, and the individual is not trespassing on the dog or wolf hybrid owner's or keeper's premises at the time of the excessive barking, howling or yelping. The bill also explicitly authorizes a person to file a written complaint to a sheriff, local law enforcement officer or animal control officer if the person's peace has been disrupted by a dog that barks, howls or yelps excessively.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0069&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-04-08", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 133)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0069&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-03-27", "action": "Work Session Held", "result": null}, {"date": "2025-03-27", "action": "Voted", "result": "ONTP"}, {"date": "2025-04-04", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-01-08", "chamber": "Senate", "action": "Committee on AGRICULTURE, CONSERVATION AND FORESTRY suggested and ordered printed REFERENCE to the C