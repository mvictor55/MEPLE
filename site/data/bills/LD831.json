{"ld": 831, "paper": "SP361", "session": "132", "title": "An Act Regarding Abandoned Vehicles Due to Involuntary Psychiatric Hospitalization", "sponsor_id": "s-moore-marianne", "cosponsor_ids": ["h-ankeles-daniel", "h-crafts-lydia", "h-graham-anne", "h-mccabe-julia"], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This bill allows a period of 120 days before the Secretary of State determines that a vehicle is abandoned if the vehicle owner is involuntarily hospitalized. The notification of involuntary hospitalization, which must be provided to the Secretary to State, may come from the owner of the vehicle, the hospital or another person authorized by the owner of the vehicle. The bill prohibits the Secretary of State from issuing a letter of ownership or certificate of title until at least 120 days after the date on which the owner of the premises where a vehicle has been abandoned, or the owner's agent, has been notified that the vehicle owner is involuntarily hospitalized. The bill also reduces the total storage charges to $600 for the first 30 days of storage and specifies the total storage charges may not exceed $1,500 for each subsequent 30-day period.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0361&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-22", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN083101.pdf", "documents": [{"label": "Bill text (LD 831)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0361&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-10", "action": "Work Session Held", "result": "TABLED"}, {"date": "20