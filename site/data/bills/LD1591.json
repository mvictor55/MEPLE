{"ld": 1591, "paper": "HP1049", "session": "132", "title": "An Act to Grant a Municipality Authority to Tax Property According to Use", "sponsor_id": "h-ankeles-daniel", "cosponsor_ids": [], "committee_code": "TAX", "committee_name": "Taxation", "summary": {"text": "This bill provides that if an amendment to the Constitution of Maine allows such an assessment, a municipality may assess differential mill rates, classification ratios or other means of differential taxation of property according to use, including homestead residences, nonhomestead residential property and property for commercial use. Property must be taxed consistently across all types of property used for similar purposes.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1049&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-21", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN159101.pdf", "documents": [{"label": "Bill text (LD 1591)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1049&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-15", "action": "Work Session Held", "result": null}, {"date": "2025-05-15", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-20", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-04-10", "chamber": "House", "action": "Committee on Taxation suggested and ordered printed."}, {"date": "2025-04-10", "chamber": "House", "action": "The Bill was REFERRED to the Committee on TAXATION."}, {"date": "2025-04-10