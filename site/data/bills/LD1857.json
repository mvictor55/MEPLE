{"ld": 1857, "paper": "SP727", "session": "132", "title": "An Act to Expand Property Tax Relief for Veterans and Their Survivors and to Modify Certain Corporate Tax Expenditures", "sponsor_id": "s-tipping-michael", "cosponsor_ids": [], "committee_code": "TAX", "committee_name": "Taxation", "summary": {"text": "Part A of the bill changes the property tax benefits for military veterans beginning with property tax years beginning on or after April 1, 2026. Part A provides that veterans are no longer required to have served during a federally recognized war period and receive an exemption of up to $5,000 of the just value of the property. It provides that veterans who are 62 years of age or older receive an exemption of up to $6,000 of the just value of the property. It also provides that veterans receive an exemption of between $10,000 and $50,000 based on their United States Department of Veterans Affairs service-connected disability rating. Part A provides that veterans' survivors remain eligible for the benefit that the veteran would be eligible for if the veteran was living.\n\nPart B eliminates tax credits for investment in qualified professional baseball facilities and for major business headquarters expansion; eliminates the discounted rate on cigarette stamps for licensed distributors; eliminates the refund on sales tax on purchases of parts and supplies for windjammers; and reduces the value of the aggregate amount of tax credit certificates that the Finance Authority of Maine may authorize under the Maine Seed Capital Tax Credit Program for investments made in calendar year 2026 from $15,000,000 to $10,000,000.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0727&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2025-06-11", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1857)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0727&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-341)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0727&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-341)", "description": null, "sponsor": null, "status": null, "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0727&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN185702.pdf"}], "committee_actions": [{"date": "2025-05-20", "action": "Work Session Held", "result": null}, {"date": "2025-05-20", "action": "Voted", "result": "Divided Report"}, {"date": "2025-06-05", "action": "Work Session Reconsidered", "result": null}, {"date": "2025-06-05", "action": "Voted", "result": "Divided Report"}, {"date": "2025-06-10", "action": "Reported Out", "result": "ONTP/OTP-AM"}], "committee_reports": [{"label": "Majority report", "recommendation": "Ought Not To Pass", "signer_count": 9, "signers": ["Senator Nicole Grohoski (Chair)", "Representative Dan Sayre (Chair)", "Senator Bruce Bickford", "Representative Kristen Cloutier", "Representative Ed Crockett", "Representative Ann Matlack", "Representative Tracy Quint", "Representative Shelley Rudnicki", "Representative Gregg Swallow"], "signer_ids": ["s-grohoski-nicole", "h-sayre-daniel", "s-bickford-bruce", "h-cloutier-kristen", "h-crockett-edward", "h-matlack-ann", "h-quint-tracy", "h-rudnicki-shelley", "h-swallow-gregory"]}, {"label": "Minority report", "recommendation": "Ought To Pass As Amended", "signer_count": 2, "signers": ["Representative Gary Friedmann", "Senator Michael Tipping"], "signer_ids": ["h-friedmann-gary", "s-tipping-michael"]}], "chamber_actions": [{"date": "2025-05-01", "chamber": "Senate", "action": "Received by the Secretary of the Senate on May 1, 2025 and REFERRED to the Committee on TAXATION purs