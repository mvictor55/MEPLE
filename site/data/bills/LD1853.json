{"ld": 1853, "paper": "HP1237", "session": "132", "title": "An Act to Establish an Educational Tax Credit Program to Help Parents Pay for Nonpublic School Tuition and Fees", "sponsor_id": "h-swallow-gregory", "cosponsor_ids": [], "committee_code": "TAX", "committee_name": "Taxation", "summary": {"text": "This bill expands the State's public education obligation beyond solely public schools to include the education of all eligible persons within a school administrative unit. It establishes a refundable tax credit program for parents or guardians of eligible students enrolled in nonpublic schools. The credit is equivalent to 70% of the cost of publicly funded education. The credit is delayed for those currently enrolled in nonpublic schools until the 2027-2028 school year. The bill establishes a companion tax credit in the Maine Revised Statutes, Title 36, chapter 822.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1237&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2025-06-16", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1853)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1237&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-733)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1237&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-733)", "description": null, "sponsor": null, "status": null, "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1237&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN185302.pdf"}], "committee_actions": [{"date": "2025-05-21", "action": "Work Session Held", "result": null}, {"date": "2025-05-21", "action": "Voted", "result": "Divided Report"}, {