{"ld": 2008, "paper": "SP827", "session": "132", "title": "An Act to Provide Funding to the Maine School of Science and Mathematics (TITLE CHANGE)", "sponsor_id": "s-grohoski-nicole", "cosponsor_ids": ["h-babin-mark", "s-bernard-susan", "h-frost-sharon", "h-gere-traci", "s-libby-james", "h-murphy-kelly", "s-rafferty-joseph", "s-stewart-harold"], "committee_code": "EDU", "committee_name": "Education and Cultural Affairs", "summary": {"text": "This bill requires a sending school administrative unit that does not operate or contract with a secondary school to pay the cost of attending the Maine School of Science and Mathematics for students from the unit and specifies that the cost of attending the Maine School of Science and Mathematics includes room and board. The bill also provides funding to the Maine School of Science and Mathematics to support administrative operations, to support in-state students' room and board expenses and for infrastructure upgrades to the school's dormitory.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0827&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2026-04-16", "governor_action": "Signed", "governor_action_date": "2026-04-16"}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 2008)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0827&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-537)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0827&item=2&snum=132", "item": 2}, {"label": "Amendment S-A to C-A (S-698)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0827&item=4&snum=132", "item": 4}], "amendments": [{"id": "C-A (S-537)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0827&item=2&snum=132", "fiscal_note_url"