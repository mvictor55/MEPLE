{"ld": 54, "paper": "HP18", "session": "132", "title": "An Act to Require Employers to Disclose Pay Ranges and Maintain Records of Employees' Pay Histories", "sponsor_id": "h-roeder-amy", "cosponsor_ids": [], "committee_code": "LAB", "committee_name": "Labor", "summary": {"text": "This bill requires an employer with 10 or more employees to include on a job posting a statement that lists the prospective range of pay the employer will offer to a successful applicant. The bill also requires an employer, upon request of an employee, to disclose the range of pay it offers for the position the employee holds and requires the employer to maintain a record of each position held by an employee and the employee's pay history during the employee's employment and for 3 years after the employee's termination of employment.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0018&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2026-04-24", "governor_action": "Signed", "governor_action_date": "2026-04-24"}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 54)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0018&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-136)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0018&item=2&snum=132", "item": 2}, {"label": "Amendment S-A to C-A (S-664)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0018&item=4&snum=132", "item": 4}, {"label": "Amendment H-A to C-A (H-1050)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0018&item=6&snum=132", "item": 6}], "amendments": [{"id": "C-A (H-136)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0018&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov