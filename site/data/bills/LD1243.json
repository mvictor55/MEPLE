{"ld": 1243, "paper": "HP818", "session": "132", "title": "An Act Regarding the Licensing of Assisted Living Facilities (EMERGENCY)", "sponsor_id": "h-strout-tiffany", "cosponsor_ids": ["h-collamore-amanda", "h-drinkwater-gary", "h-griffin-abigail", "h-javner-kathy", "s-moore-marianne", "h-quint-tracy", "h-smith-katrina", "h-stover-holly", "h-zager-samuel"], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This bill allows an assisted living facility that received a license prior to October 1, 2023 and commenced construction of a new facility prior to October 1, 2023 to be subject to the same licensure requirements as the licensee was subject to at the time of the prior license. If there were licensing violations at the facility under the previous license, the licensee does not qualify.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0818&item=1&snum=132"}, "status": "enacted", "status_label": "Emergency Enacted", "final_disposition": {"label": "Emergency Enacted", "date": "2025-06-15", "governor_action": "Emergency Unsigned", "governor_action_date": "2025-06-15"}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 1243)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0818&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-254)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0818&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-254)", "description": "Emergency", "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0818&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN124302.pdf"}], "committee_actions": [{"date": "2025-04-16", "action": "Work Session Held", "result": null}, {"date": "2025-04-16", "action": "Voted", "result": "OTP-AM"}, {"date": "2025-05-22