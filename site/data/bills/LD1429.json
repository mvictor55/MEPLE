{"ld": 1429, "paper": "HP938", "session": "132", "title": "An Act to Provide Full Reimbursement for Emergency Ambulance Services Provided to MaineCare Members", "sponsor_id": "h-fredette-kenneth", "cosponsor_ids": [], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This bill requires the Department of Health and Human Services to reimburse providers of emergency ambulance services at the full rate for services provided to MaineCare members. It applies to municipal, quasi-municipal and private ambulance services and fire department emergency medical services. The bill also requires the department to adopt rules to implement the reimbursement requirement and to submit an annual report to the Legislature.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0938&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-27", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 1429)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0938&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-20", "action": "Work Session Held", "result": null}, {"date": "2025-05-20", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-23", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-04-03", "chamber": "House", "action": "Committee on Health and Human Services suggested and ordered printed."}, {"date": "2025-04-03", "chamber": "House", "action": "The Bill was REFERRED to the Committee on HEALTH AND HUMAN SERVICES."}, {"date": "2025-04-03", "chamb