{"ld": 1154, "paper": "HP759", "session": "132", "title": "An Act to Require That Informed Consent for Abortion Include Information on Perinatal Hospice", "sponsor_id": "h-paul-reagan", "cosponsor_ids": ["h-collins-alicia", "h-griffin-abigail", "s-guerin-stacey", "s-harrington-matthew", "h-javner-kathy", "s-martin-joseph", "h-quint-tracy", "h-smith-katrina", "s-stewart-harold"], "committee_code": "JUD", "committee_name": "Judiciary", "summary": {"text": "This bill requires a health care professional, as part of ensuring informed consent for an abortion of a pregnant woman whose fetus has received a diagnosis of a lethal fetal anomaly, to inform the woman of perinatal hospice services and provide the woman with a list of available perinatal hospice services providers. If the woman declines receiving perinatal hospice services and elects to proceed with the abortion, the woman must certify that decision in writing and that the woman received the list of perinatal hospice services providers.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0759&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2025-06-10", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 1154)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0759&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-01", "action": "Work Session Held", "result": null}, {"date": "2025-04-01", "action": "Voted", "result": "Divided Report"}, {"date": "2025-06-09", "action": "Reported Out", "result": "ONTP/OTP"}], "committee_reports": [{"label": "Majority report", "recommendation": "Ought Not To Pass", "signer_count": 8, "signers": ["Senator Anne Carney (Chair)", "Representative Amy Kuhn (Chair)", "Representative Adam Lee", "