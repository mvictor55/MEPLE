{"ld": 1948, "paper": "HP1307", "session": "132", "title": "An Act to Fund MaineCare (EMERGENCY)", "sponsor_id": "h-dill-james", "cosponsor_ids": ["h-arata-amy", "h-collamore-amanda", "h-cray-dean"], "committee_code": null, "committee_name": null, "summary": {"text": "Part A of this bill provides one-time funding for the MaineCare program in fiscal year 2024-25. Part A takes effect when approved. Part B of the bill deappropriates one-time funding provided in Public Law 2025, chapter 2, Part D for the MaineCare program. Part B takes effect June 20, 2025, which is the effective date of Public Law 2025, chapter 2, Part D.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1307&item=1&snum=132"}, "status": "died", "status_label": "Died On Adjournment", "final_disposition": {"label": "Died On Adjournment", "date": "2026-04-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN194801.pdf", "documents": [{"label": "Bill text (LD 1948)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1307&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [], "committee_reports": [], "chamber_actions": [{"date": "2025-05-07", "chamber": "House", "action": "Committee on HEALTH AND HUMAN SERVICES suggested and ordered printed."}, {"date": "2025-05-07", "chamber": "House", "action": "On motion of Representative MOONEN of Portland, TABLED pending REFERENCE."}, {"date": "2025-05-07", "chamber": "House", "action": "Later today assigned."}, {"date": "2025-05-07", "chamber": "House", "action": "Speaker laid before the House"}, {"date": "2025-05-07", "chamber": "House", "action": "Subsequently, under suspension of the rules and WITHOUT REFERENCE to a Committee, the Bill was READ ONCE."}, {"date": "2025-05-07", "chamber": "House", "action": "Speaker FECTEAU of Biddeford MOVED to SUSPEND the rules for the purpose of giving the Bill its second reading without reference to any Committee"}, {"date": "2025-05-07", "chamber": "House", "action": "Representative COLLAMORE of Pittsfield OBJECTED."}, {"date": "2025-05-07", "chamber": "House", "action": "Representative FAULKINGHAM of Winter Harbor REQUESTED a division on suspension of Joint Rule 308."}, {"date": "2025-05-07", "chamber": "House", "action": "The Chair ordered a division."}, {"date": "2025-05-07", "chamber": "House", "action": "A vote of the House was taken. 69 voted in favor of the same and 63 against, and accordingly the rules were SUSPENDED and the Bill was given its SECOND READING without REFERENCE to the Committee on Bills in the Second Reading."}, {"date": "2025-05-07", "chamber": "House", "action": "Motion of Representative FREDETTE of Newport to INDEFINITELY POSTPONE the Bill and accompanying papers FAILED."}, {"date": "2025-05-07", "chamber": "House", "action": "ROLL CALL NO. 119 (Yeas 55 - Nays 85 - Absent 10 - Excused 0 - Restricted - 1)"}, {"date": "2025-05-07", "chamber": "House", "action": "Subsequently, the Bill was PASSED TO BE ENGROSSED."}, {"date": "2025-05-07", "chamber": "House", "action": "Sent for concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-05-13", "chamber": "Senate", "action": "On motion by Senator INGWERSEN of York moved the Rules be Suspended to give the Bill it's first reading without reference to a Committee PREVAILED"}, {"date": "2025-05-13", "chamber": "Senate", "action": "Roll Call Ordered Roll Call Number 141 Yeas 21 - Nays 12 - Excused 2 - Absent 0"}, {"date": "2025-05-13", "chamber": "Senate", "action": "READ ONCE"}, {"date": "2025-05-13", "chamber": "Senate", "action": "Under suspension of the Rules, READ A SECOND TIME  and PASSED TO BE ENGROSSED without reference to a Committee, in concurrence. PREVAILED"}, {"date": "2025-05-13", "chamber": "Senate", "action": "Roll Call Ordered Roll Call Number 142 Yeas 21 - Nays 12 - Excused 2 - Absent 0"}, {"