{"ld": 1874, "paper": "HP1245", "session": "132", "title": "An Act to Enable the Maine Pilotage Commission to Oversee Pilots Operating in Portland Harbor", "sponsor_id": "h-crockett-edward", "cosponsor_ids": ["s-duson-jill", "h-eaton-holly", "h-montell-karen", "h-parry-wayne"], "committee_code": "TRA", "committee_name": "Transportation", "summary": {"text": "This bill transfers jurisdiction over pilots operating in Portland Harbor from the Board of Harbor Commissioners for Portland Harbor to the Maine Pilotage Commission. It also changes the description of the coastal zones in the laws governing the Maine Pilotage Commission and, in the case of Portland Harbor, provides that certain vessels are exempt from the laws governing the Maine Pilotage Commission.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1245&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-10", "governor_action": "Signed", "governor_action_date": "2025-06-10"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1874)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1245&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-335)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1245&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-335)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1245&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN187402.pdf"}], "committee_actions": [{"date": "2025-05-13", "action": "Refer Approved by Chairs/Leads", "result": "REFER TO OTHER"}, {"date": "2025-05-13", "action": "Reported Out", "result": "REFER TO OTHER"}, {"date": "2025-05-14", "action": "Work Session Held", "result": null}, {"date": "2025-05-14",