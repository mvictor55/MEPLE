{"ld": 951, "paper": "SP406", "session": "132", "title": "An Act to Require Disclosure of Campaign Funding Sources", "sponsor_id": "s-bennett-richard", "cosponsor_ids": ["s-grohoski-nicole", "h-rielly-morgan", "h-supica-laura"], "committee_code": "VLA", "committee_name": "Veterans and Legal Affairs", "summary": {"text": "This bill requires certain party committees, political action committees and ballot question committees to notify and seek consent from a contributor in writing that the contribution may be used to make expenditures to influence a political campaign in this State. The bill requires the committee to report to the Commission on Governmental Ethics and Election Practices information about the identity of certain contributors and 3rd parties and the amount of the contribution used to make expenditures to influence a political campaign in this State. The bill contains other requirements regarding the source of contributions, required reporting relating to the top 3 funders and penalties for violations.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0406&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-04-23", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 951)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0406&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-02", "action": "Work Session Held", "result": "TABLED"}, {"date": "2025-04-16", "action": "Work Session Held", "result": null}, {"date": "2025-04-16", "action": "Voted", "result": "ONTP"}, {"date": "2025-04-22", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_c