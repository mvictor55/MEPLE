{"ld": 1241, "paper": "HP816", "session": "132", "title": "An Act to Establish the Make Change for Wildlife Program to Support the Maine Endangered and Nongame Wildlife Fund", "sponsor_id": "h-cluchey-sally", "cosponsor_ids": ["s-baldacci-joseph", "h-bridgeo-william", "s-carney-anne", "h-dill-james", "h-gramlich-lori", "h-matlack-ann", "h-sayre-daniel", "h-terry-parnell"], "committee_code": "IFW", "committee_name": "Inland Fisheries and Wildlife", "summary": {"text": "This bill repeals the Wildlife Enthusiast's Conservation Appreciation, Recreation and Enjoyment, or \"WE CARE,\" support program and establishes the Make Change for Wildlife program as a way to generate voluntary contributions to benefit the Maine Endangered and Nongame Wildlife Fund. The bill also allows businesses to deduct up to $10,000 of those amounts contributed for purposes of the corporate income tax for tax years beginning on or after January 1, 2026.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0816&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-12", "governor_action": "Signed", "governor_action_date": "2025-06-12"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1241)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0816&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-480)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0816&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-480)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0816&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN124102.pdf"}], "committee_actions": [{"date": "2025-05-05", "action": "Work Session Held", "result": null}, {"date": "2025-05-05", "