{"ld": 1906, "paper": "SP747", "session": "132", "title": "An Act to Improve Accountability and Understanding of Data in Insurance Transactions", "sponsor_id": "s-bailey-donna", "cosponsor_ids": ["h-boyer-michelle", "s-larsen-daughtry-matthea", "h-fecteau-ryan", "h-foley-robert", "h-gattine-andrew", "h-gramlich-lori", "h-mathieson-kristi", "h-morris-joshua", "h-olsen-rolf"], "committee_code": "HCIFS", "committee_name": "Health Coverage, Insurance and Financial Services", "summary": {"text": "This bill requires administrators and pharmacy benefits managers that provide health coverage or prescription drug coverage under a contract with a plan sponsor, including any person that offers health coverage or prescription drug coverage to its employees or members through a self-funded health benefit plan, to provide certain claims information to a plan sponsor upon request. The bill also gives a plan sponsor the right to request an audit to ensure compliance with a contract at least once every calendar year as long as the request is at least 6 months after a previously requested audit.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0747&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-07-01", "governor_action": "Signed", "governor_action_date": "2025-07-01"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1906)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0747&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-367)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0747&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-367)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0747&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/