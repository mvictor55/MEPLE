{"ld": 1282, "paper": "SP510", "session": "132", "title": "An Act Regarding Eligibility for Historic Preservation Bond Proceeds", "sponsor_id": "s-hickman-craig", "cosponsor_ids": ["h-fredericks-ann", "h-greenwood-randall", "s-grohoski-nicole", "h-hasenfus-tavis", "h-lemelin-michael", "h-malon-marc", "h-morris-joshua", "s-rafferty-joseph", "s-timberlake-jeffrey"], "committee_code": "EDU", "committee_name": "Education and Cultural Affairs", "summary": {"text": "This bill amends the eligibility requirements for grants through the Maine Historic Preservation Commission for the preservation and restoration of historic properties to allow eligibility for properties that have been designated as historic properties by municipal historic preservation ordinances. The bill also directs the Maine Historic Preservation Commission to adopt rules regarding the disbursement of bond proceeds authorized by Public Law 2023, chapter 653 to establish a process for properties in the State that are not on the National Register of Historic Places but have been designated as historic properties by municipal historic preservation ordinances to receive funding through the bond proceeds.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0510&item=1&snum=132"}, "status": "died", "status_label": "Died On Adjournment", "final_disposition": {"label": "Died On Adjournment", "date": "2026-04-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 1282)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0510&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-96)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0510&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-96)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=