{"ld": 1122, "paper": "HP741", "session": "132", "title": "An Act to Amend the Law Banning Single-use Carry-out Bags", "sponsor_id": "h-warren-sophia", "cosponsor_ids": ["h-bell-arthur", "h-osher-laurie"], "committee_code": "ENR", "committee_name": "Environment and Natural Resources", "summary": {"text": "This bill amends the law banning the use of single-use plastic carry-out bags at retail establishments to clarify the scope of that law by incorporating new definitions for \"recycled paper carry-out bag,\" \"reusable fabric carry-out bag\" and \"reusable plastic carry- out bag.\" It also amends related definitions and makes other associated technical changes, including amending the definition of \"point of sale\" to provide that the law's prohibitions and other provisions apply to bags provided to a customer at self-service check-out kiosks, at in-store or curbside pickup locations and at any other location, including a customer's home, at which purchased merchandise is delivered or otherwise transferred to the customer.\n\nThe bill also increases from 5 cents to 10 cents the fee that a retail establishment must charge for each recycled paper carry-out bag or reusable plastic carry-out bag used to bag products at the point of sale.\n\nThese changes to the law banning the use of single-use plastic carry-out bags at retail establishments are effective January 1, 2026.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0741&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-04-08", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 1122)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0741&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-02", "action": "Work Session Held", "result": null}, {"date": "2025-04-02", "action": "Voted", "result": "ONTP"}, {"date": "2025-04-03", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-03-18", "chamber": "House", "action": "Committee on Environment and Natural Resources suggested and ordered printed."}, {"date": "2025-03-18", "chamber": "House", "action": "The Bill was REFERRED to the Committee on ENVIRONMENT AND NATURAL RESOURCES."}, {"date": "2025-03-18", "chamber": "House", "action": "Sent for concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-03-18", "chamber": "Senate", "action": "The Bill was REFERRED to the Committee on ENVIRONMENT AND NATURAL RESOURCES  in concurrence"}, {"date": "2025-03-21", "chamber": "House", "action": "Carried over, in the same posture, to the next special or regular session of the 132nd Legislature, pursuant to Joint Order SP 519."}, {"date": "2025-04-08", "chamber": "Senate", "action": "Pursuant to Joint Rule 310.3 Placed in Legislative Files (DEAD)"}], "roll_calls": [], "hearing": {"date": "2025-03-26", "time": "10:00 AM", "location": "Cross Building, Room 216", "committee_code": "ENR", "testimony_count": 58}, "heard_with": [56, 69], "tags": ["Containers - Returnable", "Plastic Bags"], "affected_statutes": [], "testimony": [{"id": "10039362", "name": "Amanda Kendall", "organization": null, "town": "bar harbor", "position": null, "position_source": null, "date": "2025-03-26", "hearing_date": "2025-03-26", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=10039362", "has_text": true, "shared_with": [], "person_profile_id": null, "org_profile_id": null}, {"id": "10039184", "name": "Angela Kortemeier", "organization": null, "town": "Bristol", "position": null, "position_source": null, "date": "2025-03-26", "hearing_date": "2025-0