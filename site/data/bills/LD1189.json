{"ld": 1189, "paper": "HP794", "session": "132", "title": "An Act to Allow an Attorney for the State to Determine Whether to Charge Certain Class E Crimes as Civil Violations (TITLE CHANGE)", "sponsor_id": "h-moonen-matthew", "cosponsor_ids": ["s-carney-anne", "h-caruso-elizabeth", "h-henderson-rachel", "h-kuhn-amy", "h-lee-adam", "h-poirier-jennifer", "h-sinclair-david", "s-talbot-ross-rachel"], "committee_code": "JUD", "committee_name": "Judiciary", "summary": {"text": "This bill clarifies that a person may not be arrested or detained for a civil violation. The bill also directs the attorney for the State to determine whether to charge a defendant for a civil violation in place of a Class E crime that is not eligible for probation based upon a variety of factors and with a penalty of no more than $1,000. The factors involved in the determination are not elements of the criminal offense or civil violation and the determination is not subject to judicial review.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0794&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-07-07", "governor_action": "Signed", "governor_action_date": "2025-07-07"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1189)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0794&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-752)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0794&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-752)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0794&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN118902.pdf"}], "committee_actions": [{"date": "2025-04-09", "action": "Work Session Held", "r