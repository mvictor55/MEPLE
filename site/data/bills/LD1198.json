{"ld": 1198, "paper": "SP487", "session": "132", "title": "Resolve, Directing the Department of Agriculture, Conservation and Forestry to Assess Its Current Meat and Poultry Inspection Programs (EMERGENCY)", "sponsor_id": "s-black-russell", "cosponsor_ids": ["h-cooper-mark", "h-cray-dean", "h-guerrette-timothy", "h-hall-randall", "s-hickman-craig", "h-jackson-caldwell", "h-perkins-chad", "s-timberlake-jeffrey"], "committee_code": "ACF", "committee_name": "Agriculture, Conservation and Forestry", "summary": {"text": "This resolve directs the Department of Agriculture, Conservation and Forestry to conduct a review of programs and processes related to meat and poultry inspections, including processes related to exemptions from inspections, to determine areas for possible improvements, efficiencies and enhanced flexibility to benefit agricultural producers, processors and retail and public customers. The department is required to submit a report based on its evaluation by January 15, 2026 to the Joint Standing Committee on Agriculture, Conservation and Forestry, which may submit legislation related to the report to the Second Regular Session of the 132nd Legislature.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0487&item=1&snum=132"}, "status": "enacted", "status_label": "Emergency Finally Passed", "final_disposition": {"label": "Emergency Finally Passed", "date": "2025-05-30", "governor_action": "Emergency Signed", "governor_action_date": "2025-05-30"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1198)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0487&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-90)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0487&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-90)", "description": "Emergency", "sponsor": null, "status": "Adopted by House & Senate", "url": "https://le