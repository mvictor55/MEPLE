{"ld": 1775, "paper": "HP1186", "session": "132", "title": "An Act to Authorize the Issuance of a Revenue Bond to Upgrade County Jails to Meet the Corrections Needs of Maine's Counties", "sponsor_id": "h-ducharme-john", "cosponsor_ids": ["s-baldacci-joseph", "s-bernard-susan", "s-black-russell", "h-bridgeo-william", "h-farrin-wayne", "h-greenwood-randall", "s-guerin-stacey", "s-moore-marianne", "s-stewart-harold"], "committee_code": "AFA", "committee_name": "Appropriations and Financial Affairs", "summary": {"text": "This bill authorizes the Finance Authority of Maine to issue revenue bonds in the amount of $87,000,000 to provide funding to county jails, including those that detain adult residents for up to 72 hours, to upgrade their facilities to accommodate residents who have a substance use disorder and to provide treatment and recovery services for those residents and to provide supplemental funding for jails that may have potential funding shortfalls. The bonds are issued for 10 years and are repaid using equal amounts from revenue from the contract for wholesale spirits operations and the funds received from the opioid settlement funds.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1186&item=1&snum=132"}, "status": "died", "status_label": "Died On Adjournment", "final_disposition": {"label": "Died On Adjournment", "date": "2026-04-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1775)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1186&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-06-25", "action": "Carry Over Approved", "result": null}, {"date": "2025-12-15", "action": "Work Session Held", "result": "TABLED"}], "committee_reports": [], "chamber_actions": [{"date": "2025-04-24", "chamber": "House", "action": "Committee on Housing and Economic Developmen