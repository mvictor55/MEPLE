{"ld": 330, "paper": "HP230", "session": "132", "title": "Resolve, to Create an Advisory Council to Oversee the Review and Technical Revision of the Maine Criminal Code and Other Statutes Establishing Criminal Offenses", "sponsor_id": "h-milliken-nina", "cosponsor_ids": ["h-boyer-david", "h-libby-laurel", "s-talbot-ross-rachel"], "committee_code": "CJPS", "committee_name": "Criminal Justice and Public Safety", "summary": {"text": "This resolve creates an advisory council to select an outside consultant to review the Maine Criminal Code and other statutes establishing criminal offenses to identify unused and obsolete provisions, clarify confusing language, eliminate inconsistencies, consolidate or eliminate redundant provisions and reorganize or restructure the Maine Criminal Code and other statutes establishing criminal offenses. It also directs the advisory council to submit a report based upon the review and any recommended legislation to the Joint Standing Committee on Criminal Justice and Public Safety, which is authorized to report out legislation to the Second Regular Session of the 132nd Legislature.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0230&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-04-15", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 330)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0230&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-09", "action": "Work Session Held", "result": null}, {"date": "2025-04-09", "action": "Voted", "result": "ONTP"}, {"date": "2025-04-14", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not