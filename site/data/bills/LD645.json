{"ld": 645, "paper": "HP413", "session": "132", "title": "An Act to Change the Size and Composition of the Board of Directors of the Maine Health Data Organization", "sponsor_id": "h-mathieson-kristi", "cosponsor_ids": [], "committee_code": "HCIFS", "committee_name": "Health Coverage, Insurance and Financial Services", "summary": {"text": "This bill changes the size of the Maine Health Data Organization board of directors from a board with 20 voting members and one nonvoting member to a board with 12 voting members and one nonvoting member. It changes the composition of the board by adding as a voting member a representative from the pharmaceutical industry and adding as the nonvoting member the executive director of the Maine Health Data Organization. It removes the provision regarding staggering of initial terms.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0413&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-03-25", "governor_action": "Signed", "governor_action_date": "2025-03-25"}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 645)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0413&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-03-05", "action": "Work Session Held", "result": null}, {"date": "2025-03-05", "action": "Voted", "result": "OTP"}, {"date": "2025-03-11", "action": "Reported Out", "result": "OTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-02-20", "chamber": "House", "action": "Received by the Clerk of the House on February 20, 2025."}, {"date": "2025-02-20", "chamber": "House", "action": "The Bill was REFERRED to the Committee on HEALTH COVERAGE, INSURANCE AND FINANCIAL SERVICES pursuant to Joi