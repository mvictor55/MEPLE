{"ld": 534, "paper": "HP353", "session": "132", "title": "An Act to Clarify the Rights of Crime Victims and Witnesses Regarding Professional Investigator Communications", "sponsor_id": "h-hasenfus-tavis", "cosponsor_ids": [], "committee_code": "CJPS", "committee_name": "Criminal Justice and Public Safety", "summary": {"text": "This bill requires a professional investigator, prior to communicating with a victim or witness of a crime, to disclose to the victim or witness the purpose of the investigation, whom the investigation is supposed to benefit and that the victim or witness is not required to communicate with the professional investigator. This bill also requires a professional investigator to cease contact with victims or witnesses who request not to be contacted by the professional investigator.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0353&item=1&snum=132"}, "status": "died", "status_label": "Died On Adjournment", "final_disposition": {"label": "Died On Adjournment", "date": "2026-04-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 534)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0353&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-704)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0353&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-704)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0353&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN053402.pdf"}], "committee_actions": [{"date": "2025-03-26", "action": "Work Session Held", "result": "TABLED"}, {"date": "2025-05-05", "action": "Work Session Held", "result": "TABLED"}, {"date": "2025-05-14", "action": "Work Session Held", "result"