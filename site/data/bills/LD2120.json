{"ld": 2120, "paper": "HP1435", "session": "132", "title": "An Act to Enable Survivors of Abuse to Disable Connected Vehicle Services", "sponsor_id": "h-roberts-lovell-tiffany", "cosponsor_ids": [], "committee_code": "JUD", "committee_name": "Judiciary", "summary": {"text": "This bill allows a survivor of certain crimes and acts, including domestic violence, dating violence, sexual assault, stalking and sex trafficking, to request that a motor vehicle manufacturer terminate or disable the access of an abuser who committed or allegedly committed such a crime or act to a connected vehicle service. The bill defines \"connected vehicle service\" to mean a capability provided by or on behalf of a motor vehicle manufacturer or affiliate of the motor vehicle manufacturer that enables a person to remotely obtain data from or send commands to a motor vehicle and that may be accomplished through a software application that is designed to be operated on a mobile device or computer.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1435&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2026-02-24", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 2120)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1435&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2026-02-04", "action": "Work Session Held", "result": null}, {"date": "2026-02-04", "action": "Voted", "result": "ONTP"}, {"date": "2026-02-12", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2026-01-07", "chamber": "House", "acti