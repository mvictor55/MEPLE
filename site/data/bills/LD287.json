{"ld": 287, "paper": "HP187", "session": "132", "title": "An Act to Require and Encourage Safe and Interconnected Transportation Construction Projects", "sponsor_id": "h-lee-adam", "cosponsor_ids": [], "committee_code": "HED", "committee_name": "Housing and Economic Development", "summary": {"text": "This bill establishes requirements for the safety and interconnectivity of state-financed transportation construction projects, including:\n\n1. Requiring a transportation project, the design of which commences on or after January 1, 2026 and the cost of which is $500,000 or more, to:\n\nA. Perform certain duties, including identifying locations on state highways and state aid highways with a lack of facilities for or designs creating unsafe conditions for pedestrians, bicyclists and other users not in a motor vehicle; B. Consult with municipalities about active or planned transportation connections, public transportation facilities and management of posted speed limits to reduce motor vehicle crash exposure and severity; C. Adjust posted speed limits within the construction project to minimize motor vehicle crashes, particularly in locations experiencing a higher probability of crashes; and D. Plan, design and construct facilities providing context-sensitive solutions that contribute to transportation system connectivity and safety for pedestrians, bicyclists, other users not in a motor vehicle and persons accessing public transportation; and 2. Requiring the Department of Transportation to prioritize transportation funding to projects that:\n\nA. Provide street access for all transportation users; B. Encourage mixed land uses; C. Encourage infill development; D. Facilitate access to affordable or dense housing; E. Encourage walkable neighborhoods; F. Preserve open space, wetlands, parks, farms and woodlands; and G. Encourage robust community and public participation, opinions and input in the type and scope of the transportation construction or other project.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0187&item=1&snum=132"}, "status": "died", "status_label": "Accepted Minority (ONTP) Report", "final_disposition": {"label": "Accepted Minority (ONTP) Report", "date": "2026-03-05", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN028702.pdf", "documents": [{"label": "Bill text (LD 287)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0187&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-820)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0187&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-820)", "description": "Change Title", "sponsor": null, "status": null, "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0187&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN028702.pdf"}], "committee_actions": [{"date": "2025-05-16", "action": "Work Session Held", "result": "TABLED"}, {"date": "2025-05-19", "action": "Carry Over Requested", "result": null}, {"date": "2025-05-19", "action": "Carry Over Approved", "result": null}, {"date": "2026-01-15", "action": "Work Session Held", "result": null}, {"date": "2026-01-15", "action": "Voted", "result": "Divided Report"}, {"date": "2026-02-27", "action": "Reported Out", "result": "OTP-AM/ONTP"}], "committee_reports": [{"label": "Majority report", "recommendation": "Ought To Pass As Amended", "signer_count": 7, "signers": ["Senator Chip Curry (Chair)", "Representative Traci Gere (Chair)", "Senator Donna Bailey", "Representative Cheryl Golek", "Representative Cassie Julia", "Representative Grayson Lookner", "Representative Marc Malon"], "signer_ids": ["s-curry-glenn", "h-gere-traci", "s-bailey-donna", "h-golek-cheryl", "h-julia-cassie", "h-lookner-grayson", "h-malon-marc"