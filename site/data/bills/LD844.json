{"ld": 844, "paper": "HP530", "session": "132", "title": "An Act to Regulate Social Media Use by Minors Under 16 Years of Age", "sponsor_id": "h-fredette-kenneth", "cosponsor_ids": [], "committee_code": "JUD", "committee_name": "Judiciary", "summary": {"text": "This bill requires social media companies to prohibit individuals under 14 years of age from becoming or remaining an account holder. The bill requires social media companies to verify the age of an individual who attempts to become an account holder and requires social media companies to obtain and verify parental consent of social media account holders who are 14 or 15 years of age. The bill requires the Attorney General to enforce these provisions and stipulates the penalties recoverable by the Attorney General. The bill also directs the Office of the Attorney General to adopt rules to implement the age verification and parental consent processes.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0530&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2025-06-16", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN084401.pdf", "documents": [{"label": "Bill text (LD 844)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0530&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-14", "action": "Work Session Held", "result": null}, {"date": "2025-05-14", "action": "Voted", "result": "Divided Report"}, {"date": "2025-06-13", "action": "Reported Out", "result": "ONTP/OTP"}], "committee_reports": [{"label": "Majority report", "recommendation": "Ought Not To Pass", "signer_count": 12, "signers": ["Senator Anne Carney (Chair)", "Representative Amy Kuhn (Chair)", "Representa