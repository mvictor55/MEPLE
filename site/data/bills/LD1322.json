{"ld": 1322, "paper": "HP857", "session": "132", "title": "Resolve, to Establish a Pilot Program to Enhance Youth Hunting Participation", "sponsor_id": "h-roberts-lovell-tiffany", "cosponsor_ids": ["h-bridgeo-william", "h-cluchey-sally", "h-collamore-amanda", "h-dill-james", "s-guerin-stacey", "h-julia-cassie", "h-mason-richard", "h-mastraccio-anne-marie"], "committee_code": "IFW", "committee_name": "Inland Fisheries and Wildlife", "summary": {"text": "This resolve directs the Department of Inland Fisheries and Wildlife, in collaboration with the Department of Economic and Community Development, Office of Tourism, to establish through department rulemaking a 2-year pilot program, including expanded youth hunting seasons and outreach initiatives, to increase youth participation in hunting. The department is required to report annually to the joint standing committee of the Legislature having jurisdiction over inland fisheries and wildlife matters on the implementation of the pilot program and is authorized to submit legislation based on the pilot program findings after the conclusion of the pilot program.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0857&item=1&snum=132"}, "status": "enacted", "status_label": "Finally Passed", "final_disposition": {"label": "Finally Passed", "date": "2025-05-30", "governor_action": "Signed", "governor_action_date": "2025-05-30"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1322)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0857&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-202)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0857&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-202)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0857&item=2&snum=132", "fiscal_note_url": "h