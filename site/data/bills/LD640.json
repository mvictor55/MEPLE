{"ld": 640, "paper": "HP408", "session": "132", "title": "An Act Requiring That Certain Fees Charged by the Courts for Court-ordered Payments Be Capped and Paid by the Defendant (TITLE CHANGE)", "sponsor_id": "h-henderson-rachel", "cosponsor_ids": ["h-bridgeo-william", "h-caruso-elizabeth", "h-fredericks-ann", "h-lee-adam", "h-lyman-sheila"], "committee_code": "JUD", "committee_name": "Judiciary", "summary": {"text": "This bill amends the law regarding court-ordered funds paid to the court. Current law requires that a fee be paid to the court from the interest accrued from the funds in the amount of 5% of the total proceeds paid. This bill requires that the losing party pay the fee, capped at $1,000.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0408&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-11", "governor_action": "Signed", "governor_action_date": "2025-06-11"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 640)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0408&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-452)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0408&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-452)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0408&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN064002.pdf"}], "committee_actions": [{"date": "2025-03-18", "action": "Work Session Held", "result": null}, {"date": "2025-03-18", "action": "Voted", "result": "OTP-AM"}, {"date": "2025-06-03", "action": "Reported Out", "result": "OTP-AM"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought to Pass as Amended", "signer_count": null,