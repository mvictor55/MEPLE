{"ld": 1128, "paper": "HP747", "session": "132", "title": "An Act to Modernize the Formulary for Naturopathic Doctors (EMERGENCY)", "sponsor_id": "h-julia-cassie", "cosponsor_ids": ["h-archer-marshall", "s-beebe-center-anne", "h-flynn-paul", "h-montell-karen", "h-roeder-amy", "h-rollins-david", "h-shagoury-daniel"], "committee_code": "HCIFS", "committee_name": "Health Coverage, Insurance and Financial Services", "summary": {"text": "This bill requires that the rules related to the prescriptive authority of naturopathic doctors must be updated by a formulary subcommittee of the Board of Complementary Health Care Providers at least every 2 years and establishes requirements for the subcommittee. The bill requires that the formulary subcommittee update the formulary and that the board adopt the rule designating the formulary no later than January 1, 2026 in a manner that is substantially similar to the formulary that has been adopted by New Hampshire's Council on Doctors of Naturopathic Medicine Formulary, in effect as of January 1, 2025.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0747&item=1&snum=132"}, "status": "enacted", "status_label": "Emergency Enacted", "final_disposition": {"label": "Emergency Enacted", "date": "2025-05-30", "governor_action": "Emergency Signed", "governor_action_date": "2025-05-30"}, "fiscal_status": "Fiscal Impact", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN112801.pdf", "documents": [{"label": "Bill text (LD 1128)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0747&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-178)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0747&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-178)", "description": "Emergency", "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?pape