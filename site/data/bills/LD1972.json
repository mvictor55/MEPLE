{"ld": 1972, "paper": "HP1316", "session": "132", "title": "An Act to Enhance Transparency and Value in Substantial Health Care Transactions by Changing the Review and Approval Process for Those Transactions", "sponsor_id": "h-zager-samuel", "cosponsor_ids": ["h-boyer-michelle", "h-cluchey-sally", "h-foley-robert", "h-morris-joshua"], "committee_code": "HCIFS", "committee_name": "Health Coverage, Insurance and Financial Services", "summary": {"text": "This bill enacts law governing consequential transactions, such as transfers of ownership or control, among health care entities, including health care providers, health care facilities, provider organizations, pharmacy benefits managers and carriers. It establishes a preliminary and comprehensive review process carried out by the Department of Health and Human Services in consultation with the Office of Affordable Health Care and provides for post-transaction oversight. It creates provisions governing reporting on the ownership and control of health care entities upon the completion of a transaction. It also makes the provisions take effect January 1, 2026.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1316&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-28", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "fiscal_note_url": null, "documents": [{"label": "Bill text (LD 1972)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1316&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-22", "action": "Work Session Held", "result": null}, {"date": "2025-05-22", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-27", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "r