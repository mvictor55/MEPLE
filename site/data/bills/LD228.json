{"ld": 228, "paper": "HP151", "session": "132", "title": "An Act to Allow Coastal Seawalls to Be Raised by up to 2 Feet in Order to Accommodate Predicted Sea Level Rise (EMERGENCY)", "sponsor_id": "h-foley-robert", "cosponsor_ids": ["s-bailey-donna", "h-blier-mark", "h-campbell-richard", "h-gramlich-lori", "s-martin-joseph", "h-mason-richard", "h-soboleski-michael"], "committee_code": "ENR", "committee_name": "Environment and Natural Resources", "summary": {"text": "This bill amends the Natural Resources Protection Act to authorize the Department of Environmental Protection to approve a permit or permit by rule for a one-time increase in the height of a seawall or similar structure in a coastal sand dune system, as long as the seawall is in existence on January 1, 2025, the height of the seawall is increased by no more than 2 feet and the seawall otherwise meets all applicable requirements adopted by the department by rule. The bill provides a similar allowance for a 2-foot height increase where a seawall has been destroyed or threatened and is replaced after emergency action.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0151&item=1&snum=132"}, "status": "enacted", "status_label": "Emergency Enacted", "final_disposition": {"label": "Emergency Enacted", "date": "2025-05-29", "governor_action": "Emergency Signed", "governor_action_date": "2025-05-29"}, "fiscal_status": "Not Yet Determined", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN022802.pdf", "documents": [{"label": "Bill text (LD 228)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0151&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-164)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0151&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-164)", "description": "Emergency", "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0151&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN022802.pdf"}], "committee_actions": [{"date": "2025-03-19", "action": "Work Session Held", "result": null}, {"date": "2025-03-19", "action": "Voted", "result": "Divided Report"}, {"date": "2025-05-06", "action": "Work Session Reconsidered", "result": null}, {"date": "2025-05-06", "action": "Voted", "result": "OTP-AM"}, {"date": "2025-05-15", "action": "Reported Out", "result": "OTP-AM"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought to Pass as Amended", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-01-16", "chamber": "House", "action": "Received by the Clerk of the House on January 16, 2025."}, {"date": "2025-01-16", "chamber": "House", "action": "The Bill was REFERRED to the Committee on ENVIRONMENT AND NATURAL RESOURCES pursuant to Joint Rule 308.2 and ordered printed pursuant to Joint Rule 401."}, {"date": "2025-03-21", "chamber": "House", "action": "Carried over, in the same posture, to the next special or regular session of the 132nd Legislature, pursuant to Joint Order SP 519."}, {"date": "2025-05-20", "chamber": "House", "action": "CONSENT CALENDAR - FIRST DAY"}, {"date": "2025-05-20", "chamber": "House", "action": "Under suspension of the rules CONSENT CALENDAR - SECOND DAY."}, {"date": "2025-05-20", "chamber": "House", "action": "The Bill was PASSED TO BE ENGROSSED as Amended by Committee Amendment \"A\" (H-164)."}, {"date": "2025-05-20", "chamber": "House", "action": "Sent for concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-05-21", "chamber": "Senate", "action": "Report READ and ACCEPTED, in concurrence."}, {"date": "2025-05-21", "chamber": "Senate", "action": "READ ONCE."}, {"date": "2025-05-21", "chamber": "Senate", "action": "Committee Amendment \"A\" (H-164) READ and ADOPTED, in concurrence."}, {"date": "2025-05