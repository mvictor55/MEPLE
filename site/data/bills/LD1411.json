{"ld": 1411, "paper": "HP933", "session": "132", "title": "An Act to Modify the Laws Regarding Driver's License Applications", "sponsor_id": "h-ankeles-daniel", "cosponsor_ids": ["h-lee-adam", "h-o-halloran-dani", "h-rana-ambureen", "h-sato-eleanor", "h-sinclair-david"], "committee_code": "TRA", "committee_name": "Transportation", "summary": {"text": "This bill modifies the penalties applicable to a person who fails to obtain a license within 30 days of becoming a resident of this State. Under current law, a violation of this provision is a traffic infraction if the person has been a resident for less than 90 days and a Class E crime if the person has been a resident for more than 90 days. Under the bill, a person who violates this provision commits a traffic infraction and if the person has been a resident for at least 90 days the person may be fined a minimum of $150 up to a maximum fine of $500. The bill eliminates the Class E crime for violating this provision. The bill also modifies the provision of law that requires a person to disclose the person's social security number on the person's application for a driver's license or nondriver identification card. In current law there is language specifying that the provision does not apply if the applicant provides proof to the Secretary of State that the person is ineligible to receive a social security number. The bill clarifies that the provision is not applicable to any person who is ineligible to receive a social security number, whether or not the person provides proof to the Secretary of State.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0933&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-05-30", "governor_action": "Signed", "governor_action_date": "2025-05-30"}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 1411)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0933&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-08", "action": "Work Session Held", "result": null}, {"date": "2025-05-08", "action": "Voted", "result": "Divided Report"}, {"date": "2025-05-16", "action": "Reported Out", "result": "OTP/ONTP"}], "committee_reports": [{"label": "Majority report", "recommendation": "Ought To Pass", "signer_count": 11, "signers": ["Senator Tim Nangle (Chair)", "Representative Dan Ankeles", "Representative Steven Bishop", "Representative Lydia Crafts", "Representative Holly Eaton", "Senator Brad Farrin", "Representative Rick Mason", "Representative Karen Montell", "Representative Wayne Parry", "Senator Teresa Pierce", "Representative Mike Ray"], "signer_ids": ["s-nangle-timothy", "h-ankeles-daniel", "h-bishop-steven", "h-crafts-lydia", "h-eaton-holly", "s-farrin-bradlee", "h-mason-richard", "h-montell-karen", "h-parry-wayne", "s-pierce-teresa", "h-ray-d"]}, {"label": "Minority report", "recommendation": "Ought Not To Pass", "signer_count": 2, "signers": ["Representative Roger Albert", "Representative James White"], "signer_ids": ["h-albert-roger", "h-white-james"]}], "chamber_actions": [{"date": "2025-04-01", "chamber": "House", "action": "Committee on Transportation suggested and ordered printed."}, {"date": "2025-04-01", "chamber": "House", "action": "The Bill was REFERRED to the Committee on TRANSPORTATION."}, {"date": "2025-04-01", "chamber": "House", "action": "Sent for concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-04-01", "chamber": "Senate", "action": "The Bill was REFERRED to the Committee on TRANSPORTATION  in concurrence"}, {"date": "2025-05-20", "chamber": "House", "action": "Reports READ."}, {"date": "2025-05-20", "chamber": "House", "action": "On motion of Representative CRAFTS of Newcastle, the Majority Ought to Pass Report was ACCEPTED."}, {"date": "2025-05-20", "chamber": "House", "action": "The Bill was READ ONCE."}, {"date": "2025-05