{"ld": 1317, "paper": "SP547", "session": "132", "title": "An Act to Promote Responsible, Cost-effective Energy in Maine by Amending the Tariff Rates Applicable to the Commercial and Institutional Net Energy Billing Program", "sponsor_id": "s-bennett-richard", "cosponsor_ids": ["s-bickford-bruce", "s-harrington-matthew", "h-wadsworth-nathan"], "committee_code": "EUT", "committee_name": "Energy, Utilities and Technology", "summary": {"text": "This bill amends the commercial and institutional net energy billing program, starting in 2026, to allow the Public Utilities Commission to establish by rule the tariff rate applicable to all customers in the program, regardless of the size of the distributed generation resource involved in net energy billing. The bill requires the commission to establish the 2026 tariff rate at a rate between 12� per kilowatt-hour and the lesser of the tariff rates applicable in 2025. It requires the commission to establish the 2027 tariff rate at a rate between 12� per kilowatt-hour and the tariff rate applicable in 2026. Beginning January 1, 2028, the bill requires the tariff rate to equal 12� per kilowatt-hour.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0547&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-20", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 1317)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0547&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-13", "action": "Work Session Held", "result": null}, {"date": "2025-05-13", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-14", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "