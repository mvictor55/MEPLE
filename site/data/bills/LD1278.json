{"ld": 1278, "paper": "HP853", "session": "132", "title": "An Act to Change the Property Tax Appeal Process", "sponsor_id": "h-underwood-joseph", "cosponsor_ids": ["h-ardell-donald", "h-babin-mark", "h-daigle-lucien", "s-farrin-bradlee", "h-swallow-gregory", "h-wood-stephen"], "committee_code": "TAX", "committee_name": "Taxation", "summary": {"text": "This bill provides that an applicant for a property tax abatement may not apply to the county commissioners to appeal a decision of the assessors or the municipal officers with respect to nonresidential property or properties having an equalized municipal valuation of $1,000,000 or greater, either separately or in the aggregate. An applicant must make such an appeal to the State Board of Property Tax Review.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0853&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-04-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 1278)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0853&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-22", "action": "Work Session Held", "result": null}, {"date": "2025-04-22", "action": "Voted", "result": "ONTP"}, {"date": "2025-04-25", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-03-25", "chamber": "House", "action": "Committee on Taxation suggested and ordered printed."}, {"date": "2025-03-25", "chamber": "House", "action": "The Bill was REFERRED to the Committee on TAXATION."}, {"date": "2025-03-25", "chamber": "House", "action"