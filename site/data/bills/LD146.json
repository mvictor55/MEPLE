{"ld": 146, "paper": "SP82", "session": "132", "title": "An Act to Increase the Maximum Amount of the Historic Property Rehabilitation Tax Credit That May be Taken in a Year", "sponsor_id": "s-rotundo-margaret", "cosponsor_ids": ["s-bennett-richard", "s-larsen-daughtry-matthea", "h-fecteau-ryan", "h-gattine-andrew", "h-rana-ambureen"], "committee_code": "TAX", "committee_name": "Taxation", "summary": {"text": "This bill changes the maximum tax credit allowed for certified historic structure rehabilitation projects for the first 2 years in which a credit may be claimed. It changes the maximum from $5,000,000 in each of the first 2 years to $10,000,000 total across the first 2 years combined. It makes no changes to the $5,000,000 maximum tax credit allowed in subsequent years. This change applies to tax years beginning on or after January 1, 2025.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0082&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-07-01", "governor_action": "Signed", "governor_action_date": "2025-07-01"}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 146)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0082&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-76)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0082&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-76)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0082&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN014602.pdf"}], "committee_actions": [{"date": "2025-03-19", "action": "Work Session Held", "result": null}, {"date": "2025-03-19", "action": "Voted", "result": "Divided Report"}, {"date": "2025-05-12", "action": "Reporte