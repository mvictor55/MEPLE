{"ld": 1798, "paper": "SP699", "session": "132", "title": "An Act to Increase Revenue Sharing and to Control Property Taxes", "sponsor_id": "s-baldacci-joseph", "cosponsor_ids": ["s-bennett-richard", "s-cyrway-scott", "h-gramlich-lori", "s-moore-marianne", "h-o-halloran-dani", "h-roeder-amy"], "committee_code": "TAX", "committee_name": "Taxation", "summary": {"text": "This bill provides additional state-municipal revenue sharing to a municipality that has adopted and implemented a program to impose limits of increases of no more than 2% annually on the imposition of property taxes on residents who are at least 65 years of age and who qualify for the Maine resident homestead property tax exemption. The amount of the additional distribution is 20% of the amount that the municipality would receive before the additional distribution.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0699&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-21", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1798)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0699&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-15", "action": "Work Session Held", "result": null}, {"date": "2025-05-15", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-20", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-04-24", "chamber": "Senate", "action": "Committee on TAXATION suggested and ordered printed REFERENCE to the Committee on TAXATION Ordered sent down forthwith for concurrence"},