{"ld": 2064, "paper": "SP853", "session": "132", "title": "An Act to Expand Access to Early Childhood Nutrition by Establishing a Grant Program for Public Preschools", "sponsor_id": "s-larsen-daughtry-matthea", "cosponsor_ids": ["h-eaton-holly", "s-ingwersen-henry", "h-murphy-kelly", "s-pierce-teresa", "s-rafferty-joseph", "h-salisbury-suzanne"], "committee_code": "EDU", "committee_name": "Education and Cultural Affairs", "summary": {"text": "This bill requires the Maine Children's Cabinet Early Childhood Advisory Council, with input from the Department of Health and Human Services, Office of Child and Family Services and the Department of Education, to establish and administer a grant program to allow school administrative units to enter into agreements with providers of off-site public preschool programs to provide students in those programs with breakfast, lunch and a snack. The grant is limited to $1,200 per student per year, but an eligible program may apply for an additional grant of up to $10,000 for infrastructure improvements to allow the program to provide breakfast, lunch and a snack. The food provided by the public preschool program must meet certain nutrition standards.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0853&item=1&snum=132"}, "status": "died", "status_label": "Died On Adjournment", "final_disposition": {"label": "Died On Adjournment", "date": "2026-04-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 2064)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0853&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-568)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0853&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-568)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/