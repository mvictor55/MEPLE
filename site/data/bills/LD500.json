{"ld": 500, "paper": "HP329", "session": "132", "title": "An Act to Ensure Access to Safe Drinking Water from Household Wells in Rural Areas by Expanding Testing", "sponsor_id": "h-pluecker-william", "cosponsor_ids": ["h-ankeles-daniel", "h-flynn-paul", "h-gramlich-lori", "s-ingwersen-henry", "s-moore-marianne", "h-rana-ambureen", "h-shagoury-daniel", "h-stover-holly"], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This bill adds contaminants to the Department of Health and Human Services' uniform testing recommendation for private wells. The bill requires a program to provide free testing for perfluoroalkyl and polyfluoroalkyl substances in household well water of low- income residents through contracts with qualified laboratories to be paid for by funds from the department's Health and Environmental Testing Laboratory dedicated account. The department is required to conduct educational outreach to make low-income residents aware of the availability of free testing of well water and eligibility for grants from the Maine State Housing Authority to pay for water treatment systems. The bill clarifies that homeowners served by well water that exceeds state standards for perfluoroalkyl and polyfluoroalkyl substances and other contaminants are eligible for the grants.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0329&item=1&snum=132"}, "status": "died", "status_label": "Died On Adjournment", "final_disposition": {"label": "Died On Adjournment", "date": "2026-04-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 500)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0329&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-288)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0329&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-288)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0329&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN050002.pdf"}], "committee_actions": [{"date": "2025-05-08", "action": "Work Session Held", "result": null}, {"date": "2025-05-08", "action": "Voted", "result": "Divided Report"}, {"date": "2025-05-23", "action": "Reported Out", "result": "OTP-AM/ONTP"}], "committee_reports": [{"label": "Majority report", "recommendation": "Ought To Pass As Amended", "signer_count": 8, "signers": ["Senator Henry Ingwersen (Chair)", "Representative Michele Meyer (Chair)", "Representative Flavia DeBrito", "Representative Anne Graham", "Representative Julie McCabe", "Senator Tim Nangle", "Representative Daniel Shagoury", "Representative Sam Zager"], "signer_ids": ["s-ingwersen-henry", "h-meyer-michele", "h-debrito-flavia", "h-graham-anne", "h-mccabe-julia", "s-nangle-timothy", "h-shagoury-daniel", "h-zager-samuel"]}, {"label": "Minority report", "recommendation": "Ought Not To Pass", "signer_count": 5, "signers": ["Representative Lucien Daigle", "Representative Abigail Griffin", "Representative Kathy Javner", "Representative Michael Lemelin", "Senator Marianne Moore"], "signer_ids": ["h-daigle-lucien", "h-griffin-abigail", "h-javner-kathy", "h-lemelin-michael", "s-moore-marianne"]}], "chamber_actions": [{"date": "2025-02-06", "chamber": "House", "action": "Received by the Clerk of the House on February 6, 2025."}, {"date": "2025-02-06", "chamber": "House", "action": "The Bill was REFERRED to the Committee on HEALTH AND HUMAN SERVICES pursuant to Joint Rule 308.2 and ordered printed pursuant to Joint Rule 401."}, {"date": "2025-03-21", "chamber": "House", "action": "Carried over, in the same posture, to the next special or regular session of the 132nd Legislature, pursuant to Joint Order SP 519."}, {"date": "2025-05-08", "chambe