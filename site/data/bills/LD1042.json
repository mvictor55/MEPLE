{"ld": 1042, "paper": "HP671", "session": "132", "title": "An Act to Require a Person Operating a Watercraft for Recreational Purposes to Ensure All Children Under 13 Years of Age Wear United States Coast Guard Approved Personal Flotation Devices (TITLE CHANGE)", "sponsor_id": "h-hepler-allison", "cosponsor_ids": ["h-dill-james", "h-sargent-holly"], "committee_code": "IFW", "committee_name": "Inland Fisheries and Wildlife", "summary": {"text": "This bill modifies the provisions of law governing operation of a watercraft to prohibit a person from operating a watercraft unless all passenger children who are under 13 years of age are wearing an appropriate Coast Guard approved personal flotation device while on board the watercraft when the watercraft is used for recreational purposes, whether or not the watercraft is under way. An exception to this requirement applies to canoes owned by youth camps and log rafts subject to certain conditions.\n\nA person who violates this provision commits a civil violation. After multiple adjudications for violations of the inland fisheries and wildlife laws within a 5-year period, a person who violates this provision commits a Class E crime.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0671&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-05-29", "governor_action": "Signed", "governor_action_date": "2025-05-29"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1042)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0671&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-233)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0671&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-233)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0671&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN104202.pdf"}], "committee_actions": [{"date": "2025-03-18", "action": "Refer Approved by Chairs/Leads", "result": "REFER TO OTHER"}, {"date": "2025-03-18", "action": "Reported Out", "result": "REFER TO OTHER"}, {"date": "2025-04-16", "action": "Work Session Held", "result": null}, {"date": "2025-04-16", "action": "Voted", "result": "OTP-AM"}, {"date": "2025-05-20", "action": "Reported Out", "result": "OTP-AM"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought to Pass as Amended", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-03-12", "chamber": "House", "action": "Received by the Clerk of the House on March 12, 2025."}, {"date": "2025-03-12", "chamber": "House", "action": "The Bill was REFERRED to the Committee on MARINE RESOURCES pursuant to Joint Rule 308.2 and ordered printed pursuant to Joint Rule 401."}, {"date": "2025-03-20", "chamber": "House", "action": "Report of the Chair-Pursuant to Joint Rule 308.2"}, {"date": "2025-03-20", "chamber": "House", "action": "Representative HEPLER from the Committee on MARINE RESOURCES Reports a recommendation for a CHANGE OF COMMITEE."}, {"date": "2025-03-20", "chamber": "House", "action": "Report was READ and ACCEPTED."}, {"date": "2025-03-20", "chamber": "House", "action": "On motion of Representative HEPLER, the Bill was REFERRED to the Committee on INLAND FISHERIES AND WILDLIFE."}, {"date": "2025-03-20", "chamber": "House", "action": "Sent for concurrence."}, {"date": "2025-03-20", "chamber": "Senate", "action": "Report READ and ACCEPTED, in concurrence."}, {"date": "2025-03-20", "chamber": "Senate", "action": "On motion by Senator Tepler of Sagadahoc for the Committee on Marine Resources REFERRED to the Committee on Inland Fisheries and Wildlife, in concurrence."}, {"date": "2025-03-21", "chamber": "House", "action": "Carried