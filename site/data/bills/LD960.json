{"ld": 960, "paper": "HP619", "session": "132", "title": "Resolve, to Allow the Placement of Hospitalized Patients in Nursing Facilities in Alternative Locations Under Certain Circumstances (TITLE CHANGE)", "sponsor_id": "h-javner-kathy", "cosponsor_ids": ["s-bernard-susan", "h-daigle-lucien", "h-mcintyre-mathew"], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This bill makes the following changes when a hospitalized patient is awaiting discharge to a long-term care facility:\n\n1. Identification of a placement in a nursing facility or residential care facility is not required to file a petition for emergency guardianship for a patient delayed from discharge from a hospital; 2. The requirement for a MaineCare member to be placed in a nursing facility within 60 miles of the member's home when the member is being discharged from a hospital is removed; and 3. The processing standard to process a MaineCare application for a hospitalized patient awaiting a placement to a nursing facility is changed from 45 days to 30 days.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0619&item=1&snum=132"}, "status": "enacted", "status_label": "Finally Passed", "final_disposition": {"label": "Finally Passed", "date": "2025-06-10", "governor_action": "Signed", "governor_action_date": "2025-06-10"}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 960)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0619&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-417)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0619&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-417)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0619&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_