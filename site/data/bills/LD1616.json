{"ld": 1616, "paper": "HP1070", "session": "132", "title": "An Act to Eliminate Requirements for Drivers to Surrender Their Physical Driver's Licenses During a Temporary Suspension", "sponsor_id": "h-crafts-lydia", "cosponsor_ids": [], "committee_code": "TRA", "committee_name": "Transportation", "summary": {"text": "This bill eliminates requirements for an individual whose license has been temporarily suspended to surrender the individual's physical driver's license to allow the individual to keep the individual's primary identity documentation in the individual's possession. The bill also eliminates provisions establishing crimes and traffic infractions associated with display or possession of a suspended driver's license.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1070&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-05-30", "governor_action": "Signed", "governor_action_date": "2025-05-30"}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 1616)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1070&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-08", "action": "Work Session Held", "result": null}, {"date": "2025-05-08", "action": "Voted", "result": "OTP"}, {"date": "2025-05-13", "action": "Reported Out", "result": "OTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-04-11", "chamber": "House", "action": "Received by the Clerk of the House on April 11, 2025."}, {"date": "2025-04-11", "chamber": "House", "action": "The Bill was REFERRED to the Committee on TRANSPORTATION pursuant to Joint Rule 308.2 and ordered printed pursuant to Joint Rule 401."}, {"date": "2025-05-20", "chamber": "House", "action": "CONSENT CALEND