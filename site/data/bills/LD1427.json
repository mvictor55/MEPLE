{"ld": 1427, "paper": "HP936", "session": "132", "title": "An Act Extending the Statute of Limitations on Criminal Actions Involving Aggravated Sex Trafficking", "sponsor_id": "h-henderson-rachel", "cosponsor_ids": ["h-kuhn-amy", "h-lee-adam", "h-o-halloran-dani", "h-sato-eleanor"], "committee_code": "JUD", "committee_name": "Judiciary", "summary": {"text": "This bill extends the statute of limitations for prosecution of a Class A or Class B crime involving aggravated sex trafficking from 6 years to 20 years following commission of the crime. This change applies only to those Class A or Class B crimes of aggravated sex trafficking committed on or after the effective date of this legislation or for which the prosecution has not yet been barred by the statute of limitations in force immediately prior to the effective date of this legislation.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0936&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-07-01", "governor_action": "Signed", "governor_action_date": "2025-07-01"}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 1427)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0936&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-602)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0936&item=2&snum=132", "item": 2}, {"label": "Amendment C-B (H-603)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0936&item=3&snum=132", "item": 3}], "amendments": [{"id": "C-A (H-602)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0936&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN142702.pdf"}, {"id": "C-B (H-603)", "description": null, "sponsor": null, "status":