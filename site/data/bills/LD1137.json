{"ld": 1137, "paper": "SP467", "session": "132", "title": "An Act to Expand Landowner Liability Protections to Include Sport Shooting Ranges", "sponsor_id": "s-stewart-harold", "cosponsor_ids": ["h-ardell-donald", "s-bradstreet-richard", "h-drinkwater-gary", "h-perkins-chad", "s-timberlake-jeffrey"], "committee_code": "JUD", "committee_name": "Judiciary", "summary": {"text": "This bill specifies that the owner, lessee, manager, holder of an easement or occupant of land who gives permission to another to engage in sport shooting on that owner's, lessee's manager's, holder's or occupant's land is entitled to limited liability for injury to that other person. Sport shooting is defined as engaging in archery, skeet and trap shooting or other similar shooting sports and the shooting of rifles, shotguns and pistols.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0467&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2025-05-06", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 1137)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0467&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-22", "action": "Work Session Held", "result": null}, {"date": "2025-04-22", "action": "Voted", "result": "Divided Report"}, {"date": "2025-04-29", "action": "Reported Out", "result": "ONTP/OTP"}], "committee_reports": [{"label": "Majority report", "recommendation": "Ought Not To Pass", "signer_count": 12, "signers": ["Senator Anne Carney (Chair)", "Representative Amy Kuhn (Chair)", "Representative Mark Babin", "Representative Elizabeth Caruso", "Representative Rachel Henderson", "Representative Adam Lee", "Representative Dani O'Halloran", "Representative Jennifer Poirier", "Representa