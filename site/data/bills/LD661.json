{"ld": 661, "paper": "HP429", "session": "132", "title": "An Act to Amend Motor Vehicle Inspection Requirements", "sponsor_id": "h-roeder-amy", "cosponsor_ids": [], "committee_code": "TRA", "committee_name": "Transportation", "summary": {"text": "This bill provides that a new motor vehicle that a holder of a Class C license is authorized to operate is not required to have an inspection until 3 years from the last day of the month in which it was manufactured. The bill stipulates that a new motor vehicle purchased by a holder of a Class C license is required to be inspected if parts of the motor vehicle required to be inspected are damaged in a motor vehicle collision or natural disaster or if the ownership of the motor vehicle changes.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0429&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-20", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 661)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0429&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-08", "action": "Work Session Held", "result": null}, {"date": "2025-05-08", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-14", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-02-20", "chamber": "House", "action": "Received by the Clerk of the House on February 20, 2025."}, {"date": "2025-02-20", "chamber": "House", "action": "The Bill was REFERRED to the Committee on TRANSPORTATION pursuant to Joint Rule 308.2 and ordered printed pursuant to Joint Rule 401."}, {"date": "2025-03-21", "chamber": "House", "action": "Carried over, in the same posture, to the next special or regular session of the 132nd Legislature, pursuant to Joint Order SP 519."}, {"date": "2025-05-20", "chamber": "Senate", "action": "Pursuant to Joint Rule 310.3 Placed in Legislative Files (DEAD)"}], "roll_calls": [], "hearing": {"date": "2025-04-08", "time": "1:00 PM", "location": "State House, Room 126", "committee_code": "TRA", "testimony_count": 8}, "heard_with": [320, 547, 1010], "tags": ["Motor Vehicles", "Inspection"], "affected_statutes": [], "testimony": [{"id": "10042925", "name": "Bruce Gerrity", "organization": "American Property and Casualty Insurance Association", "town": null, "position": "oppose", "position_source": "inferred", "date": "2025-04-08", "hearing_date": "2025-04-08", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=10042925", "has_text": true, "shared_with": [320, 547, 1010], "person_profile_id": null, "org_profile_id": "org-american-property-and-casualty-insurance-association"}, {"id": "188644", "name": "Bruce Scott", "organization": "Department of Public Safety", "town": null, "position": "oppose", "position_source": "inferred", "date": "2025-04-08", "hearing_date": "2025-04-08", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=188644", "has_text": true, "shared_with": [], "person_profile_id": null, "org_profile_id": "a-dps"}, {"id": "10042358", "name": "Don McCann", "organization": null, "town": "Bangor", "position": "support", "position_source": "inferred", "date": "2025-04-08", "hearing_date": "2025-04-08", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=10042358", "has_text": true, "shared_with": [], "person_profile_id": null, "org_profile_id": null}, {"id": "10042755", "name": "Harris Van Pate", "organization": "Maine Policy Institute", "town": null, "position": "support", "position_source": "inferred", "date": "2025-04-08", "hearing_