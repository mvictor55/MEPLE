{"ld": 1734, "paper": "SP680", "session": "132", "title": "An Act to Exempt Over-the-counter Medicines from the Sales and Use Tax", "sponsor_id": "s-larsen-daughtry-matthea", "cosponsor_ids": ["s-bailey-donna", "s-bickford-bruce", "h-boyer-michelle", "s-brenner-stacy", "s-harrington-matthew", "h-nutting-robert", "s-reny-cameron", "h-webb-kilton", "h-zager-samuel"], "committee_code": "TAX", "committee_name": "Taxation", "summary": {"text": "This bill adds over-the-counter medicines and drugs to the sales tax exemption for medicines sold for humans on a doctor's prescription as long as the over-the-counter medicine or drug is labelled according to the requirements of the United States Food and Drug Administration. Medicines or drugs included in the new exemption include anesthetics; antacids; contraceptive supplies, drugs, devices and products approved by the United States Food and Drug Administration to prevent pregnancy; medication prepared for use in the eyes, ears or nose; opioid antagonists; products intended to be taken for coughs, colds, asthma or allergies; and steroidal medicines.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0680&item=1&snum=132"}, "status": "died", "status_label": "Died On Adjournment", "final_disposition": {"label": "Died On Adjournment", "date": "2026-04-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1734)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0680&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-288)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0680&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-288)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0680&item=2&snum=132", "fiscal_note_url": "https://legislature.mai