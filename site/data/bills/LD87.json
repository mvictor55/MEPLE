{"ld": 87, "paper": "HP51", "session": "132", "title": "An Act Regarding the State Workforce Board", "sponsor_id": "h-roeder-amy", "cosponsor_ids": [], "committee_code": "LAB", "committee_name": "Labor", "summary": {"text": "This bill changes the name of the State Workforce Board within the Department of Labor to the State Workforce Development Board for consistency with the federal Workforce Innovation and Opportunity Act. It amends the membership of the board by limiting membership to the members listed and by removing legislative review of member appointments. It clarifies that the recipient of an annual report from the board is the joint standing committee of the Legislature having jurisdiction over labor matters instead of the joint standing committee of the Legislature having jurisdiction over labor, business, research and economic development matters.\n\nThe bill also changes rules related to industry partnerships for workforce development to routine technical rules.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0051&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-05-30", "governor_action": "Signed", "governor_action_date": "2025-05-30"}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 87)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0051&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-220)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0051&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-220)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0051&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN008702.pdf"}], "committee_actions": [{"date": "2025-03-18", "action": "Work Session H