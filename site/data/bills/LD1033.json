{"ld": 1033, "paper": "HP662", "session": "132", "title": "An Act to Regulate Alcoholic Beverage Competitions", "sponsor_id": "h-shagoury-daniel", "cosponsor_ids": ["h-boyer-david", "h-graham-anne", "s-hickman-craig", "h-montell-karen"], "committee_code": "VLA", "committee_name": "Veterans and Legal Affairs", "summary": {"text": "This bill authorizes one or more certificate of approval holders or persons who produce homemade liquor to apply jointly in any combination for a permit to participate in a liquor judging competition event subject to certain conditions. The bill defines \"liquor judging competition event\" as an event where judges evaluate entries of malt liquor, wine or spirits based on a set of criteria to determine a winner of a competition.\n\nThe bill also specifies that a license for the production of homemade liquor is not required if certain conditions are met. The bill defines \"homemade liquor\" as liquor made by a person's own efforts in the person's home for personal use that is not offered for sale.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0662&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-15", "governor_action": "Unsigned", "governor_action_date": "2025-06-15"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1033)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0662&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-276)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0662&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-276)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0662&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN103302.pdf"}], "committee_actio