{"ld": 2048, "paper": "SP841", "session": "132", "title": "An Act to Amend the Laws Regarding Fantasy Contest Licensing", "sponsor_id": "s-timberlake-jeffrey", "cosponsor_ids": [], "committee_code": "VLA", "committee_name": "Veterans and Legal Affairs", "summary": {"text": "This bill requires the Director of the Gambling Control Unit within the Department of Public Safety to request a criminal history record check for each applicant for a license to conduct fantasy contests and requires the application to include a disclosure of persons that have control over an applicant. The bill also clarifies the application and license fees for an occupational license for a fantasy contest operator.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0841&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2026-03-05", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "fiscal_note_url": null, "documents": [{"label": "Bill text (LD 2048)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0841&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2026-02-18", "action": "Work Session Held", "result": null}, {"date": "2026-02-18", "action": "Voted", "result": "ONTP"}, {"date": "2026-03-02", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-12-09", "chamber": "Senate", "action": "Received by the Secretary of the Senate on December 9, 2025 and REFERRED to the Committee on VETERANS AND LEGAL AFFAIRS pursuant to Joint Rule 308.2"}, {"date": "2026-03-05", "chamber": "Senate", "action": "Pursuant to Joint Rule 310.3 Placed in Legislative