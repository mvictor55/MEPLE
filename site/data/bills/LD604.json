{"ld": 604, "paper": "HP372", "session": "132", "title": "An Act to Ensure Access to Concurrent Methadone Treatment and Intensive Outpatient Programs", "sponsor_id": "h-supica-laura", "cosponsor_ids": ["s-baldacci-joseph", "h-boyer-david", "s-brenner-stacy", "h-graham-anne", "h-lookner-grayson", "h-mastraccio-anne-marie", "h-milliken-nina", "h-shagoury-daniel", "h-warren-sophia"], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This bill prohibits the Department of Health and Human Services from prohibiting coverage of or otherwise restricting coverage for individuals enrolled in the MaineCare program from receiving methadone maintenance for the treatment of opioid use disorder and from concurrently participating in medically appropriate intensive outpatient programs and other outpatient services intended for the treatment of substance use disorder or behavioral health disorders. It directs the department to adopt rules implementing these requirements no later than 90 days after the effective date of the rules.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0372&item=1&snum=132"}, "status": "died", "status_label": "Died On Adjournment", "final_disposition": {"label": "Died On Adjournment", "date": "2026-04-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 604)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0372&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-239)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0372&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-239)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0372&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fis