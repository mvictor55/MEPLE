{"ld": 775, "paper": "HP498", "session": "132", "title": "An Act Requiring Voter Approval of Legislative and Gubernatorial Pay Increases", "sponsor_id": "h-tuell-william", "cosponsor_ids": ["h-mcintyre-mathew", "s-moore-marianne"], "committee_code": "SLG", "committee_name": "State and Local Government", "summary": {"text": "This bill requires that any measure providing for an increase in the annual salary of the Governor enacted by the Legislature with an effective date after the first Wednesday of January 2027 must include provisions requiring the salary increase to be submitted to the legal voters of the State for approval or rejection at the next general election held in the month of November following the enactment of the measure. The bill also requires that any measure providing for a salary increase for members of the Senate and House of Representatives enacted by the Legislature with an effective date after the first Wednesday of December 2024, excluding the cost-of-living adjustment, must include provisions requiring the salary increase to be submitted to the legal voters of the State for approval or rejection at the next general election held in the month of November following the enactment of the measure.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0498&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2025-05-28", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 775)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0498&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-261)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0498&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-261)", "description": null, "sponsor": null, "status": null, "url": "ht