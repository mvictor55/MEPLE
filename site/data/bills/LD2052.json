{"ld": 2052, "paper": "HP1376", "session": "132", "title": "Resolve, to Study the Use of Technology in Classrooms and Study Safeguards Related to Its Use (EMERGENCY)", "sponsor_id": "h-sargent-holly", "cosponsor_ids": [], "committee_code": "EDU", "committee_name": "Education and Cultural Affairs", "summary": {"text": "This resolve directs the Maine Education Policy Research Institute to develop a survey to gather and analyze information from school administrative units regarding the use of technology in the classroom, safety policies and procedures in place and the means employed to ensure compliance with those policies and procedures and to gather information on current guidance about best practices from state and national experts for safe instructional technology use for children. The Maine Education Policy Research Institute is required to submit a report based on its analysis, including recommendations to the Department of Education and suggested legislation, by December 1, 2026 to the joint standing committee of the Legislature having jurisdiction over education and cultural affairs, which is authorized to submit legislation related to the report to the 133rd Legislature in 2027.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1376&item=1&snum=132"}, "status": "enacted", "status_label": "Emergency Finally Passed", "final_disposition": {"label": "Emergency Finally Passed", "date": "2026-04-03", "governor_action": "Emergency Signed", "governor_action_date": "2026-04-03"}, "fiscal_status": "Fiscal Impact", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN205201.pdf", "documents": [{"label": "Bill text (LD 2052)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1376&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-841)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1376&item=2&snum=132", "item": 2}], "amendments": [{"id"