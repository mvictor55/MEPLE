{"ld": 2010, "paper": "HP1340", "session": "132", "title": "An Act Updating References to the United States Internal Revenue Code of 1986 Contained in the Maine Revised Statutes (EMERGENCY)", "sponsor_id": "h-sayre-daniel", "cosponsor_ids": [], "committee_code": "TAX", "committee_name": "Taxation", "summary": {"text": "This bill updates references to the United States Internal Revenue Code of 1986 contained in the Maine Revised Statutes, Title 36 to refer to the United States Internal Revenue Code of 1986 as amended through December 31, 2025, for tax years beginning on or after January 1, 2025 and for any prior tax year as specifically provided by the United States Internal Revenue Code of 1986, as amended.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1340&item=1&snum=132"}, "status": "died", "status_label": "Died On Adjournment", "final_disposition": {"label": "Died On Adjournment", "date": "2026-04-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 2010)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1340&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [], "committee_reports": [], "chamber_actions": [{"date": "2025-12-03", "chamber": "House", "action": "Received by the Clerk of the House on December 3, 2025."}, {"date": "2025-12-03", "chamber": "House", "action": "The Bill was REFERRED to the Committee on TAXATION pursuant to Joint Rule 308.2 and ordered printed pursuant to Joint Rule 401."}, {"date": "2026-04-29", "chamber": "House", "action": "The Bill was in the possession of the Committee on Taxation when the Legislature adjourned Sine Die and was placed in the Legislative Files. (DEAD)"}], "roll_calls": [], "hearing": {"date": "2026-02-19", "time": "1:00 PM", "location": "State House, Room 127", "committee_code": "TAX", "testimony_count": 5}, "tags": ["Income Tax", "Fede