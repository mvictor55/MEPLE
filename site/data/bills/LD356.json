{"ld": 356, "paper": "SP142", "session": "132", "title": "Resolve, Directing the Board of Pesticides Control to Prohibit the Use of Rodenticides in Outdoor Residential Settings (TITLE CHANGE)", "sponsor_id": "s-bennett-richard", "cosponsor_ids": ["h-bell-arthur", "h-cimino-marygrace", "h-doudera-victoria", "h-eder-john", "s-grohoski-nicole", "h-milliken-nina"], "committee_code": "ACF", "committee_name": "Agriculture, Conservation and Forestry", "summary": {"text": "This bill prohibits a person from using any pesticide outdoors within 500 feet of a property owned by another person unless the person provides written notification to the owner, lessee or other legal occupant of the property of the intent to apply pesticides at least 7 days prior to the pesticide application. The bill provides that this prohibition does not apply to aerial application of pesticides. The bill also explicitly prohibits handling, transporting, storing, displaying or distributing pesticides in a manner that endangers pets and explicitly prohibits disposing of, discarding or storing any pesticides or pesticide containers in a manner that may cause injury to pets.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0142&item=1&snum=132"}, "status": "enacted", "status_label": "Finally Passed", "final_disposition": {"label": "Finally Passed", "date": "2025-06-08", "governor_action": "Unsigned", "governor_action_date": "2025-06-08"}, "fiscal_status": "Not Yet Determined", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN035602.pdf", "documents": [{"label": "Bill text (LD 356)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0142&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-88)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0142&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-88)", "description": null, "sponsor": null, "status": "Adopted b