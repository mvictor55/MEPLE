{"ld": 1078, "paper": "HP700", "session": "132", "title": "An Act to Support Maine's Public Health Objectives by Increasing Access to Hypodermic Apparatus Exchange Programs", "sponsor_id": "h-rana-ambureen", "cosponsor_ids": ["h-babin-mark", "h-debrito-flavia", "h-graham-anne", "s-grohoski-nicole", "h-mccabe-julia", "h-osher-laurie", "h-shagoury-daniel"], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This bill allows a certified hypodermic apparatus exchange program, also known as a syringe service program, to operate additional locations within the same county as the certified program. The certified program must provide monthly data to the Maine Center for Disease Control and Prevention on the locations of additional sites, the number of hypodermic apparatuses collected and disposed of and any additional data requested. This places in statute the requirements of Executive Orders 27 FY 19/20 and 33 FY 20/21.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0700&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-22", "governor_action": "Unsigned", "governor_action_date": "2025-06-22"}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 1078)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0700&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-485)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0700&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-485)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0700&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN107802.pdf"}], "committee_actions": [{"date": "2025-04-10", "action": "Work Session Held", "result": "TA