{"ld": 1248, "paper": "HP823", "session": "132", "title": "An Act Regarding Physical Escort and Restraint and Seclusion of Students in Schools", "sponsor_id": "h-sargent-holly", "cosponsor_ids": ["h-crockett-edward", "h-frost-sharon", "h-haggan-kimberly", "h-hepler-allison", "s-nangle-timothy", "h-ray-d", "h-shagoury-daniel", "h-sinclair-david", "h-tuell-william"], "committee_code": "EDU", "committee_name": "Education and Cultural Affairs", "summary": {"text": "This bill amends the definition of \"physical escort\" in the law regarding physical restraint and seclusion in educational settings to provide that the temporary touching or holding of the hand, wrist, arm, shoulder or back of a student to induce the student to walk to a safe location does not need to be voluntary.\n\nThe bill also amends the prohibition on the use of physical restraint or seclusion by removing the requirement that an imminent danger be of serious physical injury and instead requires only that there is imminent danger of injury.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0823&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-11", "governor_action": "Signed", "governor_action_date": "2025-06-11"}, "fiscal_status": "Not Yet Determined", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN124802.pdf", "documents": [{"label": "Bill text (LD 1248)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0823&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-399)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0823&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-399)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0823&item=2&snum=132", "fiscal_note_url": "https://legislatur