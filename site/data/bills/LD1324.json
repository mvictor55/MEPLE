{"ld": 1324, "paper": "HP859", "session": "132", "title": "An Act to Protect Maine Consumers Shopping for Electric Vehicles from Deceptive Advertising and Marketing Practices", "sponsor_id": "h-beck-matthew", "cosponsor_ids": ["h-ankeles-daniel", "s-bennett-richard", "s-carney-anne", "h-faircloth-sean", "h-friedmann-gary", "h-kuhn-amy", "h-lee-adam", "h-pugh-dylan", "h-sato-eleanor"], "committee_code": "HED", "committee_name": "Housing and Economic Development", "summary": {"text": "This bill prohibits motor vehicle manufacturers and dealers from using deceptive marketing or advertising practices that falsely suggest or imply that gasoline-powered hybrid vehicles are wholly or primarily powered by electricity. The Attorney General may enforce the provisions of the bill. A violation of the provisions of the bill constitutes a violation of the Maine Unfair Trade Practices Act.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0859&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2025-06-03", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN132401.pdf", "documents": [{"label": "Bill text (LD 1324)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0859&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-15", "action": "Work Session Held", "result": null}, {"date": "2025-05-15", "action": "Voted", "result": "Divided Report"}, {"date": "2025-05-29", "action": "Reported Out", "result": "ONTP/OTP"}], "committee_reports": [{"label": "Majority report", "recommendation": "Ought Not To Pass", "signer_count": 10, "signers": ["Senator Chip Curry (Chair)", "Representative Traci Gere (Chair)", "Representative Amanda Collamore", "Repres