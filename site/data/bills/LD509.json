{"ld": 509, "paper": "SP227", "session": "132", "title": "An Act to Allow a Journeyman Electrician to Supervise 3 Helper Electricians", "sponsor_id": "s-timberlake-jeffrey", "cosponsor_ids": ["s-bickford-bruce", "s-black-russell", "s-cyrway-scott", "s-farrin-bradlee", "h-lyman-sheila"], "committee_code": "LAB", "committee_name": "Labor", "summary": {"text": "This bill changes the number of helper electricians who may be supervised by a journeyman electrician. Under current law, a journeyman electrician may supervise one helper electrician or 2 helper electricians if they are enrolled in or have completed a certain educational program. This bill eliminates this distinction and allows a journeyman electrician to supervise 3 helper electricians.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0227&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2025-06-03", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 509)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0227&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-03-11", "action": "Work Session Held", "result": null}, {"date": "2025-03-11", "action": "Voted", "result": "Divided Report"}, {"date": "2025-05-30", "action": "Reported Out", "result": "ONTP/OTP-AM"}], "committee_reports": [{"label": "Majority report", "recommendation": "Ought Not To Pass", "signer_count": 9, "signers": ["Senator Michael Tipping (Chair)", "Representative Marshall Archer", "Representative Matthew Beck", "Senator Dick Bradstreet", "Representative Gary Drinkwater", "Representative Valli Geiger", "Representative Rafael Macias", "Senator Joseph Rafferty", "Representative Amy Roeder"], "signer_ids": ["s-tipping-michael", "h-archer-marshall", "h