{"ld": 2176, "paper": "SP881", "session": "132", "title": "An Act to Safeguard Personal Information and Strengthen Tenant Rights in Maine (TITLE CHANGE)", "sponsor_id": "s-duson-jill", "cosponsor_ids": ["s-bailey-donna", "s-carney-anne", "h-dhalac-deqa", "h-gattine-andrew", "s-lawrence-mark", "h-lee-adam", "h-rana-ambureen", "h-sato-eleanor", "h-sinclair-david"], "committee_code": "JUD", "committee_name": "Judiciary", "summary": {"text": "This bill clarifies that a writ of habeas corpus creates a presumption that a person has been deprived of that person's personal liberty under the Maine Civil Rights Act. The bill also authorizes the Attorney General to bring a civil action if a person unlawfully deprives another person of personal liberty when the Supreme Judicial Court or Superior Court issues a writ of habeas corpus. Finally, the bill clarifies that there is no bar on any action for damages involving a writ of habeas corpus or for damages related to a writ of habeas corpus pursuant to the Maine Civil Rights Act.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0881&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2026-04-22", "governor_action": "Unsigned", "governor_action_date": "2026-04-22"}, "fiscal_status": "Fiscal Impact", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN217601.pdf", "documents": [{"label": "Bill text (LD 2176)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0881&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-640)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0881&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-640)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0881&item=2&snum=132", "fiscal_note_url": "https://