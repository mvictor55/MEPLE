{"ld": 2021, "paper": "HP1351", "session": "132", "title": "An Act to Add an Online Option for Reporting of Suspected Abuse, Neglect and Exploitation of Adults", "sponsor_id": "h-meyer-michele", "cosponsor_ids": [], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "Current law requires that reports to the Department of Health and Human Services regarding abuse, neglect or exploitation of adults must be made by telephone. This bill adds the option of reporting by an online portal to align state law with federal regulations promulgated in June 2024 that require states to allow at least 2 methods of reporting, one of which must be online.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1351&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2026-02-26", "governor_action": "Signed", "governor_action_date": "2026-02-26"}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 2021)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1351&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2026-01-14", "action": "Work Session Held", "result": null}, {"date": "2026-01-14", "action": "Voted", "result": "OTP"}, {"date": "2026-01-23", "action": "Reported Out", "result": "OTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-12-03", "chamber": "House", "action": "Received by the Clerk of the House on December 3, 2025."}, {"date": "2025-12-03", "chamber": "House", "action": "The Bill was REFERRED to the Committee on HEALTH AND HUMAN SERVICES pursuant to Joint Rule 308.2 and ordered printed pursuant to Joint Rule 401."}, {"date": "2026-01-14", "chamber": "J", "action": "Work Session Held"}, {"date": "2026-01-14", "chamber