{"ld": 1607, "paper": "HP1061", "session": "132", "title": "An Act to Require Law Enforcement Agencies to Adopt Written Policies Regarding Compliance with Certain Constitutional Obligations Related to Disclosure of Evidence", "sponsor_id": "h-bunker-stephan", "cosponsor_ids": [], "committee_code": "CJPS", "committee_name": "Criminal Justice and Public Safety", "summary": {"text": "This bill requires that, by January 1, 2026, law enforcement agencies adopt written policies regarding procedures to deal with assisting a prosecuting agency in complying with the prosecuting agency's constitutional obligations under Brady v. Maryland (1963) and Giglio v. United States (1972) and regarding the requirement to comply with mandatory disclosures to the Maine Criminal Justice Academy.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1061&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-09", "governor_action": "Signed", "governor_action_date": "2025-06-09"}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 1607)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1061&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-14", "action": "Work Session Held", "result": null}, {"date": "2025-05-14", "action": "Voted", "result": "Divided Report"}, {"date": "2025-05-23", "action": "Reported Out", "result": "OTP/ONTP"}], "committee_reports": [{"label": "Majority report", "recommendation": "Ought To Pass", "signer_count": 10, "signers": ["Senator Anne Beebe-Center (Chair)", "Representative Tavis Hasenfus (Chair)", "Representative Mana Abdi", "Representative Stephan Bunker", "Senator Chip Curry", "Senator Scott Cyrway", "Representative Michel Lajoie", "Representative Grayson Lookner", "Representative Nina Milliken", "Representative Robert Nutting"], "signer_ids": ["s-beebe-center-an