{"ld": 2023, "paper": "HP1353", "session": "132", "title": "Resolve, to Establish a Working Group to Identify Ways to Manage Moorings on Inland Waters", "sponsor_id": "h-dill-james", "cosponsor_ids": [], "committee_code": "IFW", "committee_name": "Inland Fisheries and Wildlife", "summary": {"text": "This resolve directs the Commissioner of Inland Fisheries and Wildlife to establish a working group focused on identifying issues and solutions related to moorings on inland waters. The commissioner is directed to report to the joint standing committee of the Legislature having jurisdiction over inland fisheries and wildlife matters by November 4, 2026 with the findings and conclusions of the working group, including any recommended legislation. The joint standing committee is authorized to submit a bill related to the report to the 133rd Legislature in 2027.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1353&item=1&snum=132"}, "status": "enacted", "status_label": "Finally Passed", "final_disposition": {"label": "Finally Passed", "date": "2026-04-03", "governor_action": "Signed", "governor_action_date": "2026-04-03"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 2023)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1353&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-859)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1353&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-859)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1353&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN202302.pdf"}], "committee_actions": [{"date": "2026-01-28", "action": "Work Session Held", "result": null}, {"date": "2026-01-28", "action": "Voted", "result": "OTP-AM"}, {"date": "2026-02-