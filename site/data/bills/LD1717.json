{"ld": 1717, "paper": "SP670", "session": "132", "title": "An Act Regarding Background Checks for Medical Cannabis Providers", "sponsor_id": "s-harrington-matthew", "cosponsor_ids": ["h-boyer-david", "h-fredericks-ann", "s-hickman-craig"], "committee_code": "VLA", "committee_name": "Veterans and Legal Affairs", "summary": {"text": "This bill requires anyone applying for or renewing a registry identification card or registration certificate under the Maine Medical Use of Cannabis Act to submit to a criminal history record check. If a person applying for or renewing a registry identification card or registration certificate is a business entity, every officer or director or assistant of the business entity is also required to submit to a criminal history record check.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0670&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-20", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "fiscal_note_url": null, "documents": [{"label": "Bill text (LD 1717)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0670&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-12", "action": "Work Session Held", "result": null}, {"date": "2025-05-12", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-19", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-04-17", "chamber": "Senate", "action": "Committee on VETERANS AND LEGAL AFFAIRS suggested and ordered printed REFERENCE to the Committee on VETERANS AND LEGAL AFFAIRS Ordered sent down forthwith for concurrence"}, {"d