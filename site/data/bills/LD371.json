{"ld": 371, "paper": "SP163", "session": "132", "title": "An Act to Expand Hydroelectric Development by Removing the 100-megawatt Cap", "sponsor_id": "s-martin-joseph", "cosponsor_ids": ["s-cyrway-scott", "h-foster-steven", "s-harrington-matthew", "h-paul-reagan", "h-soboleski-michael", "s-timberlake-jeffrey", "h-wadsworth-nathan"], "committee_code": "EUT", "committee_name": "Energy, Utilities and Technology", "summary": {"text": "This bill provides that sources of electrical generation relying on hydroelectric generators are not subject to a limit of 100 megawatts of power production capacity. The bill also amends the law governing the criteria that must be met for the Department of Environmental Protection to approve a hydropower project. The bill requires the department to make a decision on a complete application for a project within 6 months of the date the complete application is received. It also clarifies that an approved hydropower project may operate at its full nameplate capacity subject to the requirements of applicable laws and rules.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0163&item=1&snum=132"}, "status": "died", "status_label": "Died Between Houses", "final_disposition": {"label": "Died Between Houses", "date": "2025-06-10", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 371)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0163&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-277)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0163&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-277)", "description": "Change Title", "sponsor": null, "status": "Adopted by Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0163&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN0