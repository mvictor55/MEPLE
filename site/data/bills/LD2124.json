{"ld": 2124, "paper": "HP1439", "session": "132", "title": "An Act to Support Emergency Shelter Funding Using Revenue from the Real Estate Transfer Tax", "sponsor_id": "h-gattine-andrew", "cosponsor_ids": ["s-curry-glenn", "s-larsen-daughtry-matthea", "h-fecteau-ryan", "h-gere-traci", "h-rana-ambureen", "h-roeder-amy", "s-rotundo-margaret", "h-sayre-daniel", "s-talbot-ross-rachel"], "committee_code": "HED", "committee_name": "Housing and Economic Development", "summary": {"text": "Under current law, 90% of the revenue from the real estate transfer tax is submitted to the State and 10% is retained by the counties, except that, for fiscal years 2025-26 and 2026-27, the percentage retained by the counties is reduced to 9.2%.\n\nThis bill reduces the percentage of the real estate transfer tax revenue retained by counties by 1.8% and requires 1% of the revenue to be transferred to the Maine State Housing Authority for deposit in the shelter operating subsidy program beginning September 1, 2026; beginning August 1, 2027, 1.8% of the revenue is required to be transferred to the Maine State Housing Authority to be allocated as part of the operations share of the shelter operating subsidy program. Beginning September 1, 2026, the percentage of the real estate transfer tax retained by counties is reduced to 8.2%.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1439&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2026-04-16", "governor_action": "Signed", "governor_action_date": "2026-04-16"}, "fiscal_status": "Not Yet Determined", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN212403.pdf", "documents": [{"label": "Bill text (LD 2124)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1439&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-887)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1439&item=2&snum=132", "item": 2}, {"label": "Amendment C-B (H-888)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1439&item=3&snum=132", "item": 3}, {"label": "Amendment S-A to C-B (S-688)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1439&item=6&snum=132", "item": 6}, {"label": "Amendment H-A to C-B (H-1058)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1439&item=8&snum=132", "item": 8}], "amendments": [{"id": "C-A (H-887)", "description": null, "sponsor": null, "status": null, "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1439&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN212402.pdf"}, {"id": "C-B (H-888)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1439&item=3&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN212403.pdf"}, {"id": "S-A to C-B (S-688)", "description": null, "sponsor": "Senator Rotundo", "status": null, "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1439&item=6&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN212406.pdf"}, {"id": "H-A to C-B (H-1058)", "description": null, "sponsor": "Representative Gattine", "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1439&item=8&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN212408.pdf"}], "committee_actions": [{"date": "2026-02-17", "action": "Work Session Held", "result": "TABLED"}, {"date": "2026-03-03", "action": "Work Session Held", "result": null}, {"date": "2026-03-03", "action": "Voted", "result": "Divided Report"}, {"date": "2026-03-24", "action": "Reported Out", "result": "OTP-AM/OTP-AM"}], "co