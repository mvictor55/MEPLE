{"ld": 931, "paper": "HP596", "session": "132", "title": "An Act to Amend the Law Allowing Individuals Subject to Pretrial or Presentence Incarceration to Be Credited Time for Participation in Work Projects Within a Jail (TITLE CHANGE)", "sponsor_id": "h-o-halloran-dani", "cosponsor_ids": ["h-babin-mark", "h-dill-james", "h-mcintyre-mathew", "h-milliken-nina", "h-pugh-dylan", "h-roeder-amy", "h-sachs-melanie", "h-sinclair-david"], "committee_code": "CJPS", "committee_name": "Criminal Justice and Public Safety", "summary": {"text": "This bill allows an inmate who is detained at a county or regional jail pretrial or presentence to voluntarily participate in a public works-related project or in the improvement of property owned by a charitable organization. Such an inmate may have the inmate's sentence to the jail prorated at the rate of up to one day removed from the sentence for every 16 hours of participation in the project if the inmate is sentenced on the charge for which the inmate is detained at the jail.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0596&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-17", "governor_action": "Signed", "governor_action_date": "2025-06-17"}, "fiscal_status": "No Fiscal Impact", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN093101.pdf", "documents": [{"label": "Bill text (LD 931)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0596&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-637)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0596&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-637)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0596&item=2&snum=132", "fiscal_note_url": "https://legisla