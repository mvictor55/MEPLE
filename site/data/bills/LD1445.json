{"ld": 1445, "paper": "SP586", "session": "132", "title": "An Act to Prevent Financial Exploitation of Vulnerable Adults (TITLE CHANGE)", "sponsor_id": "s-carney-anne", "cosponsor_ids": ["h-babin-mark", "s-bailey-donna", "s-bennett-richard", "h-boyer-michelle", "s-duson-jill", "h-fecteau-ryan", "s-grohoski-nicole", "s-moore-marianne", "h-stover-holly"], "committee_code": "HCIFS", "committee_name": "Health Coverage, Insurance and Financial Services", "summary": {"text": "This bill authorizes a financial institution or credit union authorized to do business in this State to report suspected financial exploitation of an adult 62 years of age or older to the Office of the Attorney General. The bill also authorizes a financial institution or credit union to delay, for a certain period of time and under certain conditions, a disbursement from an account if financial exploitation is suspected. A financial institution or credit union that takes action in good faith in response to suspected financial exploitation is immune from administrative or civil liability. The bill allows a financial institution or credit union to provide access to or copies of records related to suspected financial exploitation to a law enforcement agency and designates records provided to a law enforcement agency as confidential.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0586&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-09", "governor_action": "Signed", "governor_action_date": "2025-06-09"}, "fiscal_status": "Fiscal Impact", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN144501.pdf", "documents": [{"label": "Bill text (LD 1445)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0586&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-147)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0586&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-147)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0586&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN144502.pdf"}], "committee_actions": [{"date": "2025-04-23", "action": "Work Session Held", "result": "TABLED"}, {"date": "2025-05-01", "action": "Work Session Held", "result": null}, {"date": "2025-05-01", "action": "Voted", "result": "OTP-AM"}, {"date": "2025-05-23", "action": "Reported Out", "result": "OTP-AM"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought to Pass as Amended", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-04-08", "chamber": "Senate", "action": "Committee on HEALTH COVERAGE, INSURANCE AND FINANCIAL SERVICES suggested and ordered printed REFERENCE to the Committee on HEALTH COVERAGE, INSURANCE AND FINANCIAL SERVICES Ordered sent down forthwith for concurrence"}, {"date": "2025-04-08", "chamber": "House", "action": "The Bill was REFERRED to the Committee on HEALTH COVERAGE, INSURANCE AND FINANCIAL SERVICES."}, {"date": "2025-04-08", "chamber": "House", "action": "In concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-05-27", "chamber": "Senate", "action": "Report READ and ACCEPTED."}, {"date": "2025-05-27", "chamber": "Senate", "action": "READ ONCE."}, {"date": "2025-05-27", "chamber": "Senate", "action": "Committee Amendment \"A\" (S-147) READ and ADOPTED."}, {"date": "2025-05-27", "chamber": "Senate", "action": "Under suspension of the Rules, READ A SECOND TIME and PASSED TO BE ENGROSSED AS AMENDED BY Committee Amendment \"A\" (S-147)."}, {"date": "2025-05-27", "chamber": "Senate", "action": "Ordered sent down forthwith for concurrence."}, {"date": "2025-05-28", "chamber": "House", "action": "CONSENT CALENDAR - FIRST DAY"}, {"date":