{"ld": 1036, "paper": "HP665", "session": "132", "title": "An Act to Protect Recipients of Public Assistance from Housing Discrimination", "sponsor_id": "h-rana-ambureen", "cosponsor_ids": ["h-arford-poppy", "s-baldacci-joseph", "h-gattine-andrew", "h-golek-cheryl", "h-lookner-grayson", "h-sato-eleanor", "h-sinclair-david", "h-stover-holly", "s-talbot-ross-rachel"], "committee_code": "HED", "committee_name": "Housing and Economic Development", "summary": {"text": "This bill makes it unlawful to discriminate, in housing or public accommodation, against an individual because of the individual's receipt of public assistance in the same manner as it is unlawful to discriminate against other protected classes. The bill defines \"status as a recipient of federal, state or local public assistance\" as an individual's status as having federal, state or local public assistance as a source of income, including medical assistance and housing subsidies and the individual's having to meet any requirements for the individual to use the income.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0665&item=1&snum=132"}, "status": "died", "status_label": "Died Between Houses", "final_disposition": {"label": "Died Between Houses", "date": "2025-06-09", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 1036)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0665&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-13", "action": "Work Session Held", "result": null}, {"date": "2025-05-13", "action": "Voted", "result": "Divided Report"}, {"date": "2025-06-02", "action": "Reported Out", "result": "OTP/ONTP"}], "committee_reports": [{"label": "Majority report", "recommendation": "Ought To Pass", "signer_count": 6, "signers": ["Senator Chip Curry (Chair)", "Representative Traci Gere (Chair)", "Representati