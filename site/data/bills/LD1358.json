{"ld": 1358, "paper": "HP881", "session": "132", "title": "An Act to Reduce Electricity Rates by Removing Limitations on the Ownership of Generation by an Affiliate of an Investor-owned Transmission and Distribution Utility", "sponsor_id": "h-faulkingham-william", "cosponsor_ids": ["h-foster-steven", "s-harrington-matthew", "h-mcintyre-mathew", "h-smith-katrina", "s-stewart-harold"], "committee_code": "EUT", "committee_name": "Energy, Utilities and Technology", "summary": {"text": "This bill permits an affiliate of an investor-owned transmission and distribution utility to own generation or generation-related assets in accordance with standards of conduct adopted by the Public Utilities Commission including when the generation or generation- related assets are directly interconnected to the facilities owned or operated by that investor-owned transmission and distribution utility. The bill also removes the prohibition on affiliate generation or generation-related assets participating in long-term contracts under the Maine Revised Statutes, Title 35-A.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0881&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2025-05-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1358)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0881&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-282)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0881&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-282)", "description": "Change Title", "sponsor": null, "status": null, "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0881&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_13