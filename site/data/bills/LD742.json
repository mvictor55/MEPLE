{"ld": 742, "paper": "HP484", "session": "132", "title": "An Act to Permit Telehealth Services Across State Lines Following Referral from a Primary Care Provider Based in the State", "sponsor_id": "h-fredette-kenneth", "cosponsor_ids": [], "committee_code": "HCIFS", "committee_name": "Health Coverage, Insurance and Financial Services", "summary": {"text": "This bill permits health care providers licensed in another state to provide telehealth services to a patient in this State as long as the patient is referred for those services by a primary care provider licensed in this State and the primary care provider has obtained and documented the patient's written informed consent to receive telehealth services. The out- of-state provider must comply with the provisions of state law and rules regarding telehealth services and, prior to the provision of telehealth services, must disclose to the patient the provider's qualifications, proof of licensure and contact information.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0484&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2025-05-21", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 742)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0484&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-177)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0484&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-177)", "description": null, "sponsor": null, "status": null, "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0484&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN074202.pdf"}], "committee_actions": [{"date": "2025-03-19", "action": "Work Sessio