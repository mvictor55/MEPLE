{"ld": 1419, "paper": "SP575", "session": "132", "title": "An Act to Provide a Sales Tax Exemption for Housing Constructed Off-site Similar to That for On-site Construction (EMERGENCY)", "sponsor_id": "s-bennett-richard", "cosponsor_ids": ["s-bickford-bruce", "h-blier-mark", "s-bradstreet-richard", "s-curry-glenn", "h-fecteau-ryan", "h-gere-traci", "h-golek-cheryl", "s-pierce-teresa"], "committee_code": "TAX", "committee_name": "Taxation", "summary": {"text": "Current law provides a sales tax exemption for sales of new manufactured housing for all costs, excluding materials, included in the sale price, but only to a maximum of 50% of the sale price. This bill changes that exemption to 75% of the sale price to reflect the exemption for housing built on the site of its location.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0575&item=1&snum=132"}, "status": "died", "status_label": "Died On Adjournment", "final_disposition": {"label": "Died On Adjournment", "date": "2026-04-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1419)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0575&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-491)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0575&item=3&snum=132", "item": 3}], "amendments": [{"id": "C-A (S-491)", "description": "Emergency", "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0575&item=3&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN141903.pdf"}], "committee_actions": [{"date": "2025-04-30", "action": "Work Session Held", "result": null}, {"date": "2025-04-30", "action": "Voted", "result": "OTP-AM"}, {"date": "2025-06-17", "action": "Carry Over Approved", "result": null}, {"date": "2025-10-17",