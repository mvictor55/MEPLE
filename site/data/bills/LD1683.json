{"ld": 1683, "paper": "HP1118", "session": "132", "title": "An Act to Make a Freedom of Access Act Request Free of Charge upon Petition", "sponsor_id": "h-chapman-quentin", "cosponsor_ids": ["h-boyer-david", "h-faulkingham-william", "h-fredericks-ann", "s-haggan-david", "h-henderson-rachel", "s-hickman-craig", "h-libby-laurel", "s-timberlake-jeffrey"], "committee_code": "JUD", "committee_name": "Judiciary", "summary": {"text": "This bill amends the Freedom of Access Act by:\n\n1. Prohibiting the charging of a fee by an agency or official that has custody or control of a public record that is requested if that request is accompanied by a petition signed by at least 150 individuals registered to vote in this State making the same request; and 2. Requiring that the agency or official to provide an update regarding the status of the request at least every 30 working days; current law requires the agency or official to make a good faith effort to comply with the request within the nonbinding estimate of time provided by the agency or official.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1118&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-28", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1683)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1118&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-06", "action": "Work Session Held", "result": null}, {"date": "2025-05-06", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-27", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}],