{"ld": 215, "paper": "HP138", "session": "132", "title": "An Act Regarding Large Recovery Residences (TITLE CHANGE)", "sponsor_id": "h-hasenfus-tavis", "cosponsor_ids": ["s-hickman-craig"], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This bill establishes a rental assistance program within the Department of Health and Human Services to support persons who are residing in certified recovery residences that have the capacity to serve 20 or more residents at one time. The rental assistance, equal to the monthly rent, is paid directly to the recovery residence for the eligible person. The person must be otherwise eligible for municipal general assistance. If the eligible person receives the rental assistance, the person is not eligible for housing assistance under the municipal general assistance program.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0138&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-07-01", "governor_action": "Signed", "governor_action_date": "2025-07-01"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 215)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0138&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-645)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0138&item=2&snum=132", "item": 2}, {"label": "Amendment S-A to C-A (S-369)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0138&item=4&snum=132", "item": 4}, {"label": "Amendment S-B to C-A (S-450)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0138&item=7&snum=132", "item": 7}], "amendments": [{"id": "C-A (H-645)", "description": "Emergency", "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0138&item=2&snum=132