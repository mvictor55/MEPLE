{"ld": 1054, "paper": "HP683", "session": "132", "title": "An Act to Amend Certain Definitions in the Laws Governing Conservation Easements (TITLE CHANGE)", "sponsor_id": "h-dill-james", "cosponsor_ids": ["h-bridgeo-william", "h-faulkingham-william", "h-hepler-allison", "h-moonen-matthew"], "committee_code": "ACF", "committee_name": "Agriculture, Conservation and Forestry", "summary": {"text": "This bill provides an exception to the prohibitions against the purchase, sale or offer for sale of certain wild animals and wild birds. A member of the Penobscot Nation who is a resident of the State and who has lawfully killed or trapped and registered a bear, deer, moose or wild turkey or lawfully killed or trapped a wild bird within the Penobscot Indian territory may use, sell or offer for sale or aid in buying, selling or offering for sale bear, deer, moose, wild turkey and wild birds at an eating establishment, lodging place, mobile eating place or recreational camp or sporting camp that is located within the Penobscot Indian territory.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0683&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2026-04-03", "governor_action": "Signed", "governor_action_date": "2026-04-03"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1054)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0683&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-883)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0683&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-883)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0683&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN105402.pdf"}], "commi