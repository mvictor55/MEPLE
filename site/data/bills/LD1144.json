{"ld": 1144, "paper": "SP475", "session": "132", "title": "An Act to Reinstate the Property Tax Stabilization Program", "sponsor_id": "s-libby-james", "cosponsor_ids": ["s-bickford-bruce", "s-stewart-harold"], "committee_code": "TAX", "committee_name": "Taxation", "summary": {"text": "This bill reinstates the program that stabilizes property taxes on homesteads of permanent residents 65 years of age or older for property tax years beginning on or after April 1, 2026. It limits stabilization to $900,000 of the assessed value of an eligible homestead and provides that an eligible individual may have the property tax stabilized on only one eligible homestead in a property tax year. It provides that a municipality may recover from the State the cost to administer the program.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0475&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-04-24", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 1144)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0475&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-15", "action": "Work Session Held", "result": null}, {"date": "2025-04-15", "action": "Voted", "result": "ONTP"}, {"date": "2025-04-22", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-03-18", "chamber": "Senate", "action": "Committee on TAXATION suggested and ordered printed REFERENCE to the Committee on TAXATION Ordered sent down forthwith for concurrence"}, {"date": "2025-03-18", "chamber": "House", "action": "The Bi