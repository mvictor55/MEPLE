{"ld": 481, "paper": "HP310", "session": "132", "title": "An Act to Allow a Water District Created by Special Act of the Legislature to Borrow Money and Issue a Warrant Prior to a Default", "sponsor_id": "h-beck-matthew", "cosponsor_ids": ["h-boyer-michelle", "s-brenner-stacy", "s-harrington-matthew", "h-kessler-christopher", "h-olsen-rolf", "h-wadsworth-nathan", "h-warren-sophia"], "committee_code": "EUT", "committee_name": "Energy, Utilities and Technology", "summary": {"text": "This bill provides that if a water district, prior to a default in the payment of the principal of or interest on a note, bond or other evidence of indebtedness, makes a determination that the district's anticipated revenues from the normal payment of water charges will not be sufficient to pay the district's anticipated operating expenses, the water district may borrow money to pay the principal and interest and other transaction costs related to the borrowing and may issue the district's warrant immediately to those portions of the municipality or municipalities that constitute the district to repay the amount borrowed, plus interest.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0310&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-04-11", "governor_action": "Signed", "governor_action_date": "2025-04-11"}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 481)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0310&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-03-12", "action": "Work Session Held", "result": "TABLED"}, {"date": "2025-03-19", "action": "Work Session Held", "result": null}, {"date": "2025-03-19", "action": "Voted", "result": "OTP"}, {"date": "2025-03-21", "action": "Reported Out", "result": "OTP"}], "committee_reports": [{"label": "Committee report", "recommenda