{"ld": 890, "paper": "SP378", "session": "132", "title": "An Act to Permit the Dispensing of Ivermectin Pursuant to a Standing Order upon Request for COVID-19, Flu and Cancer Patients", "sponsor_id": "s-haggan-david", "cosponsor_ids": ["h-caruso-elizabeth", "h-ducharme-john", "s-farrin-bradlee", "h-faulkingham-william", "h-fredette-kenneth", "s-harrington-matthew", "s-timberlake-jeffrey"], "committee_code": "HCIFS", "committee_name": "Health Coverage, Insurance and Financial Services", "summary": {"text": "This bill authorizes a pharmacist to dispense ivermectin upon request of a patient pursuant to a standing order from a practitioner acting within the lawful scope of the practitioner's license. The standing order must meet certain conditions, including authorization to dispense ivermectin to a patient for the treatment of COVID-19, influenza or cancer. A pharmacist who acts under a standing order is deemed to be dispensing ivermectin for a legitimate medical purpose in the usual course of the practice of pharmacy.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0378&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-21", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 890)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0378&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-08", "action": "Work Session Held", "result": null}, {"date": "2025-05-08", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-15", "action": "Work Session Reconsidered", "result": null}, {"date": "2025-05-15", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-20", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-03-04", "chamber": "Senate", "action": "Committee on HEALTH COVERAGE, INSURANCE AND FINANCIAL SERVICES suggested and ordered printed REFERENCE to the Committee on HEALTH COVERAGE, INSURANCE AND FINANCIAL SERVICES Ordered sent down forthwith for concurrence"}, {"date": "2025-03-04", "chamber": "House", "action": "The Bill was REFERRED to the Committee on HEALTH COVERAGE, INSURANCE AND FINANCIAL SERVICES."}, {"date": "2025-03-04", "chamber": "House", "action": "In concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-03-21", "chamber": "Senate", "action": "CARRIED OVER, in the same posture, to the next special or regular session of the 132nd Legislature, pursuant to Joint Order SP 519."}, {"date": "2025-05-08", "chamber": "J", "action": "Work Session Held"}, {"date": "2025-05-08", "chamber": "J", "action": "Voted: ONTP"}, {"date": "2025-05-15", "chamber": "J", "action": "Work Session Reconsidered"}, {"date": "2025-05-15", "chamber": "J", "action": "Voted: ONTP"}, {"date": "2025-05-20", "chamber": "J", "action": "Reported Out: ONTP"}, {"date": "2025-05-21", "chamber": "Senate", "action": "Pursuant to Joint Rule 310.3 Placed in Legislative Files (DEAD)"}], "roll_calls": [], "hearing": {"date": "2025-05-01", "time": "10:00 AM", "location": "Cross Building, Room 220", "committee_code": "HCIFS", "testimony_count": 8}, "tags": ["Prescription Drugs", "Access"], "affected_statutes": [], "testimony": [{"id": "10047754", "name": "Anne Sedlack", "organization": "Maine Medical Association", "town": null, "position": "oppose", "position_source": "inferred", "date": "2025-05-01", "hearing_date": "2025-05-01", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=10047754", "has_text": true}, {"id": "192137", "name": "Chad Grignon", "organization": "Athens", "town": null, "position": "support", "position_source": "infe