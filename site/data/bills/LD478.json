{"ld": 478, "paper": "HP307", "session": "132", "title": "An Act to Reduce Maximum Speeds on Roads Close to Residences", "sponsor_id": "h-henderson-rachel", "cosponsor_ids": [], "committee_code": "TRA", "committee_name": "Transportation", "summary": {"text": "Except when conditions or other regulations require a lower speed, this bill sets the maximum rates of speed for a public way where at least one residence is within 15 feet of the public way as follows:\n\n1. Twenty-five miles per hour for a snowplow and equipment used by the Department of Transportation exclusively for the removal of snow on the public way; 2. Twenty-five miles per hour for a vehicle with at least 5 axles; and 3. Thirty-five miles per hour for all other vehicles.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0307&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-04-01", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN047801.pdf", "documents": [{"label": "Bill text (LD 478)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0307&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-03-25", "action": "Work Session Held", "result": null}, {"date": "2025-03-25", "action": "Voted", "result": "ONTP"}, {"date": "2025-03-27", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-02-06", "chamber": "House", "action": "Received by the Clerk of the House on February 6, 2025."}, {"date": "2025-02-06", "chamber": "House", "action": "The Bill was REFERRED to th