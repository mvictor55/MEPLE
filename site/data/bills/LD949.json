{"ld": 949, "paper": "HP614", "session": "132", "title": "An Act to Clarify Licensing Jurisdiction for Manufactured Housing Communities", "sponsor_id": "h-golek-cheryl", "cosponsor_ids": ["h-arata-amy", "s-bennett-richard", "s-bradstreet-richard", "s-curry-glenn", "h-fecteau-ryan", "h-gere-traci", "h-malon-marc", "h-mingo-arthur", "h-yusuf-yusuf"], "committee_code": "HED", "committee_name": "Housing and Economic Development", "summary": {"text": "This bill requires a municipality to accept a license issued by the Manufactured Housing Board as evidence a manufactured housing community meets all requirements to operate. The bill provides that a municipality may not charge any additional fees for a manufactured housing community to operate. The bill also provides that a municipality may not charge a fee for any type of permit for manufactured housing if the manufactured housing or the installation thereof is governed by rules of the United States Department of Housing and Urban Development or the Manufactured Housing Board.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0614&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-27", "governor_action": "Signed", "governor_action_date": "2025-06-27"}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 949)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0614&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-491)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0614&item=2&snum=132", "item": 2}, {"label": "Amendment H-A to C-A (H-735)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0614&item=4&snum=132", "item": 4}], "amendments": [{"id": "C-A (H-491)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0614&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN094902.pdf"}, {"id": "H-A to C-A (H-735)", "description": null, "sponsor": "Representative Golek", "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0614&item=4&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN094904.pdf"}], "committee_actions": [{"date": "2025-04-29", "action": "Work Session Held", "result": null}, {"date": "2025-04-29", "action": "Voted", "result": "OTP-AM"}, {"date": "2025-06-04", "action": "Reported Out", "result": "OTP-AM"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought to Pass as Amended", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-03-05", "chamber": "House", "action": "Received by the Clerk of the House on March 5, 2025."}, {"date": "2025-03-05", "chamber": "House", "action": "The Bill was REFERRED to the Committee on HOUSING AND ECONOMIC DEVELOPMENT pursuant to Joint Rule 308.2 and ordered printed pursuant to Joint Rule 401."}, {"date": "2025-03-21", "chamber": "House", "action": "Carried over, in the same posture, to the next special or regular session of the 132nd Legislature, pursuant to Joint Order SP 519."}, {"date": "2025-04-29", "chamber": "J", "action": "Work Session Held"}, {"date": "2025-04-29", "chamber": "J", "action": "Voted: OTP-AM"}, {"date": "2025-06-04", "chamber": "J", "action": "Reported Out: OTP-AM"}, {"date": "2025-06-04", "chamber": "House", "action": "CONSENT CALENDAR - FIRST DAY"}, {"date": "2025-06-04", "chamber": "House", "action": "Under suspension of the rules CONSENT CALENDAR - SECOND DAY."}, {"date": "2025-06-04", "chamber": "House", "action": "The Bill was PASSED TO BE ENGROSSED as Amended by Committee Amendment \"A\" (H-491)."}, {"date": "2025-06-04", "chamber": "House", "action": "Sent for concurrence. ORDERED SENT F