{"ld": 1380, "paper": "HP902", "session": "132", "title": "Resolve, Establishing the Study Group on Solutions to Address Maine's Behavioral Health Workforce Shortage", "sponsor_id": "h-stover-holly", "cosponsor_ids": ["h-collamore-amanda", "h-crafts-lydia", "h-faircloth-sean", "h-gramlich-lori", "h-mccabe-julia", "s-moore-marianne", "h-roeder-amy", "h-strout-tiffany"], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This resolve establishes the Study Group on Solutions to Address Maine's Behavioral Health Workforce Shortage, which is directed to review the State's behavioral health workforce needs and assess the feasibility of strategies and initiatives for recommended changes. The study group is required to submit a report and suggested legislation by December 3, 2025 to the Joint Standing Committee on Health and Human Services, which is authorized to report out legislation based on the report to the Second Regular Session of the 132nd Legislature.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0902&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-04-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1380)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0902&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-16", "action": "Work Session Held", "result": null}, {"date": "2025-04-16", "action": "Voted", "result": "ONTP"}, {"date": "2025-04-23", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-04-01", "c