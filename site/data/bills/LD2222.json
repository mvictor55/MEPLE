{"ld": 2222, "paper": "HP1499", "session": "132", "title": "An Act to Establish Municipal Cost Components for Unorganized Territory Services to Be Rendered in Fiscal Year 2026-27 (EMERGENCY)", "sponsor_id": "h-sayre-daniel", "cosponsor_ids": [], "committee_code": "TAX", "committee_name": "Taxation", "summary": {"text": "This bill establishes municipal cost components for state and county services provided to the unorganized territory that would normally be paid for by a municipality. The municipal cost components constitute the property tax for the unorganized territory. The bill also provides for a one-time prepayment in fiscal year 2025-26 to the unorganized territories of Washington County and requires recovery of the prepayment through the municipal cost component on or before June 30, 2027.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1499&item=1&snum=132"}, "status": "enacted", "status_label": "Emergency Enacted", "final_disposition": {"label": "Emergency Enacted", "date": "2026-04-13", "governor_action": "Emergency Signed", "governor_action_date": "2026-04-13"}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 2222)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1499&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-897)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1499&item=2&snum=132", "item": 2}, {"label": "Amendment C-B (H-898)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1499&item=3&snum=132", "item": 3}], "amendments": [{"id": "C-A (H-897)", "description": "Emergency", "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1499&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN222202.pdf"}, {"id": "C-B (H-898)", "description": "Emergency", "sponsor": null, "status": n