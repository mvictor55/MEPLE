{"ld": 1177, "paper": "HP782", "session": "132", "title": "Resolve, to Study the Public Health and Environmental Risks from Synthetic Turf (TITLE CHANGE)", "sponsor_id": "h-gramlich-lori", "cosponsor_ids": ["h-ankeles-daniel", "s-bennett-richard", "s-larsen-daughtry-matthea", "h-dhalac-deqa", "h-doudera-victoria", "s-ingwersen-henry", "h-kessler-christopher", "h-osher-laurie", "h-rielly-morgan"], "committee_code": "ENR", "committee_name": "Environment and Natural Resources", "summary": {"text": "This resolve puts a 3-year moratorium on the installation or reinstallation of synthetic turf in any park, outdoor playing field or athletic field, indoor athletic facility or similar venue. It directs the Department of Environmental Protection to examine whether synthetic turf is a risk to public health, the surrounding environment and the climate emissions goals of the State as compared to turf and, if it is a risk, the ways in which synthetic turf is a risk. It directs the department to submit, no later than November 4, 2026, a report that includes its findings and recommendations, including suggested legislation, for presentation to the 133rd Legislature in 2027. The department is also directed to conduct an outreach program to inform local governments, civic organizations, schools and the public regarding the findings of the report.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0782&item=1&snum=132"}, "status": "died", "status_label": "Died On Adjournment", "final_disposition": {"label": "Died On Adjournment", "date": "2026-04-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1177)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0782&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-240)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0782&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-240)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0782&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN117702.pdf"}], "committee_actions": [{"date": "2025-04-16", "action": "Work Session Held", "result": "TABLED"}, {"date": "2025-04-30", "action": "Work Session Held", "result": null}, {"date": "2025-04-30", "action": "Voted", "result": "OTP-AM"}, {"date": "2025-05-21", "action": "Reported Out", "result": "OTP-AM"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought to Pass as Amended", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-03-20", "chamber": "House", "action": "Committee on Environment and Natural Resources suggested and ordered printed."}, {"date": "2025-03-20", "chamber": "House", "action": "The Resolve was REFERRED to the Committee on ENVIRONMENT AND NATURAL RESOURCES."}, {"date": "2025-03-20", "chamber": "House", "action": "Sent for concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-03-20", "chamber": "Senate", "action": "The Bill was REFERRED to the Committee on ENVIRONMENT AND NATURAL RESOURCES  in concurrence"}, {"date": "2025-03-21", "chamber": "House", "action": "Carried over, in the same posture, to the next special or regular session of the 132nd Legislature, pursuant to Joint Order SP 519."}, {"date": "2025-04-16", "chamber": "J", "action": "Work Session Held: TABLED"}, {"date": "2025-04-30", "chamber": "J", "action": "Work Session Held"}, {"date": "2025-04-30", "chamber": "J", "action": "Voted: OTP-AM"}, {"date": "2025-05-21", "chamber": "J", "action": "Reported Out: OTP-AM"}, {"date": "2025-05-22", "chamber": "House", "action": "CONSENT CALENDAR - FIRST DAY"}, {"date": "2025-05-22", "chamber": "House", "action": "Under suspension of the rules CONSENT CALENDAR - SECOND DAY."}, {"date": 