{"ld": 97, "paper": "HP62", "session": "132", "title": "An Act to Facilitate the Improvement of Credit Scores of Residents of Department of Corrections Facilities", "sponsor_id": "h-sayre-daniel", "cosponsor_ids": [], "committee_code": "CJPS", "committee_name": "Criminal Justice and Public Safety", "summary": {"text": "This bill allows, under rules established by the Commissioner of Corrections, a juvenile or adult client of a correctional or detention facility to obtain a loan from a financial institution or credit union. The bill exempts the loan funds from being used for restitution or the client's telephone call account if the loan is designed to improve the client's credit score; the funds are deposited in the client's savings account at the financial institution or credit union; the loan is secured in full by funds disbursed by the client after any collections required by law; and the loan is required to be repaid in full using those secured funds or other funds disbursed by the client.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0062&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-03-21", "governor_action": "Signed", "governor_action_date": "2025-03-21"}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 97)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0062&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-02-05", "action": "Work Session Held", "result": null}, {"date": "2025-02-05", "action": "Voted", "result": "OTP"}, {"date": "2025-02-14", "action": "Reported Out", "result": "OTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-01-08", "chamber": "House", "action": "Committee on HEALTH COVERAGE, INSURANCE A