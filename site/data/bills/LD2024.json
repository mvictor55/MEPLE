{"ld": 2024, "paper": "HP1354", "session": "132", "title": "An Act to Make Changes to Certain Licensing Laws Governing For-hire Charter Boat Operators, Lobster and Crab Fishing and Elver Dealers", "sponsor_id": "h-hepler-allison", "cosponsor_ids": [], "committee_code": "MAR", "committee_name": "Marine Resources", "summary": {"text": "This bill makes changes to certain licensing laws related to marine resources. It clarifies eligibility requirements for a for-hire charter boat operator's license. It amends a provision of law governing lobster and crab trap limits by removing language that describes trap limits prior to March 1, 2000 and repealing a provision that establishes a specific civil penalty for violating trap limits. It removes a prohibition on issuing an elver dealer's license or supplemental license to a person using the same business address as a person who has violated certain laws governing elver dealers for at least 5 years following the violation.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1354&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2026-03-19", "governor_action": "Signed", "governor_action_date": "2026-03-19"}, "fiscal_status": "Not Yet Determined", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN202402.pdf", "documents": [{"label": "Bill text (LD 2024)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1354&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-812)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1354&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-812)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1354&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscal