{"ld": 1690, "paper": "HP1125", "session": "132", "title": "An Act Regarding Artificial Intelligence in Campaign Advertising", "sponsor_id": "h-kuhn-amy", "cosponsor_ids": ["h-cloutier-kristen", "h-malon-marc", "h-poirier-jennifer", "h-pugh-dylan", "h-sayre-daniel", "h-supica-laura"], "committee_code": "VLA", "committee_name": "Veterans and Legal Affairs", "summary": {"text": "This bill requires a person or an entity to disclose when an image, audio recording or video recording used in a political communication has been materially manipulated by artificial intelligence or by other means. The bill establishes that a violation of the requirement may result in a penalty of no more than 500% of the amount of the expenditure in violation and provides exemptions for certain categories of political communications.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1125&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-27", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1690)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1125&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-02", "action": "Work Session Held", "result": "TABLED"}, {"date": "2025-05-12", "action": "Work Session Held", "result": "TABLED"}, {"date": "2025-05-19", "action": "Work Session Held", "result": null}, {"date": "2025-05-19", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-22", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-04-17", "chamber": "House", "action": "Committee o