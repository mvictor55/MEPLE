{"ld": 1898, "paper": "HP1269", "session": "132", "title": "An Act to Correct Outdated References Regarding the Maine Human Rights Act", "sponsor_id": "h-moonen-matthew", "cosponsor_ids": [], "committee_code": "JUD", "committee_name": "Judiciary", "summary": {"text": "This bill modifies provisions of the Maine Human Rights Act to correct references to protection orders that were sought or received under the Maine Revised Statutes, Title 19-A, former section 4007, which was repealed effective January 1, 2023. The bill clarifies that it remains unlawful to discriminate against an individual on the basis of that individual's previous actions seeking or receiving an order of protection under the former law and that it is unlawful to discriminate against an individual on the basis of that individual's previous actions seeking or receiving a final protection order under the current law or under a substantially similar provision of the law of another state or nation.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1269&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-11", "governor_action": "Signed", "governor_action_date": "2025-06-11"}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 1898)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1269&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-12", "action": "Work Session Held", "result": null}, {"date": "2025-05-12", "action": "Voted", "result": "OTP"}, {"date": "2025-06-03", "action": "Reported Out", "result": "OTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-05-01", "chamber": "House", "action": "Received by the Clerk of the House on May 1, 2025."}, {"date": "2025-05-