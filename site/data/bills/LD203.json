{"ld": 203, "paper": "SP90", "session": "132", "title": "An Act to Provide an Income Tax Credit for Employer-supported Child Care", "sponsor_id": "s-stewart-harold", "cosponsor_ids": ["s-bennett-richard", "s-bickford-bruce", "h-guerrette-timothy", "s-libby-james"], "committee_code": "TAX", "committee_name": "Taxation", "summary": {"text": "This bill repeals the law governing the employer-assisted day care income tax credit, which by its own terms does not apply to tax years beginning on or after January 1, 2016. The bill authorizes, for tax years beginning on or after January 1, 2026, a refundable tax credit for an employer that pays or provides in-kind resources for child care for the children of its employees. The amount of the annual credit is 50% of the amount expended or $3,000 per child, whichever is lower. The bill also provides that the credit is subject to ongoing legislative review.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0090&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-06", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 203)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0090&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-29", "action": "Work Session Held", "result": null}, {"date": "2025-04-29", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-01", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-01-14", "chamber": "Senate", "action": "Committee on TAXATION suggested and ordered printed REFERENCE to the Committee on TAXATION Ordered sent down forthwith for concurrence"}, {"date": "2025-01-14", "chamber": "House", "action": "The Bill was REFERRED to the Committee on TAXATION."}, {"date": "2025-01-14", "chamber": "House", "action": "In concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-03-21", "chamber": "Senate", "action": "CARRIED OVER, in the same posture, to the next special or regular session of the 132nd Legislature, pursuant to Joint Order SP 519."}, {"date": "2025-04-29", "chamber": "J", "action": "Work Session Held"}, {"date": "2025-04-29", "chamber": "J", "action": "Voted: ONTP"}, {"date": "2025-05-01", "chamber": "J", "action": "Reported Out: ONTP"}, {"date": "2025-05-06", "chamber": "Senate", "action": "Pursuant to Joint Rule 310.3 Placed in Legislative Files (DEAD)"}], "roll_calls": [], "hearing": {"date": "2025-04-16", "time": "1:00 PM", "location": "State House, Room 127", "committee_code": "TAX", "testimony_count": 9}, "heard_with": [1555], "tags": ["Income Tax", "Credits"], "affected_statutes": [], "testimony": [{"id": "10044761", "name": "Eamonn Dundon", "organization": "Portland Regional Chamber", "town": null, "position": "support", "position_source": "inferred", "date": "2025-04-16", "hearing_date": "2025-04-16", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=10044761", "has_text": true, "shared_with": [], "person_profile_id": null, "org_profile_id": "org-portland-regional-chamber"}, {"id": "10045184", "name": "Kathryn Menefee", "organization": null, "town": "Washington", "position": null, "position_source": null, "date": "2025-04-16", "hearing_date": "2025-04-16", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=10045184", "has_text": true, "shared_with": [], "person_profile_id": null, "org_profile_id": null}, {"id": "10043575", "name": "Kim Russell", "organization": "Educate Maine", "town": null, "position": "support", "position_source": "inferred", "date": "2025-04-16", "hearing_date": "2025-04-16