{"ld": 1705, "paper": "HP1140", "session": "132", "title": "An Act Regarding Adult Education Funding and Oversight", "sponsor_id": "h-sargent-holly", "cosponsor_ids": ["h-brennan-michael", "h-dodge-janice", "h-farrin-wayne", "h-graham-anne", "h-hepler-allison", "s-libby-james", "h-mitchell-christina", "h-murphy-kelly", "h-shagoury-daniel"], "committee_code": "EDU", "committee_name": "Education and Cultural Affairs", "summary": {"text": "This bill establishes the Career Advancement and Navigation Program within the Department of Education in collaboration with the Maine Community College System. The program requires the department to employ one college and career success coordinator at each community college campus to provide students with academic support, advisory services and referrals to community services.\n\nThe bill also requires the Department of Education to annually assess adult education needs in the State relative to funding appropriated by the Legislature and requires the department to annually submit a report to the Legislature detailing its assessment and recommendations. The bill also requires the department to submit to the Legislature a detailed written explanation for any funding for adult education that is not disbursed in accordance with the reimbursement procedures described in the laws governing adult education. The department is also required to adopt guidelines for the use of state funds for adult education programs and to convene a stakeholder group to provide input on statewide goals for adult education, funding priorities and statewide program improvements. The bill requires the Legislature to appropriate from the General Fund an amount equal to 100% of the state obligation for adult education funding in accordance with the Maine Revised Statutes, Title 20-A, section 8606-A, subsection 4.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1140&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2026-04-16", "governor_action": "Signed", "governor_action_date": "2026-04-16"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1705)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1140&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-611)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1140&item=2&snum=132", "item": 2}, {"label": "Amendment S-A to C-A (S-684)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1140&item=4&snum=132", "item": 4}], "amendments": [{"id": "C-A (H-611)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1140&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN170502.pdf"}, {"id": "S-A to C-A (S-684)", "description": null, "sponsor": "Senator Rotundo", "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1140&item=4&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN170504.pdf"}], "committee_actions": [{"date": "2025-05-16", "action": "Work Session Held", "result": null}, {"date": "2025-05-16", "action": "Voted", "result": "OTP-AM"}, {"date": "2025-06-10", "action": "Reported Out", "result": "OTP-AM"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought to Pass as Amended", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-04-17", "chamber": "House", "action": "Committee on Education and Cultural Affairs suggested and ordered printed."}, {"date": "2025-04-17", "chamber": "House", "action": "The Bill was REFERRED to the Committee on EDUCATION AND CULTURAL AFFAIRS."}, {"date": "2025-04-17", "chamber": "House", "action": "Sent for concurrence. ORDERED S