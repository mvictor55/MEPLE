{"ld": 1608, "paper": "HP1062", "session": "132", "title": "An Act to Counter Unlawful Cannabis Cultivation", "sponsor_id": "h-perkins-chad", "cosponsor_ids": ["h-adams-jeffrey", "h-ardell-donald", "s-cyrway-scott", "h-eder-john", "h-foster-steven", "h-fredericks-ann", "s-harrington-matthew", "h-mcintyre-mathew", "h-white-james"], "committee_code": "VLA", "committee_name": "Veterans and Legal Affairs", "summary": {"text": "This bill allows the Department of Administrative and Financial Services to deny a registry identification card or registration certificate to any person who would be authorized under that registration to cultivate cannabis at a geographical location that has been the site of repeated violations under the Maine Medical Use of Cannabis Act or the Cannabis Legalization Act. It allows the department to place a moratorium not to exceed 10 years on such geographical locations for the purpose of issuing or renewing a registration. It also allows the Office of Cannabis Policy within the Department of Administrative and Financial Services to place a moratorium not to exceed 10 years on any geographical location that has been the site of repeated violations under the Maine Medical Use of Cannabis Act or the Cannabis Legalization Act for the purposes of issuing or renewing licenses under the Cannabis Legalization Act.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1062&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-14", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "fiscal_note_url": null, "documents": [{"label": "Bill text (LD 1608)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1062&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-08", "actio