{"ld": 163, "paper": "HP96", "session": "132", "title": "An Act to Require Health Insurance Coverage for Federally Approved Nonprescription Oral Hormonal Contraceptives and Nonprescription Emergency Contraceptives", "sponsor_id": "h-arford-poppy", "cosponsor_ids": ["s-bailey-donna", "h-boyer-michelle", "h-cloutier-kristen", "h-cluchey-sally", "s-larsen-daughtry-matthea", "h-gramlich-lori", "h-mathieson-kristi", "h-stover-holly", "s-talbot-ross-rachel"], "committee_code": "HCIFS", "committee_name": "Health Coverage, Insurance and Financial Services", "summary": {"text": "This bill expands the requirements in current law for coverage of contraceptives to include nonprescription oral hormonal contraceptives and nonprescription emergency contraceptives approved by the federal Food and Drug Administration. The bill provides that a prescription is not required for insurance coverage for nonprescription oral hormonal contraceptives and nonprescription emergency contraceptives and requires insurers to establish mechanisms to ensure that an enrollee who purchases a nonprescription oral hormonal contraceptive or nonprescription emergency contraceptive at a pharmacy has the option to make the purchase pursuant to a standing order issued for billing purposes without a payment required at the point of sale or to make the purchase with a payment at the point of sale and submit a claim for reimbursement to the insurer. The requirements apply beginning January 1, 2026.\n\nThe bill requires health insurance carriers to notify enrollees, at least annually, of the coverage requirements for contraceptive supplies and the procedures an enrollee must follow to access coverage for nonprescription oral hormonal contraceptives and nonprescription emergency contraceptives at a pharmacy without an out-of-pocket cost at the point of sale or by submitting a claim for reimbursement. The bill also authorizes the Department of Professional and Financial Regulation, Bureau of Insurance to adopt rules to implement the provisions and also requires the bureau to monitor implementation by health insurance carriers and to report to the joint standing committee of the Legislature having jurisdiction over health coverage, insurance and financial services matters no later than November 4, 2026.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0096&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-07-01", "governor_action": "Signed", "governor_action_date": "2025-07-01"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 163)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0096&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-120)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0096&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-120)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0096&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN016302.pdf"}], "committee_actions": [{"date": "2025-02-12", "action": "Work Session Held", "result": null}, {"date": "2025-02-12", "action": "Voted", "result": "Divided Report"}, {"date": "2025-05-08", "action": "Reported Out", "result": "ONTP/OTP-AM"}], "committee_reports": [{"label": "Majority report", "recommendation": "Ought Not To Pass", "signer_count": 7, "signers": ["Representative Marygrace Cimino", "Representative Paul Flynn", "Representative Robert Foley", "Senator David Haggan", "Representative Anne-Marie Mastraccio", "Representative Joshua Morris", "Representative Rolf Olsen"], "signer_ids": ["h-cimino-marygrace", "h-flynn-paul", "h-foley-robert", "s-haggan-david", "h-mastraccio-anne-marie", "h-morris-joshua", "h-olsen-rolf"]}, {"label": "Minority report