{"ld": 2006, "paper": "SP822", "session": "132", "title": "Resolve, Authorizing the Director of the Bureau of Parks and Lands to Make Certain Land Transactions in Aroostook and Somerset Counties", "sponsor_id": "s-bernard-susan", "cosponsor_ids": [], "committee_code": "ACF", "committee_name": "Agriculture, Conservation and Forestry", "summary": {"text": "This resolve authorizes the Director of the Bureau of Parks and Lands within the Department of Agriculture, Conservation and Forestry to implement land transactions. The bureau is authorized to convey approximately 7 acres under an existing road in the Town of Westmanland to the town. The bureau is also authorized to sell approximately 0.25 acres of land in Seboomook Township and to exchange less than 0.25 acres in the City of Presque Isle to resolve a long-standing encroachment on the state land.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0822&item=1&snum=132"}, "status": "enacted", "status_label": "Finally Passed", "final_disposition": {"label": "Finally Passed", "date": "2026-02-26", "governor_action": "Signed", "governor_action_date": "2026-02-26"}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 2006)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0822&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-490)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0822&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-490)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0822&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN200602.pdf"}], "committee_actions": [{"date": "2026-01-07", "action": "Work Session Held", "result": null}, {"date": "2026-01-07", "action": "Voted", "result": "OTP-AM"}, {"date": "2026-01-16", "action