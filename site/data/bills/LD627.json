{"ld": 627, "paper": "HP395", "session": "132", "title": "An Act to Require Insurance Coverage for Glucagon-like Peptide-1 Receptor Agonist Medication", "sponsor_id": "h-stover-holly", "cosponsor_ids": ["h-ankeles-daniel", "h-dhalac-deqa", "h-graham-anne", "h-gramlich-lori", "h-meyer-michele", "h-roberts-lovell-tiffany", "h-roeder-amy", "h-salisbury-suzanne"], "committee_code": "HCIFS", "committee_name": "Health Coverage, Insurance and Financial Services", "summary": {"text": "This bill requires carriers offering health plans in this State to provide coverage for glucagon-like peptide-1 receptor agonist medication approved by the federal Food and Drug Administration and prescribed by a health care provider. It also requires the Department of Professional and Financial Regulation, Bureau of Insurance to initiate an education campaign regarding the coverage requirements and the health benefits associated with the use of the medication. The requirements of the bill apply to health plans issued or renewed on or after January 1, 2026.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0395&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-04-08", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 627)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0395&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-03-26", "action": "Work Session Held", "result": null}, {"date": "2025-03-26", "action": "Voted", "result": "ONTP"}, {"date": "2025-04-01", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_ac