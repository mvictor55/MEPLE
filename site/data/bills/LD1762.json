{"ld": 1762, "paper": "HP1180", "session": "132", "title": "An Act to Protect Recreational Trails by Establishing the Trails for the Future Program", "sponsor_id": "h-blier-mark", "cosponsor_ids": ["s-baldacci-joseph", "s-larsen-daughtry-matthea", "h-drinkwater-gary", "h-fecteau-ryan", "s-hickman-craig", "h-mason-richard", "h-pluecker-william", "h-roberts-lovell-tiffany", "s-stewart-harold"], "committee_code": "ACF", "committee_name": "Agriculture, Conservation and Forestry", "summary": {"text": "This bill creates the Trails for the Future Fund and the Trails for the Future Program to protect public access to established recreational trails, including snowmobile trails and all-terrain vehicle, or ATV, trails, through the acquisition of property and the establishment of easements. The bill requires that an acquisition or grant made pursuant to the program is subject to the requirement that the recreational trail on the property may not be altered or developed in a manner that precludes its existing use, including use by a snowmobile or by an ATV, if applicable. The bill also requires that any change to the access or layout of a recreational trail protected pursuant to the program must be approved by the snowmobile club, ATV club or another club or group that maintains the recreational trail. If no club or group is responsible for maintaining the recreational trail the proposed changes must be approved by the Commissioner of Agriculture, Conservation and Forestry.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1180&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-28", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "fiscal_note_url": null, "documents": [{"label": "Bill text (LD 1762)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1180&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-13", "action": "Work Session Held", "result": null}, {"date": "2025-05-13", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-27", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-04-22", "chamber": "House", "action": "Committee on Agriculture, Conservation and Forestry suggested and ordered printed."}, {"date": "2025-04-22", "chamber": "House", "action": "The Bill was REFERRED to the Committee on AGRICULTURE, CONSERVATION AND FORESTRY."}, {"date": "2025-04-22", "chamber": "House", "action": "Sent for concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-04-22", "chamber": "Senate", "action": "The Bill was REFERRED to the Committee on AGRICULTURE, CONSERVATION AND FORESTRY  in concurrence"}, {"date": "2025-05-28", "chamber": "Senate", "action": "Pursuant to Joint Rule 310.3 Placed in Legislative Files (DEAD)"}], "roll_calls": [], "hearing": {"date": "2025-05-06", "time": "1:00 PM", "location": "Cross Building, Room 214", "committee_code": "ACF", "testimony_count": 6}, "heard_with": [], "tags": ["Recreation", "Property Access"], "affected_statutes": [], "testimony": [{"id": "10050816", "name": "James Cote", "organization": "Maine Snowmobile Association", "town": null, "position": "neutral", "position_source": "inferred", "date": "2025-05-06", "hearing_date": "2025-05-06", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=10050816", "has_text": true, "shared_with": [], "person_profile_id": null, "org_profile_id": "org-maine-snowmobile-association"}, {"id": "192808", "name": "John Raymond", "organization": "ATV Maine", "town": null, "position": "support", "position_source": "inferred", "date": "2025-05-06", "hearing_date": "2025-05-06", "