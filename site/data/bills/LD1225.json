{"ld": 1225, "paper": "HP800", "session": "132", "title": "An Act to Amend the Nursing Education Loan Repayment Program", "sponsor_id": "h-roberts-lovell-tiffany", "cosponsor_ids": ["h-brennan-michael", "h-collamore-amanda", "h-crockett-edward", "s-curry-glenn", "h-dodge-janice", "h-murphy-kelly", "s-rafferty-joseph", "h-sargent-holly"], "committee_code": "EDU", "committee_name": "Education and Cultural Affairs", "summary": {"text": "This bill modifies the nursing education loan repayment program by amending the criteria to add an outstanding education loan relating to an associate or bachelor's degree of any kind to the list of debts that qualify for the program, whether or not the otherwise qualifying nurse has outstanding debts related to a master's or doctoral nursing degree. Under the bill, the Finance Authority of Maine must repay the loan for an associate or bachelor's degree up to $20,000 for a qualifying full-time nurse and up to $10,000 for a qualifying part-time nurse.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0800&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-06", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 1225)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0800&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-28", "action": "Work Session Held", "result": null}, {"date": "2025-04-28", "action": "Voted", "result": "ONTP"}, {"date": "2025-04-29", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-03-25", "chamber": "House"