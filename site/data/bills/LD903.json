{"ld": 903, "paper": "SP392", "session": "132", "title": "An Act to Regulate the Advertising of Cannabis Products", "sponsor_id": "s-cyrway-scott", "cosponsor_ids": ["h-arata-amy", "s-baldacci-joseph", "s-bernard-susan", "h-boyer-david", "h-ducharme-john", "s-farrin-bradlee", "h-lajoie-michel", "h-nutting-robert", "h-perkins-chad"], "committee_code": "VLA", "committee_name": "Veterans and Legal Affairs", "summary": {"text": "This bill amends the provisions of law regarding signs, advertising and marketing for medical use cannabis and adult use cannabis. The bill prohibits all forms of marketing and advertising except for the following:\n\n1. Establishing a website or other Internet-based presence containing only general information on contact information, location, hours and products available; 2. Listings in business directories; and 3. The use of signs on the registered caregiver's, dispensary's or adult use cannabis licensee's premises.\n\nThe bill establishes requirements for signs located on the registered caregiver's, dispensary's or adult use cannabis licensee's premises. It also allows for the Department of Administrative and Financial Services, Office of Cannabis Policy to review voluntary requests for approval of adult use cannabis licensees' signs.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0392&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-04-08", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 903)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0392&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-03-26", "action": "Work Session Held", "result": null}, {"date": "2025-03-26", "action": "Voted", "result": "ONTP"}, {"date": "2025-04-01", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-03-05", "chamber": "Senate", "action": "Received by the Secretary of the Senate on March 5, 2025 and REFERRED to the Committee on VETERANS AND LEGAL AFFAIRS pursuant to Joint Rule 308.2"}, {"date": "2025-03-21", "chamber": "Senate", "action": "CARRIED OVER, in the same posture, to the next special or regular session of the 132nd Legislature, pursuant to Joint Order SP 519."}, {"date": "2025-03-26", "chamber": "J", "action": "Work Session Held"}, {"date": "2025-03-26", "chamber": "J", "action": "Voted: ONTP"}, {"date": "2025-04-01", "chamber": "J", "action": "Reported Out: ONTP"}, {"date": "2025-04-08", "chamber": "Senate", "action": "Pursuant to Joint Rule 310.3 Placed in Legislative Files (DEAD)"}], "roll_calls": [], "hearing": {"date": "2025-03-19", "time": "11:30 AM", "location": "State House, Room 437", "committee_code": "VLA", "testimony_count": 13}, "tags": ["Cannabis", "Adult Use And Medical Cannabis"], "affected_statutes": [], "testimony": [{"id": "186433", "name": "Amy McFarland", "organization": "Independence Farm", "town": null, "position": "oppose", "position_source": "inferred", "date": "2025-03-19", "hearing_date": "2025-03-19", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=186433", "has_text": true}, {"id": "10037989", "name": "David McFarland", "organization": "Waterford", "town": null, "position": null, "position_source": null, "date": "2025-03-19", "hearing_date": "2025-03-19", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=10037989", "has_text": true}, {"id": "10038107", "name": "Jared Rolfe", "organization": "Bridgton", "town": null, "position": null, "position_source": null, "date": "2025-03-19", "hearing_date": "2025-03-19", "url": "https: