{"ld": 1484, "paper": "HP975", "session": "132", "title": "An Act Related to Public Access of Records of Certain Disciplinary Actions of Public Employees", "sponsor_id": "h-bishop-steven", "cosponsor_ids": ["h-chapman-quentin", "s-haggan-david", "h-henderson-rachel", "s-martin-joseph", "h-schmersal-burgess-tammy", "h-white-russell"], "committee_code": "JUD", "committee_name": "Judiciary", "summary": {"text": "This bill modifies provisions of law related to the confidentiality of certain employee records. Under current law, if disciplinary action is taken against a state, county or municipal employee, the final written decision associated with the disciplinary action is not confidential. Under the bill, only disciplinary actions that are of a nature that impose or result in a financial disadvantage, including, but not limited to, termination, demotion or suspension without pay, may become public.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0975&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-04-24", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 1484)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0975&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-15", "action": "Work Session Held", "result": null}, {"date": "2025-04-15", "action": "Voted", "result": "ONTP"}, {"date": "2025-04-23", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-04-03", "chamber": "House", "action": "Committee on Judiciary suggested and ordered printed."}, {"date": "2025-0