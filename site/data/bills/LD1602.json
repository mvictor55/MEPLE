{"ld": 1602, "paper": "SP639", "session": "132", "title": "An Act to Remove the Exemption from Sales and Use Tax for Automobiles Purchased for Use as Rentals", "sponsor_id": "s-tipping-michael", "cosponsor_ids": ["h-matlack-ann", "h-rana-ambureen", "s-talbot-ross-rachel"], "committee_code": "TAX", "committee_name": "Taxation", "summary": {"text": "Under current law, the sale of an automobile to a person in the business of renting automobiles for a period of less than one year is not taxed; instead, the lease of the vehicle to a consumer is taxed at the rate of 10%.\n\nThis bill requires a person purchasing an automobile for the purpose of renting the automobile for less than one year to pay a sales and use tax of 5.5%. The lease of the vehicle to a consumer continues to be taxed at 10%.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0639&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-06", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 1602)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0639&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-23", "action": "Work Session Held", "result": null}, {"date": "2025-04-23", "action": "Voted", "result": "ONTP"}, {"date": "2025-04-30", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-04-10", "chamber": "Senate", "action": "Committee on TAXATION suggested and ordered printed REFERENCE to the Committee on TAXATION Ordered sent down forthwith for concurrence"}, {"date": "2025-04-10", "chamber": "House", "action": "The Bill was REFERRED to the Committee on TAXATION."}, {"date": "2025-04-10", "chamber": "House", "action": "In concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-04-23", "chamber": "J", "action": "Work Session Held"}, {"date": "2025-04-23", "chamber": "J", "action": "Voted: ONTP"}, {"date": "2025-04-30", "chamber": "J", "action": "Reported Out: ONTP"}, {"date": "2025-05-06", "chamber": "Senate", "action": "Pursuant to Joint Rule 310.3 Placed in Legislative Files (DEAD)"}], "roll_calls": [], "hearing": {"date": "2025-04-23", "time": "1:00 PM", "location": "State House, Room 127", "committee_code": "TAX", "testimony_count": 7}, "tags": ["Sales And Use Tax", "Exempt Items"], "affected_statutes": [], "testimony": [{"id": "10045990", "name": "Brian Parke", "organization": "Maine Motor Transport Association", "town": null, "position": "oppose", "position_source": "inferred", "date": "2025-04-23", "hearing_date": "2025-04-23", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=10045990", "has_text": true}, {"id": "10045897", "name": "Brianna January", "organization": "McLean", "town": null, "position": "support", "position_source": "inferred", "date": "2025-04-23", "hearing_date": "2025-04-23", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=10045897", "has_text": true}, {"id": "10045704", "name": "Don Lefeve", "organization": "American Car Rental Assn", "town": null, "position": null, "position_source": null, "date": "2025-04-23", "hearing_date": "2025-04-23", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=10045704", "has_text": true}, {"id": "10046045", "name": "Jason Ellis", "organization": "Enterprise Mobility", "town": null, "position": "oppose", "position_source": "inferred", "date": "2025-04-23", "hearing_date": "2025-04-23", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=10046045", "has_text": true}, {"id": "10045905", "name": "Michael Allen", "organizat