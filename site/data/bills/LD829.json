{"ld": 829, "paper": "SP356", "session": "132", "title": "An Act to Standardize the Laws Regarding the Carrying of Concealed Handguns in State Parks (EMERGENCY)", "sponsor_id": "s-haggan-david", "cosponsor_ids": ["h-ardell-donald", "h-foster-steven", "s-harrington-matthew", "h-henderson-rachel", "h-perkins-chad", "h-poirier-jennifer", "h-white-james"], "committee_code": "JUD", "committee_name": "Judiciary", "summary": {"text": "This bill removes the requirement that a person have a valid permit in order to carry a concealed handgun in state parks, Baxter State Park, the Allagash Wilderness Waterway and Acadia National Park and instead provides that any person who is not otherwise prohibited from possessing a firearm may carry a concealed handgun in these locations. The bill also directs the Department of Agriculture, Conservation and Forestry, Bureau of Parks and Lands to update its rules to remove the requirement that a person have a valid permit in order to carry a concealed handgun in state parks, Baxter State Park and the Allagash Wilderness Waterway.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0356&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2025-06-13", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 829)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0356&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-363)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0356&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-363)", "description": "Emergency", "sponsor": null, "status": null, "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0356&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/