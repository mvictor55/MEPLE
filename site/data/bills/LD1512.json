{"ld": 1512, "paper": "HP996", "session": "132", "title": "An Act to Protect Patients from Health Care Discrimination and Guarantee Access to the Lowest Available Cost for Care", "sponsor_id": "h-morris-joshua", "cosponsor_ids": [], "committee_code": "HCIFS", "committee_name": "Health Coverage, Insurance and Financial Services", "summary": {"text": "This bill provides that a health care provider may not discriminate against a patient based on the patient's method of payment. It also requires the disclosure of a discounted cash price option upon request, free itemized bills and, for an uninsured patient's health care service or treatment, a price that is the lesser of what Medicare would pay and the lowest amount payable under any of the health care provider's contracts.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0996&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-28", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 1512)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0996&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-08", "action": "Work Session Held", "result": null}, {"date": "2025-05-08", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-27", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-04-08", "chamber": "House", "action": "Committee on HEALTH AND HUMAN SERVICES suggested and ordered printed."}, {"date": "2025-04-08", "chamber": "House", "action": "On motion of Representative MEYER of Eliot, the Resolve was REFERRED to th