{"ld": 1920, "paper": "HP1281", "session": "132", "title": "An Act to Prohibit the Sale of Potentially Intoxicating Hemp Products to a Person Under 21 Years of Age (EMERGENCY)", "sponsor_id": "h-strout-tiffany", "cosponsor_ids": ["h-frost-sharon", "h-osher-laurie", "s-talbot-ross-rachel"], "committee_code": "ACF", "committee_name": "Agriculture, Conservation and Forestry", "summary": {"text": "This bill prohibits the sale of potentially intoxicating hemp products to a person who has not attained 21 years of age. The bill also establishes requirements for the packaging of hemp products, including the requirement that all potentially intoxicating hemp products that are not salves or topical products be packaged in child-resistant and tamper-evident packaging. The bill also provides that all hemp products are subject to the requirement that the product not be labeled or packaged in a manner that violates federal trademark law and not be designed in such a way that would cause a person to confuse the product with a different trademarked product.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1281&item=1&snum=132"}, "status": "enacted", "status_label": "Emergency Enacted", "final_disposition": {"label": "Emergency Enacted", "date": "2025-06-24", "governor_action": "Emergency Unsigned", "governor_action_date": "2025-06-24"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1920)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1281&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-584)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1281&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-584)", "description": "Emergency", "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1281&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN192002.pdf"}], "committee_actions": [{"date": "2025-05-22", "action": "Work Session Held", "result": null}, {"date": "2025-05-22", "action": "Voted", "result": "Divided Report"}, {"date": "2025-06-03", "action": "Work Session Reconsidered", "result": null}, {"date": "2025-06-03", "action": "Voted", "result": "Divided Report"}, {"date": "2025-06-09", "action": "Reported Out", "result": "OTP-AM/ONTP"}], "committee_reports": [{"label": "Majority report", "recommendation": "Ought To Pass As Amended", "signer_count": 10, "signers": ["Representative Bill Pluecker (Chair)", "Senator Rachel Talbot Ross (Chair)", "Representative Stephan Bunker", "Representative Mark Cooper", "Representative Dean Cray", "Representative Sharon Frost", "Representative Timothy Guerrette", "Representative Allison Hepler", "Senator Henry Ingwersen", "Representative Caldwell Jackson"], "signer_ids": ["h-pluecker-william", "s-talbot-ross-rachel", "h-bunker-stephan", "h-cooper-mark", "h-cray-dean", "h-frost-sharon", "h-guerrette-timothy", "h-hepler-allison", "s-ingwersen-henry", "h-jackson-caldwell"]}, {"label": "Minority report", "recommendation": "Ought Not To Pass", "signer_count": 2, "signers": ["Senator Russell Black", "Representative Jim Dill"], "signer_ids": ["s-black-russell", "h-dill-james"]}], "chamber_actions": [{"date": "2025-05-06", "chamber": "House", "action": "Committee on AGRICULTURE, CONSERVATION AND FORESTRY suggested and ordered printed."}, {"date": "2025-05-06", "chamber": "House", "action": "On motion of Representative DILL of Old Town, the Bill was REFERRED to the Committee on VETERANS AND LEGAL AFFAIRS."}, {"date": "2025-05-06", "chamber": "House", "action": "Sent for concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-05-07", "chamber": "Senate", "action": "On motion by Senator TALBOT ROSS of Cumberland Tabled until Later in Today's Session, pending REFERENCE"}, {"date": "2025-05-07", "chamber": "Senate", "action": "Unfinished Business"}, {"date"