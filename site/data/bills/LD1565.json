{"ld": 1565, "paper": "HP1023", "session": "132", "title": "An Act to Allow the Use of Certain All-terrain Vehicles on Snowmobile Trails", "sponsor_id": "h-hymes-benjamin", "cosponsor_ids": ["h-guerrette-timothy"], "committee_code": "IFW", "committee_name": "Inland Fisheries and Wildlife", "summary": {"text": "This bill provides that when registering an all-terrain vehicle, a person may purchase an endorsement for $25 that allows them to switch between tires and snow tracks for the registration period to operate on snowmobile trails in the State. The endorsement is in the form of stickers, which must be displayed on the front and back of the ATV next to the registration number.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1023&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-14", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1565)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1023&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-05", "action": "Work Session Held", "result": null}, {"date": "2025-05-05", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-06", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-04-10", "chamber": "House", "action": "Committee on Inland Fisheries and Wildlife suggested and ordered printed."}, {"date": "2025-04-10", "chamber": "House", "action": "The Bill was REFERRED to the Committee on INLAND FISHERIES AND WILDLIFE."}, {"date": "2025-04-10", "chamber": "House", "action": "Sent for concurrence. ORDERED SE