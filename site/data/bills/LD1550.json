{"ld": 1550, "paper": "SP634", "session": "132", "title": "Resolve, Directing the Department of Health and Human Services to Amend Its Rules to Protect Water Quality by Reducing Nutrient Pollution from Septic Systems", "sponsor_id": "s-ingwersen-henry", "cosponsor_ids": ["s-bennett-richard", "h-bridgeo-william", "h-hepler-allison", "h-meyer-michele", "s-moore-marianne", "s-nangle-timothy", "s-tepler-denise"], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This resolve directs the Department of Health and Human Services to amend its rule governing subsurface wastewater disposal by:\n\n1. Amending the design standards for disposal fields in a manner that addresses short circuiting by reducing nutrient loading from septic tank effluent through natural processes; 2. Applying the amended design standards only to soil profiles that pose a high risk of short circuiting due to the presence of sand or gravel layers in lower soil horizons or bedrock fractures; and 3. Providing that an area of land suitable for the installation of a disposal field may not be rendered unsuitable due to any changes in the rule amended pursuant to this resolve.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0634&item=1&snum=132"}, "status": "enacted", "status_label": "Finally Passed", "final_disposition": {"label": "Finally Passed", "date": "2025-05-30", "governor_action": "Signed", "governor_action_date": "2025-05-30"}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 1550)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0634&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-102)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0634&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-102)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0634&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN155002.pdf"}], "committee_actions": [{"date": "2025-05-06", "action": "Work Session Held", "result": null}, {"date": "2025-05-06", "action": "Voted", "result": "OTP-AM"}, {"date": "2025-05-16", "action": "Reported Out", "result": "OTP-AM"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought to Pass as Amended", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-04-10", "chamber": "Senate", "action": "Committee on HEALTH AND HUMAN SERVICES suggested and ordered printed REFERENCE to the Committee on HEALTH AND HUMAN SERVICES Ordered sent down forthwith for concurrence"}, {"date": "2025-04-10", "chamber": "House", "action": "The Resolve was REFERRED to the Committee on HEALTH AND HUMAN SERVICES."}, {"date": "2025-04-10", "chamber": "House", "action": "In concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-05-06", "chamber": "J", "action": "Work Session Held"}, {"date": "2025-05-06", "chamber": "J", "action": "Voted: OTP-AM"}, {"date": "2025-05-16", "chamber": "J", "action": "Reported Out: OTP-AM"}, {"date": "2025-05-20", "chamber": "Senate", "action": "Report READ and ACCEPTED."}, {"date": "2025-05-20", "chamber": "Senate", "action": "READ ONCE."}, {"date": "2025-05-20", "chamber": "Senate", "action": "Committee Amendment \"A\" (S-102) READ and ADOPTED."}, {"date": "2025-05-20", "chamber": "Senate", "action": "Under suspension of the Rules, READ A SECOND TIME and PASSED TO BE ENGROSSED AS AMENDED BY Committee Amendment \"A\" (S-102)."}, {"date": "2025-05-20", "chamber": "Senate", "action": "Ordered sent down forthwith for concurrence."}, {"date": "2025-05-22", "chamber": "House", "action": "CONSENT CALENDAR - FIRST DAY"}, {"date": "2025-05-22", "chamber": "House", "action": "Under suspension of the rules CONSENT CALENDAR - SECOND DAY."}, {"date": "2025-05-22", "chambe