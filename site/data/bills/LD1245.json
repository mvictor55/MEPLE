{"ld": 1245, "paper": "HP820", "session": "132", "title": "An Act to Establish a Fund and Council to Support Working Waterfronts (TITLE CHANGE)", "sponsor_id": "h-rielly-morgan", "cosponsor_ids": ["h-ankeles-daniel", "s-duson-jill", "h-gere-traci", "h-golek-cheryl", "h-stover-holly", "h-strout-tiffany", "s-tepler-denise"], "committee_code": "HED", "committee_name": "Housing and Economic Development", "summary": {"text": "This bill establishes the Working Waterfront Information Campaign Fund, which is administered by the Maine Office of Community Affairs. The office is directed to work with the Department of Economic and Community Development, Office of Tourism; coastal municipal and regional governments; and organizations and coalitions that have experience advocating for the protection and preservation of working waterfronts in the State and experience working with persons who use working waterfronts in the State. In collaboration with those entities, the office is directed to produce working waterfront information campaigns.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0820&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-11", "governor_action": "Signed", "governor_action_date": "2025-06-11"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1245)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0820&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-453)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0820&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-453)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0820&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN124502.pdf"}], "committee_a