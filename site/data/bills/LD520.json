{"ld": 520, "paper": "HP338", "session": "132", "title": "An Act to Ensure Choices in Health Insurance Markets by Modifying the Provisions of Law Governing Clear Choice Design Health Plans", "sponsor_id": "h-morris-joshua", "cosponsor_ids": ["h-cimino-marygrace", "h-flynn-paul", "h-foley-robert", "s-haggan-david", "h-olsen-rolf"], "committee_code": "HCIFS", "committee_name": "Health Coverage, Insurance and Financial Services", "summary": {"text": "This bill amends the provisions of the Maine Insurance Code related to pooled market and clear choice design.\n\nThe bill eliminates the requirement that health insurance carriers offering individual health plans must make those plans available to all eligible small employers within the plan's approved service area. It also eliminates the requirement that health insurance carriers offering small group health plans make those plans available to all eligible individuals residing within the plan's approved service area.\n\nThe bill eliminates requirements related to premium rate adjustments for health plans that are issued on other than a calendar year basis.\n\nThe bill requires the Superintendent of Insurance to develop separate clear choice designs for individual health plans and small group health plans and requires that on January 31st of each year, the superintendent must release the proposed clear choice designs to be used in the following plan year for review and comment by stakeholders. The bill modifies provisions related to alternative designs to allow carriers to offer up to 3 alternative individual health plan designs and up to 3 alternative small group health plan designs.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0338&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-03-20", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "fiscal_note_url": null, "documents": [{"label": "Bill text (LD 520)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0338&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-03-05", "action": "Work Session Held", "result": "TABLED"}, {"date": "2025-03-12", "action": "Work Session Held", "result": null}, {"date": "2025-03-12", "action": "Voted", "result": "ONTP"}, {"date": "2025-03-14", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-02-07", "chamber": "House", "action": "Received by the Clerk of the House on February 7, 2025."}, {"date": "2025-02-07", "chamber": "House", "action": "The Bill was REFERRED to the Committee on HEALTH COVERAGE, INSURANCE AND FINANCIAL SERVICES pursuant to Joint Rule 308.2 and ordered printed pursuant to Joint Rule 401."}, {"date": "2025-03-20", "chamber": "Senate", "action": "Pursuant to Joint Rule 310.3 Placed in Legislative Files (DEAD)"}], "roll_calls": [], "hearing": {"date": "2025-02-27", "time": "1:00 PM", "location": "Cross Building, Room 220", "committee_code": "HCIFS", "testimony_count": 7}, "heard_with": [], "tags": ["Insurance", "Health Insurance"], "affected_statutes": [], "testimony": [{"id": "184477", "name": "Dan Demeritt", "organization": "Maine Association of Health Plans", "town": null, "position": "support", "position_source": "inferred", "date": "2025-02-27", "hearing_date": "2025-02-27", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=184477", "has_text": true, "shared_with": [], "person_profile_id": null, "org_profile_id": "org-maine-association-of-health-plans"}, {"id": "184476", "name": "Jake Lachance", "organization": "Maine State Chamber of Commerce", "town": null, "position": "support", "position