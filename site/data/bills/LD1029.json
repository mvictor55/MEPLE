{"ld": 1029, "paper": "SP447", "session": "132", "title": "An Act to Ensure General Assistance for Housing Does Not Reduce Assistance for Other Basic Necessities and to Increase Presumptive Eligibility and State Reimbursement for General Assistance", "sponsor_id": "s-talbot-ross-rachel", "cosponsor_ids": ["s-curry-glenn", "h-debrito-flavia", "h-gattine-andrew", "h-gere-traci", "h-graham-anne", "h-rana-ambureen", "s-rotundo-margaret", "s-tipping-michael", "h-zager-samuel"], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This bill:\n\n1. Requires that the total maximum general assistance level provided to a person or household sufficiently account for housing assistance while providing adequate eligibility for other basic necessities; 2. Increases the period of presumptive eligibility for general assistance for a person who is provided shelter in an emergency shelter for the homeless from 30 days to 180 days; and 3. Increases from 70% to 90% the amount of state reimbursement for direct costs of general assistance incurred by each municipality and Indian tribe and requires the Department of Health and Human Services to reimburse municipalities and Indian tribes 100% of direct costs for providing emergency shelter for the homeless.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0447&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-22", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "fiscal_note_url": null, "documents": [{"label": "Bill text (LD 1029)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0447&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-24", "action": "Work Session Held", "result": "TABLED"}, {"date": 