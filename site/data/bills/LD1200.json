{"ld": 1200, "paper": "SP489", "session": "132", "title": "An Act to Prohibit the Sale of Items Intended to Be Used to Inhale Nitrous Oxide for Recreational Purposes", "sponsor_id": "s-reny-cameron", "cosponsor_ids": [], "committee_code": "CJPS", "committee_name": "Criminal Justice and Public Safety", "summary": {"text": "This bill prohibits a person from intentionally or knowingly selling or distributing to another person a device that contains nitrous oxide or is intended to be used to inhale nitrous oxide for recreational drug use purposes. Dentists, dental hygienists, dental who therapists, pharmacists, pharmacy interns, physicians and physician assistants who administer nitrous oxide in accordance with their scopes of practice are exempt from this provision. A person who violates this provision commits a civil violation and is subject to a fine of not less than $250 nor more than $500 for the first offense; not less than $400 nor more than $700 for the 2nd offense; and $1,000 for the 3rd and each subsequent offense.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0489&item=1&snum=132"}, "status": "died", "status_label": "Died Between Houses", "final_disposition": {"label": "Died Between Houses", "date": "2025-06-13", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN120001.pdf", "documents": [{"label": "Bill text (LD 1200)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0489&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-340)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0489&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-340)", "description": null, "sponsor": null, "status": "Adopted by Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0489&item=2&snum=132", "fiscal_note_url": 