{"ld": 1421, "paper": "SP577", "session": "132", "title": "An Act to Clarify Parental Notifications Regarding Child Care Facility Investigations", "sponsor_id": "s-pierce-teresa", "cosponsor_ids": [], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This bill requires that a child care facility, family child care provider or nursery school notify the parent or legal guardian of children enrolled in that facility, provider or nursery school when the facility, provider or nursery school is under investigation for violating certain laws governing facilities for children under the Maine Revised Statutes, Title 22, Subtitle 6: Facilities for Children and Adults. A violation of this requirement is a civil violation for which a fine of not more than $500 per incident may be adjudged.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0577&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-04-30", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 1421)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0577&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-25", "action": "Work Session Held", "result": null}, {"date": "2025-04-25", "action": "Voted", "result": "ONTP"}, {"date": "2025-04-28", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-04-01", "chamber": "Senate", "action": "Committee on HEALTH AND HUMAN SERVICES suggested and ordered printed REFERENCE to the Committee on HEALTH AND HUMAN SERVICES Ordered sent down forthw