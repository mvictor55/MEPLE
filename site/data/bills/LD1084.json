{"ld": 1084, "paper": "HP706", "session": "132", "title": "Resolve, to Alleviate the Behavioral Health Workforce Shortage by Allowing the Training and Granting of Behavioral Health Certifications by Community-based Agencies and Hospitals", "sponsor_id": "h-crafts-lydia", "cosponsor_ids": ["h-carlow-nathan", "h-graham-anne", "s-ingwersen-henry", "s-moore-marianne", "h-shagoury-daniel"], "committee_code": "HCIFS", "committee_name": "Health Coverage, Insurance and Financial Services", "summary": {"text": "This resolve requires the Department of Health and Human Services to, by January 1, 2026, amend its rules to allow community-based agencies and hospitals to provide in-house training and to certify their own staff for all levels of mental health rehabilitation technicians, certified residential medication aides and behavioral health professionals. It requires the department to terminate 3rd-party contracts to conduct this training and to end the requirement for 3rd-party approval for certifications for those positions.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0706&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-20", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1084)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0706&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-09", "action": "Work Session Held", "result": "TABLED"}, {"date": "2025-05-08", "action": "Work Session Held", "result": null}, {"date": "2025-05-08", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-14", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "si