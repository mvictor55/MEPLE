{"ld": 357, "paper": "SP143", "session": "132", "title": "An Act to Establish a State Minimum Hourly Wage for Agricultural Workers", "sponsor_id": "s-bennett-richard", "cosponsor_ids": ["h-roeder-amy", "s-talbot-ross-rachel", "s-tipping-michael"], "committee_code": "LAB", "committee_name": "Labor", "summary": {"text": "This bill provides that individuals employed to perform agricultural labor may not be paid at a rate less than the state minimum hourly wage of $14.65 per hour and that, on January 1, 2027 and each January 1st thereafter, the minimum hourly wage then in effect must be increased by the increase in the cost of living. It also provides that employers that employ individuals to perform agricultural labor are required to keep a true and accurate record of the hours worked by each employee and the wages paid to each employee. The bill also provides remedies for employees and penalties for employers for unpaid minimum hourly wage violations.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0143&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-20", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 357)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0143&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-06", "action": "Work Session Held", "result": null}, {"date": "2025-05-06", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-14", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-01-30", "chamber": "Senate", "action": "Received by the 