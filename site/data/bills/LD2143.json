{"ld": 2143, "paper": "SP861", "session": "132", "title": "An Act Facilitating the Reconstruction or Replacement of Storm-damaged Commercial Fisheries Facilities and Infrastructure", "sponsor_id": "s-larsen-daughtry-matthea", "cosponsor_ids": ["h-golek-cheryl"], "committee_code": "HED", "committee_name": "Housing and Economic Development", "summary": {"text": "This bill amends the provisions of law governing a municipal board of appeals' authority to issue variances to local ordinances. The bill provides that a petitioner seeking a variance from a municipal ordinance to make repairs to the person's dock, pier or wharf or structure thereon does not have to meet the requirement that the person's land cannot yield a reasonable return unless the variance is granted, as long as the dock, pier or wharf or structure thereon sustained substantial damage and is to be reconstructed or replaced for a functionally dependent use as defined in 44 Code of Federal Regulations, Section 59.1.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0861&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2026-04-06", "governor_action": "Signed", "governor_action_date": "2026-04-06"}, "fiscal_status": "No Fiscal Impact", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN214301.pdf", "documents": [{"label": "Bill text (LD 2143)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0861&item=1&snum=132", "item": 1}, {"label": "Amendment H-A (H-895)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0861&item=4&snum=132", "item": 4}], "amendments": [{"id": "H-A (H-895)", "description": null, "sponsor": "Representative Gere", "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0861&item=4&snum=132", "fiscal_note_url": "https://legislature.maine.gov/le