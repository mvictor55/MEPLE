{"ld": 853, "paper": "HP539", "session": "132", "title": "An Act to Replace the Minimum Hourly Wage with a Regionally Based Living Wage", "sponsor_id": "h-geiger-valli", "cosponsor_ids": ["h-beck-matthew", "h-macias-rafael", "h-roeder-amy", "s-tipping-michael", "h-warren-sophia"], "committee_code": "LAB", "committee_name": "Labor", "summary": {"text": "This bill replaces the minimum wage for the State with a regional living wage beginning January 1, 2026, according to data provided by the Massachusetts Institute of Technology, Living Wage Calculator, or its successor organization. The bill divides the State into regions based on counties for the purposes of a regional living wage. The bill provides that, until December 31, 2025, the minimum hourly wage is $14.65, which is the minimum hourly wage as of January 1, 2025.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0539&item=1&snum=132"}, "status": "died", "status_label": "Accepted Report B (ONTP)", "final_disposition": {"label": "Accepted Report B (ONTP)", "date": "2025-05-28", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 853)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0539&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-212)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0539&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-212)", "description": null, "sponsor": null, "status": null, "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0539&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN085302.pdf"}], "committee_actions": [{"date": "2025-04-01", "action": "Work Session Held", "result": null}, {"date": "2025-04-01", "action": "Voted", "result": "Divided Report"}, {"date": "2025-05-19", "action": "Reported Out", "result": "OTP-AM