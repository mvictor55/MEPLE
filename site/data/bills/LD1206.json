{"ld": 1206, "paper": "SP495", "session": "132", "title": "An Act to Control Property Taxes by Increasing the Percentage of the Business Equipment Tax Exemption That Municipalities May Recover", "sponsor_id": "s-tepler-denise", "cosponsor_ids": ["h-ducharme-john", "s-duson-jill", "h-roeder-amy", "s-rotundo-margaret", "s-talbot-ross-rachel", "s-tipping-michael"], "committee_code": "TAX", "committee_name": "Taxation", "summary": {"text": "This bill amends provisions governing the business equipment tax exemption. Current law allows municipalities to recover from the State 50% of the tax revenue lost as the result of a valid business equipment tax exemption. The bill increases the percentage that a municipality may recover for property tax years beginning April 1, 2026 to 60%. Under the bill, the percentage recoverable increases each property tax year until the percentage recoverable is 80% for property tax years beginning on or after April 1, 2030.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0495&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2025-06-09", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN120601.pdf", "documents": [{"label": "Bill text (LD 1206)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0495&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-311)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0495&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-311)", "description": null, "sponsor": null, "status": null, "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0495&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN1206