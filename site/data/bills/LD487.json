{"ld": 487, "paper": "HP316", "session": "132", "title": "Resolve, Directing the Northern New England Passenger Rail Authority to Apply for Federal Funding for the Purpose of Identifying the Rail Corridor Connecting Portland to Orono as an Intercity Passenger Rail Corridor (EMERGENCY)", "sponsor_id": "h-hasenfus-tavis", "cosponsor_ids": ["s-baldacci-joseph", "h-bishop-steven", "s-cyrway-scott", "h-ducharme-john", "h-fredette-kenneth", "s-hickman-craig", "h-montell-karen", "h-moonen-matthew", "h-sayre-daniel"], "committee_code": "TRA", "committee_name": "Transportation", "summary": {"text": "This resolve directs the Northern New England Passenger Rail Authority to apply for funding through the federal corridor identification and development program for the purpose of identifying the rail corridor that extends from Portland through Auburn, Lewiston, Waterville and Bangor to Orono, with other station locations determined to be appropriate, as an intercity passenger rail corridor. The Northern New England Passenger Rail Authority is directed to apply for this funding during the 2025 application period.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0316&item=1&snum=132"}, "status": "died", "status_label": "Died Between Houses", "final_disposition": {"label": "Died Between Houses", "date": "2025-05-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 487)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0316&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-117)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0316&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-117)", "description": "Emergency", "sponsor": null, "status": null, "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0316&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legi