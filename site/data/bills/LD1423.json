{"ld": 1423, "paper": "SP579", "session": "132", "title": "An Act to Improve Recycling by Updating the Stewardship Program for Packaging", "sponsor_id": "s-baldacci-joseph", "cosponsor_ids": [], "committee_code": "ENR", "committee_name": "Environment and Natural Resources", "summary": {"text": "This bill amends the laws governing the State's stewardship program for packaging to exclude certain commercial, cosmetic, medical, environmental, dangerous, hazardous or flammable product packaging and packaging of products related to public health and water quality testing from the requirements of the program and updates the definition of \"toxicity\" for purposes of the program. The bill requires the Department of Environmental Protection to adopt a process to approve a producer payment system under the program. It also updates the definition of \"producer\" to add clarification regarding packaging of certain products sold at physical retail locations in the State and via the Internet, remote sale or remote distribution.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0579&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-20", "governor_action": "Signed", "governor_action_date": "2025-06-20"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1423)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0579&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-419)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0579&item=2&snum=132", "item": 2}, {"label": "Amendment C-B (S-420)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0579&item=3&snum=132", "item": 3}], "amendments": [{"id": "C-A (S-419)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0579&item=2