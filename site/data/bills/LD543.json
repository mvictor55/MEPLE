{"ld": 543, "paper": "HP362", "session": "132", "title": "An Act to Enhance Maine's Wildlife Conservation Efforts and Preserve Maine's Sporting Heritage by Requiring Hunter Safety Education in Schools", "sponsor_id": "h-ardell-donald", "cosponsor_ids": ["s-bernard-susan", "h-daigle-lucien", "s-harrington-matthew", "h-nutting-robert", "h-paul-reagan", "h-perkins-chad", "h-swallow-gregory", "h-thorne-james"], "committee_code": "EDU", "committee_name": "Education and Cultural Affairs", "summary": {"text": "This bill adds a requirement that the elements of a firearm hunter safety course must be taught no later than grade 9 in all public and private schools in Maine. Successful completion of the course will result in the issuance to the student of a hunter safety certificate that satisfies the safety course requirement for obtaining an adult hunting license in Maine.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0362&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-03-20", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 543)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0362&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-03-05", "action": "Work Session Held", "result": null}, {"date": "2025-03-05", "action": "Voted", "result": "Divided Report"}, {"date": "2025-03-17", "action": "Work Session Reconsidered", "result": null}, {"date": "2025-03-17", "action": "Voted", "result": "ONTP"}, {"date": "2025-03-19", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "20