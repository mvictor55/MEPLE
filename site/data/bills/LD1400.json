{"ld": 1400, "paper": "HP922", "session": "132", "title": "An Act to Exempt Certain Public School Districts and Their Employees from the Paid Family and Medical Leave Benefits Program", "sponsor_id": "h-carlow-nathan", "cosponsor_ids": ["h-haggan-kimberly", "h-morris-joshua"], "committee_code": "LAB", "committee_name": "Labor", "summary": {"text": "This bill provides that a school district is exempt from the paid family and medical leave benefits program if the school district:\n\n1. Provided family leave and medical leave benefits substantially equivalent to those provided in the paid family and medical leave benefits program pursuant to a collective bargaining agreement in effect on January 1, 2025; and 2. Continually maintains substantially equivalent paid family leave and medical leave benefits for employees pursuant to a collective bargaining agreement or other contractual agreement, including benefits for sick leave and family sick leave, that accrue annually to at least 12 weeks of leave.\n\nIt also requires the Department of Labor to refund contributions made to the department by a school district before the school district was exempt from the paid family and medical leave benefits program. It requires a school district employer that deducted a portion of the premium to the employee as part of the employee's wage to remit that portion of the premium to the employee as part of the employee's wage.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0922&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2025-06-05", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN140002.pdf", "documents": [{"label": "Bill text (LD 1400)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0922&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-505)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0922&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-505)", "description": "Change Title", "sponsor": null, "status": null, "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0922&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN140002.pdf"}], "committee_actions": [{"date": "2025-05-07", "action": "Work Session Held", "result": null}, {"date": "2025-05-07", "action": "Voted", "result": "Divided Report"}, {"date": "2025-06-04", "action": "Reported Out", "result": "ONTP/OTP-AM"}], "committee_reports": [{"label": "Majority report", "recommendation": "Ought Not To Pass", "signer_count": 8, "signers": ["Senator Michael Tipping (Chair)", "Representative Marshall Archer", "Representative Matthew Beck", "Representative Valli Geiger", "Representative Rafael Macias", "Senator Joseph Rafferty", "Representative Amy Roeder", "Representative Charles Skold"], "signer_ids": ["s-tipping-michael", "h-archer-marshall", "h-beck-matthew", "h-geiger-valli", "h-macias-rafael", "s-rafferty-joseph", "h-roeder-amy", "h-skold-charles"]}, {"label": "Minority report", "recommendation": "Ought To Pass As Amended", "signer_count": 5, "signers": ["Senator Dick Bradstreet", "Representative Alicia Collins", "Representative Gary Drinkwater", "Representative Laurel Libby", "Representative Mike Soboleski"], "signer_ids": ["s-bradstreet-richard", "h-collins-alicia", "h-drinkwater-gary", "h-libby-laurel", "h-soboleski-michael"]}], "chamber_actions": [{"date": "2025-04-01", "chamber": "House", "action": "Committee on Labor suggested and ordered printed."}, {"date": "2025-04-01", "chamber": "House", "action": "The Bill was REFERRED to the Committee on LABOR."}, {"date": "2025-04-01", "chamber": "House", "action": "Sent for concurrence. ORDERED SENT FORTHWITH."},