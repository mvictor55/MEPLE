{"ld": 1783, "paper": "HP1194", "session": "132", "title": "An Act to Clarify Municipal Affordable Housing Tax Increment Financing", "sponsor_id": "h-salisbury-suzanne", "cosponsor_ids": ["h-friedmann-gary", "h-mastraccio-anne-marie", "h-matlack-ann", "h-murphy-kelly", "h-rollins-david"], "committee_code": "TAX", "committee_name": "Taxation", "summary": {"text": "This bill makes changes to the laws governing municipal affordable housing development districts, including the following.\n\n1. It amends the law regarding the duration of affordable housing development programs.\n\n2. It changes the costs related to public safety improvements that are considered authorized project costs.\n\n3. It provides for the retention or return of tax increment revenues remaining in an affordable housing development fund on the date a development district ends. 4. It authorizes a legislative body of a municipality to delegate to a municipal officer a reporting requirement.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1194&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-10", "governor_action": "Signed", "governor_action_date": "2025-06-10"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1783)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1194&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-409)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1194&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-409)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1194&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN178302.pdf"}], "committee_actions": [{"date": "2025-05-13", "action": "Work Session Held", "result":