{"ld": 1167, "paper": "HP772", "session": "132", "title": "Resolve, to Create a Pilot Program to Assist Nonprofit Housing Developers in Rehabilitating Existing Aging Housing Stock for First-time Home Buyers", "sponsor_id": "h-mccabe-julia", "cosponsor_ids": ["h-abdi-mana", "h-bell-arthur", "h-cloutier-kristen", "h-debrito-flavia", "h-geiger-valli", "s-rotundo-margaret", "h-shagoury-daniel"], "committee_code": "HED", "committee_name": "Housing and Economic Development", "summary": {"text": "This resolve directs the Maine State Housing Authority to create a pilot program to provide nonprofit housing developers grants of up to $80,000 per unit to rehabilitate existing aging housing stock for purchase by first-time home buyers who will occupy the unit and whose income does not exceed 120% of the area's median income and who agree to relinquish a graduated percentage of profit if they sell the unit within the first 3 years of ownership.\n\nThe resolve also provides $1,200,000 to fund the pilot program.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0772&item=1&snum=132"}, "status": "died", "status_label": "Died On Adjournment", "final_disposition": {"label": "Died On Adjournment", "date": "2026-04-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN116701.pdf", "documents": [{"label": "Bill text (LD 1167)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0772&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-492)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0772&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-492)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0772&item=2&snum=132", "fiscal_note_url": "https://legislature.