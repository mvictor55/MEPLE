{"ld": 369, "paper": "SP161", "session": "132", "title": "An Act to Grant or Extend Conditional Teaching Certificates Under Certain Circumstances", "sponsor_id": "s-libby-james", "cosponsor_ids": ["h-bagshaw-barbara", "h-carlow-nathan", "h-haggan-kimberly", "h-lyman-sheila"], "committee_code": "EDU", "committee_name": "Education and Cultural Affairs", "summary": {"text": "This bill allows the Commissioner of Education to grant an extension of a conditional teaching certificate in the case of extenuating circumstances. The request for an extension must be accompanied by supporting documentation of the circumstances. The bill also allows the commissioner to issue a conditional certificate to an individual who has been employed as a full-time professor at a college or university in the State for at least 5 years and prohibits the Commissioner of Public Safety from assessing a fee for fingerprinting such an applicant.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0161&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2025-06-03", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 369)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0161&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-222)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0161&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-222)", "description": null, "sponsor": null, "status": null, "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0161&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN036902.pdf"}], "committee_actions": [{"date": "2025-03-19", "action": "Work Session Held", "result": "TABLED"}, {"date": "2025-05-16", "ac