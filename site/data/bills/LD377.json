{"ld": 377, "paper": "SP133", "session": "132", "title": "An Act to Establish a University of Maine Medical School and to Dedicate Funds from Raising the Cigarette Tax to the School", "sponsor_id": "s-baldacci-joseph", "cosponsor_ids": ["h-rana-ambureen", "s-tipping-michael"], "committee_code": "EDU", "committee_name": "Education and Cultural Affairs", "summary": {"text": "This bill requires the University of Maine System to locate, construct, equip and operate a college of medicine in Penobscot County. The college of medicine must include a rural health care course of study and clinic outreach to Aroostook, Penobscot, Piscatiquis, Washington, Waldo, Hancock and Somerset counties. The bill also increases the rate of tax on cigarettes and credits that increase to the University of Maine System for the location, construction, equipping and operation of a college of medicine. It also provides an effective date of July 1, 2026 for the provisions regarding the increased tax and its use.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0133&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-03-18", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 377)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0133&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-03-10", "action": "Work Session Held", "result": null}, {"date": "2025-03-10", "action": "Voted", "result": "ONTP"}, {"date": "2025-03-17", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-02-04", "chamber": "Senat