{"ld": 278, "paper": "SP128", "session": "132", "title": "An Act to Eliminate the Tobacco Products Tax on Certain Products That Contain Nicotine", "sponsor_id": "s-harrington-matthew", "cosponsor_ids": ["h-ducharme-john", "h-libby-laurel", "s-martin-joseph", "h-morris-joshua", "s-timberlake-jeffrey"], "committee_code": "TAX", "committee_name": "Taxation", "summary": {"text": "This bill modifies the tobacco products tax by eliminating the tax imposed on certain products that contain nicotine but not tobacco.\n\nCurrent law provides a general definition for \"tobacco products\" as well as a list of specific types of products that are included in that definition. This bill modifies the general definition to remove language that would allow products that contain either natural or artificial nicotine, but not tobacco, to be taxable. The bill does not alter the list of specific products that are taxable, including electronic smoking devices, whether or not they contain nicotine.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0128&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2025-05-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 278)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0128&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-136)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0128&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-136)", "description": null, "sponsor": null, "status": null, "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0128&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN027802.pdf"}], "committee_actions": [{"date": "2025-02-26", "action": "Work Session Held", "result": null}, {"date": "2025-02-26", "action": "Voted", "result": "Divided Report"}, {"date": "2025-05-22", "action": "Reported Out", "result": "ONTP/OTP-AM"}], "committee_reports": [{"label": "Majority report", "recommendation": "Ought Not To Pass", "signer_count": 7, "signers": ["Senator Nicole Grohoski (Chair)", "Representative Dan Sayre (Chair)", "Representative Kristen Cloutier", "Representative Ed Crockett", "Representative Gary Friedmann", "Representative Ann Matlack", "Senator Michael Tipping"], "signer_ids": ["s-grohoski-nicole", "h-sayre-daniel", "h-cloutier-kristen", "h-crockett-edward", "h-friedmann-gary", "h-matlack-ann", "s-tipping-michael"]}, {"label": "Minority report", "recommendation": "Ought To Pass As Amended", "signer_count": 5, "signers": ["Senator Bruce Bickford", "Representative Tracy Quint", "Representative Shelley Rudnicki", "Representative Gregg Swallow", "Representative Russell White"], "signer_ids": ["s-bickford-bruce", "h-quint-tracy", "h-rudnicki-shelley", "h-swallow-gregory", "h-white-russell"]}], "chamber_actions": [{"date": "2025-01-28", "chamber": "Senate", "action": "Committee on TAXATION suggested and ordered printed REFERENCE to the Committee on TAXATION Ordered sent down forthwith for concurrence"}, {"date": "2025-01-28", "chamber": "House", "action": "The Bill was REFERRED to the Committee on TAXATION."}, {"date": "2025-01-28", "chamber": "House", "action": "In concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-03-21", "chamber": "Senate", "action": "CARRIED OVER, in the same posture, to the next special or regular session of the 132nd Legislature, pursuant to Joint Order SP 519."}, {"date": "2025-05-28", "chamber": "Senate", "action": "Reports READ"}, {"date": "2025-05-28", "chamber": "Senate", "action": "On motion by Senator TIPPING of Penobscot The Majority Ought Not To Pass Report ACCEPTED. PREVAILED."}, {"date": "2025-05-28", "chamber": "Senate", "action": "Roll Call Ordered Roll Call Number 251 Y