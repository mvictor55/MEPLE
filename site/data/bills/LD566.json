{"ld": 566, "paper": "SP246", "session": "132", "title": "An Act to Modernize the Motor Vehicle Inspection Program and Amend the Law Governing Inspection Fees", "sponsor_id": "s-farrin-bradlee", "cosponsor_ids": ["h-ankeles-daniel", "h-crafts-lydia", "h-ducharme-john"], "committee_code": "TRA", "committee_name": "Transportation", "summary": {"text": "This bill authorizes the Chief of the State Police to require the use of an electronic inspection program for the purpose of performing motor vehicle inspections. It also authorizes an inspection station to charge a $20 fee for inspection regardless of the model year of the inspected vehicle and provides that an operator of an official school bus inspection station is entitled to a fee of $20 for each school bus inspected.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0246&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2026-01-20", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 566)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0246&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-08", "action": "Work Session Held", "result": null}, {"date": "2025-05-08", "action": "Voted", "result": "Divided Report"}, {"date": "2025-05-15", "action": "Work Session Reconsidered", "result": "TABLED"}, {"date": "2025-05-16", "action": "Carry Over Requested", "result": null}, {"date": "2025-05-19", "action": "Carry Over Approved", "result": null}, {"date": "2026-01-08", "action": "Work Session Held", "result": null}, {"date": "2026-01-08", "action": "Voted", "result": "ONTP"}, {"date": "2026-01-13", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report",