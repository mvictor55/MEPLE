{"ld": 44, "paper": "HP8", "session": "132", "title": "An Act to Amend the Laws Pertaining to Elver Fishing", "sponsor_id": "h-hepler-allison", "cosponsor_ids": [], "committee_code": "MAR", "committee_name": "Marine Resources", "summary": {"text": "This bill amends several laws pertaining to elver fishing. It amends the mandatory license suspension for selling elvers without using an elver transaction card from permanent for the first offense to 3 years for the first offense and permanent for a 2nd offense. It allows the holder of an elver fishing license to have another license holder empty the fyke net when under the direct supervision of the license holder whose tag is on the net. It prohibits elver harvesters from holding elvers for longer than 6 hours and from holding elvers within a residential dwelling. Violation of these provisions is a Class E crime. The bill also changes the date the elver fishing lottery is held from February 15th to March 15th.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0008&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-10", "governor_action": "Signed", "governor_action_date": "2025-06-10"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 44)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0008&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-344)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0008&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-344)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0008&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN004402.pdf"}], "committee_actions": [{"date": "2025-03-13", "action": "Work Session Held", "result": 