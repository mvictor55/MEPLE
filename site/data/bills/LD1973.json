{"ld": 1973, "paper": "HP1317", "session": "132", "title": "Resolve, to Establish the Commission to Study Oversight and Funding Structures for Recovery Residences and Resident Protections (EMERGENCY)", "sponsor_id": "h-rollins-david", "cosponsor_ids": ["h-collins-alicia", "h-dhalac-deqa", "h-hasenfus-tavis", "h-milliken-nina", "s-moore-marianne", "s-reny-cameron", "h-sayre-daniel", "s-talbot-ross-rachel"], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This resolve establishes the Commission to Study Oversight and Funding Structures for Recovery Residences and Resident Protections. The commission is required to evaluate various policies and industry standards and make policy recommendations with respect to the following: the use of general assistance and the possible expansion or development of new state-funded subsidy programs for use at a recovery residence; alternative models of oversight structure for recovery residences, including voluntary certification, mandatory certification or licensure; and policies related to the use of prescribed medications in recovery residences.\n\nThe commission is composed of 15 members, including Legislators, the Commissioner of Health and Human Services or the commissioner's designee, the Director of the Office of Policy Innovation and the Future or the director's designee and various other members who have experience with recovery residences, advocating for individuals with substance use disorder or expertise in tenant rights or housing protections for persons with disabilities or substance use disorder.\n\nNo later than December 3, 2025, the commission is required to submit to the Joint Standing Committee on Health and Human Services a report that includes the commission's findings and recommendations, including any suggested legislation. The committee may report out a bill related to the report to the Second Regular Session of the 132nd Legislature.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1317&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-27", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1973)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1317&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-21", "action": "Work Session Held", "result": null}, {"date": "2025-05-21", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-23", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-05-13", "chamber": "House", "action": "Committee on Health and Human Services suggested and ordered printed."}, {"date": "2025-05-13", "chamber": "House", "action": "The Resolve was REFERRED to the Committee on HEALTH AND HUMAN SERVICES."}, {"date": "2025-05-13", "chamber": "House", "action": "Sent for concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-05-13", "chamber": "Senate", "action": "The Bill was REFERRED to the Committee on HEALTH AND HUMAN SERVICES  in concurrence"}, {"date": "2025-05-27", "chamber": "Senate", "action": "Pursuant to Joint Rule 310.3 Placed in Legislative Files (DEAD)"}], "roll_calls": [], "hearing": {"date": "2025-05-19", "time": "1:31 PM", "location": "Cross Building, Room 209", "committee_code": "HHS", "testimony_count": 10}, "heard_with": [], "tags": ["Substance Use Disorder", "Treatment"], "affected_statutes": [], "testimony": [{"id": "10056447", "name": "Amanda Campbell", "organization": "Maine Municipal Association", "town": null, "position": "neutral", "position_source": "inferred", "date": "2025-0