{"ld": 413, "paper": "HP267", "session": "132", "title": "An Act Regarding Disclosure by Sellers of Residential Real Property of Notices of Shoreland Zoning Ordinance Violations", "sponsor_id": "h-ducharme-john", "cosponsor_ids": ["h-arata-amy", "s-bernard-susan", "h-blier-mark", "h-cray-dean", "h-poirier-jennifer"], "committee_code": "HED", "committee_name": "Housing and Economic Development", "summary": {"text": "Under current law, a seller of residential real property must provide to a purchaser a property disclosure statement that includes, among other things, information regarding actual or alleged violations of shoreland zoning ordinances imposed on and applicable to the property. This bill removes the reference in that law to alleged shoreland zoning violations but otherwise maintains the disclosure requirement for actual shoreland zoning violations.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0267&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-05-13", "governor_action": "Unsigned", "governor_action_date": "2025-05-13"}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 413)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0267&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-67)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0267&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-67)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0267&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN041302.pdf"}], "committee_actions": [{"date": "2025-03-06", "action": "Work Session Held", "result": null}, {"date": "2025-03-06", "action": "Voted", "result": "OTP-AM"}, {"date": "2025-04-22", "action": "R