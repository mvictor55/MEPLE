{"ld": 980, "paper": "SP399", "session": "132", "title": "Resolve, to Create the Commission to Improve the Oversight of the Long-term Care System", "sponsor_id": "s-tepler-denise", "cosponsor_ids": ["h-arford-poppy", "s-bailey-donna", "h-foley-robert", "s-ingwersen-henry", "s-moore-marianne", "s-reny-cameron", "h-shagoury-daniel"], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This resolve creates the Commission to Improve the Oversight of the Long-term Care System to study and make recommendations on the current status of and improvements to long-term care facilities and the long-term care industry in the State. The resolve requires the commission to submit a report of its findings and recommendations to the Joint Standing Committee on Health and Human Services by March 1, 2026 and authorizes the joint standing committee to submit legislation based on the findings and recommendations in the report to the Second Regular Session of the 132nd Legislature.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0399&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-04-08", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 980)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0399&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-02", "action": "Work Session Held", "result": null}, {"date": "2025-04-02", "action": "Voted", "result": "ONTP"}, {"date": "2025-04-07", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-03-11", "chamber": "Senate", "action": "Committee on HEALTH AND HUMAN SERVICES suggested and ordered printed REFERENCE to the Committee on HEALTH AND HUMAN SERVICES Ordered sent down forthwith for concurrence"}, {"date": "2025-03-11", "chamber": "House", "action": "The Resolve was REFERRED to the Committee on HEALTH AND HUMAN SERVICES."}, {"date": "2025-03-11", "chamber": "House", "action": "In concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-03-21", "chamber": "Senate", "action": "CARRIED OVER, in the same posture, to the next special or regular session of the 132nd Legislature, pursuant to Joint Order SP 519."}, {"date": "2025-04-08", "chamber": "Senate", "action": "Pursuant to Joint Rule 310.3 Placed in Legislative Files (DEAD)"}], "roll_calls": [], "hearing": {"date": "2025-03-28", "time": "10:00 AM", "location": "Cross Building, Room 209", "committee_code": "HHS", "testimony_count": 10}, "heard_with": [], "tags": ["Health Care Facilities", "Long-term Care Facilities"], "affected_statutes": [], "testimony": [{"id": "187644", "name": "Angela Westhoff", "organization": "Maine Health Care Association", "town": null, "position": "neutral", "position_source": "inferred", "date": "2025-03-28", "hearing_date": "2025-03-28", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=187644", "has_text": true, "shared_with": [], "person_profile_id": null, "org_profile_id": "org-maine-health-care-association"}, {"id": "10039251", "name": "Brenda Peluso", "organization": "Maine's Essential Care & Support Workforce Partnership", "town": null, "position": "neutral", "position_source": "inferred", "date": "2025-03-28", "hearing_date": "2025-03-28", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=10039251", "has_text": true, "shared_with": [], "person_profile_id": null, "org_profile_id": "org-maines-essential-care-and-support-workforce-partnership"}, {"id": "187646", "name": "Denise Tepler", "organization": "Maine State Legislature", "to