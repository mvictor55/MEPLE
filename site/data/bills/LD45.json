{"ld": 45, "paper": "HP9", "session": "132", "title": "An Act Allowing the Department of Corrections to Offset Some of the Costs of Technology Provided to Residents of Correctional Facilities", "sponsor_id": "h-lee-adam", "cosponsor_ids": [], "committee_code": "CJPS", "committee_name": "Criminal Justice and Public Safety", "summary": {"text": "This bill allows the Commissioner of Corrections to establish a fee for the use of technology by residents of correctional facilities, subject to exceptions as provided in the bill. Any technology fees collected must be deposited into the Resident Technology Fund, a nonlapsing fund established by the bill within the Department of Corrections. Funds may be used to offset the cost of buying and maintaining technology provided to residents of correctional facilities.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0009&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-18", "governor_action": "Signed", "governor_action_date": "2025-06-18"}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 45)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0009&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-646)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0009&item=2&snum=132", "item": 2}, {"label": "Amendment C-B (H-647)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0009&item=3&snum=132", "item": 3}], "amendments": [{"id": "C-A (H-646)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0009&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN004502.pdf"}, {"id": "C-B (H-647)", "description": null, "sponsor": null, "status": null, "url": "https://legislature.maine