{"ld": 1035, "paper": "HP664", "session": "132", "title": "Resolve, to Study the Safe Disposal of Single-use Propane Canisters", "sponsor_id": "h-rana-ambureen", "cosponsor_ids": ["h-ankeles-daniel", "s-baldacci-joseph", "h-bell-arthur", "s-grohoski-nicole", "h-kessler-christopher", "h-osher-laurie"], "committee_code": "ENR", "committee_name": "Environment and Natural Resources", "summary": {"text": "This resolve directs the Department of Environmental Protection to study the current infrastructure for the disposal of single-use propane canisters and make recommendations regarding improvements to allow residents of the State to safely dispose of used canisters and directs the department to perform research on the viability of implementing a statewide ban on propane canisters that are not manufactured to be refillable. The department is directed to submit a report by December 3, 2025 to the Joint Standing Committee on Environment and Natural Resources, which may report out legislation to the Second Regular Session of the 132nd Legislature.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0664&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-04-08", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 1035)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0664&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-02", "action": "Work Session Held", "result": null}, {"date": "2025-04-02", "action": "Voted", "result": "ONTP"}, {"date": "2025-04-03", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "