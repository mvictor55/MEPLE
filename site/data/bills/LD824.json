{"ld": 824, "paper": "SP342", "session": "132", "title": "An Act Regarding Pet Fees in Rental Housing", "sponsor_id": "s-bailey-donna", "cosponsor_ids": ["s-carney-anne", "h-doudera-victoria", "h-roberts-lovell-tiffany", "h-roeder-amy", "h-shagoury-daniel", "h-skold-charles", "h-white-russell"], "committee_code": "HED", "committee_name": "Housing and Economic Development", "summary": {"text": "This bill prohibits a landlord, agent, contractor, designee or other entity from charging or collecting a fee as a condition of keeping a pet within a rented dwelling unit, except that a fee for pet rent not to exceed 1% of the monthly rental charge and a pet security deposit not to exceed $300 may be charged. The bill also prohibits a landlord, agent, contractor, designee or other entity from charging or collecting a fee for a service animal or an assistance animal.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0342&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-04-30", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 824)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0342&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-15", "action": "Work Session Held", "result": null}, {"date": "2025-04-15", "action": "Voted", "result": "ONTP"}, {"date": "2025-04-29", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-03-04", "chamber": "Senate", "action": "Committee on JUDICIARY suggested and ordered printed"}, {"date": "2025-03-04", "chamber": "Senate", "action": "On motion by Senator CARNEY of Cumberland REFERENCE to the Committee on HOUSING AND ECONOMIC DEVELOPMENT Ordered sent down forthwith for concurrence"}, {"date": "2025-03-04", "chamber": "House", "action": "The Bill was REFERRED to the Committee on HOUSING AND ECONOMIC DEVELOPMENT."}, {"date": "2025-03-04", "chamber": "House", "action": "In concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-03-21", "chamber": "Senate", "action": "CARRIED OVER, in the same posture, to the next special or regular session of the 132nd Legislature, pursuant to Joint Order SP 519."}, {"date": "2025-04-15", "chamber": "J", "action": "Work Session Held"}, {"date": "2025-04-15", "chamber": "J", "action": "Voted: ONTP"}, {"date": "2025-04-29", "chamber": "J", "action": "Reported Out: ONTP"}, {"date": "2025-04-30", "chamber": "Senate", "action": "Pursuant to Joint Rule 310.3 Placed in Legislative Files (DEAD)"}], "roll_calls": [], "hearing": {"date": "2025-03-25", "time": "1:15 PM", "location": "Cross Building, Room 206", "committee_code": "HED", "testimony_count": 11}, "heard_with": [], "tags": ["Housing", "Rental Housing"], "affected_statutes": [], "testimony": [{"id": "186699", "name": "Amy Arata", "organization": "Maine State Legislature", "town": null, "position": "oppose", "position_source": "inferred", "date": "2025-03-25", "hearing_date": "2025-03-25", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=186699", "has_text": true, "shared_with": []}, {"id": "10038288", "name": "Amy Racine", "organization": "MREMA", "town": null, "position": "oppose", "position_source": "inferred", "date": "2025-03-25", "hearing_date": "2025-03-25", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=10038288", "has_text": true, "shared_with": []}, {"id": "10039008", "name": "Andy Cashman", "organization": "Maine Association of REALTORSÂ®", "town": null, "position": "oppose", "position_source": "inferred", "date": "2025-03-25", "hearing_date": "2025-03-25", "url":