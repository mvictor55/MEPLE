{"ld": 947, "paper": "HP612", "session": "132", "title": "An Act to Clarify Overnight Docking at Mainland Ports for Certain Island Ferry Vessels", "sponsor_id": "h-matlack-ann", "cosponsor_ids": ["s-beebe-center-anne", "h-eaton-holly", "h-geiger-valli", "h-ray-d"], "committee_code": "TRA", "committee_name": "Transportation", "summary": {"text": "This bill requires the Department of Transportation to allow a ferry operated by the Maine State Ferry Service to dock overnight at its island port or to dock at a mainland port when that docking is common practice, with the exception that the department may require a ferry vessel to dock at a mainland port or at an alternative island port for an emergency situation, including, but not limited to, an extreme weather event.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0612&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-22", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 947)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0612&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-15", "action": "Work Session Held", "result": null}, {"date": "2025-05-15", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-20", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-03-05", "chamber": "House", "action": "Received by the Clerk of the House on March 5, 2025."}, {"date": "2025-03-05", "chamber": "House", "action": "The Bill was REFERRED to the Committee on TRANSPORTATION pursuant to Joint Rule 308.2 and ordere