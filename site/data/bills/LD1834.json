{"ld": 1834, "paper": "SP716", "session": "132", "title": "An Act to Clarify the Availability of Alternative Claims Payment Methods to Dental Care Providers (TITLE CHANGE)", "sponsor_id": "s-baldacci-joseph", "cosponsor_ids": [], "committee_code": "HCIFS", "committee_name": "Health Coverage, Insurance and Financial Services", "summary": {"text": "This bill allows insurers of individual and group health insurance policies, health maintenance organizations and insurance carriers to pay claims for reimbursement to dental care providers by credit card, automated clearing house network or other similar electronic payment methods that charge a fee or other similar charge to process the payment if the insurer informs the dental care provider of the fee or similar charge prior to payment, the insurer offers an alternative payment method that does not charge a fee or similar charge and the dental care provider agrees to accept payment by that payment method.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0716&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-12", "governor_action": "Signed", "governor_action_date": "2025-06-12"}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 1834)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0716&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-239)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0716&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-239)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0716&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN183402.pdf"}], "committee_actions": [{"date": "2025-05-15", "action": "Work Session Held", "result": null}, 