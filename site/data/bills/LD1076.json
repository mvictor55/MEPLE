{"ld": 1076, "paper": "HP698", "session": "132", "title": "An Act to Hire School Security Officers to Protect Students and Make Schools Safer", "sponsor_id": "h-perkins-chad", "cosponsor_ids": ["h-ardell-donald", "h-babin-mark", "s-cyrway-scott", "s-guerin-stacey", "s-harrington-matthew", "h-mcintyre-mathew", "h-mingo-arthur", "h-nutting-robert", "h-paul-reagan"], "committee_code": "EDU", "committee_name": "Education and Cultural Affairs", "summary": {"text": "This bill creates a program, similar to the judicial marshal program, that allows municipal police departments and county sheriff's offices to hire personnel specifically as school security officers. These officers must be trained by the Maine Criminal Justice Academy and must be certified as part-time law enforcement officers under the preservice training program.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0698&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-04-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 1076)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0698&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-23", "action": "Work Session Held", "result": null}, {"date": "2025-04-23", "action": "Voted", "result": "ONTP"}, {"date": "2025-04-28", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-03-14", "chamber": "House", "action": "Received by the Clerk of the House on March 14, 2025."}, {"date": "2025-03-14", "chamber": "House", "action": "The Bill was REFERRED to the Committee