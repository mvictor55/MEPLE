{"ld": 1768, "paper": "SP686", "session": "132", "title": "An Act to Protect Residents of Mobile Home Parks by Amending the Real Estate Transfer Tax", "sponsor_id": "s-bailey-donna", "cosponsor_ids": ["s-baldacci-joseph", "s-curry-glenn", "h-gramlich-lori", "s-hickman-craig", "s-nangle-timothy", "s-reny-cameron", "s-talbot-ross-rachel", "s-tipping-michael"], "committee_code": "TAX", "committee_name": "Taxation", "summary": {"text": "This bill treats the real estate transfer tax on the sale of mobile home parks differently than the sale of other real estate. Sales of mobile home parks to the residents of those parks are not subject to the real estate transfer tax. The real estate transfer tax received by the State from buyers of mobile home parks is allocated entirely to the Housing Opportunities for Maine Fund within the Maine State Housing Authority.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0686&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-07-01", "governor_action": "Signed", "governor_action_date": "2025-07-01"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1768)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0686&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-216)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0686&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-216)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0686&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN176802.pdf"}], "committee_actions": [{"date": "2025-05-13", "action": "Work Session Held", "result": null}, {"date": "2025-05-13", "action": "Voted", "result": "Divided Report"}, {"date": "2025-06-02", "act