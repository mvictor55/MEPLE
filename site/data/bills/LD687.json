{"ld": 687, "paper": "SP304", "session": "132", "title": "An Act to Assert State Ownership over Ocean Waters up to 12 Nautical Miles and Submerged Lands and Marine Resources up to 24 Nautical Miles off the State's Coast and to Direct the Attorney General to Study That Ownership", "sponsor_id": "s-martin-joseph", "cosponsor_ids": ["s-beebe-center-anne", "s-cyrway-scott", "h-faulkingham-william", "s-moore-marianne", "h-soboleski-michael"], "committee_code": "MAR", "committee_name": "Marine Resources", "summary": {"text": "This bill is a concept draft pursuant to Joint Rule 208.\n\nThis bill would exert the State's ownership and jurisdiction over all waters within the rise and fall of the tide seaward 12 nautical miles and all submerged lands and the harvesting of marine resources from the coastline for a distance of 24 nautical miles. The bill would also require the Office of the Attorney General to study the legal issues regarding state ownership and sovereignty over marine resources beyond the 12-nautical-mile territorial sea limit.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0304&item=1&snum=132"}, "status": "withdrawn", "status_label": "Automatic Withdrawal Pursuant to Joint Rule 305.6", "final_disposition": {"label": "Automatic Withdrawal Pursuant to Joint Rule 305.6", "date": "2025-03-20", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN068701.pdf", "documents": [{"label": "Bill text (LD 687)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0304&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-03-07", "action": "Reported Out", "result": "AWD"}], "committee_reports": [{"label": "Committee report", "recommendation": "AWD", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-02-20