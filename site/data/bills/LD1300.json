{"ld": 1300, "paper": "SP530", "session": "132", "title": "An Act to Strengthen Maine's Implied Warranty Laws", "sponsor_id": "s-tipping-michael", "cosponsor_ids": ["s-baldacci-joseph", "h-beck-matthew", "s-bickford-bruce", "h-boyer-david", "h-dhalac-deqa", "s-lawrence-mark", "h-macias-rafael", "s-reny-cameron", "h-roeder-amy"], "committee_code": "HCIFS", "committee_name": "Health Coverage, Insurance and Financial Services", "summary": {"text": "This bill requires the Office of the Attorney General to notify online sellers doing business in the State, who remit $10,000 or more in sales tax, of the implied warranty laws. The bill also requires the Attorney General to make available an online complaint form for residents to use if they believe the seller is not adhering to the implied warranty laws.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0530&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-04-23", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 1300)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0530&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-16", "action": "Work Session Held", "result": null}, {"date": "2025-04-16", "action": "Voted", "result": "ONTP"}, {"date": "2025-04-22", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-03-25", "chamber": "Senate", "action": "Committee on HOUSING AND ECONOMIC DEVELOPMENT suggested and ordered printed"}, {"date": "2025-03-25", "chamber": "Senate", "action": "On motion by Senator CURRY of Waldo RE