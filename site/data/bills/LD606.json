{"ld": 606, "paper": "HP374", "session": "132", "title": "Resolve, to Study Barriers to Financial Assistance Programs for Farmers and Food Producers (EMERGENCY)", "sponsor_id": "h-pluecker-william", "cosponsor_ids": [], "committee_code": "ACF", "committee_name": "Agriculture, Conservation and Forestry", "summary": {"text": "This resolve requires the Commissioner of Agriculture, Conservation and Forestry to direct staff of the Bureau of Agriculture, Food and Rural Resources to study the bureau's financial assistance programs for farmers and food producers to identify barriers to these programs and methods to eliminate those barriers and increase the effectiveness of the programs in addressing farmer and food producer needs. The commissioner is required to submit a report by January 15, 2026 to the Joint Standing Committee on Agriculture, Conservation and Forestry, which may report out legislation to the Second Regular Session of the 132nd Legislature.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0374&item=1&snum=132"}, "status": "enacted", "status_label": "Emergency Finally Passed", "final_disposition": {"label": "Emergency Finally Passed", "date": "2025-05-13", "governor_action": "Emergency Unsigned", "governor_action_date": "2025-05-13"}, "fiscal_status": "Not Yet Determined", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN060602.pdf", "documents": [{"label": "Bill text (LD 606)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0374&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-65)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0374&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-65)", "description": "Emergency", "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0374&item=2&snum=132", "fiscal_note_url": "https://legislature.ma