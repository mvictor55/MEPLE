{"ld": 1888, "paper": "HP1259", "session": "132", "title": "Resolve, to Study the Establishment of a New Crime of Racketeering for Drug Offenses and Sex Trafficking (TITLE CHANGE)", "sponsor_id": "h-arata-amy", "cosponsor_ids": ["h-ardell-donald", "s-beebe-center-anne", "h-faulkingham-william", "h-gramlich-lori", "s-harrington-matthew", "h-lee-adam", "h-mcintyre-mathew", "h-poirier-jennifer", "h-stover-holly"], "committee_code": "CJPS", "committee_name": "Criminal Justice and Public Safety", "summary": {"text": "This bill creates the criminal offense of racketeering, which allows for prosecution of individuals who are members of a racketeering enterprise when 2 or more qualifying criminal acts have been committed by members of the criminal enterprise. Qualifying criminal acts include human trafficking, drug trafficking, illicit marijuana cultivation operations, thefts and financial fraud, gambling and violent acts.\n\nThe bill provides a mechanism for assets, including money, wrongfully obtained through a racketeering enterprise to be forfeited by amending the criminal asset forfeiture laws.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1259&item=1&snum=132"}, "status": "died", "status_label": "Died On Adjournment", "final_disposition": {"label": "Died On Adjournment", "date": "2026-04-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 1888)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1259&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-630)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1259&item=2&snum=132", "item": 2}, {"label": "Amendment C-B (H-631)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1259&item=3&snum=132", "item": 3}], "amendments": [{"id": "C-A (H-630)", "description": null, "sponsor": null, "status": "Adopted by House & Senate