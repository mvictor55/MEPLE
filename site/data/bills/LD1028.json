{"ld": 1028, "paper": "SP446", "session": "132", "title": "Resolve, to Establish the Task Force to Study Equitable Access to Maternal Health Care and Birthing Facilities", "sponsor_id": "s-talbot-ross-rachel", "cosponsor_ids": ["h-arata-amy", "h-boyer-michelle", "s-brenner-stacy", "s-carney-anne", "h-daigle-lucien", "s-ingwersen-henry", "h-javner-kathy", "s-moore-marianne", "h-zager-samuel"], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This resolve establishes the Task Force to Study Equitable Access to Maternal Health Care and Birthing Facilities, which is directed to study past closures of maternal health care centers in the State, the current availability of access to maternal health care services in the State and methods to increase patient access to maternal health care services, including equitable access for vulnerable populations. The task force is required to submit a report and suggested legislation by January 6, 2026 to the Joint Standing Committee on Health and Human Services, which is authorized to report out legislation based on the report to the Second Regular Session of the 132nd Legislature.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0446&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-04-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1028)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0446&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-15", "action": "Work Session Held", "result": null}, {"date": "2025-04-15", "action": "Voted", "result": "ONTP"}, {"date": "2025-04-23", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"lab