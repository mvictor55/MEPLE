{"ld": 998, "paper": "HP645", "session": "132", "title": "An Act Regarding an Employer's Authority to Prohibit an Employee from Storing a Firearm in the Employee's Vehicle", "sponsor_id": "h-collins-alicia", "cosponsor_ids": ["s-bradstreet-richard", "h-daigle-lucien", "h-drinkwater-gary", "h-flynn-paul", "s-haggan-david", "h-haggan-kimberly", "s-moore-marianne", "h-poirier-jennifer", "h-smith-katrina", "h-tuell-william"], "committee_code": "JUD", "committee_name": "Judiciary", "summary": {"text": "This bill modifies the provision of law governing an employer's authority to prohibit an employee from storing a firearm in the employee's vehicle. The current law states that an employer is not permitted to prohibit an employee from storing a firearm in the employee's vehicle if the employee has a valid permit to carry a concealed firearm under the Maine Revised Statutes, Title 25, chapter 252, as long as the vehicle is locked and the firearm is stored out of sight. The bill removes the specification that the employee must have a valid permit to carry a concealed firearm.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0645&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2025-06-12", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 998)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0645&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-03", "action": "Work Session Held", "result": null}, {"date": "2025-04-03", "action": "Voted", "result": "Divided Report"}, {"date": "2025-06-11", "action": "Reported Out", "result": "ONTP/OTP"}], "committee_reports": [{"label": "Majority report", "recommendation": "Ought Not To Pass", "signer_count": 11, "signers": ["Senator Ann