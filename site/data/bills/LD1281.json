{"ld": 1281, "paper": "SP509", "session": "132", "title": "An Act to Address the Safety of Nurses and Improve Patient Care by Enacting the Maine Quality Care Act", "sponsor_id": "s-brenner-stacy", "cosponsor_ids": ["h-beck-matthew", "s-larsen-daughtry-matthea", "h-friedmann-gary", "h-geiger-valli", "h-roeder-amy", "h-webb-kilton"], "committee_code": null, "committee_name": null, "summary": {"text": "This bill establishes the Maine Quality Care Act to ensure adequate direct care registered nurse staffing assignments in health care facilities, including hospitals, freestanding emergency departments and ambulatory surgical facilities, and critical access hospitals to provide safe and effective patient care. It establishes minimum staffing requirements for direct care registered nurses based on patient care unit and patient needs, specifies the method to calculate a health care facility's compliance with the staffing requirements, protects direct care registered nurses from retaliation and includes notice, record-keeping and enforcement requirements. The bill also directs the Department of Health and Human Services to establish a process for critical access hospitals to request flexibility regarding the minimum staffing requirements.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0509&item=1&snum=132"}, "status": "died", "status_label": "Died On Adjournment", "final_disposition": {"label": "Died On Adjournment", "date": "2026-04-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 1281)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0509&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [], "committee_reports": [], "chamber_actions": [{"date": "2025-03-25", "chamber": "Senate", "action": "Committee on HEALTH AND HUMAN SERVICES suggested and ordered printed"}, {"date": "2025-03-25", "chamber":