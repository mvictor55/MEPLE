{"ld": 521, "paper": "HP340", "session": "132", "title": "An Act to Prohibit Discrimination in Housing Based on Source of Income, Veteran Status or Military Status", "sponsor_id": "h-julia-cassie", "cosponsor_ids": ["h-abdi-mana", "h-archer-marshall", "h-debrito-flavia", "h-gere-traci", "h-lookner-grayson", "h-milliken-nina", "h-roberts-lovell-tiffany"], "committee_code": "JUD", "committee_name": "Judiciary", "summary": {"text": "This bill amends the Maine Human Rights Act to prohibit housing discrimination on the basis of an individual's military status, veteran status or source of income. The bill defines \"source of income\" to include income from any federal, state or local public assistance program, including payments under the United States Social Security Act, medical assistance and housing vouchers; income received by court order; any payment from a trust, guardian, conservator, cosigner or relative; and any other lawful source of income or funds.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0340&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-04-08", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 521)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0340&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-03-14", "action": "Work Session Held", "result": null}, {"date": "2025-03-14", "action": "Voted", "result": "ONTP"}, {"date": "2025-03-31", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-02-11", "chamber": "House", "action": "Committee on Judiciary suggested and ordered printed."}, {"date": "2025-02-11", "chamber": "House", "action": "The Bill was REFERRED to the Committee on JUDICIARY."}, {"date": "2025-02-11", "chamber": "House", "action": "Sent for concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-02-11", "chamber": "Senate", "action": "The Bill was REFERRED to the Committee on JUDICIARY  in concurrence"}, {"date": "2025-03-21", "chamber": "House", "action": "Carried over, in the same posture, to the next special or regular session of the 132nd Legislature, pursuant to Joint Order SP 519."}, {"date": "2025-04-08", "chamber": "Senate", "action": "Pursuant to Joint Rule 310.3 Placed in Legislative Files (DEAD)"}], "roll_calls": [], "hearing": {"date": "2025-03-03", "time": "1:00 PM", "location": "State House, Room 438", "committee_code": "JUD", "testimony_count": 13}, "heard_with": [], "tags": ["Human Rights", "Discrimination"], "affected_statutes": [], "testimony": [{"id": "10035427", "name": "Andrea Mancuso", "organization": "MCEDV", "town": null, "position": "support", "position_source": "inferred", "date": "2025-03-03", "hearing_date": "2025-03-03", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=10035427", "has_text": true, "shared_with": [], "person_profile_id": null, "org_profile_id": "org-mcedv"}, {"id": "10035838", "name": "Annika Moore", "organization": "Preble Street", "town": null, "position": null, "position_source": null, "date": "2025-03-03", "hearing_date": "2025-03-03", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=10035838", "has_text": false, "shared_with": [], "person_profile_id": null, "org_profile_id": "org-preble-street"}, {"id": "10035487", "name": "Cassie Julia", "organization": "House District 65: Waterville", "town": null, "position": "support", "position_source": "inferred", "date": "2025-03-03", "hearing_date": "2025-03-03", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=10035487", "has_text"