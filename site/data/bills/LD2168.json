{"ld": 2168, "paper": "HP1457", "session": "132", "title": "An Act to Increase Accountability for Persons Engaged in Commercial Sexual Exploitation and Human Trafficking and to Support Victims", "sponsor_id": "h-stover-holly", "cosponsor_ids": ["h-arata-amy", "h-faircloth-sean", "h-fecteau-ryan", "h-gattine-andrew", "h-gramlich-lori", "h-henderson-rachel", "s-reny-cameron", "h-roeder-amy", "h-salisbury-suzanne"], "committee_code": "JUD", "committee_name": "Judiciary", "summary": {"text": "This bill directs the court to impose a $500 assessment, or a $1,000 assessment for repeat offenders, on a person convicted of engaging a person for prostitution, sex trafficking, aggravated sex trafficking, soliciting a child for commercial sexual exploitation or commercial sexual exploitation of a minor or person with a mental disability. Money from assessments is deposited in the Victims' Compensation Fund and must be used to meet the needs of victims and survivors of these crimes.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1457&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2026-04-13", "governor_action": "Signed", "governor_action_date": "2026-04-13"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 2168)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1457&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-939)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1457&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-939)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1457&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN216802.pdf"}], "committee_actions": [{"date": "2026-03-04", "action": "Work Session He