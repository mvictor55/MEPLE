{"ld": 1707, "paper": "HP1142", "session": "132", "title": "An Act to Require a Person to Be a United States Citizen to Receive State or Local Financial Assistance and to Ensure Municipal Compliance with Federal Immigration Laws", "sponsor_id": "h-greenwood-randall", "cosponsor_ids": ["h-drinkwater-gary", "h-ducharme-john", "h-faulkingham-william", "h-javner-kathy", "h-rudnicki-shelley", "h-smith-katrina", "h-soboleski-michael", "s-stewart-harold", "h-thorne-james"], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This bill requires an individual to be a citizen of the United States in order to receive any form of financial assistance from the State or a municipality, except for funding for general purpose aid for education. The bill also provides that a municipality is ineligible to receive municipal general assistance and state-municipal revenue sharing if that municipality prohibits or restricts, formally or informally, the exchange of information with federal immigration authorities or any other federal, state or local government entity regarding the citizenship or immigration status, lawful or unlawful, of any individual or the maintenance of such information.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1142&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2025-06-09", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1707)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1142&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-444)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1142&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-444)", "description": "Change Title", "sponsor": null, "status": null, 