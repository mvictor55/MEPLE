{"ld": 61, "paper": "HP25", "session": "132", "title": "An Act to Regulate Employer Surveillance to Protect Workers", "sponsor_id": "h-roeder-amy", "cosponsor_ids": ["s-tipping-michael"], "committee_code": "LAB", "committee_name": "Labor", "summary": {"text": "This bill specifies that an employer may use employer surveillance only if the employer informs the employee before beginning employer surveillance. It prohibits an employer from using audiovisual monitoring in an employee's residence or personal vehicle or on the employee's property and provides that an employee can decline a request by an employer to install data collection or transmission applications on the employee's personal electronic devices for the purposes of employer surveillance. It requires that an employer notify a prospective employee during the interview process that the employer engages in employer surveillance. It gives rule-making authority to the Department of Labor. It also creates a private right of action for persons aggrieved by a violation by an employer.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0025&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2026-01-11", "governor_action": "Unsigned", "governor_action_date": "2026-01-11"}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 61)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0025&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-213)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0025&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-213)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0025&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN006102.pdf"}], "committ