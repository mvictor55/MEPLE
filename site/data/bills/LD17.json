{"ld": 17, "paper": "SP28", "session": "132", "title": "An Act to Designate the Warden of the Maine State Prison as Chief Administrative Officer of the Bolduc Correctional Facility", "sponsor_id": "s-beebe-center-anne", "cosponsor_ids": [], "committee_code": "CJPS", "committee_name": "Criminal Justice and Public Safety", "summary": {"text": "This bill designates the warden of the Maine State Prison as the chief administrative officer of the Bolduc Correctional Facility and removes the power to appoint an assistant director.\n\nThe bill also changes the provision of law allowing the warden to appoint deputy wardens to clarify that any deputies appointed by the warden are responsible when the warden is absent or unable to perform the duties of the office rather than specifically absent from the Maine State Prison or unable to perform the duties of the office.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0028&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-03-21", "governor_action": "Signed", "governor_action_date": "2025-03-21"}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 17)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0028&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-02-05", "action": "Work Session Held", "result": null}, {"date": "2025-02-05", "action": "Voted", "result": "OTP"}, {"date": "2025-02-14", "action": "Reported Out", "result": "OTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-01-08", "chamber": "Senate", "action": "Received by the Secretary of the Senate on January 6, 2025 and REFERRED to the Committee on CRIMINAL JUSTICE AND PUBLIC SAFETY pursuant to Joint Rule 308.2"}, {"date": "2025-02-0