{"ld": 262, "paper": "HP165", "session": "132", "title": "An Act to Amend the Laws Governing the Taste Testing of Wine and Malt Liquor to Facilitate Marketing by Wholesalers (EMERGENCY)", "sponsor_id": "h-crockett-edward", "cosponsor_ids": ["h-boyer-david"], "committee_code": "VLA", "committee_name": "Veterans and Legal Affairs", "summary": {"text": "This bill modifies the law governing taste-testing events held by malt liquor and wine wholesale licensees. Under current law, wholesale licensees may rent or lease an area from a retail licensee for the purpose of inviting retail licensees to taste test wine or malt liquor products. The bill broadens a wholesale licensee's ability to hold such a taste-testing event by also allowing the wholesale licensee to rent or lease an unlicensed venue for that purpose.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0165&item=1&snum=132"}, "status": "enacted", "status_label": "Emergency Enacted", "final_disposition": {"label": "Emergency Enacted", "date": "2025-03-21", "governor_action": "Emergency Signed", "governor_action_date": "2025-03-21"}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 262)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0165&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-03-05", "action": "Work Session Held", "result": null}, {"date": "2025-03-05", "action": "Voted", "result": "OTP"}, {"date": "2025-03-12", "action": "Reported Out", "result": "OTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-01-23", "chamber": "House", "action": "Received by the Clerk of the House on January 23, 2025."}, {"date": "2025-01-23", "chamber": "House", "action": "The Bill was REFERRED to the Committee on VETERANS AND LEGAL AFFAIRS pursuant to Joint Rule 308.2 and ordered printed pursuant to Joint Rule 401."}, {"date": "2025-03-18", "chamber": "House", "action": "CONSENT CALENDAR - FIRST DAY"}, {"date": "2025-03-18", "chamber": "House", "action": "Under suspension of the rules CONSENT CALENDAR - SECOND DAY."}, {"date": "2025-03-18", "chamber": "House", "action": "The Bill was PASSED TO BE ENGROSSED."}, {"date": "2025-03-18", "chamber": "House", "action": "Sent for concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-03-20", "chamber": "Senate", "action": "Report READ and ACCEPTED, in concurrence."}, {"date": "2025-03-20", "chamber": "Senate", "action": "READ ONCE"}, {"date": "2025-03-20", "chamber": "Senate", "action": "Under suspension of the Rules, READ A SECOND TIME and PASSED TO BE ENGROSSED, in concurrence."}, {"date": "2025-03-20", "chamber": "Senate", "action": "Ordered sent down forthwith."}, {"date": "2025-03-20", "chamber": "House", "action": "This being an emergency measure, a two-thirds vote of all the members elected to the House was necessary."}, {"date": "2025-03-20", "chamber": "House", "action": "PASSED TO BE ENACTED."}, {"date": "2025-03-20", "chamber": "House", "action": "Sent for concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-03-20", "chamber": "Senate", "action": "PASSED TO BE ENACTED - Emergency - 2/3 Elected Required, in concurrence."}], "roll_calls": [], "hearing": {"date": "2025-02-26", "time": "9:30 AM", "location": "State House, Room 437", "committee_code": "VLA", "testimony_count": 4}, "heard_with": [], "tags": ["Alcoholic Beverages", "Tastings"], "affected_statutes": [{"title": "28-A", "section": "1402", "subsection": "3", "paragraph": "D", "effect": "AMD"}, {"title": "28-A", "section": "1402", "subsection": "2", "paragraph": null, "effect": "AMD"}], "testimony": [{"id": "184214", "name": "Cheryl Timberlake", "organization": "Maine Beverage Distributors Association", "town": null, "position": null, "position_source": null, "date": "2025-02-26", "hearing_date": "2025-02-26", "u