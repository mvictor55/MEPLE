{"ld": 568, "paper": "SP248", "session": "132", "title": "Resolve, Directing the Public Utilities Commission to Evaluate Different Procurement Methods for Standard-offer Service (TITLE CHANGE)", "sponsor_id": "s-harrington-matthew", "cosponsor_ids": ["h-paul-reagan", "s-stewart-harold", "h-warren-sophia"], "committee_code": "EUT", "committee_name": "Energy, Utilities and Technology", "summary": {"text": "This bill limits standard-offer electricity service provider contracts to 6 months and requires that if at the end of the contract the Public Utilities Commission rejects all bids for a new standard-offer service contract, the expiring contract continues until the commission accepts a bid for a new contract. The bill also requires that if at the end of a standard-offer electricity service contract the current standard-offer service provider submits a bid for a new contract at a higher rate for electricity than the expiring contract, the provider must include justification for the rate increase.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0248&item=1&snum=132"}, "status": "enacted", "status_label": "Finally Passed", "final_disposition": {"label": "Finally Passed", "date": "2025-06-09", "governor_action": "Signed", "governor_action_date": "2025-06-09"}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 568)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0248&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-173)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0248&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-173)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0248&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN056802.pdf"}], "committee_actions": [{"date": "2025-