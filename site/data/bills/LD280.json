{"ld": 280, "paper": "SP130", "session": "132", "title": "An Act to Establish Lifetime Ferry Passes for Retired Maine State Ferry Service Employees", "sponsor_id": "s-beebe-center-anne", "cosponsor_ids": ["s-curry-glenn"], "committee_code": "TRA", "committee_name": "Transportation", "summary": {"text": "This bill provides that a state employee who is retired from employment with the Maine State Ferry Service is eligible to receive a lifetime ferry pass and a waiver from any reservation fees. The bill defines \"lifetime ferry pass\" as a pass that provides 2 round-trip passages per month for a passenger and a vehicle on a ferry operated by the Maine State Ferry Service if the passenger gives at least 24 hours' notice of a planned round-trip passage to the Maine State Ferry Service.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0130&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-10", "governor_action": "Signed", "governor_action_date": "2025-06-10"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 280)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0130&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-193)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0130&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-193)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0130&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN028002.pdf"}], "committee_actions": [{"date": "2025-05-15", "action": "Work Session Held", "result": null}, {"date": "2025-05-15", "action": "Voted", "result": "OTP-AM"}, {"date": "2025-05-29", "action": "Reported Out", "result": "OTP-AM"}], "committee_reports": [{"label": "Comm