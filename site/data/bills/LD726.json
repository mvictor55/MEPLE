{"ld": 726, "paper": "HP465", "session": "132", "title": "An Act to Protect Municipalities' Investment in Law Enforcement Officers", "sponsor_id": "h-boyer-david", "cosponsor_ids": ["s-beebe-center-anne", "s-bennett-richard", "h-bishop-steven", "s-grohoski-nicole", "s-harrington-matthew", "h-hasenfus-tavis", "h-perkins-chad", "s-tipping-michael", "h-white-russell"], "committee_code": "CJPS", "committee_name": "Criminal Justice and Public Safety", "summary": {"text": "Current law requires that when a governmental entity hires a full-time law enforcement officer within 5 years of the officer's graduation from the Maine Criminal Justice Academy or the Indian police academy at the federal law enforcement training center, and that officer's training had been paid for by the officer's original governmental entity, the hiring governmental entity must pay the original governmental entity a designated portion of the officer's training costs. This bill increases the amount of those payments.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0465&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2025-06-02", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 726)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0465&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-306)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0465&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-306)", "description": null, "sponsor": null, "status": null, "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0465&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN072602.pdf"}], "committee_actions": [{"date": "2025-03-19", "act