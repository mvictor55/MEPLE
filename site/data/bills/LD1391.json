{"ld": 1391, "paper": "HP913", "session": "132", "title": "An Act to Update the Maine Self-service Storage Act", "sponsor_id": "h-ducharme-john", "cosponsor_ids": ["h-arata-amy", "s-baldacci-joseph", "h-collamore-amanda", "h-foster-steven", "h-malon-marc", "h-mingo-arthur", "h-parry-wayne", "h-roberts-lovell-tiffany"], "committee_code": "HED", "committee_name": "Housing and Economic Development", "summary": {"text": "This bill updates the Maine Self-service Storage Act by:\n\n1. Amending the definition of abandoned leased space to include space containing personal property more than 15 days after the date given in a notice to terminate or not renew the rental agreement; 2. Permitting the electronic delivery and acceptance of rental agreements; 3. Allowing notices to be sent electronically; 4. Deeming accepted rental agreements that have been sent to but not signed by the occupant if the occupant continues to pay rent or occupy the space; 5. Permitting online sales of personal property that has had a lien placed on it by the operator; and 6. Allowing notices to be sent to the operator at an address specified in the rental agreement.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0913&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-05-30", "governor_action": "Signed", "governor_action_date": "2025-05-30"}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 1391)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0913&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-08", "action": "Work Session Held", "result": null}, {"date": "2025-05-08", "action": "Voted", "result": "OTP"}, {"date": "2025-05-14", "action": "Reported Out", "result": "OTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought to Pass", "signer_count": null, "signe