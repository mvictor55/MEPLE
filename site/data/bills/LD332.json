{"ld": 332, "paper": "HP232", "session": "132", "title": "An Act to Establish Mandatory Minimum Sentences for Gross Sexual Assaults Against Children and Aggravated Sex Trafficking of Children", "sponsor_id": "h-greenwood-randall", "cosponsor_ids": ["s-bickford-bruce", "h-cluchey-sally", "s-harrington-matthew", "h-henderson-rachel", "h-lavigne-thomas", "h-poirier-jennifer", "h-rudnicki-shelley", "h-thorne-james", "h-white-james"], "committee_code": "JUD", "committee_name": "Judiciary", "summary": {"text": "This bill provides that if the State pleads and proves that a gross sexual assault was committed against an individual who had not yet attained 12 years of age, the court is required to impose a definite term of imprisonment of not less than 25 years, none of which may be suspended. It also provides that, in the case of a gross sexual assault committed against an individual who had not yet attained 12 years of age when the defendant had previously been convicted and sentenced for committing gross sexual assault, formerly denominated as gross sexual misconduct, or rape against an individual who had not yet attained 12 years of age or that the defendant had previously been convicted and sentenced for engaging in substantially similar conduct in another jurisdiction against an individual who had not yet attained 12 years of age, the court is required to instead impose a term of imprisonment for life. It also provides that, in the case of aggravated sex trafficking for which the State pleads and proves that the defendant knowingly promoted prostitution of a person who had not yet attained 12 years of age, the court is required to set a definite term of imprisonment of not less than 25 years, none of which may be suspended.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0232&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2025-06-05", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN033201.pdf", "documents": [{"label": "Bill text (LD 332)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0232&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-461)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0232&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-461)", "description": null, "sponsor": null, "status": null, "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0232&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN033202.pdf"}], "committee_actions": [{"date": "2025-03-18", "action": "Work Session Held", "result": "TABLED"}, {"date": "2025-05-13", "action": "Work Session Held", "result": null}, {"date": "2025-05-13", "action": "Voted", "result": "Divided Report"}, {"date": "2025-06-03", "action": "Reported Out", "result": "ONTP/OTP-AM"}], "committee_reports": [{"label": "Majority report", "recommendation": "Ought Not To Pass", "signer_count": 11, "signers": ["Senator Anne Carney (Chair)", "Representative Amy Kuhn (Chair)", "Representative Mark Babin", "Representative Elizabeth Caruso", "Representative Rachel Henderson", "Representative Adam Lee", "Representative Dani O'Halloran", "Representative Dylan Pugh", "Representative Ellie Sato", "Representative David Sinclair", "Senator Rachel Talbot Ross"], "signer_ids": ["s-carney-anne", "h-kuhn-amy", "h-babin-mark", "h-caruso-elizabeth", "h-henderson-rachel", "h-lee-adam", "h-o-halloran-dani", "h-pugh-dylan", "h-sato-eleanor", "h-sinclair-david", "s-talbot-ross-rachel"]}, {"label": "Minority report", "recommendation": "Ought To Pass As Amended", "signer_count": 2, "signers": ["Senator David Haggan", "Representative Jennifer Poirier"], "signer_ids": ["s-haggan-davi