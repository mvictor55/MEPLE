{"ld": 1588, "paper": "HP1046", "session": "132", "title": "An Act to Ensure Transparency in Student Transfer Requests", "sponsor_id": "h-bagshaw-barbara", "cosponsor_ids": ["h-albert-roger", "h-collins-alicia", "h-griffin-abigail", "s-harrington-matthew", "s-libby-james", "s-moore-marianne", "h-schmersal-burgess-tammy", "h-soboleski-michael", "s-stewart-harold"], "committee_code": "EDU", "committee_name": "Education and Cultural Affairs", "summary": {"text": "This bill modifies the education laws governing student transfers to require greater transparency by school administrative units and the Commissioner of Education. The bill requires school administrative units to report information pertaining to requests by students to transfer either to or from that school administrative unit within the past year. The bill also requires the commissioner to make a de-identified version of that information available on the Department of Education's publicly accessible website, including information related to any transfer request reviewed by the commissioner.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1046&item=1&snum=132"}, "status": "died", "status_label": "Died On Adjournment", "final_disposition": {"label": "Died On Adjournment", "date": "2026-04-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN158802.pdf", "documents": [{"label": "Bill text (LD 1588)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1046&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-406)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1046&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-406)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1046&it