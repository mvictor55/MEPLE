{"ld": 2066, "paper": "SP855", "session": "132", "title": "An Act to Establish the Child Care Employment Award", "sponsor_id": "s-ingwersen-henry", "cosponsor_ids": ["s-bennett-richard", "s-larsen-daughtry-matthea", "h-fecteau-ryan", "s-moore-marianne", "s-nangle-timothy", "s-rotundo-margaret"], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This bill establishes the Child Care Employment Award in order to provide child care subsidies to recipients who are employed by licensed child care facilities or family child care providers and whose children are receiving care from such facilities or providers. It provides that subsidy awards must be provided directly to the child care facility or family child care provider. It authorizes the Department of Health and Human Services to adopt routine technical rules regarding subsidy award amounts, waiting list management, quality standards and limitations on the number of children supported. It also requires the department to establish a full-time position to administer the award and increases the award program's funding to $3,000,000.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0855&item=1&snum=132"}, "status": "died", "status_label": "Died On Adjournment", "final_disposition": {"label": "Died On Adjournment", "date": "2026-04-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN206601.pdf", "documents": [{"label": "Bill text (LD 2066)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0855&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-513)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0855&item=2&snum=132", "item": 2}, {"label": "Amendment C-B (S-514)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0855&item=3&snum=13