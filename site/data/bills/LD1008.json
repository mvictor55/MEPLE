{"ld": 1008, "paper": "HP655", "session": "132", "title": "An Act to Require the Attorney General to Seek Legislative Approval Before Filing Any Civil Suit on Behalf of the State and to Authorize Citizen-initiated Petitions to Move for Dismissal", "sponsor_id": "h-tuell-william", "cosponsor_ids": [], "committee_code": "JUD", "committee_name": "Judiciary", "summary": {"text": "This bill creates a process for the Attorney General to request legislative approval before filing a case on behalf of the State in state or federal court. The bill authorizes the joint standing committee of the Legislature having jurisdiction over judiciary matters to report out legislation authorizing the Attorney General's request for approval in the House of Representatives and the Senate. The bill also authorizes any registered voter in the State to request a citizen-initiated review of any case filed by the Attorney General and requires that proceedings in that case be halted until the petition process has been completed. Finally, the bill authorizes the Legislature to meet during the interim for the purposes of completing legislative review on a request by the Attorney General.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0655&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2025-05-21", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 1008)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0655&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-169)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0655&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-169)", "description": null, "sponsor": null, "status": null, "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0655&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN100802.pdf"}], "committee_actions": [{"date": "2025-03-27", "action": "Work Session Held", "result": null}, {"date": "2025-03-27", "action": "Voted", "result": "Divided Report"}, {"date": "2025-05-15", "action": "Reported Out", "result": "ONTP/OTP-AM"}], "committee_reports": [{"label": "Majority report", "recommendation": "Ought Not To Pass", "signer_count": 11, "signers": ["Senator Anne Carney (Chair)", "Representative Amy Kuhn (Chair)", "Representative Mark Babin", "Representative Elizabeth Caruso", "Representative Rachel Henderson", "Representative Adam Lee", "Representative Dani O'Halloran", "Representative Dylan Pugh", "Representative Ellie Sato", "Representative David Sinclair", "Senator Rachel Talbot Ross"], "signer_ids": ["s-carney-anne", "h-kuhn-amy", "h-babin-mark", "h-caruso-elizabeth", "h-henderson-rachel", "h-lee-adam", "h-o-halloran-dani", "h-pugh-dylan", "h-sato-eleanor", "h-sinclair-david", "s-talbot-ross-rachel"]}, {"label": "Minority report", "recommendation": "Ought To Pass As Amended", "signer_count": 2, "signers": ["Senator David Haggan", "Representative Jennifer Poirier"], "signer_ids": ["s-haggan-david", "h-poirier-jennifer"]}], "chamber_actions": [{"date": "2025-03-11", "chamber": "House", "action": "Committee on Judiciary suggested and ordered printed."}, {"date": "2025-03-11", "chamber": "House", "action": "The Bill was REFERRED to the Committee on JUDICIARY."}, {"date": "2025-03-11", "chamber": "House", "action": "Sent for concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-03-11", "chamber": "Senate", "action": "The Bill was REFERRED to the Committee on JUDICIARY  in concurrence"}, {"date": "2025-03-21", "chamber": "House", "action": "Carried over, in the same posture, to the next special or regular session of the 132nd Legislature, pursuant to Joint Order SP 519."}, {"date": "2025-05-20", "chamber": "House", "action": "Reports