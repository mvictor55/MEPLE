{"ld": 2013, "paper": "HP1343", "session": "132", "title": "An Act to Authorize the Commissioner of Marine Resources to Adopt Emergency Rules to Protect Certain Marine Mammals in Exceptional Circumstances", "sponsor_id": "h-hepler-allison", "cosponsor_ids": [], "committee_code": "MAR", "committee_name": "Marine Resources", "summary": {"text": "This bill authorizes the Commissioner of Marine Resources to adopt emergency rules under the Maine Revised Statutes, Title 5, section 8054 to limit the taking of marine organisms by method or location to protect certain marine mammals when the commissioner determines that immediate action is necessary to mitigate circumstances posing an exceptionally high level of risk to those mammals. The bill also requires the Department of Marine Resources to submit a report to the joint standing committee of the Legislature having jurisdiction over marine resources matters no later than December 1, 2027 that includes information and findings and recommendations related to any uses of the emergency rule-making authority authorized by this legislation.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1343&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2026-04-03", "governor_action": "Signed", "governor_action_date": "2026-04-03"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 2013)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1343&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-856)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1343&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-856)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1343&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/