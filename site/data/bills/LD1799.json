{"ld": 1799, "paper": "HP1204", "session": "132", "title": "Resolve, Directing the Department of Health and Human Services to Review the Progressive Treatment Program and Processes by Which a Person May Be Involuntarily Admitted to a Psychiatric Hospital or Receive Court-ordered Community Treatment", "sponsor_id": "h-debrito-flavia", "cosponsor_ids": ["h-daigle-lucien", "h-graham-anne", "h-javner-kathy", "h-mccabe-julia", "s-moore-marianne", "h-shagoury-daniel", "h-zager-samuel"], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This resolve directs the Commissioner of Health and Human Services to convene a stakeholder group of interested parties to review the entire process related to a progressive treatment program under the Maine Revised Statutes, Title 34-B, section 3873-A and to review for efficiency and effectiveness the processes by which a person may be involuntarily admitted to a psychiatric hospital or receive court-ordered community treatment pursuant to Title 34-B, chapter 3, subchapter 4, article 3. The commissioner is required to submit a report with recommendations to the Joint Standing Committee on Health and Human Services no later than December 3, 2025. The committee is authorized to report out legislation to the Second Regular Session of the 132nd Legislature related to the recommendations in the report.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1204&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-22", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1799)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1204&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-15", "action": "Work Session Held", "result": null}, {"date": "2025-05-15", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-21", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-04-24", "chamber": "House", "action": "Committee on Health and Human Services suggested and ordered printed."}, {"date": "2025-04-24", "chamber": "House", "action": "The Resolve was REFERRED to the Committee on HEALTH AND HUMAN SERVICES."}, {"date": "2025-04-24", "chamber": "House", "action": "Sent for concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-04-24", "chamber": "Senate", "action": "The Bill was REFERRED to the Committee on HEALTH AND HUMAN SERVICES  in concurrence"}, {"date": "2025-05-22", "chamber": "Senate", "action": "Pursuant to Joint Rule 310.3 Placed in Legislative Files (DEAD)"}], "roll_calls": [], "hearing": {"date": "2025-05-09", "time": "11:00 AM", "location": "Cross Building, Room 209", "committee_code": "HHS", "testimony_count": 15}, "heard_with": [], "tags": ["Mental Health Services", "Mental Health Institutions"], "affected_statutes": [], "testimony": [{"id": "192960", "name": "Adam Bloom-Paicopolos", "organization": "Alliance for Addiction and Mental Health Services", "town": null, "position": "support", "position_source": "inferred", "date": "2025-05-09", "hearing_date": "2025-05-09", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=192960", "has_text": true, "shared_with": [], "person_profile_id": null, "org_profile_id": "org-alliance-for-addiction-and-mental-health-services"}, {"id": "10054169", "name": "Alyson Maloy, MD", "organization": "Maine Association of Psychiatric Physicians (MAPP)", "town": null, "position": "support", "position_source": "inferred", "date": "2025-05-09", "hearing_date": "2025-05-09", "url": "https://legislature.maine.gov/l