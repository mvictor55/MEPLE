{"ld": 77, "paper": "HP41", "session": "132", "title": "An Act to Stabilize and Sustainably Fund the Department of Inland Fisheries and Wildlife, Fisheries and Hatcheries Division by Increasing the Inland Fishing License Fees and Establishing the Inland Fisheries Conservation and Enhancement Fund", "sponsor_id": "h-wood-stephen", "cosponsor_ids": [], "committee_code": "IFW", "committee_name": "Inland Fisheries and Wildlife", "summary": {"text": "This bill establishes the Inland Fisheries Conservation and Enhancement Fund to be used by the Department of Inland Fisheries and Wildlife for the conservation and enhancement of inland freshwater fisheries resources. The bill increases the fee for inland fishing licenses by $7.00 and dedicates $6.00 of the increase to the Inland Fisheries Conservation and Enhancement Fund and $1 of the increase to the Boat Launch Facilities Fund.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0041&item=1&snum=132"}, "status": "died", "status_label": "Died On Adjournment", "final_disposition": {"label": "Died On Adjournment", "date": "2025-06-25", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 77)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0041&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-323)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0041&item=2&snum=132", "item": 2}, {"label": "Amendment H-A to C-A (H-641)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0041&item=4&snum=132", "item": 4}], "amendments": [{"id": "C-A (H-323)", "description": "Change Title", "sponsor": null, "status": "Adopted by House", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0041&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN007702.pdf"}, {"id": "H-A to C-