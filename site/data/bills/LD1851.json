{"ld": 1851, "paper": "HP1235", "session": "132", "title": "An Act to Bring Parity Among the Wabanaki Nations Regarding the Generation of Revenues from Gaming", "sponsor_id": "h-malon-marc", "cosponsor_ids": ["s-talbot-ross-rachel"], "committee_code": "VLA", "committee_name": "Veterans and Legal Affairs", "summary": {"text": "This bill makes changes to the laws related to the distribution of slot machine revenues generated in the State by a casino with a commercial track licensed to operate slot machines. The bill increases the total net slot machine income to be collected and distributed by a casino with a commercial track licensed to operate slot machines from 39% to 46% and provides for the distribution of the additional 7% of net slot machine income to the tribal governments of the Houlton Band of Maliseet Indians and the Mi'kmaq Nation.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1235&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2026-03-25", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1851)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1235&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-875)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1235&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-875)", "description": null, "sponsor": null, "status": null, "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1235&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN185102.pdf"}], "committee_actions": [{"date": "2025-05-12", "action": "Work Session Held", "result": "TABLED"}, {"date": "2025-05-19", "action": "Carry Over Requested", "result": null}, {"date": "2025-05-19