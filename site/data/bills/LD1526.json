{"ld": 1526, "paper": "SP610", "session": "132", "title": "An Act to Change the Permissible Hours and Penalities Pertaining to the Use of Consumer Fireworks", "sponsor_id": "s-beebe-center-anne", "cosponsor_ids": [], "committee_code": "CJPS", "committee_name": "Criminal Justice and Public Safety", "summary": {"text": "This bill changes the hours consumer fireworks may be used to provide that consumer fireworks may be used from 9:00 a.m. to 9:00 p.m. It also changes the minimum and maximum penalties for violations related to restrictions on the use of consumer fireworks to provide that the fines are not less than $100 and not more than $1,000 per offense.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0610&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-21", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN152601.pdf", "documents": [{"label": "Bill text (LD 1526)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0610&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-14", "action": "Work Session Held", "result": null}, {"date": "2025-05-14", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-20", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-04-08", "chamber": "Senate", "action": "Committee on CRIMINAL JUSTICE AND PUBLIC SAFETY suggested and ordered printed REFERENCE to the Committee on CRIMINAL JUSTICE AND PUBLIC SAFETY Ordered sent down forthwith for concurrence"}, {"date": "2025-04-08", "chamber