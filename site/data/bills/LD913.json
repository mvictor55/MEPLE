{"ld": 913, "paper": "SP403", "session": "132", "title": "An Act to Amend the Law Regulating the Resale of Tickets (TITLE CHANGE)", "sponsor_id": "s-larsen-daughtry-matthea", "cosponsor_ids": ["s-bailey-donna", "s-baldacci-joseph", "h-collamore-amanda", "h-ducharme-john", "s-farrin-bradlee", "s-grohoski-nicole", "s-nangle-timothy", "s-reny-cameron", "h-roberts-lovell-tiffany"], "committee_code": "HED", "committee_name": "Housing and Economic Development", "summary": {"text": "This bill prohibits a seller of a ticket to an entertainment event from prohibiting the purchaser from transferring the ticket with or without consideration to a 3rd party, requires the seller to offer the option of a transferable ticket if the ticketing system does not allow for a ticket to be transferred and prohibits a person from denying a ticket holder admission to an entertainment event solely because the ticket has been resold. This bill does not apply to tickets sold to students for events at public institutions of higher education or to places of entertainment with a seating capacity of 3,500 or less if the place of entertainment provides written notice to the Commissioner of Administrative and Financial Services.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0403&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-18", "governor_action": "Signed", "governor_action_date": "2025-06-18"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 913)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0403&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-308)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0403&item=2&snum=132", "item": 2}, {"label": "Amendment S-A to C-A (S-351)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0403&item=4&snum=132", "item": 4}], "ame