{"ld": 1927, "paper": "HP1288", "session": "132", "title": "An Act to Add Mold to the Implied Warranty and Covenant of Habitability (TITLE CHANGE)", "sponsor_id": "h-kessler-christopher", "cosponsor_ids": ["s-libby-james", "h-montell-karen", "h-shagoury-daniel", "h-woodsome-david"], "committee_code": "JUD", "committee_name": "Judiciary", "summary": {"text": "This bill requires a landlord, upon receipt of a request from a tenant, to inspect a dwelling unit within 24 hours following a leaking event or for visible mold or dampness. The bill also requires a landlord to demonstrate reasonable effort to repair the source of the leak and restore the area within 5 days of inspection. The bill requires a tenant to, after reasonable notice, allow the landlord or the landlord's agent access to the dwelling unit for remediation purposes. Finally, the bill gives remedies and enforcement mechanisms to the landlord and the tenant for noncompliance with the duties given under these provisions.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1288&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2026-01-11", "governor_action": "Unsigned", "governor_action_date": "2026-01-11"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1927)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1288&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-681)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1288&item=2&snum=132", "item": 2}, {"label": "Amendment C-B (H-682)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1288&item=3&snum=132", "item": 3}, {"label": "Amendment C-C (H-683)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1288&item=4&snum=132", "item": 4}], "amendments": [{"id": "C-A (H-681)", "description": null, "sponsor": null, "status": "Adop