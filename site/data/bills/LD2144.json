{"ld": 2144, "paper": "SP862", "session": "132", "title": "Resolve, to Establish the Working Group to Prioritize Wellness and Mental Health Resources for Heritage Industries", "sponsor_id": "s-ingwersen-henry", "cosponsor_ids": ["s-black-russell", "s-brenner-stacy", "h-hepler-allison", "s-hickman-craig", "s-moore-marianne", "h-pluecker-william", "s-reny-cameron", "h-strout-tiffany", "s-tepler-denise"], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This resolve creates the Working Group to Prioritize Wellness and Mental Health Resources for Heritage Industries, which is directed to review existing mental health and wellness resources available to individuals in Maine's heritage industries, identify gaps in the provision of services and barriers to accessing existing resources, examine successful models from other states and jurisdictions, develop recommendations for establishing sustainable funding mechanisms and service delivery models and explore opportunities for public education to reduce stigma around mental health issues and increase awareness of mental health services. The resolve requires the working group to submit a report of its findings and recommendations to the joint standing committees of the Legislature having jurisdiction over agriculture, conservation and forestry matters, marine resources matters and health and human services matters by December 1, 2026 and authorizes the joint standing committees to each submit legislation to the 133rd Legislature in 2027.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0862&item=1&snum=132"}, "status": "enacted", "status_label": "Finally Passed", "final_disposition": {"label": "Finally Passed", "date": "2026-03-23", "governor_action": "Signed", "governor_action_date": "2026-03-23"}, "fiscal_status": "Not Yet Determined", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN214402.pdf", "documents": [{"label": "Bill text (LD 2144)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0862&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-531)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0862&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-531)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0862&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN214402.pdf"}], "committee_actions": [{"date": "2026-02-03", "action": "Work Session Held", "result": null}, {"date": "2026-02-03", "action": "Voted", "result": "OTP-AM"}, {"date": "2026-02-11", "action": "Work Session Reconsidered", "result": null}, {"date": "2026-02-11", "action": "Voted", "result": "OTP-AM"}, {"date": "2026-03-09", "action": "Reported Out", "result": "OTP-AM"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought to Pass as Amended", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2026-01-07", "chamber": "Senate", "action": "Committee on HEALTH AND HUMAN SERVICES suggested and ordered printed REFERENCE to the Committee on HEALTH AND HUMAN SERVICES Ordered sent down forthwith for concurrence"}, {"date": "2026-01-07", "chamber": "House", "action": "The Resolve was REFERRED to the Committee on HEALTH AND HUMAN SERVICES."}, {"date": "2026-01-07", "chamber": "House", "action": "In concurrence. ORDERED SENT FORTHWITH."}, {"date": "2026-03-10", "chamber": "Senate", "action": "Report READ and ACCEPTED."}, {"date": "2026-03-10", "chamber": "Senate", "action": "Bill READ ONCE."}, {"date": "2026-03-10", "chamber": "Senate", "action": "Committee Amendment \"A\" (S-531) READ and ADOPTED."}, {"date": "2026-03-10", "chamber": "Senate", "action": "ASSIGNED FOR SECOND READING NEXT LEGISLATIVE DAY."}, {"date": "2026-03-12"