{"ld": 102, "paper": "HP67", "session": "132", "title": "An Act to Notify the Public of Juveniles That Have Escaped a Department of Corrections Facility and to Direct the Department of Corrections to Study the Further Release of Juvenile Intelligence and Investigative Record Information (TITLE CHANGE)", "sponsor_id": "h-lajoie-michel", "cosponsor_ids": [], "committee_code": "CJPS", "committee_name": "Criminal Justice and Public Safety", "summary": {"text": "This bill allows criminal justice agencies to provide to the public certain juvenile history record information for the purpose of apprehending juveniles when either the juvenile has escaped from custody as defined by the Maine Criminal Code or a warrant of arrest has been issued alleging the juvenile has committed a juvenile crime that would constitute murder or a Class A, B, C or D crime if the juvenile were an adult. The bill also allows the juvenile history record information to be shared if the juvenile had attained 18 years of age at the time of the alleged escape.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0067&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2026-04-03", "governor_action": "Signed", "governor_action_date": "2026-04-03"}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 102)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0067&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-849)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0067&item=2&snum=132", "item": 2}, {"label": "Amendment C-B (H-850)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0067&item=3&snum=132", "item": 3}], "amendments": [{"id": "C-A (H-849)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0067