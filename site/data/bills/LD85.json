{"ld": 85, "paper": "HP49", "session": "132", "title": "An Act to Revitalize the Maine Temporary Assistance for Needy Families Advisory Council", "sponsor_id": "h-meyer-michele", "cosponsor_ids": [], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This bill makes the following changes to the laws governing the Maine Temporary Assistance for Needy Families Advisory Council.\n\n1. It changes the matters on which the council provides advice to clarify matters affecting recipients of TANF cash and other TANF recipients.\n\n2. It allows for the removal from the council of a member who fails to attend 2 meetings within a 12-month period.\n\n3. It removes the provision requiring the establishment of a postsecondary education subcommittee.\n\n4. It authorizes compensation, in the amount of the legislative per diem, and reimbursement for expenses for a member who is not otherwise compensated for the member's time serving on the council by the member's employer or the entity the member represents.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0049&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-03-21", "governor_action": "Signed", "governor_action_date": "2025-03-21"}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 85)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0049&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-02-05", "action": "Work Session Held", "result": null}, {"date": "2025-02-05", "action": "Voted", "result": "OTP"}, {"date": "2025-02-11", "action": "Reported Out", "result": "OTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-01-06", "chamber": "House", "action": "Rece