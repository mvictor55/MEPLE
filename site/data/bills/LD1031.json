{"ld": 1031, "paper": "HP660", "session": "132", "title": "An Act to Allow Time-share Associations to Charge Credit Card Surcharges", "sponsor_id": "h-morris-joshua", "cosponsor_ids": ["h-quint-tracy"], "committee_code": "HCIFS", "committee_name": "Health Coverage, Insurance and Financial Services", "summary": {"text": "This bill authorizes a time-share association or managing entity that charges an assessment or fee to impose a surcharge on a time-share owner that uses a credit card or debit card to make payments as long as the surcharge is clearly disclosed prior to payment and the amount of the surcharge does not exceed the costs associated with providing the credit card or debit card service that are directly incurred by the association or managing entity or assessed by an authorized 3rd-party payment service provider for a credit card or debit card transaction.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0660&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-04-08", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 1031)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0660&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-02", "action": "Work Session Held", "result": null}, {"date": "2025-04-02", "action": "Voted", "result": "ONTP"}, {"date": "2025-04-04", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-03-12", "chamber": "House", "action": "Received by the Clerk of the House on March 12, 2025."}, {"date": "2025-03-12", "chamber": "House", "ac