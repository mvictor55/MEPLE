{"ld": 994, "paper": "HP641", "session": "132", "title": "An Act Regarding the Enforcement Provisions of the Law Governing Private Road Maintenance", "sponsor_id": "h-hepler-allison", "cosponsor_ids": ["s-bailey-donna"], "committee_code": "JUD", "committee_name": "Judiciary", "summary": {"text": "This bill provides that if a residential property owner fails to pay that owner's share of the cost of reasonable and necessary repairs to and maintenance of a private road, the payment is delinquent if not paid within 30 days after a demand in writing, which must contain the name of the vendor, the purpose of the repair or maintenance and the date the vendor was paid and must be delivered to that owner at the address set forth in the municipal tax records, and a civil action for payment of the amount owed together with interest from the date of the written demand for payment, filing fees and other costs of collection including reasonable attorney's fees may be brought against that owner by a residential property owner or owners who share a common benefit in the road, either jointly or severally.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0641&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-04-08", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 994)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0641&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-02", "action": "Work Session Held", "result": null}, {"date": "2025-04-02", "action": "Voted", "result": "ONTP"}, {"date": "2025-04-07", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-03-11", "chamber": "House", "action": "Committee on TRANSPORTATION suggested and ordered printed."}, {"date": "2025-03-11", "chamber": "House", "action": "On motion of Representative CRAFTS of Newcastle, the Bill was REFERRED to the Committee on JUDICIARY."}, {"date": "2025-03-11", "chamber": "House", "action": "Sent for concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-03-11", "chamber": "Senate", "action": "The Bill was REFERRED to the Committee on JUDICIARY."}, {"date": "2025-03-11", "chamber": "Senate", "action": "In concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-03-21", "chamber": "House", "action": "Carried over, in the same posture, to the next special or regular session of the 132nd Legislature, pursuant to Joint Order SP 519."}, {"date": "2025-04-02", "chamber": "J", "action": "Work Session Held"}, {"date": "2025-04-02", "chamber": "J", "action": "Voted: ONTP"}, {"date": "2025-04-07", "chamber": "J", "action": "Reported Out: ONTP"}, {"date": "2025-04-08", "chamber": "Senate", "action": "Pursuant to Joint Rule 310.3 Placed in Legislative Files (DEAD)"}], "roll_calls": [], "hearing": {"date": "2025-03-24", "time": "1:00 PM", "location": "State House, Room 438", "committee_code": "JUD", "testimony_count": 6}, "heard_with": [], "tags": ["Roads", "Private Ways"], "affected_statutes": [], "testimony": [{"id": "186678", "name": "Allison Hepler", "organization": "Maine State Legislature", "town": null, "position": "support", "position_source": "inferred", "date": "2025-03-24", "hearing_date": "2025-03-24", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=186678", "has_text": true, "shared_with": []}, {"id": "10038465", "name": "Kathy Maher", "organization": "Cornish", "town": null, "position": null, "position_source": null, "date": "2025-03-24", "hearing_date": "2025-03-24", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=10