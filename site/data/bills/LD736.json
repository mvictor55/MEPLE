{"ld": 736, "paper": "HP478", "session": "132", "title": "An Act to Improve Ferry Service Reliability by Providing Scholarships at the Maine Maritime Academy", "sponsor_id": "h-ray-d", "cosponsor_ids": ["h-dodge-janice"], "committee_code": "EDU", "committee_name": "Education and Cultural Affairs", "summary": {"text": "This bill requires the Maine Maritime Academy to create the Workforce Development Scholarship Program to assist students in earning the initial credits necessary to work at a state, municipal, private or quasi-public ferry service operator located in and serving residents of the State. The bill also requires the Maine Maritime Academy to consult with the Maine State Ferry Service or a state, municipal, private or quasi-public ferry service operator in the development and implementation of the Workforce Development Scholarship Program and jointly develop a method for processing applications.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0478&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-28", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 736)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0478&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-03-24", "action": "Work Session Held", "result": null}, {"date": "2025-03-24", "action": "Voted", "result": "Divided Report"}, {"date": "2025-04-14", "action": "Work Session Reconsidered", "result": null}, {"date": "2025-04-14", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-27", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_i