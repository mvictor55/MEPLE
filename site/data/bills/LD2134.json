{"ld": 2134, "paper": "SP832", "session": "132", "title": "An Act to Create an Exception to the Prohibition of Tobacco Sales in Retail Establishments Containing Pharmacies for Certain Small Grocery Stores (EMERGENCY)", "sponsor_id": "s-curry-glenn", "cosponsor_ids": [], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This bill creates an exception to the provision of law that prohibits a retail establishment that contains a pharmacy from obtaining a retail tobacco license. Under the bill, a grocery store containing a pharmacy is eligible for a retail tobacco license if the store has no more than 26,000 square feet of customer-accessible sales area; the pharmacy was established in the grocery store prior to July 7, 2025 and is independently licensed and operates in a separately demised, leased space; all tobacco sales are made from the grocery store's independent inventory and point-of-sale system; and the grocery store complies with all other requirements under the provisions governing retail tobacco licenses.\n\nThe bill also removes references to the sale of tobacco through vending machines or the practice of giving away tobacco products in the course of trade, both of which were made illegal by Public Law 2025, chapter 367.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0832&item=1&snum=132"}, "status": "enacted", "status_label": "Emergency Enacted", "final_disposition": {"label": "Emergency Enacted", "date": "2026-03-19", "governor_action": "Emergency Signed", "governor_action_date": "2026-03-19"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 2134)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0832&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-521)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0832&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-521)", "des