{"ld": 594, "paper": "SP278", "session": "132", "title": "Resolve, Directing the State Auditor to Audit All State Agencies", "sponsor_id": "s-bradstreet-richard", "cosponsor_ids": ["h-caruso-elizabeth", "h-chapman-quentin", "h-drinkwater-gary", "h-fredericks-ann", "h-greenwood-randall", "h-henderson-rachel", "h-libby-laurel", "h-schmersal-burgess-tammy", "h-underwood-joseph"], "committee_code": "SLG", "committee_name": "State and Local Government", "summary": {"text": "This resolve requires the State Auditor to audit all state agencies and compile a report for each state agency listing the number of current employees; the number of newly hired employees over a period of time; the current and projected budget; the growth of the budget over a period of time; the agency's jurisdiction, roles and responsibilities; the scope of current, completed and incomplete projects over a period of time; and the percentage of the total of the most current state biennial budget the agency's budget represents.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0278&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2025-06-03", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN059401.pdf", "documents": [{"label": "Bill text (LD 594)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0278&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-199)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0278&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-199)", "description": null, "sponsor": null, "status": null, "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0278&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.