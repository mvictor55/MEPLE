{"ld": 1531, "paper": "SP615", "session": "132", "title": "An Act to Better Protect Animal-drawn Vehicles and Motorists on Public Roadways", "sponsor_id": "s-guerin-stacey", "cosponsor_ids": ["h-daigle-lucien", "h-foster-steven", "h-guerrette-timothy"], "committee_code": "TRA", "committee_name": "Transportation", "summary": {"text": "This bill repeals the current law relating to light and reflective gear requirements for animal-drawn vehicles operated on a public way and replaces it with more detailed light and gear requirements for the operation of animal-drawn vehicles at all times and additional requirements for times when there is limited visibility. The bill also provides an exception for animal-drawn agricultural equipment that is not transporting any livestock or a person other than the operator.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0615&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-13", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 1531)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0615&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-01", "action": "Work Session Held", "result": null}, {"date": "2025-05-01", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-07", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-04-08", "chamber": "Senate", "action": "Committee on TRANSPORTATION suggested and ordered printed REFERENCE to the Committee on TRANSPORTATION Ordered sent down forthwith for concurrence"}, {"date": "2025-0