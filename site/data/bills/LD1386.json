{"ld": 1386, "paper": "HP908", "session": "132", "title": "An Act to Provide Emergency One-time Relief from the Wild Blueberry Tax for Sellers in Maine and Partial Relief for Processors and Shippers (EMERGENCY)", "sponsor_id": "h-strout-tiffany", "cosponsor_ids": ["h-arata-amy", "h-faulkingham-william", "h-libby-laurel", "s-martin-joseph", "h-mingo-arthur", "s-moore-marianne", "h-tuell-william"], "committee_code": "TAX", "committee_name": "Taxation", "summary": {"text": "Current law imposes a tax at the rate of 1 1/2 cents per pound on wild blueberries shipped or processed in the State; 1/2 of the tax is paid by the seller and 1/2 of the tax is paid by the processor or the shipper. This bill exempts sellers of blueberries harvested in the State from the imposition of the blueberry tax for the 2025 calendar year, which will result in a tax of 0.75 cents per pound on processors and shippers for blueberries harvested in the State. Processors and shippers continue to be responsible for collecting and paying the tax on blueberries harvested outside the State.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0908&item=1&snum=132"}, "status": "died", "status_label": "Died Between Houses", "final_disposition": {"label": "Died Between Houses", "date": "2025-06-17", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1386)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0908&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-742)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0908&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-742)", "description": "Change Title", "sponsor": null, "status": "Adopted by House", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0908&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fi