{"ld": 592, "paper": "SP276", "session": "132", "title": "Resolve, to Study Laws Regarding Endangering the Welfare of a Child (TITLE CHANGE)", "sponsor_id": "s-baldacci-joseph", "cosponsor_ids": ["s-rafferty-joseph"], "committee_code": "CJPS", "committee_name": "Criminal Justice and Public Safety", "summary": {"text": "The current Class D crime of endangering the welfare of a child under the Maine Revised Statutes, Title 17-A, section 554, subsection 1, paragraph C is established when a person violates a duty of care or protection to a child and thereby recklessly endangers the child. This bill amends the provision to describe the crime by attaching the culpable mental state element of recklessness to the violation of the duty. The bill amends the laws governing the crime by enacting more serious penalty provisions if a person's reckless violation of the duty of care or protection results in serious bodily injury to or death of a child. If the child suffers serious bodily injury as a result, the crime is a Class C crime; if the child dies, the crime is a Class B crime.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0276&item=1&snum=132"}, "status": "died", "status_label": "Died On Adjournment", "final_disposition": {"label": "Died On Adjournment", "date": "2026-04-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 592)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0276&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-385)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0276&item=2&snum=132", "item": 2}, {"label": "Amendment C-B (S-386)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0276&item=3&snum=132", "item": 3}], "amendments": [{"id": "C-A (S-385)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legis