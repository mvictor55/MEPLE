{"ld": 1216, "paper": "SP505", "session": "132", "title": "An Act to Improve Behavioral Health Crisis Services and Suicide Prevention Services", "sponsor_id": "s-nangle-timothy", "cosponsor_ids": [], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This bill is a concept draft pursuant to Joint Rule 208.\n\nThis bill would improve the quality of and access to behavioral health crisis services; reduce the stigma surrounding suicide, mental health conditions and substance use disorder; provide a behavioral health crisis response that is substantially equivalent to the response already provided to individuals who require emergency physical health care in the State; strengthen the crisis response for children, youth, young persons and families; and codify the name of the 988 telephone number for the national suicide and crisis hotline.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0505&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2026-04-03", "governor_action": "Signed", "governor_action_date": "2026-04-03"}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 1216)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0505&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-561)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0505&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-561)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0505&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN121602.pdf"}], "committee_actions": [{"date": "2025-05-22", "action": "Work Session Held", "result": "TABLED"}, {"date": "2025-05-23", "action": "Carry Over Requested", "result": null}