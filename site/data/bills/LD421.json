{"ld": 421, "paper": "HP275", "session": "132", "title": "An Act to Eliminate Barriers to Reentry into the Community After Incarceration by Repealing Certain Driver's License Suspension Provisions", "sponsor_id": "h-milliken-nina", "cosponsor_ids": ["h-ankeles-daniel", "h-boyer-david", "h-crafts-lydia", "h-lee-adam", "h-libby-laurel", "h-sinclair-david"], "committee_code": "CJPS", "committee_name": "Criminal Justice and Public Safety", "summary": {"text": "This bill repeals provisions in the Maine Criminal Code that authorize the court to suspend a person's driver's license, permit, privilege to operate a motor vehicle or right to apply for or obtain a license for a period not to exceed 5 years if the person uses a motor vehicle to facilitate:\n\n1. The trafficking of a scheduled drug; 2. The trafficking or furnishing of a counterfeit drug; 3. The aggravated trafficking in a scheduled drug; 4. The aggravated trafficking in or furnishing of a counterfeit drug; 5. The aggravated furnishing of a scheduled drug; 6. The aggravated cultivating of marijuana; 7. The unlawful furnishing of a scheduled drug; or 8. The aggravated illegal importation of a scheduled drug.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0275&item=1&snum=132"}, "status": "died", "status_label": "Died Between Houses", "final_disposition": {"label": "Died Between Houses", "date": "2025-05-22", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 421)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0275&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-16", "action": "Work Session Held", "result": null}, {"date": "2025-04-16", "action": "Voted", "result": "Divided Report"}, {"date": "2025-05-08", "action": "Reported Out", "result": "ONTP/OTP"}], "committee_reports": [{"label": "Majority report", "recommendat