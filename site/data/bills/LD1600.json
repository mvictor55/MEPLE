{"ld": 1600, "paper": "HP1058", "session": "132", "title": "An Act to Provide Regional Support Funding for Municipal Police Departments to Support Special Response Teams", "sponsor_id": "h-ankeles-daniel", "cosponsor_ids": ["h-crockett-edward", "h-faircloth-sean", "h-mastraccio-anne-marie", "h-moonen-matthew", "h-murphy-kelly", "h-roeder-amy", "h-rollins-david"], "committee_code": "CJPS", "committee_name": "Criminal Justice and Public Safety", "summary": {"text": "This bill creates the Special Response Team Fund to reimburse municipalities that maintain and operate special response teams, which are elite tactical law enforcement teams certified by the Maine Criminal Justice Academy that rapidly respond to high-risk law enforcement operations and conduct criminal investigations that exceed the capabilities of standard law enforcement agencies and require specialized training, equipment and tactics. The bill requires each county to contribute annually a pro rata share based upon population of an amount equal to refund 10% of the previous calendar year's expenses that each municipality spent to maintain and operate a special response team.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1058&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-13", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1600)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1058&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-07", "action": "Work Session Held", "result": null}, {"date": "2025-05-07", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-12", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee repo