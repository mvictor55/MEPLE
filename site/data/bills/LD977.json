{"ld": 977, "paper": "HP637", "session": "132", "title": "Resolve, Requiring the Maine Health Data Organization to Develop a Plan for Measuring Gaps in Home and Community-based Services", "sponsor_id": "h-cluchey-sally", "cosponsor_ids": [], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This resolve requires the Maine Health Data Organization to develop a plan for annual measurements of the gap between authorized care and the services actually provided for home and community-based services under the MaineCare program, state-funded programs and the forthcoming lifespan program using existing data. The Department of Health and Human Services is required to provide data to the Maine Health Data Organization upon request. The Maine Health Data Organization must submit a report to the Joint Standing Committee on Health and Human Services no later than January 15, 2026.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0637&item=1&snum=132"}, "status": "enacted", "status_label": "Finally Passed", "final_disposition": {"label": "Finally Passed", "date": "2025-07-01", "governor_action": "Signed", "governor_action_date": "2025-07-01"}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 977)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0637&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-175)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0637&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-175)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0637&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN097702.pdf"}], "committee_actions": [{"date": "2025-03-11", "action": "Refer Approved by Chairs/Leads", "result": "REFER TO OTHER"}, {"dat