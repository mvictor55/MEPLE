{"ld": 927, "paper": "HP592", "session": "132", "title": "An Act to Require Chaplains in School Administrative Units", "sponsor_id": "h-paul-reagan", "cosponsor_ids": ["s-cyrway-scott", "h-eder-john", "h-flynn-paul", "h-foster-steven", "s-haggan-david", "s-harrington-matthew", "s-martin-joseph", "h-white-james"], "committee_code": "EDU", "committee_name": "Education and Cultural Affairs", "summary": {"text": "This bill requires school administrative units to employ or accept as volunteers at least one chaplain to provide support, services or programs to students, staff or parents of students of the school administrative unit. A school chaplain must be certified, licensed or ordained by a faith organization recognized by the United States Department of Defense but is not required to be certified by the Department of Education. A school chaplain must undergo fingerprinting and a criminal background check and may not be listed on a sex offender registry in this State or another jurisdiction. A school chaplain is immune from civil liability for acts and statements made as a school chaplain except for malicious, willful and deliberate acts or statements intended to cause harm or intimidate.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0592&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-04-01", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 927)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0592&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-03-26", "action": "Work Session Held", "result": null}, {"date": "2025-03-26", "action": "Voted", "result": "ONTP"}, {"date": "2025-03-28", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-03-05", "chamber": "House", "action": "Received by the Clerk of the House on March 5, 2025."}, {"date": "2025-03-05", "chamber": "House", "action": "The Bill was REFERRED to the Committee on EDUCATION AND CULTURAL AFFAIRS pursuant to Joint Rule 308.2 and ordered printed pursuant to Joint Rule 401."}, {"date": "2025-03-21", "chamber": "House", "action": "Carried over, in the same posture, to the next special or regular session of the 132nd Legislature, pursuant to Joint Order SP 519."}, {"date": "2025-03-26", "chamber": "J", "action": "Work Session Held"}, {"date": "2025-03-26", "chamber": "J", "action": "Voted: ONTP"}, {"date": "2025-03-28", "chamber": "J", "action": "Reported Out: ONTP"}, {"date": "2025-04-01", "chamber": "Senate", "action": "Pursuant to Joint Rule 310.3 Placed in Legislative Files (DEAD)"}], "roll_calls": [], "hearing": {"date": "2025-03-26", "time": "11:30 AM", "location": "Cross Building, Room 208", "committee_code": "EDU", "testimony_count": 9}, "tags": ["School Personnel", "Guidance Counselors"], "affected_statutes": [], "testimony": [{"id": "10039791", "name": "Abigail Treadwell", "organization": "North Berwick", "town": null, "position": null, "position_source": null, "date": "2025-03-26", "hearing_date": "2025-03-26", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=10039791", "has_text": true}, {"id": "10039796", "name": "Abigail Treadwell", "organization": "North Berwick", "town": null, "position": null, "position_source": null, "date": "2025-03-26", "hearing_date": "2025-03-26", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=10039796", "has_text": true}, {"id": "10039774", "name": "Alicia Rea", "organization": "ACLU of Maine", "town": null, "position": "oppose", "position_source": "inferred", "date": "2025-03-26