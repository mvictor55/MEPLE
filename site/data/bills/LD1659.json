{"ld": 1659, "paper": "HP1100", "session": "132", "title": "An Act to Raise Revenue to Fund Firefighting Equipment Purchases and Training Related to Electric Vehicle Fires Through a Fee on Electric Vehicles", "sponsor_id": "h-hymes-benjamin", "cosponsor_ids": ["s-cyrway-scott", "h-guerrette-timothy", "h-lance-michael", "h-lemelin-michael"], "committee_code": "TRA", "committee_name": "Transportation", "summary": {"text": "This bill establishes the Electric Vehicle Firefighting Fund to provide funds to fire departments in the State to purchase equipment and provide training related to electric vehicle fires. The bill also establishes a fee of $250 on the sale of new and used electric vehicles by a dealer. The bill requires revenue from the fee to be collected by the Secretary of State on behalf of the State Tax Assessor and deposited into the Electric Vehicle Firefighting Fund.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1100&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-20", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1659)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1100&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-07", "action": "Work Session Held", "result": null}, {"date": "2025-05-07", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-13", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-04-15", "chamber": "House", "action": "Committee on HOUSING AND ECONOMIC DEVELOPMENT suggested and ordered printed."}, {"date": "2