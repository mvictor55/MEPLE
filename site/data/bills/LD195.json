{"ld": 195, "paper": "SP95", "session": "132", "title": "An Act to Create the Small Business Capital Savings Account Program", "sponsor_id": "s-stewart-harold", "cosponsor_ids": ["s-baldacci-joseph", "s-bernard-susan", "s-bickford-bruce", "h-faulkingham-william", "h-guerrette-timothy", "h-hall-randall", "s-hickman-craig", "h-pluecker-william", "s-talbot-ross-rachel"], "committee_code": "HED", "committee_name": "Housing and Economic Development", "summary": {"text": "This bill establishes the Small Business Capital Savings Account Program in the Department of Economic and Community Development to certify small businesses engaged in commercial agricultural production, commercial fishing or commercial wood harvesting eligible to claim a tax deduction for contributions made to qualifying small business capital savings accounts to be used for capital expenditures. The bill creates the tax deduction and establishes that withdrawals from the savings accounts are taxable income if not used for capital expenditures.\n\nContributions may be made beginning January 1, 2026 but may not be made after December 31, 2029.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0095&item=1&snum=132"}, "status": "died", "status_label": "Died On Adjournment", "final_disposition": {"label": "Died On Adjournment", "date": "2026-04-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 195)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0095&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-252)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0095&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-252)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0095&item=2&snum=132", "fiscal_note_url": "https: