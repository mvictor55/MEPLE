{"ld": 769, "paper": "SP327", "session": "132", "title": "An Act Regarding Access to Behavioral Health Supports for Adults with Certain Disabilities", "sponsor_id": "s-ingwersen-henry", "cosponsor_ids": [], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This bill amends the law governing access to behavioral health supports for adults with an intellectual disability or autism by replacing a complex multiparty review process with a clinical review requirement. It also removes the authority to use restraints on adults except as an emergency short-term step to protect the adult from imminent injury to that adult or others. It also codifies existing rules on safety devices, making it clear that such devices are not considered positive behavioral health support plans and therefore do not require the same level of review as positive behavioral health support plans. Also, to conform with current practice, the bill repeals a provision of law regarding the authority of providers of residential services to establish house rules in residential units owned or operated by the provider.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0327&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-12", "governor_action": "Signed", "governor_action_date": "2025-06-12"}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 769)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0327&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-234)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0327&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-234)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0327&item=2&snum=132", "fiscal_note_url": "https:/