{"ld": 872, "paper": "HP558", "session": "132", "title": "An Act to Ensure Determinations Made by the State Are Free from Unethical, Unsafe or Illegal Interference by Artificial Intelligence", "sponsor_id": "h-friedmann-gary", "cosponsor_ids": [], "committee_code": "SLG", "committee_name": "State and Local Government", "summary": {"text": "This bill requires the Office of Information Technology within the Department of Administrative and Financial Services to be responsible for creating, maintaining and ensuring the use of a list of approved artificial intelligence software or systems for procurement and use by the State. The bill also prohibits the purchase and use of artificial intelligence software by the State unless the State maintains the sovereign, intentional control of the behavior of the software to enable the State to fully comply with constitutional and legal mandates and secures the right to due process by guaranteeing that residents affected by a decision made by the State with the assistance of the software have an accessible and affordable way to understand, review and appeal the decision.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0558&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2025-06-09", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 872)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0558&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-566)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0558&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-566)", "description": "Change Title", "sponsor": null, "status": null, "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0558&item=2&snum=132", "fiscal_note_ur