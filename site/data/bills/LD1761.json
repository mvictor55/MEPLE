{"ld": 1761, "paper": "HP1179", "session": "132", "title": "An Act to Prohibit Indemnification Agreements", "sponsor_id": "h-morris-joshua", "cosponsor_ids": [], "committee_code": "JUD", "committee_name": "Judiciary", "summary": {"text": "This bill prohibits contract agreements that indemnify or hold harmless the promisee from or against any negligence, claim or liability arising out of an intentional act or omission of the promisee or promisor. Parties to a contract are not prohibited from agreeing that the promisee must be included as an additional insured in an insurance contract. The bill does not affect the validity of workers' compensation or other insurance contracts.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1179&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2026-01-27", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1761)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1179&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-545)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1179&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-545)", "description": "Change Title", "sponsor": null, "status": "Adopted by House", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1179&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN176102.pdf"}], "committee_actions": [{"date": "2025-05-15", "action": "Work Session Held", "result": "TABLED"}, {"date": "2025-05-21", "action": "Work Session Held", "result": null}, {"date": "2025-05-21", "action": "Voted", "result": "ONTP"}, {"date": "2025-06-06", "action": "Reported Out", "result": "OTP-AM"}, {"date": "20