{"ld": 1307, "paper": "SP537", "session": "132", "title": "An Act to Suspend the Remittance Obligation for Paid Family and Medical Leave Private Plan Users (EMERGENCY)", "sponsor_id": "s-bradstreet-richard", "cosponsor_ids": ["s-bickford-bruce", "s-cyrway-scott", "h-flynn-paul", "h-foster-steven", "h-guerrette-timothy", "s-martin-joseph", "s-stewart-harold"], "committee_code": "LAB", "committee_name": "Labor", "summary": {"text": "This bill immediately suspends the payroll premiums imposed on employers under the paid family and medical leave benefits program until January 1, 2026, but allows an employer that wants to participate in the program to continue to pay the premiums. The bill also requires the Department of Labor to amend its rules adopted for the program to establish an expedited process for approval of an employer's substitute private plan that is substantially equivalent to the program and to waive the payroll premiums during consideration of an employer's application for exemption. The rules must be in effect no later than November 1, 2025.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0537&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2025-06-03", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN130702.pdf", "documents": [{"label": "Bill text (LD 1307)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0537&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-197)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0537&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-197)", "description": "Emergency, Change Title", "sponsor": null, "status": null, "url": "https://legislature.maine.gov/legis/bill