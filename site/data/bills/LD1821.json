{"ld": 1821, "paper": "HP1219", "session": "132", "title": "An Act to Ensure Responsible Business Practices by Licensed Firearms Dealers", "sponsor_id": "h-kuhn-amy", "cosponsor_ids": ["s-carney-anne", "h-doudera-victoria", "h-gramlich-lori", "h-lee-adam", "h-moonen-matthew"], "committee_code": "JUD", "committee_name": "Judiciary", "summary": {"text": "This bill requires the Department of Public Safety to adopt rules specifying the minimum security requirements for firearm dealers including the requirement of alarm systems, record retention and site hardening. The bill also designates as a Class C crime falsifying a certification that a firearm dealer is in compliance with department minimum security rules. The bill also creates a civil violation for failure to comply with the minimum security requirements outlined in the bill. Finally, the bill requires firearm dealers and gun shows to post signs informing customers of the crime of endangering the welfare of a child, background check requirements, suicide prevention resources and firearm safety course information.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1219&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2026-04-09", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1821)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1219&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-1029)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1219&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-1029)", "description": null, "sponsor": null, "status": null, "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1219&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/b