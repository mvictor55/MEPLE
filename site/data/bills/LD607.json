{"ld": 607, "paper": "HP375", "session": "132", "title": "An Act to Require the Approval of Superintendent Agreements Regarding Transfers of Students Between School Administrative Units", "sponsor_id": "h-libby-laurel", "cosponsor_ids": ["h-boyer-david", "h-foley-robert", "h-foster-steven", "h-haggan-kimberly", "h-lance-michael", "h-olsen-rolf", "h-poirier-jennifer"], "committee_code": "EDU", "committee_name": "Education and Cultural Affairs", "summary": {"text": "This bill provides that, in the case of a student transferring from one school administrative unit to another, the superintendent of each school administrative unit must approve the transfer if the student's parent approves and the superintendent of the receiving school administrative unit has determined that the school administrative unit has the capacity to enroll the student. A transfer must be approved if the receiving school administrative unit has adequate physical space to enroll the student and enrolling the student would not require additional staff.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0375&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2025-06-02", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 607)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0375&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-12", "action": "Work Session Held", "result": null}, {"date": "2025-05-12", "action": "Voted", "result": "Divided Report"}, {"date": "2025-05-28", "action": "Reported Out", "result": "ONTP/OTP"}], "committee_reports": [{"label": "Majority report", "recommendation": "Ought Not To Pass", "signer_count": 9, "signers": ["Representative Kelly Murphy (Chair)", "Senator Joseph Raffer