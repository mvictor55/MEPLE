{"ld": 218, "paper": "HP141", "session": "132", "title": "An Act to Make Student Transfer Agreements Renew Automatically Except in Certain Circumstances", "sponsor_id": "h-hasenfus-tavis", "cosponsor_ids": ["h-arata-amy"], "committee_code": "EDU", "committee_name": "Education and Cultural Affairs", "summary": {"text": "This bill repeals the provision in current law requiring superintendents to annually review transfers of students to a school administrative unit other than the one in which the student has permanent residence. The bill provides that such transfers must be automatically renewed on an annual basis unless a superintendent determines that the student's attendance is irregular, the student is disruptive, the student does not use best efforts to succeed in class or the transfer is no longer in the best interest of the student.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0141&item=1&snum=132"}, "status": "died", "status_label": "Died Between Houses", "final_disposition": {"label": "Died Between Houses", "date": "2025-06-11", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 218)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0141&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-12", "action": "Work Session Held", "result": null}, {"date": "2025-05-12", "action": "Voted", "result": "Divided Report"}, {"date": "2025-05-20", "action": "Reported Out", "result": "ONTP/OTP"}], "committee_reports": [{"label": "Majority report", "recommendation": "Ought Not To Pass", "signer_count": 9, "signers": ["Representative Kelly Murphy (Chair)", "Senator Joseph Rafferty (Chair)", "Representative Michael Brennan", "Representative Nathan Carlow", "Representative Ed Crockett", "Representative Jan Dodge", "Representative Christina Mitchell", "Senator Teresa Pierce", "Representa