{"ld": 1205, "paper": "SP494", "session": "132", "title": "An Act to Set Limits on Virtual Currency Kiosks", "sponsor_id": "s-tepler-denise", "cosponsor_ids": ["h-arford-poppy", "s-carney-anne", "h-foley-robert", "s-ingwersen-henry"], "committee_code": "HCIFS", "committee_name": "Health Coverage, Insurance and Financial Services", "summary": {"text": "This bill requires licensing of virtual currency kiosk operators, caps fees at the greater of $5 and 3% of the dollar amount of the transaction, establishes a $1,000 per day transaction limit, and requires an operator that allows another person to engage in virtual currency business activity via a virtual currency kiosk owned by that operator to ensure that the person engaging in the virtual currency business activity is licensed and in compliance with applicable provisions governing virtual currency kiosk operators.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0494&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-22", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 1205)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0494&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-01", "action": "Work Session Held", "result": null}, {"date": "2025-05-01", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-21", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-03-20", "chamber": "Senate", "action": "Committee on HEALTH COVERAGE, INSURANCE AND FINANCIAL SERVICES suggested and ordered printed REFERENCE to t