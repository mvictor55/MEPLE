{"ld": 1203, "paper": "SP492", "session": "132", "title": "An Act to Provide Grants to Schools That Contract for Behavioral and Mental Health Services", "sponsor_id": "s-talbot-ross-rachel", "cosponsor_ids": ["s-bennett-richard", "h-carlow-nathan", "h-dodge-janice", "s-ingwersen-henry", "h-mitchell-christina", "s-moore-marianne", "h-murphy-kelly", "s-rafferty-joseph", "s-rotundo-margaret"], "committee_code": "EDU", "committee_name": "Education and Cultural Affairs", "summary": {"text": "3239 This bill establishes a grant program within the Department of Education to provide grants to school administrative units that contract for behavioral and mental health services provided by licensed behavioral and mental health service providers. The bill limits the use of funds provided through the grant program to behavioral and mental health services that are not otherwise covered or reimbursable through the MaineCare program and provides that funds must be used in a manner that does not supplant qualified and available school administrative unit behavioral and mental health staff. The bill also provides that the amounts of the grants must be based on a school administrative unit's need for clinicians and in the amount of $20,000 per clinician prior to July 1, 2027 and $25,000 per clinician beginning July 1, 2027. The bill provides funding for the grants for fiscal years 2025-26 and 2026-27.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0492&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-14", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN120301.pdf", "documents": [{"label": "Bill text (LD 1203)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0492&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-09", "action": "Work Session Held", "result": null}, {"date": "2025-05-09", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-12", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-03-20", "chamber": "Senate", "action": "Committee on EDUCATION AND CULTURAL AFFAIRS suggested and ordered printed REFERENCE to the Committee on EDUCATION AND CULTURAL AFFAIRS Ordered sent down forthwith for concurrence"}, {"date": "2025-03-20", "chamber": "House", "action": "The Bill was REFERRED to the Committee on EDUCATION AND CULTURAL AFFAIRS."}, {"date": "2025-03-20", "chamber": "House", "action": "In concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-03-21", "chamber": "Senate", "action": "CARRIED OVER, in the same posture, to the next special or regular session of the 132nd Legislature, pursuant to Joint Order SP 519."}, {"date": "2025-05-14", "chamber": "Senate", "action": "Pursuant to Joint Rule 310.3 Placed in Legislative Files (DEAD)"}], "roll_calls": [], "hearing": {"date": "2025-04-08", "time": "1:00 PM", "location": "Cross Building, Room 208", "committee_code": "EDU", "testimony_count": 30}, "heard_with": [858], "tags": ["School Programs", "Health Care"], "affected_statutes": [], "testimony": [{"id": "188467", "name": "Adam Bloom-Paicopolos", "organization": "Alliance for Addiction and Mental Health Services", "town": null, "position": null, "position_source": null, "date": "2025-04-08", "hearing_date": "2025-04-08", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=188467", "has_text": true, "shared_with": [858], "person_profile_id": null, "org_profile_id": "org-alliance-for-addiction-and-mental-health-services"}, {"id": "10042887", "name": "Amy Hufnage