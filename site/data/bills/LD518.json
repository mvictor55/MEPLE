{"ld": 518, "paper": "HP336", "session": "132", "title": "Resolve, Increasing Access to Maternal and Child Health Care (EMERGENCY)", "sponsor_id": "h-meyer-michele", "cosponsor_ids": ["s-ingwersen-henry"], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This resolve directs the Department of Health and Human Services to examine barriers to the universal referral of all pregnant or parenting individuals and families to the State's maternal and child health home visiting program, known as \"CradleME,\" and develop recommendations for removing the barriers and increasing referrals. The department is directed to seek input from interested stakeholders in the development of the recommendations and to make its report, including any suggested legislation, to the Joint Standing Committee on Health and Human Services no later than December 3, 2025. The joint standing committee is authorized to submit legislation to the Second Regular Session of the 132nd Legislature.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0336&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-03-27", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "fiscal_note_url": null, "documents": [{"label": "Bill text (LD 518)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0336&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-03-21", "action": "Work Session Held", "result": null}, {"date": "2025-03-21", "action": "Voted", "result": "ONTP"}, {"date": "2025-03-26", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actio