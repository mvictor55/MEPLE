{"ld": 1295, "paper": "SP525", "session": "132", "title": "An Act to Waive Basic Law Enforcement Training Requirements for Full-time Law Enforcement Officers Who Have Successfully Completed Equivalent Courses in Other Jurisdictions", "sponsor_id": "s-moore-marianne", "cosponsor_ids": ["s-bernard-susan", "s-black-russell", "h-boyer-david", "s-cyrway-scott", "s-martin-joseph", "h-mingo-arthur", "h-perkins-chad", "s-stewart-harold", "h-tuell-william"], "committee_code": "CJPS", "committee_name": "Criminal Justice and Public Safety", "summary": {"text": "Current law permits, but does not require, the Board of Trustees of the Maine Criminal Justice Academy to waive basic training requirements for newly employed law enforcement officers that have completed an equivalent basic law enforcement training course. This bill changes the waiver from permissive to mandatory if an officer has completed an equivalent training course. Additionally, the bill directs the board to conduct a study to review the current waiver requirements and suggest legislation to reduce any unnecessary or burdensome requirements that would prevent a law enforcement officer from qualifying for a law enforcement basic training waiver.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0525&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-04-23", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 1295)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0525&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-16", "action": "Work Session Held", "result": null}, {"date": "2025-04-16", "action": "Voted", "result": "ONTP"}, {"date": "2025-04-22", "action": "Reported Out", "result"