{"ld": 1725, "paper": "HP1152", "session": "132", "title": "An Act to Require Reporting Regarding County Jail Boards of Visitors (TITLE CHANGE)", "sponsor_id": "h-nutting-robert", "cosponsor_ids": ["h-arata-amy", "s-cyrway-scott", "h-ducharme-john"], "committee_code": "CJPS", "committee_name": "Criminal Justice and Public Safety", "summary": {"text": "This bill changes the number of members on boards of visitors of jails from 7 to 5 or more. It removes requirements that board members meet specific criteria. It requires a board of visitors to provide a copy of its annual report to the county sheriff. It removes the requirement that a board of visitors provide a copy of its annual report to the joint standing committee of the Legislature having jurisdiction over criminal justice and public safety matters and it removes the requirement that the sheriff provide copies with the sheriff's response to the reports to the joint standing committee of the Legislature having jurisdiction over criminal justice and public safety matters. It also removes the requirement that a board of visitors appear before the joint standing committee of the Legislature having jurisdiction over criminal justice and public safety matters upon request.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1152&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-17", "governor_action": "Signed", "governor_action_date": "2025-06-17"}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 1725)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1152&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-573)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1152&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-573)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "ht