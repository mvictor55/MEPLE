{"ld": 1878, "paper": "HP1249", "session": "132", "title": "An Act to Establish a Managed Care Program for MaineCare Services", "sponsor_id": "h-stover-holly", "cosponsor_ids": ["h-brennan-michael", "h-ducharme-john", "h-graham-anne", "h-gramlich-lori", "h-javner-kathy", "s-moore-marianne", "s-reny-cameron", "h-shagoury-daniel", "s-stewart-harold"], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This bill establishes a managed care program for MaineCare services.\n\nThe bill requires the Department of Health and Human Services to issue a request for proposals to contract with 3 managed care organizations to provide MaineCare services. Managed care refers to a system of delivering services through arrangements with selected providers to furnish health care services and financial incentives for patients to use the participating providers and procedures included in the managed care program. The model also requires that the department reimburse the managed care organizations primarily using negotiated monthly rate per enrollee, rather than a fee-for-service model.\n\nThe bill establishes a number of requirements for developing the procurement process and essential contract terms. The bill establishes deadlines by which specific categories of eligible enrollees must be enrolled in the managed care program, beginning February 1, 2029. The department must submit a report to the Legislature by December 3, 2025 detailing its plan for implementing the program within the timeline established by this legislation. The bill also includes a deadline of April 1, 2026, by which time the department must submit all waivers and amendments for the state Medicaid plan that are necessary to implement this legislation. The department is authorized to adopt rules. Rules adopted are considered major substantive rules under the Maine Administrative Procedure Act.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1249&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-27", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1878)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1249&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-21", "action": "Work Session Held", "result": null}, {"date": "2025-05-21", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-23", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-05-01", "chamber": "House", "action": "Received by the Clerk of the House on May 1, 2025."}, {"date": "2025-05-01", "chamber": "House", "action": "The Bill was REFERRED to the Committee on HEALTH AND HUMAN SERVICES pursuant to Joint Rule 308.2 and ordered printed pursuant to Joint Rule 401."}, {"date": "2025-05-21", "chamber": "J", "action": "Work Session Held"}, {"date": "2025-05-21", "chamber": "J", "action": "Voted: ONTP"}, {"date": "2025-05-23", "chamber": "J", "action": "Reported Out: ONTP"}, {"date": "2025-05-27", "chamber": "Senate", "action": "Pursuant to Joint Rule 310.3 Placed in Legislative Files (DEAD)"}], "roll_calls": [], "hearing": {"date": "2025-05-12", "time": "10:00 AM", "location": "Cross Building, Room 209", "committee_code": "HHS", "testimony_count": 20}, "heard_with": [], "tags": ["Medicaid", "Mainecare"], "affected_statutes": [], "testimony": [{"id": "10055412", "name": "Adam Bloom-Paicopolos", "organization": "Alliance for Addiction & Mental Health Services, Maine", "town": null, "position": "oppose", "position_source": "inferred", "date": "2025-05-12", "hearing_d