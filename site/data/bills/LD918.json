{"ld": 918, "paper": "HP583", "session": "132", "title": "An Act to Allow a Qualifying Religious Organization to Self-insure for Automobile Insurance", "sponsor_id": "h-foster-steven", "cosponsor_ids": ["h-babin-mark", "s-bennett-richard", "h-cimino-marygrace", "h-cluchey-sally", "h-faulkingham-william", "s-guerin-stacey", "s-haggan-david", "h-morris-joshua", "h-wadsworth-nathan"], "committee_code": "HCIFS", "committee_name": "Health Coverage, Insurance and Financial Services", "summary": {"text": "This bill provides authorization for qualifying religious organizations to satisfy the requirements for financial responsibility to operate a motor vehicle registered in this State through self-insurance. The bill sets forth the requirements that must be met before the Secretary of State may grant a certificate of self-insurance to a religious organization and its members. The bill authorizes a member of the qualifying religious organization to provide that certificate of self-insurance as evidence of financial responsibility to register a motor vehicle owned or operated by that member.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0583&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2025-05-14", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN091801.pdf", "documents": [{"label": "Bill text (LD 918)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0583&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-124)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0583&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-124)", "description": "Change Title", "sponsor": null, "status": null, "url": "https://legislature.maine.gov