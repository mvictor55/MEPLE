{"ld": 1234, "paper": "HP809", "session": "132", "title": "An Act Regarding Cellular Telephones in Public Schools (TITLE CHANGE)", "sponsor_id": "h-campbell-richard", "cosponsor_ids": [], "committee_code": "EDU", "committee_name": "Education and Cultural Affairs", "summary": {"text": "This bill requires school administrative units to require that all public schools adopt and enforce a policy that prohibits students from possessing cellular telephones in a classroom. A policy developed by a school must contain an exception that allows a student to possess a cellular telephone in a classroom in certain emergency circumstances. This provision does not require schools to prohibit students from possessing cellular telephones on school property in a place other than a classroom.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0809&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-09", "governor_action": "Signed", "governor_action_date": "2025-06-09"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1234)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0809&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-317)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0809&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-317)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0809&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN123402.pdf"}], "committee_actions": [{"date": "2025-05-02", "action": "Work Session Held", "result": null}, {"date": "2025-05-02", "action": "Voted", "result": "Divided Report"}, {"date": "2025-05-28", "action": "Reported Out", "result": "OTP-AM/ONTP"}], "committee_reports": [{"label":