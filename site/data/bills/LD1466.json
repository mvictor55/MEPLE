{"ld": 1466, "paper": "HP958", "session": "132", "title": "An Act Related to Excusing a School from Making Up Missed Days When It Cannot Operate During a Declared State of Emergency", "sponsor_id": "h-collamore-amanda", "cosponsor_ids": ["h-collins-alicia", "h-dill-james", "s-grohoski-nicole", "s-haggan-david", "h-haggan-kimberly", "s-libby-james", "h-strout-tiffany"], "committee_code": "EDU", "committee_name": "Education and Cultural Affairs", "summary": {"text": "This bill requires the Commissioner of Education to exempt a school from making up missed instructional days in cases when the school is located in a section of the State for which a state of emergency has been declared by the Governor and the school was in fact unable to operate due to circumstances or conditions related to the reason for the emergency proclamation. The bill requires the Department of Education to update its rules and requires that the rules clarify that a school requesting the exemption may not be required to submit a waiver application.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0958&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2025-06-04", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 1466)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0958&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-425)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0958&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-425)", "description": null, "sponsor": null, "status": null, "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0958&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN146602.pdf"}], "committee_action