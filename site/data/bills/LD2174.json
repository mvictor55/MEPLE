{"ld": 2174, "paper": "HP1462", "session": "132", "title": "An Act to Replace the Maine Waterway Development and Conservation Act with the Maine Renewable Energy and Associated Transmission Development and Conservation Act (EMERGENCY)", "sponsor_id": "h-kessler-christopher", "cosponsor_ids": [], "committee_code": "ENR", "committee_name": "Environment and Natural Resources", "summary": {"text": "This bill repeals the Maine Waterway Development and Conservation Act, which governs permits and certifications for hydropower projects. The bill enacts the Maine Renewable Energy and Associated Transmission Development and Conservation Act, which prohibits the construction, reconstruction or expansion of a renewable or clean energy project without first obtaining a permit from the Department of Environmental Protection. It defines \"renewable or clean energy project\" as any development that uses a 5-megawatt or greater clean resource for the purpose of generating electrical power. The bill directs the department to, within 60 days after the effective date of this legislation, initiate rulemaking to establish, under the site location of development laws, a permit-by- rule process for renewable or clean energy projects.\n\nThe bill also specifies that rules adopted by the Department of Environmental Protection to establish permit-by-rule processes under the site location of development laws are routine technical rules.\n\nOther than the repeal of the Maine Waterway Development and Conservation Act, this bill does not include amendments to or repeal of sections of the Maine Revised Statutes that may be necessary to administer and implement the Maine Renewable Energy and Associated Transmission Development and Conservation Act. It also does not include amendments to or repeal of sections of the Maine Revised Statutes necessary to correct and update any cross-references in the statutes to provisions of law repealed in this bill.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1462&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2026-03-12", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 2174)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1462&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2026-03-04", "action": "Work Session Held", "result": null}, {"date": "2026-03-04", "action": "Voted", "result": "ONTP"}, {"date": "2026-03-10", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2026-01-27", "chamber": "House", "action": "Committee on Environment and Natural Resources suggested and ordered printed."}, {"date": "2026-01-27", "chamber": "House", "action": "The Bill was REFERRED to the Committee on ENVIRONMENT AND NATURAL RESOURCES."}, {"date": "2026-01-27", "chamber": "House", "action": "Sent for concurrence. ORDERED SENT FORTHWITH."}, {"date": "2026-01-27", "chamber": "Senate", "action": "The Bill was REFERRED to the Committee on ENVIRONMENT AND NATURAL RESOURCES  in concurrence"}, {"date": "2026-03-12", "chamber": "Senate", "action": "Pursuant to Joint Rule 310.3 Placed in Legislative Files (DEAD)"}], "roll_calls": [], "hearing": {"date": "2026-02-25", "time": "1:00 PM", "location": "Cross Building, Room 216", "committee_code": "ENR", "testimony_count": 83}, "heard_with": [], "tags": ["Dams", "Licensing"], "affected_statutes": [], "testimony": [{"id": "10061104", "name": "Adam Gaal", "organization": null, "town": "Millinocket", "position": null, "position_source": null, "date": "2026-02-25", "hearing_date": "2026-02-25", "url": "htt