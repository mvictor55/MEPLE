{"ld": 671, "paper": "HP439", "session": "132", "title": "An Act to Abolish the Maine Income Tax and Establish a Zero-based Budget", "sponsor_id": "h-libby-laurel", "cosponsor_ids": ["h-boyer-david", "s-haggan-david", "h-haggan-kimberly", "h-mingo-arthur", "h-morris-joshua", "h-olsen-rolf"], "committee_code": "TAX", "committee_name": "Taxation", "summary": {"text": "This bill eliminates the Maine income tax beginning January 1, 2026. It requires the Department of Administrative and Financial Services to review provisions of law that refer to income tax and submit a report, including suggested legislation, to the Second Regular Session of the 132nd Legislature identifying necessary changes to implement the elimination. The bill also requires the development of a new budgeting system in which agencies would be subject to zero-based budgeting every 8 years and in the interim years be subject to review and alternative budget requirements.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0439&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2025-05-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 671)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0439&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-299)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0439&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-299)", "description": "Change Title", "sponsor": null, "status": null, "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0439&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN067102.pdf"}], "committee_actions": [{"date": "2025-03-19", "action": "Work Session Held", "result": n