{"ld": 1815, "paper": "SP703", "session": "132", "title": "An Act to Require a Blood Test for Drugs for Drivers Involved in a Motor Vehicle Accident That Results in Serious Bodily Injury or Death", "sponsor_id": "s-cyrway-scott", "cosponsor_ids": ["s-bailey-donna", "h-dill-james", "h-flynn-paul", "h-graham-anne", "s-harrington-matthew", "h-paul-reagan", "h-perkins-chad", "h-shagoury-daniel", "h-thorne-james"], "committee_code": "CJPS", "committee_name": "Criminal Justice and Public Safety", "summary": {"text": "This bill does the following.\n\n1. It requires an operator of a motor vehicle to submit to a blood test for drugs when the operator is involved in an accident where there is probable cause to believe that death or serious bodily injury has occurred or will occur as a result of the accident. 2. It allows the blood test to be admissible at trial if the court reviews all available evidence, with the exception of the blood test, and the court determines that probable cause exists to believe that the operator was under the influence of THC at the time of the accident.\n\n3. It requires that the Secretary of State suspend an operator's license for one year if the operator fails to submit to a blood test that is required under this bill. However, the bill requires that the suspension be removed if the person can show that the person was not under the influence of THC or that the person did not negligently cause the accident.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0703&item=1&snum=132"}, "status": "died", "status_label": "Died Between Houses", "final_disposition": {"label": "Died Between Houses", "date": "2025-06-16", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN181502.pdf", "documents": [{"label": "Bill text (LD 1815)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0703&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-371)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0703&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-371)", "description": "Change Title", "sponsor": null, "status": "Adopted by Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0703&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN181502.pdf"}], "committee_actions": [{"date": "2025-05-14", "action": "Work Session Held", "result": null}, {"date": "2025-05-14", "action": "Voted", "result": "Divided Report"}, {"date": "2025-06-12", "action": "Reported Out", "result": "ONTP/OTP-AM"}], "committee_reports": [{"label": "Majority report", "recommendation": "Ought Not To Pass", "signer_count": 7, "signers": ["Senator Anne Beebe-Center (Chair)", "Representative Tavis Hasenfus (Chair)", "Representative Mana Abdi", "Representative Stephan Bunker", "Representative Michel Lajoie", "Representative Grayson Lookner", "Representative Nina Milliken"], "signer_ids": ["s-beebe-center-anne", "h-hasenfus-tavis", "h-abdi-mana", "h-bunker-stephan", "h-lajoie-michel", "h-lookner-grayson", "h-milliken-nina"]}, {"label": "Minority report", "recommendation": "Ought To Pass As Amended", "signer_count": 6, "signers": ["Representative Donald Ardell", "Senator Chip Curry", "Senator Scott Cyrway", "Representative Mathew McIntyre", "Representative Robert Nutting", "Representative Chad Perkins"], "signer_ids": ["h-ardell-donald", "s-curry-glenn", "s-cyrway-scott", "h-mcintyre-mathew", "h-nutting-robert", "h-perkins-chad"]}], "chamber_actions": [{"date": "2025-04-29", "chamber": "Senate", "action": "Committee on CRIMINAL JUSTICE AND PUBLIC SAFETY suggested and ordered printed REFERENCE to the Committee on CRIMINAL JUSTICE AND PUBLIC SAFETY Ordered sent down forthwith for concurrence"}, {"date": "2025-04-29", "chamber": "House", "action": "The Bill