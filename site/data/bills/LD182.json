{"ld": 182, "paper": "HP115", "session": "132", "title": "An Act to Provide Per Diem Payments for MaineCare Residents of the Maine Veterans' Homes (TITLE CHANGE)", "sponsor_id": "h-supica-laura", "cosponsor_ids": [], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This bill requires the Department of Health and Human Services to establish reimbursement rates for Maine Veterans' Homes services covered by the MaineCare program. It requires the MaineCare program to reimburse veterans' facilities for covered services on a per resident daily rate basis that will reimburse the portion of the total MaineCare allowable cost of operating each veterans' facility attributable to the provision of services to residents who receive MaineCare benefits. It requires the department to index the rates to inflation annually and authorizes the department to contract with a 3rd party to derive or review the rates.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0115&item=1&snum=132"}, "status": "died", "status_label": "Died On Adjournment", "final_disposition": {"label": "Died On Adjournment", "date": "2026-04-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 182)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0115&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-702)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0115&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-702)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0115&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN018202.pdf"}], "committee_actions": [{"date": "2025-05-20", "action": "Work Session Held", "result": null}, {"date":