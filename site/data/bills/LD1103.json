{"ld": 1103, "paper": "SP466", "session": "132", "title": "An Act Regarding Unallocated Balances in a School Administrative Unit School Budget", "sponsor_id": "s-rafferty-joseph", "cosponsor_ids": ["h-dodge-janice", "h-haggan-kimberly", "h-mitchell-christina", "h-sargent-holly"], "committee_code": "EDU", "committee_name": "Education and Cultural Affairs", "summary": {"text": "This bill modifies the provision of law related to carrying forward general operating fund unallocated balances at the end of a school administrative unit's fiscal year. Under current law, unallocated balances in excess of 5% of the previous fiscal year's school budget must be used to reduce the state and local share of the total allocation for the purposes of computing state subsidy and school boards may carry forward unallocated balances in excess of 5% of the previous year's school budget and disburse the funds over a period not to exceed 3 years, except for in fiscal years 2021-22, 2022-23, 2023-24 and 2024-25, during which time the applicable percentage threshold is 9% of the previous year's school budget, not 5%.\n\nThe bill modifies this provision to provide that the temporary percentage threshold of 9% applies to all future fiscal years.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0466&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-09", "governor_action": "Signed", "governor_action_date": "2025-06-09"}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 1103)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0466&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-16", "action": "Work Session Held", "result": null}, {"date": "2025-05-16", "action": "Voted", "result": "Divided Report"}, {"date": "2025-05-22", "action": "Reported Out", "result": "OTP/ONTP"}], "committee_r