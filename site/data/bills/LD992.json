{"ld": 992, "paper": "SP426", "session": "132", "title": "An Act to Protect Consumers from Hidden Fees and Ensure Transparent Pricing for Live Event Tickets and Short-term Lodging", "sponsor_id": "s-nangle-timothy", "cosponsor_ids": ["s-larsen-daughtry-matthea"], "committee_code": "HED", "committee_name": "Housing and Economic Development", "summary": {"text": "This bill requires persons selling tickets to entertainment events and renting short-term lodging to fully disclose all mandatory fees and display the total price of the ticket or lodging more prominently than other pricing information. The bill requires enforcement by the Attorney General, allows for a private cause of action by a consumer harmed by a violation of the prize disclosure requirements and provides that a person who violates the price disclosure requirements is subject to treble damages and a penalty not to exceed $5,000 for each violation.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0426&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2025-05-22", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 992)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0426&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-03", "action": "Work Session Held", "result": null}, {"date": "2025-04-03", "action": "Voted", "result": "Divided Report"}, {"date": "2025-05-20", "action": "Reported Out", "result": "ONTP/OTP"}], "committee_reports": [{"label": "Majority report", "recommendation": "Ought Not To Pass", "signer_count": 10, "signers": ["Representative Traci Gere (Chair)", "Senator Donna Bailey", "Representative Amanda Collamore", "Representative John Eder", "Representative Cheryl Golek", "Representative Marc Malon", "Representative Arthur Mingo", "Representative Tiffany Roberts", "Representative Mark Walker", "Representative Yusuf Yusuf"], "signer_ids": ["h-gere-traci", "s-bailey-donna", "h-collamore-amanda", "h-eder-john", "h-golek-cheryl", "h-malon-marc", "h-mingo-arthur", "h-walker-mark", "h-yusuf-yusuf"]}, {"label": "Minority report", "recommendation": "Ought To Pass", "signer_count": 2, "signers": ["Senator Chip Curry (Chair)", "Representative Cassie Julia"], "signer_ids": ["s-curry-glenn", "h-julia-cassie"]}], "chamber_actions": [{"date": "2025-03-11", "chamber": "Senate", "action": "Committee on HOUSING AND ECONOMIC DEVELOPMENT suggested and ordered printed REFERENCE to the Committee on HOUSING AND ECONOMIC DEVELOPMENT Ordered sent down forthwith for concurrence"}, {"date": "2025-03-11", "chamber": "House", "action": "The Bill was REFERRED to the Committee on HOUSING AND ECONOMIC DEVELOPMENT."}, {"date": "2025-03-11", "chamber": "House", "action": "In concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-03-21", "chamber": "Senate", "action": "CARRIED OVER, in the same posture, to the next special or regular session of the 132nd Legislature, pursuant to Joint Order SP 519."}, {"date": "2025-05-20", "chamber": "Senate", "action": "Reports Read"}, {"date": "2025-05-20", "chamber": "Senate", "action": "On motion by Senator CURRY of Waldo the Majority Ought Not to Pass Report ACCEPTED."}, {"date": "2025-05-20", "chamber": "Senate", "action": "Ordered sent down forthwith for concurrence"}, {"date": "2025-05-22", "chamber": "House", "action": "Reports READ."}, {"date": "2025-05-22", "chamber": "House", "action": "On motion of Representative GERE of Kennebunkport, the Majority Ought Not to Pass Report was ACCEPTED."}, {"date": "2025-05-22", "chamber": "House", "action": "In concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-05-22", "chamber": "House", "action": "Placed in the Legislative Files. (DEAD)"}], "roll_calls": [], "hearing": {"date": "2025-03-27", "time"