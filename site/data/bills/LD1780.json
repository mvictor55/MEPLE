{"ld": 1780, "paper": "HP1191", "session": "132", "title": "An Act to Secure Under Authority of a Subpoena Pretrial Statements from a Witness Other than the Defendant in a Criminal Proceeding", "sponsor_id": "h-sinclair-david", "cosponsor_ids": [], "committee_code": "JUD", "committee_name": "Judiciary", "summary": {"text": "This bill allows a defendant to request that any person with information relevant to the proceeding give a statement upon being served a written notice of statement no later than 14 days before the date scheduled for the statement to be taken. The bill provides a procedure to bar a person who fails to appear for a scheduled statement from appearing as a witness in any case on the topic described in the notice of statement. The bill also allows a person to terminate a statement if the examination is being conducted in bad faith.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1191&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2025-06-16", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1780)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1191&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-720)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1191&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-720)", "description": null, "sponsor": null, "status": null, "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1191&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN178002.pdf"}], "committee_actions": [{"date": "2025-05-13", "action": "Work Session Held", "result": null}, {"date": "2025-05-13", "action": "Voted", "result": "Divided Report"}, {"date": "2025-06-13"