{"ld": 241, "paper": "SP107", "session": "132", "title": "An Act to Authorize the Public Utilities Commission to Approve Rate Adjustments for Low-income Water Utility Ratepayers", "sponsor_id": "s-lawrence-mark", "cosponsor_ids": [], "committee_code": "EUT", "committee_name": "Energy, Utilities and Technology", "summary": {"text": "This bill allows a water utility or group of water utilities to petition the Public Utilities Commission to approve a low-income assistance program to allow qualifying low-income residential ratepayers to receive a discount or credit applying to the amount the residential ratepayer would otherwise owe to the water utility. The bill requires the commission to approve the rate change if it determines that the proposal is a cost-effective way to keep water affordable for low-income residential ratepayers.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0107&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-05-29", "governor_action": "Signed", "governor_action_date": "2025-05-29"}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 241)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0107&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-82)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0107&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-82)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0107&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN024102.pdf"}], "committee_actions": [{"date": "2025-03-12", "action": "Work Session Held", "result": null}, {"date": "2025-03-12", "action": "Voted", "result": "Divided Report"}, {"date": "2025-05-14", "action": "Reported Out", "result"