{"ld": 363, "paper": "SP155", "session": "132", "title": "An Act to Authorize a General Fund Bond Issue to Create the School Capital Improvement Fund", "sponsor_id": "s-carney-anne", "cosponsor_ids": ["h-boyer-michelle", "s-haggan-david", "h-hepler-allison", "s-libby-james", "s-pierce-teresa", "s-tepler-denise"], "committee_code": "AFA", "committee_name": "Appropriations and Financial Affairs", "summary": {"text": "This bill is a concept draft pursuant to Joint Rule 208.\n\nThis bill would authorize a General Fund bond issue in order to create the School Capital Improvement Fund. The fund would be available to any school district, subject to eligibility criteria such as the condition and age of the school facility to be renovated or replaced. Funds would be available to school districts on a one-to-one matching basis.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0155&item=1&snum=132"}, "status": "died", "status_label": "Died On Adjournment", "final_disposition": {"label": "Died On Adjournment", "date": "2026-04-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 363)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0155&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-06-25", "action": "Carry Over Approved", "result": null}], "committee_reports": [], "chamber_actions": [{"date": "2025-01-30", "chamber": "Senate", "action": "Received by the Secretary of the Senate on January 30, 2025 and REFERRED to the Committee on APPROPRIATIONS AND FINANCIAL AFFAIRS pursuant to Joint Rule 308.2"}, {"date": "2025-03-21", "chamber": "Senate", "action": "CARRIED OVER, in the same posture, to the next special or regular session of the 132nd Legislature, pursuant to Joint Order SP 519."}, {"date": "2025-06-25", "chamber": "J", "action": "Carry Over Approved"}, {"date": "2025-06-25", "cha