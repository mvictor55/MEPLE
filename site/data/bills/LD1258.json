{"ld": 1258, "paper": "HP833", "session": "132", "title": "An Act to Include Qualified Out-of-state Electric Vehicle Providers and Clarify Provisions Regarding Electric Bicycles Under the Electric Vehicle Fund", "sponsor_id": "h-warren-sophia", "cosponsor_ids": [], "committee_code": "EUT", "committee_name": "Energy, Utilities and Technology", "summary": {"text": "This bill amends the law establishing the Electric Vehicle Fund incentive program to include that an electric vehicle may also be purchased or leased from an out-of-state authorized licensee of the original equipment manufacturer or an out-of-state licensed automobile dealer if the seller or lessor meets all requirements applicable to in-state sellers or lessors as determined by the trust. For a vehicle to be eligible for the incentive program under current law, a purchase or lease from an authorized licensee of the original equipment manufacturer or a licensed automobile dealer must be from licensees or dealers located in the State. The bill also clarifies the eligibility requirements applicable to incentives for electric bicycles under the incentive program.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0833&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-15", "governor_action": "Unsigned", "governor_action_date": "2025-06-15"}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 1258)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0833&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-17", "action": "Work Session Held", "result": null}, {"date": "2025-04-17", "action": "Voted", "result": "Divided Report"}, {"date": "2025-05-28", "action": "Reported Out", "result": "OTP/ONTP"}], "committee_reports": [{"label": "Majority report", "recommendation": "Ought To Pass", "signer_count": 8, "signers