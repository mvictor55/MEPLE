{"ld": 1207, "paper": "SP496", "session": "132", "title": "An Act to Amend the Site Location of Development Laws to Require a 100-foot Buffer Between Solar Energy Developments and Rivers, Streams and Brooks (TITLE CHANGE)", "sponsor_id": "s-black-russell", "cosponsor_ids": ["h-babin-mark", "s-bickford-bruce", "h-cooper-mark", "h-cray-dean", "h-guerrette-timothy", "h-hall-randall", "h-jackson-caldwell", "h-perkins-chad", "s-timberlake-jeffrey"], "committee_code": "ENR", "committee_name": "Environment and Natural Resources", "summary": {"text": "This bill directs the Department of Environmental Protection, in consultation with the Department of Inland Fisheries and Wildlife, to establish, adopt rules for and administer a program to monitor air and water temperatures surrounding solar energy developments. Under the bill, \"solar energy development\" is defined as a development occupying 3 or more acres that uses a solar energy system consisting of ground-mounted solar panels to convert solar energy to electrical energy for sale or use by a person other than the generator.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0496&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-05-23", "governor_action": "Signed", "governor_action_date": "2025-05-23"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1207)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0496&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-65)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0496&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-65)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0496&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd