{"ld": 1609, "paper": "HP1063", "session": "132", "title": "An Act Regarding Background Checks for Medical Cannabis Providers (TITLE CHANGE)", "sponsor_id": "h-fredericks-ann", "cosponsor_ids": ["h-ardell-donald", "h-boyer-david", "h-henderson-rachel", "h-perkins-chad", "h-soboleski-michael", "s-stewart-harold"], "committee_code": "VLA", "committee_name": "Veterans and Legal Affairs", "summary": {"text": "This bill requires the Department of Administrative and Financial Services, Office of Cannabis Policy to deny a license under the Cannabis Legalization Act to any person associated with organized crime as identified by state or federal law enforcement officers within the 5 years prior to application. It requires the office to deny a license to any person who operates a cannabis establishment at a physical location known to be associated with organized crime within the 5 years before the finding of the association as identified by state or federal law enforcement officers. It also requires the office to revoke, for a period of 5 years, a license currently held by a licensee if the person or the physical location of a licensed cannabis establishment is known to be associated with organized crime as identified by state or federal law enforcement officers. These requirements also apply to registrations issued under the Maine Medical Use of Cannabis Act.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1063&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2026-04-03", "governor_action": "Signed", "governor_action_date": "2026-04-03"}, "fiscal_status": "Not Yet Determined", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN160902.pdf", "documents": [{"label": "Bill text (LD 1609)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1063&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-874)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1063&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-874)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1063&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN160902.pdf"}], "committee_actions": [{"date": "2025-05-12", "action": "Work Session Held", "result": "TABLED"}, {"date": "2025-05-16", "action": "Work Session Held", "result": "TABLED"}, {"date": "2025-05-19", "action": "Carry Over Requested", "result": null}, {"date": "2025-05-19", "action": "Carry Over Approved", "result": null}, {"date": "2026-01-12", "action": "Work Session Held", "result": null}, {"date": "2026-01-12", "action": "Voted", "result": "OTP-AM"}, {"date": "2026-03-19", "action": "Reported Out", "result": "OTP-AM"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought to Pass as Amended", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-04-11", "chamber": "House", "action": "Received by the Clerk of the House on April 11, 2025."}, {"date": "2025-04-11", "chamber": "House", "action": "The Bill was REFERRED to the Committee on VETERANS AND LEGAL AFFAIRS pursuant to Joint Rule 308.2 and ordered printed pursuant to Joint Rule 401."}, {"date": "2025-06-25", "chamber": "House", "action": "Carried over, in the same posture, to any special or regular session of the 132nd Legislature, pursuant to Joint Order SP 800."}, {"date": "2026-03-24", "chamber": "House", "action": "CONSENT CALENDAR - FIRST DAY"}, {"date": "2026-03-24", "chamber": "House", "action": "Under suspension of the rules CONSENT CALENDAR - SECOND DAY."}, {"date": "2026-03-24", "chamber": "House", "action": "The Bill was PASSED TO BE ENGROSSED as Amended by Committee Amendment \"A\" (H-874)."}, {"date": "2026-03-24", "chamber": "Hous