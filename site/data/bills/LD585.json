{"ld": 585, "paper": "SP268", "session": "132", "title": "An Act to Use Certain Regional Transmission Organization Payments for Beneficial Electrification to Reduce Electricity Rates", "sponsor_id": "s-ingwersen-henry", "cosponsor_ids": ["s-brenner-stacy", "s-carney-anne", "h-kessler-christopher", "h-malon-marc", "h-runte-walter", "h-sayre-daniel"], "committee_code": "EUT", "committee_name": "Energy, Utilities and Technology", "summary": {"text": "This bill eliminates the limited time period that previously applied to the directive to assign forward capacity market payments exclusively for heat pumps and adds electric vehicles as an additional eligible use of the forward capacity market funds, while leaving in place the authorization for these funds to be used for heat pumps as well. The bill also updates language regarding the allowable use of forward capacity market funds to promote beneficial electrification, to supplement incentives that support beneficial electrification measures and to reliably reduce electricity rates.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0268&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-04-25", "governor_action": "Signed", "governor_action_date": "2025-04-25"}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 585)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0268&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-03-19", "action": "Work Session Held", "result": null}, {"date": "2025-03-19", "action": "Voted", "result": "Divided Report"}, {"date": "2025-04-07", "action": "Reported Out", "result": "OTP/ONTP"}], "committee_reports": [{"label": "Majority report", "recommendation": "Ought To Pass", "signer_count": 8, "signers": ["Senator Mark Lawrence (Chair)", "Representative Melanie Sachs (Chair)", "Representative Valli