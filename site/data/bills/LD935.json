{"ld": 935, "paper": "HP600", "session": "132", "title": "Resolve, Directing the Department of Environmental Protection to Report on Air and Soil Chemical and Metal Levels and on Soil Testing on Solar Panel Farm Sites", "sponsor_id": "h-quint-tracy", "cosponsor_ids": ["h-bagshaw-barbara", "h-caruso-elizabeth", "h-collamore-amanda", "h-daigle-lucien", "h-henderson-rachel", "h-mason-richard", "h-paul-reagan", "s-stewart-harold", "h-strout-tiffany"], "committee_code": "ENR", "committee_name": "Environment and Natural Resources", "summary": {"text": "This resolve directs the Department of Environmental Protection to submit 2 reports to the Joint Standing Committee on Environment and Natural Resources. The first report must include available information on the levels of chemicals and metals, both airborne and in soil, in the State, including information on any periodic sampling performed by the department. The 2nd report must include information regarding soil testing done by the department on solar panel farm sites in the State, including testing done before installation, testing done after installation and any ongoing testing, and any results of that testing.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0600&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2025-05-21", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 935)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0600&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-192)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0600&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-192)", "description": null, "sponsor": null, "status": null, "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0