{"ld": 1617, "paper": "HP1071", "session": "132", "title": "An Act to Lower the Exclusion Amount for the Estate Tax and Create an Exclusion for Family Farms and Aquaculture, Fishing and Wood Harvesting Businesses", "sponsor_id": "h-golek-cheryl", "cosponsor_ids": ["h-abdi-mana", "h-macias-rafael", "h-rana-ambureen", "h-sato-eleanor"], "committee_code": "TAX", "committee_name": "Taxation", "summary": {"text": "This bill lowers the exclusion amount, below which the Maine estate tax does not apply, to $1,000,000 from the $5,600,000 in current law for estates of decedents dying on or after January 1, 2026.\n\nThe bill also creates an additional exclusion amount from the estate tax for family farms and aquaculture, fishing and wood harvesting businesses of up to $3,800,000. This additional exclusion applies to farmland or depreciable machinery and equipment used in commercial agriculture, aquaculture, fishing or wood harvesting that is inherited by a family member and remains in commercial use for 5 years following transfer.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1071&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-28", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1617)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1071&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-21", "action": "Work Session Held", "result": null}, {"date": "2025-05-21", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-27", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions":