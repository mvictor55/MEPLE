{"ld": 1504, "paper": "HP988", "session": "132", "title": "An Act to Support Small Businesses by Providing a Refundable Tax Credit to Certain Businesses to Offset Credit and Debit Card Transaction Fees", "sponsor_id": "h-farrin-wayne", "cosponsor_ids": ["h-crockett-edward", "h-flynn-paul", "s-reny-cameron", "h-rollins-david", "h-simmons-abden", "h-stover-holly", "h-terry-parnell"], "committee_code": "HCIFS", "committee_name": "Health Coverage, Insurance and Financial Services", "summary": {"text": "This bill creates a tax credit for businesses with less than $2,400,000 in gross sales annually that accept credit cards or debit cards for payment and are charged a transaction fee by the issuer of that card. The amount of the tax credit is the amount of the fees the business paid or 2.5% of the sales taxes remitted by that business to the State, whichever is less. The tax credit is refundable.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0988&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-27", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1504)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0988&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-29", "action": "Work Session Held", "result": null}, {"date": "2025-04-29", "action": "Voted", "result": "REFERRED"}, {"date": "2025-05-06", "action": "Reported Out", "result": "REFERRED TO HCIFS"}, {"date": "2025-05-21", "action": "Work Session Held", "result": null}, {"date": "2025-05-21", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-22", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not t