{"ld": 1209, "paper": "SP498", "session": "132", "title": "Resolve, to Create a Working Group to Study the Safety and Use of Nonconforming Vehicles on Maine's Roads and Highways (TITLE CHANGE)", "sponsor_id": "s-larsen-daughtry-matthea", "cosponsor_ids": ["s-farrin-bradlee", "h-hepler-allison", "s-nangle-timothy", "h-pluecker-william"], "committee_code": "TRA", "committee_name": "Transportation", "summary": {"text": "This resolve directs the Secretary of State to convene a working group to study the potential to allow registration and use by motorists of small lightweight vehicles, including mini trucks, on the State's roads and highways, to review the systems and laws in place for antique vehicles and to study improving road safety generally. The Secretary of State is directed to report by December 3, 2025 to the Joint Standing Committee on Transportation, which is authorized to introduce legislation to the Second Regular Session of the 132nd Legislature.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0498&item=1&snum=132"}, "status": "enacted", "status_label": "Finally Passed", "final_disposition": {"label": "Finally Passed", "date": "2025-05-16", "governor_action": "Signed", "governor_action_date": "2025-05-16"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1209)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0498&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-41)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0498&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-41)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0498&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN120902.pdf"}], "committee_actions": [{"date": "2025-04-10", "action": "Work Session Hel