{"ld": 1930, "paper": "HP1291", "session": "132", "title": "An Act Regarding Acts of Violence Committed Against a Pregnant Woman", "sponsor_id": "h-paul-reagan", "cosponsor_ids": ["h-bishop-steven", "h-collins-alicia", "s-cyrway-scott", "h-griffin-abigail", "s-haggan-david", "h-smith-katrina", "h-white-russell"], "committee_code": "JUD", "committee_name": "Judiciary", "summary": {"text": "This bill provides that for certain provisions of the Maine Criminal Code, including those governing murder, manslaughter and assault, the term \"person\" or \"human being\" includes an unborn child. Exceptions are included for an act committed by the mother of an unborn child, a lawful medical procedure performed by a physician or other licensed medical professional at the request of a mother of an unborn child or the mother's legal guardian or the lawful dispensation or administration of lawfully prescribed medication.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1291&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2025-06-10", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 1930)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1291&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-589)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1291&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-589)", "description": null, "sponsor": null, "status": null, "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1291&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN193002.pdf"}], "committee_actions": [{"date": "2025-05-28", "action": "Work Session Held", "result": null}, {"date": "2025-05-28", "action": "Vote