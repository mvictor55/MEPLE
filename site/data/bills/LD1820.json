{"ld": 1820, "paper": "HP1218", "session": "132", "title": "An Act to Simplify Regulation of the Adult Use Cannabis Industry", "sponsor_id": "h-chapman-quentin", "cosponsor_ids": [], "committee_code": "VLA", "committee_name": "Veterans and Legal Affairs", "summary": {"text": "This bill amends the Cannabis Legalization Act and the laws governing personal adult use of cannabis by eliminating the individual identification card requirement for licensees, eliminating cannabis purchase limits, eliminating certain requirements regarding the inspection of licensed premises and eliminating certain cannabis and cannabis product labeling requirements. The bill amends certain provisions regarding cannabis delivery transactions, including allowing licensees to use the tracking system established by the Department of Administrative and Financial Services, Office of Cannabis Policy to track delivery transactions and sales at specified events. The bill prohibits the Office of Cannabis Policy from requiring licensees to sign forms that require the licensees to waive certain rights protected under constitutional, statutory or common law privilege. The bill also clarifies excise tax laws as they apply to cannabis biomass.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1218&item=1&snum=132"}, "status": "died", "status_label": "Died On Adjournment", "final_disposition": {"label": "Died On Adjournment", "date": "2026-04-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN182002.pdf", "documents": [{"label": "Bill text (LD 1820)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1218&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-651)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1218&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-651)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1218&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN182002.pdf"}], "committee_actions": [{"date": "2025-05-22", "action": "Work Session Held", "result": null}, {"date": "2025-05-22", "action": "Voted", "result": "OTP-AM"}, {"date": "2025-06-11", "action": "Reported Out", "result": "OTP-AM"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought to Pass as Amended", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-04-29", "chamber": "House", "action": "Committee on Veterans and Legal Affairs suggested and ordered printed."}, {"date": "2025-04-29", "chamber": "House", "action": "The Bill was REFERRED to the Committee on VETERANS AND LEGAL AFFAIRS."}, {"date": "2025-04-29", "chamber": "House", "action": "Sent for concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-04-29", "chamber": "Senate", "action": "The Bill was REFERRED to the Committee on VETERANS AND LEGAL AFFAIRS  in concurrence"}, {"date": "2025-06-11", "chamber": "House", "action": "CONSENT CALENDAR - FIRST DAY"}, {"date": "2025-06-11", "chamber": "House", "action": "Under suspension of the rules CONSENT CALENDAR - SECOND DAY."}, {"date": "2025-06-11", "chamber": "House", "action": "The Bill was PASSED TO BE ENGROSSED as Amended by Committee Amendment \"A\" (H-651)."}, {"date": "2025-06-11", "chamber": "House", "action": "Sent for concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-06-12", "chamber": "Senate", "action": "Report READ and ACCEPTED, in concurrence."}, {"date": "2025-06-12", "chamber": "Senate", "action": "READ ONCE."}, {"date": "2025-06-12", "chamber": "Senate", "action": "Committee Amendment \"A\" (H-651) READ and ADOPTED, in concurrence."}, {"date": "2025-06-12", "chamber": "Senate", "action": "Under suspension of t