{"ld": 1453, "paper": "SP594", "session": "132", "title": "Resolve, to Establish the Housing Production Innovation Working Group (EMERGENCY) (TITLE CHANGE)", "sponsor_id": "s-bennett-richard", "cosponsor_ids": ["h-collamore-amanda", "s-curry-glenn", "h-eder-john", "h-gere-traci", "h-julia-cassie", "h-yusuf-yusuf"], "committee_code": "HED", "committee_name": "Housing and Economic Development", "summary": {"text": "This resolve establishes the Innovative Factory-made Housing Working Group, which is directed to study the potential of innovative factory-made housing technologies to reduce housing production costs and accelerate housing production in the State. The working group is required to submit a report and suggested legislation by December 3, 2025 to the Joint Standing Committee on Housing and Economic Development, which is authorized to report out legislation based on the report to the Second Regular Session of the 132nd Legislature.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0594&item=1&snum=132"}, "status": "enacted", "status_label": "Emergency Finally Passed", "final_disposition": {"label": "Emergency Finally Passed", "date": "2025-07-01", "governor_action": "Emergency Signed", "governor_action_date": "2025-07-01"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1453)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0594&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-243)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0594&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-243)", "description": "Emergency", "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0594&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN145302.pdf"}], "committee_actions": [{"date": "2025-05-01", "action"