{"ld": 1150, "paper": "HP755", "session": "132", "title": "An Act to Require Reporting of Sheltering or Aiding Missing Children", "sponsor_id": "h-mastraccio-anne-marie", "cosponsor_ids": [], "committee_code": "CJPS", "committee_name": "Criminal Justice and Public Safety", "summary": {"text": "This bill requires that if a person knowingly shelters or aids in obtaining shelter for a missing child for more than 24 hours without the consent of the missing child's parent, guardian or legal custodian, the person must provide information regarding the missing child's location and condition to a law enforcement officer who has contacted that person. A person who violates this provision is subject to a civil penalty not to exceed $250.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0755&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-05-09", "governor_action": "Signed", "governor_action_date": "2025-05-09"}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 1150)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0755&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-16", "action": "Work Session Held", "result": null}, {"date": "2025-04-16", "action": "Voted", "result": "OTP"}, {"date": "2025-04-22", "action": "Reported Out", "result": "OTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-03-20", "chamber": "House", "action": "Committee on Criminal Justice and Public Safety suggested and ordered printed."}, {"date": "2025-03-20", "chamber": "House", "action": "The Bill was REFERRED to the Committee on CRIMINAL JUSTICE AND PUBLIC SAFETY."}, {"date": "2025-03-20", "chamber": "House", "action": "Sent for concurrence. ORDERED SENT FORTHW