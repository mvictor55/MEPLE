{"ld": 51, "paper": "HP15", "session": "132", "title": "An Act to Increase Oversight of Fatalities of and Serious Injuries to Adults Subject to Public Guardianship", "sponsor_id": "h-shagoury-daniel", "cosponsor_ids": [], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "Under current law, the Aging and Disability Mortality Review Panel reviews deaths of and serious injuries to adults receiving services in home-based and community-based services programs, including participants in those programs who are subject to public guardianship. This bill expands the charge of the panel to review all deaths of and serious injuries to adults subject to public guardianship, whether or not they are enrolled in home- based and community-based services programs. It also amends the membership of the panel.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0015&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-05-29", "governor_action": "Signed", "governor_action_date": "2025-05-29"}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 51)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0015&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-208)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0015&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-208)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0015&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN005102.pdf"}], "committee_actions": [{"date": "2025-05-01", "action": "Work Session Held", "result": null}, {"date": "2025-05-01", "action": "Voted", "result": "OTP-AM"}, {"date": "2025-05-19", "action": "Reported Out", "result": "OT