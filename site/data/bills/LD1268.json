{"ld": 1268, "paper": "HP843", "session": "132", "title": "An Act to Address Employee Recruitment and Retention Issues Within the Maine State Ferry Service by Providing a Yearly Stipend", "sponsor_id": "h-ray-d", "cosponsor_ids": ["h-beck-matthew", "h-eaton-holly", "h-faircloth-sean", "h-macias-rafael", "h-webb-kilton"], "committee_code": "TRA", "committee_name": "Transportation", "summary": {"text": "This bill directs the Department of Transportation, beginning January 1, 2026, to provide an annual stipend to all employees of the Maine State Ferry Service calculated in an amount equal to $5.00 per hour multiplied by the total hours worked the previous year for each employee and prohibits the department from raising ferry tolls to pay for the stipend.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0843&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2025-06-09", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1268)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0843&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-539)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0843&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-539)", "description": null, "sponsor": null, "status": null, "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0843&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN126802.pdf"}], "committee_actions": [{"date": "2025-05-15", "action": "Work Session Held", "result": null}, {"date": "2025-05-15", "action": "Voted", "result": "Divided Report"}, {"date": "2025-06-06", "action": "Reported Out", "result": "ONTP/OTP-AM"}], "committee_reports": [{"label": "Majority r