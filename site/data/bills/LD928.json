{"ld": 928, "paper": "HP593", "session": "132", "title": "An Act to Maintain Public Access to Town Ways in Maine", "sponsor_id": "h-white-james", "cosponsor_ids": ["h-albert-roger", "h-foster-steven", "s-libby-james", "h-mason-richard", "h-montell-karen", "h-parry-wayne", "h-ray-d", "h-rudnicki-shelley", "h-thorne-james"], "committee_code": "SLG", "committee_name": "State and Local Government", "summary": {"text": "This bill provides that if the municipal officers or county commissioners have declared a town way discontinued by abandonment and have retained a public easement in the abandoned town way under this section for at least 15 years, the municipality, county commissioners or an abutter on the way may not gate, bar or otherwise obstruct the town way.\n\nThe bill also provides that if the municipal officers or county commissioners have declared a town way discontinued by abandonment and have retained a public easement in the abandoned town way under this section for less than 15 years, the municipality, county commissioners or an abutter on the way, acting with the written permission of the municipal officers or county commissioners, may remove any gates, bars or other obstructions in the town way.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0593&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-21", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 928)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0593&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-16", "action": "Work Session Held", "result": null}, {"date": "2025-04-16", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-21", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-03-05", "chamber": "House", "action": "Received by the Clerk of the House on March 5, 2025."}, {"date": "2025-03-05", "chamber": "House", "action": "The Bill was REFERRED to the Committee on STATE AND LOCAL GOVERNMENT pursuant to Joint Rule 308.2 and ordered printed pursuant to Joint Rule 401."}, {"date": "2025-03-21", "chamber": "House", "action": "Carried over, in the same posture, to the next special or regular session of the 132nd Legislature, pursuant to Joint Order SP 519."}, {"date": "2025-04-16", "chamber": "J", "action": "Work Session Held"}, {"date": "2025-04-16", "chamber": "J", "action": "Voted: ONTP"}, {"date": "2025-05-21", "chamber": "J", "action": "Reported Out: ONTP"}, {"date": "2025-05-21", "chamber": "Senate", "action": "Pursuant to Joint Rule 310.3 Placed in Legislative Files (DEAD)"}], "roll_calls": [], "hearing": {"date": "2025-03-26", "time": "10:00 AM", "location": "Cross Building, Room 214", "committee_code": "SLG", "testimony_count": 10}, "heard_with": [], "tags": ["Municipalities", "Roads"], "affected_statutes": [], "testimony": [{"id": "187461", "name": "James White", "organization": "Maine State Legislature", "town": null, "position": null, "position_source": null, "date": "2025-03-26", "hearing_date": "2025-03-26", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=187461", "has_text": true, "shared_with": []}, {"id": "10039422", "name": "Jean-Marie Caterina", "organization": "Maine County Commissioners Association", "town": null, "position": "neutral", "position_source": "inferred", "date": "2025-03-26", "hearing_date": "2025-03-26", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=10039422", "has_text": true, "shared_with": []}, {"id": "187459", "name": "Jeffrey Stevens", "organization": nul