{"ld": 905, "paper": "SP394", "session": "132", "title": "An Act to Clarify the Process to Transfer Funds Resulting from the Expiration of Unused Kilowatt-hour Credits to Be Used to Provide Assistance to Low-income Electricity Customers", "sponsor_id": "s-lawrence-mark", "cosponsor_ids": [], "committee_code": "EUT", "committee_name": "Energy, Utilities and Technology", "summary": {"text": "This bill changes the mechanism by which a transmission and distribution utility is required to remit the value of unused kilowatt-hour credits that were accumulated and that expired during the prior calendar year by requiring the utility to remit the value to the administrators of the statewide low-income assistance plan and the individual low-income assistance programs instead of the Public Utilities Commission. It also changes the date for remittance from January 1st to April 1st and requires that the commission, by rule, adopt provisions regarding the manner by which the transmission and distribution utility must report to the commission information regarding the number of unused kilowatt-hour credits that were accumulated by all customers of the utility with net energy billing arrangements during the prior calendar year and that expired during the prior calendar year and the monetary value of those credits.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0394&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-04-25", "governor_action": "Signed", "governor_action_date": "2025-04-25"}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 905)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0394&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-03-26", "action": "Work Session Held", "result": null}, {"date": "2025-03-26", "action": "Voted", "result": "OTP"}, {"date": "2025-04-09", "action": "Reported Out", "result": "OTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-03-05", "chamber": "Senate", "action": "Received by the Secretary of the Senate on March 5, 2025 and REFERRED to the Committee on ENERGY, UTILITIES AND TECHNOLOGY pursuant to Joint Rule 308.2"}, {"date": "2025-03-21", "chamber": "Senate", "action": "CARRIED OVER, in the same posture, to the next special or regular session of the 132nd Legislature, pursuant to Joint Order SP 519."}, {"date": "2025-03-26", "chamber": "J", "action": "Work Session Held"}, {"date": "2025-03-26", "chamber": "J", "action": "Voted: OTP"}, {"date": "2025-04-09", "chamber": "J", "action": "Reported Out: OTP"}, {"date": "2025-04-15", "chamber": "Senate", "action": "Report READ and ACCEPTED."}, {"date": "2025-04-15", "chamber": "Senate", "action": "READ ONCE"}, {"date": "2025-04-15", "chamber": "Senate", "action": "Under suspension of the Rules, READ A SECOND TIME and PASSED TO BE ENGROSSED."}, {"date": "2025-04-15", "chamber": "Senate", "action": "Ordered sent down forthwith for concurrence."}, {"date": "2025-04-17", "chamber": "House", "action": "CONSENT CALENDAR - FIRST DAY"}, {"date": "2025-04-17", "chamber": "House", "action": "Under suspension of the rules CONSENT CALENDAR - SECOND DAY."}, {"date": "2025-04-17", "chamber": "House", "action": "The Bill was PASSED TO BE ENGROSSED."}, {"date": "2025-04-17", "chamber": "House", "action": "In concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-04-22", "chamber": "House", "action": "PASSED TO BE ENACTED."}, {"date": "2025-04-22", "chamber": "House", "action": "Sent for concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-04-23", "chamber": "Senate", "action": "PASSED TO BE ENACTED, in concurrence."}], "roll_calls": [], "hearing": {"date": "2025-03-26", "time": "1:00 PM", "location": "Cross Building, Room 211", "com