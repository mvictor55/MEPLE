{"ld": 1306, "paper": "SP536", "session": "132", "title": "An Act to Continue the Exemption for Polystyrene Foam Disposable Food Service Containers Prepackaged at Wholesale (EMERGENCY)", "sponsor_id": "s-bradstreet-richard", "cosponsor_ids": ["h-arata-amy", "s-bickford-bruce", "s-cyrway-scott", "h-flynn-paul", "h-foster-steven", "h-guerrette-timothy", "s-martin-joseph", "s-stewart-harold"], "committee_code": "ENR", "committee_name": "Environment and Natural Resources", "summary": {"text": "This bill amends the law governing disposable food service containers in the following ways.\n\n1. It repeals the provision that is currently set to take effect on July 1, 2025 that defines \"disposable food service container\" to include service ware used to contain, transport or otherwise package raw, uncooked or butchered meat, poultry, fish, seafood or eggs. It retains the provision that is currently set to repeal on July 1, 2025, which does not include service ware used to contain, transport or otherwise package raw, uncooked or butchered meat, poultry, fish, seafood or eggs.\n\n2. Current law repeals, effective July 1, 2025, the current exemption for a covered establishment to sell at retail food or beverages in or on a polystyrene foam disposable food service container that the covered establishment purchases prepackaged at wholesale. The bill removes that July 1, 2025 repeal.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0536&item=1&snum=132"}, "status": "enacted", "status_label": "Emergency Enacted", "final_disposition": {"label": "Emergency Enacted", "date": "2025-05-30", "governor_action": "Emergency Signed", "governor_action_date": "2025-05-30"}, "fiscal_status": "Not Yet Determined", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN130602.pdf", "documents": [{"label": "Bill text (LD 1306)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0536&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-92)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0536&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-92)", "description": "Emergency", "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0536&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN130602.pdf"}], "committee_actions": [{"date": "2025-04-16", "action": "Work Session Held", "result": null}, {"date": "2025-04-16", "action": "Voted", "result": "OTP-AM"}, {"date": "2025-05-15", "action": "Reported Out", "result": "OTP-AM"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought to Pass as Amended", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-03-27", "chamber": "Senate", "action": "Committee on ENVIRONMENT AND NATURAL RESOURCES suggested and ordered printed REFERENCE to the Committee on ENVIRONMENT AND NATURAL RESOURCES Ordered sent down forthwith for concurrence"}, {"date": "2025-03-27", "chamber": "House", "action": "The Bill was REFERRED to the Committee on ENVIRONMENT AND NATURAL RESOURCES."}, {"date": "2025-03-27", "chamber": "House", "action": "In concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-05-20", "chamber": "Senate", "action": "Report READ and ACCEPTED."}, {"date": "2025-05-20", "chamber": "Senate", "action": "READ ONCE."}, {"date": "2025-05-20", "chamber": "Senate", "action": "Committee Amendment \"A\" (S-92) READ and ADOPTED."}, {"date": "2025-05-20", "chamber": "Senate", "action": "Under suspension of the Rules, READ A SECOND TIME and PASSED TO BE ENGROSSED AS AMENDED BY Committee Amendment \"A\" (S-92)."}, {"date": "2025-05-20", "chamber": "Senate", "action": "Ordered sent down forthwith for concurrence."}, {"date": "2025-05-22", "chamber": "House", "action": "CONSENT CALENDAR - FIRST DAY"}, {"date": "2025-05-