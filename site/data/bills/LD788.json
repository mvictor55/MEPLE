{"ld": 788, "paper": "SP348", "session": "132", "title": "An Act to Promote an Innovation-driven Economy by Increasing Research and Development Spending", "sponsor_id": "s-pierce-teresa", "cosponsor_ids": ["s-bennett-richard", "h-cloutier-kristen", "s-larsen-daughtry-matthea", "h-fecteau-ryan", "s-lawrence-mark", "s-stewart-harold"], "committee_code": "HED", "committee_name": "Housing and Economic Development", "summary": {"text": "This bill adds supporting the goal of increasing research and development spending as a percentage of the State's economy to meet the national average by 2030 to the responsibilities of the Maine Economic Growth Council. It also directs the council to track the progress toward the research and development spending goal and submit a report annually to the joint standing committees of the Legislature having jurisdiction over research and economic development matters and appropriations and financial affairs. The council is also authorized to seek budgetary recommendations from the Office of Innovation and the Maine Innovation Economy Advisory Board regarding the research and development spending goal.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0348&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-05-29", "governor_action": "Signed", "governor_action_date": "2025-05-29"}, "fiscal_status": "Not Yet Determined", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN078802.pdf", "documents": [{"label": "Bill text (LD 788)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0348&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-120)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0348&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-120)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url":