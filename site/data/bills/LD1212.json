{"ld": 1212, "paper": "SP501", "session": "132", "title": "Resolve, to Study Opportunities for the Efficiency Maine Trust to Support the Promotion and Use of Modern Wood Heating", "sponsor_id": "s-harrington-matthew", "cosponsor_ids": ["h-foster-steven", "h-mcintyre-mathew", "h-paul-reagan"], "committee_code": "EUT", "committee_name": "Energy, Utilities and Technology", "summary": {"text": "This resolve requires the Efficiency Maine Trust, in collaboration with the Department of Economic and Community Development, to work with representatives of the modern wood heating system industry to study and make recommendations relating to programs and incentives encouraging the promotion and use of modern wood heating systems in the State. The Efficiency Maine Trust must submit a report related to the study to the Joint Standing Committee on Energy, Utilities and Technology and the joint standing committee may report out a bill related to the report to the Second Regular Session of the 132nd Legislature.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0501&item=1&snum=132"}, "status": "enacted", "status_label": "Finally Passed", "final_disposition": {"label": "Finally Passed", "date": "2025-06-09", "governor_action": "Signed", "governor_action_date": "2025-06-09"}, "fiscal_status": "Not Yet Determined", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN121202.pdf", "documents": [{"label": "Bill text (LD 1212)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0501&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-174)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0501&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-174)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0501&item=2&snum=132", "fiscal_note_url": "https://legi