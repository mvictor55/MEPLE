{"ld": 1304, "paper": "SP534", "session": "132", "title": "RESOLUTION, Proposing an Amendment to the Constitution of Maine to Limit Property Tax Increases for Individuals 65 Years of Age or Older and Shift the Tax Burden to State Gaming Revenues", "sponsor_id": "s-baldacci-joseph", "cosponsor_ids": ["s-nangle-timothy", "h-o-halloran-dani", "h-roeder-amy", "h-supica-laura"], "committee_code": "TAX", "committee_name": "Taxation", "summary": {"text": "This resolution proposes to amend the Constitution of Maine to authorize the Legislature to require taxes on property owned and occupied by a permanent resident of this State for at least 12 months as that person's primary residence to be capped at 2% each year if that person is at least 65 years of age. Upon transfer of the property to someone other than a family member of the owner, the property would assume the just value at the time of transfer. The State is required to reimburse municipalities for revenue lost due to the 2% cap on taxes using revenue from a 2% tax imposed on the sale of lottery tickets and sports betting.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0534&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-21", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 1304)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0534&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-15", "action": "Work Session Held", "result": null}, {"date": "2025-05-15", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-20", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-03-25", "chamber": "Senate", "action": "Committee on TAXATION suggested and ordered printed REFERENCE to the Committee on TAXATION Ordered sent down forthwith for concurrence"}, {"date": "2025-03-25", "chamber": "House", "action": "The RESOLUTION was REFERRED to the Committee on TAXATION."}, {"date": "2025-03-25", "chamber": "House", "action": "In concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-05-15", "chamber": "J", "action": "Work Session Held"}, {"date": "2025-05-15", "chamber": "J", "action": "Voted: ONTP"}, {"date": "2025-05-20", "chamber": "J", "action": "Reported Out: ONTP"}, {"date": "2025-05-21", "chamber": "Senate", "action": "Pursuant to Joint Rule 310.3 Placed in Legislative Files (DEAD)"}], "roll_calls": [], "hearing": {"date": "2025-05-01", "time": "1:00 PM", "location": "State House, Room 127", "committee_code": "TAX", "testimony_count": 5}, "heard_with": [], "tags": ["Property Tax", "Relief"], "affected_statutes": [], "testimony": [{"id": "192223", "name": "Joe Baldacci", "organization": "Maine State Legislature", "town": null, "position": "support", "position_source": "inferred", "date": "2025-05-01", "hearing_date": "2025-05-01", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=192223", "has_text": true, "shared_with": [], "person_profile_id": null, "org_profile_id": null}, {"id": "10047135", "name": "Kate Dufour", "organization": "Maine Municipal Association", "town": null, "position": "oppose", "position_source": "inferred", "date": "2025-05-01", "hearing_date": "2025-05-01", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=10047135", "has_text": true, "shared_with": [], "person_profile_id": null, "org_profile_id": "org-maine-municipal-association"}, {"id": "192222", "name": "Kerry Leichtman", "organization": "Towns of Camden and Rockport", "town": null, "position": "support", "position_source": "inferred", "date": "2025-05-01",