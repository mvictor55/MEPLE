{"ld": 891, "paper": "SP379", "session": "132", "title": "An Act to Exclude Poverty as a Factor When Determining Instances of Willful Neglect or Abuse of a Child", "sponsor_id": "s-hickman-craig", "cosponsor_ids": ["s-bailey-donna", "h-drinkwater-gary", "s-duson-jill", "h-javner-kathy", "s-moore-marianne", "h-roeder-amy"], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This bill amends certain definitions under the Child and Family Services and Child Protection Act and excludes poverty as a factor in a determination of willful neglect or abuse of a child. The bill also amends the laws governing preliminary protection order requests and reasonable efforts to prevent the removal of a child from a home to require the consideration of specific efforts made, the duration of those efforts and the outcome of those efforts.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0379&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-04-30", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 891)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0379&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-25", "action": "Work Session Held", "result": null}, {"date": "2025-04-25", "action": "Voted", "result": "ONTP"}, {"date": "2025-04-28", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-03-04", "chamber": "Senate", "action": "Committee on HEALTH AND HUMAN SERVICES suggested and ordered printed REFERENCE to the Committee on HEALTH AN