{"ld": 164, "paper": "HP97", "session": "132", "title": "An Act to Exempt Authorized Emergency Vehicles from Tolls When Operating in an Official Capacity", "sponsor_id": "h-mcintyre-mathew", "cosponsor_ids": ["s-bickford-bruce"], "committee_code": "TRA", "committee_name": "Transportation", "summary": {"text": "This bill prohibits the Maine Turnpike Authority from charging or collecting tolls on an authorized emergency vehicle that is using the turnpike to respond to an emergency, for nonemergency medical transport or to travel to a repair facility that specializes in maintenance and repair for authorized emergency vehicles. The bill defines \"authorized emergency vehicle\" and \"responding to an emergency.\"", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0097&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-04-17", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 164)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0097&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-10", "action": "Work Session Held", "result": null}, {"date": "2025-04-10", "action": "Voted", "result": "ONTP"}, {"date": "2025-04-16", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-01-14", "chamber": "House", "action": "Committee on Transportation suggested and ordered printed."}, {"date": "2025-01-14", "chamber": "House", "action": "The Bill was REFERRED to the Committee on TRANSPORTATION."}, {"date": "2025-01-14", "chamber": "House", "action": "Sent for concurrence. ORDERED SENT