{"ld": 1794, "paper": "SP696", "session": "132", "title": "An Act to Provide Protection from Unfair Parking Tickets on Lots Accessible to the Public", "sponsor_id": "s-nangle-timothy", "cosponsor_ids": [], "committee_code": "HCIFS", "committee_name": "Health Coverage, Insurance and Financial Services", "summary": {"text": "This bill requires that a notice of parking violation on property accessible by the general public must be provided at the time of the violation. Under the bill, failure by the owner of a motor vehicle to pay fees assessed for a parking violation on the property may not be reported to a credit reporting agency. The Attorney General is charged with enforcing these provisions, and a person harmed by a violation may bring an action in court against the person or entity in violation as long as the person has first filed a request for mediation with the Office of the Attorney General. A person or entity that violates these provisions is subject to treble damages and a penalty not to exceed $5,000 per occurrence.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0696&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-18", "governor_action": "Signed", "governor_action_date": "2025-06-18"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1794)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0696&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-335)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0696&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-335)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0696&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN179402.pdf"}], "committee_ac