{"ld": 266, "paper": "HP169", "session": "132", "title": "An Act to Require the Updating of Voter Registration Signatures", "sponsor_id": "h-smith-katrina", "cosponsor_ids": ["h-collins-alicia", "h-daigle-lucien", "h-flynn-paul", "h-guerrette-timothy", "h-hymes-benjamin", "h-lance-michael"], "committee_code": "VLA", "committee_name": "Veterans and Legal Affairs", "summary": {"text": "This bill stipulates that, beginning January 1, 2026, a voter signature is valid for 5 years from the time it was last updated. It also requires the registrar from each municipality to review the central voter registration system annually and notify those voters whose signatures expire in that calendar year and provide those voters with a voter signature registration update form. The bill also requires the registrar to update the central voter registration system with the updated signatures.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0169&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2025-05-21", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 266)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0169&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-187)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0169&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-187)", "description": "Change Title", "sponsor": null, "status": null, "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0169&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN026602.pdf"}], "committee_actions": [{"date": "2025-02-11", "action": "Refer Approved by Chairs/Leads", "result": "REFER TO OTHER"}, {"date": "2025-02-11", "action": "Repor