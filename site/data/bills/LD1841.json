{"ld": 1841, "paper": "SP724", "session": "132", "title": "An Act to Modify the Process of Selling Tax-acquired Properties", "sponsor_id": "s-moore-marianne", "cosponsor_ids": ["h-lemelin-michael", "h-mingo-arthur", "h-tuell-william"], "committee_code": "TAX", "committee_name": "Taxation", "summary": {"text": "This bill amends the municipal sale of foreclosed property process to allow for a deed in lieu of foreclosure from the delinquent property owner. The bill amends the sale process to require mandatory notices to the delinquent owner and sets forth a series of actions required before a municipality can complete its sale of the property. Deductions for the expenses of the municipality are allowed to be deducted from the funds received from the sale of foreclosed, tax-acquired property above what the former owner owed the municipality.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0724&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1841)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0724&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-22", "action": "Work Session Held", "result": null}, {"date": "2025-05-22", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-28", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-04-30", "chamber": "Senate", "action": "Committee on TAXATION suggested and ordered printed REFERENCE to the Committee on TAXATION Ordered sent down forthwith for concur