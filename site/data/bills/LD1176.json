{"ld": 1176, "paper": "HP781", "session": "132", "title": "An Act to Provide for the Sustainable Management of Marine Resources and Create a Noncommercial Northern Shrimp License", "sponsor_id": "h-eaton-holly", "cosponsor_ids": [], "committee_code": "MAR", "committee_name": "Marine Resources", "summary": {"text": "This bill amends the sustainable development of emerging fisheries law to allow the Commissioner of Marine Resources to require an endorsement on a fishing license for an emerging fishery for a species whose harvest is currently authorized under the commercial pelagic and anadromous fishing license. It also removes a license exemption for the taking of northern shrimp for personal use and creates a resident noncommercial northern shrimp license at a cost of $20, which is deposited in the Shrimp Management Fund.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0781&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-10", "governor_action": "Signed", "governor_action_date": "2025-06-10"}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 1176)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0781&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-17", "action": "Work Session Held", "result": null}, {"date": "2025-04-17", "action": "Voted", "result": "OTP"}, {"date": "2025-05-29", "action": "Reported Out", "result": "OTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-03-20", "chamber": "House", "action": "Committee on Marine Resources suggested and ordered printed."}, {"date": "2025-03-20", "chamber": "House", "action": "The Bill was REFERRED to the Committee on MARINE RESOURCES."}, {"date": "2025-03-20", "chamber": "