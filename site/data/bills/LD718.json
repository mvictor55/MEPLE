{"ld": 718, "paper": "HP457", "session": "132", "title": "An Act to Require Municipal Clerks to Issue Absentee Ballots Only to Residents of That Municipality and to Eliminate Ongoing Absentee Voter Status", "sponsor_id": "h-adams-jeffrey", "cosponsor_ids": [], "committee_code": "VLA", "committee_name": "Veterans and Legal Affairs", "summary": {"text": "This bill requires a municipal clerk to issue an absentee ballot only to a person who is registered to vote in that municipality, including the voter and an immediate family member or a 3rd person designated by the voter to deliver the ballot on the voter's behalf. It also repeals the provisions allowing for application for ongoing absentee voter status.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0457&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-03-18", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 718)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0457&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-03-10", "action": "Work Session Held", "result": null}, {"date": "2025-03-10", "action": "Voted", "result": "ONTP"}, {"date": "2025-03-17", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-02-20", "chamber": "House", "action": "Received by the Clerk of the House on February 20, 2025."}, {"date": "2025-02-20", "chamber": "House", "action": "The Bill was REFERRED to the Committee on VETERANS AND LEGAL AFFAIRS pursuant to Joint Rule 308.2 and ordered printed pursuant to Joint Rule 401."}, {"date": "2