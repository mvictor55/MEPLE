{"ld": 943, "paper": "HP608", "session": "132", "title": "An Act to Require the ASPIRE-TANF Program to Be Administered by State Employees", "sponsor_id": "h-archer-marshall", "cosponsor_ids": ["h-crockett-edward", "h-dhalac-deqa", "s-ingwersen-henry", "h-macias-rafael", "h-roeder-amy", "h-sayre-daniel"], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This bill requires the Department of Health and Human Services to administer the Additional Support for People in Retraining and Employment - Temporary Assistance for Needy Families program, also known as the ASPIRE-TANF program, with department employees and provides for the phasing out of contracted public and private agencies providing program services by December 31, 2026, except for certain service delivery functions including job training and education, employment support, child care assistance and transportation assistance. The bill also requires the department to submit an annual report to the Legislature detailing the staffing and participant outcomes of the program and the challenges and successes of administering the program.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0608&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2026-01-27", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 943)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0608&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-19", "action": "Work Session Held", "result": "TABLED"}, {"date": "2025-05-23", "action": "Carry Over Requested", "result": null}, {"date": "2025-06-25", "action": "Carry Over Approved", "result": null}, {"date": "2026-01-13", "action": "Wo