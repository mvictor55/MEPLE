{"ld": 1070, "paper": "SP455", "session": "132", "title": "Resolve, to Study a Medicaid Forward Plan for Maine", "sponsor_id": "s-tipping-michael", "cosponsor_ids": ["h-arford-poppy", "s-carney-anne", "h-faircloth-sean", "s-reny-cameron", "s-talbot-ross-rachel", "s-tepler-denise"], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This resolve requires the Office of Affordable Health Care to study the impact of implementing a Medicaid Forward plan and amending the MaineCare state plan to provide medical assistance to residents who are under 65 years of age, who have a household income exceeding 138% of the federal poverty level and who are not otherwise eligible for and enrolled in health care coverage. The office is required to propose a plan to implement a Medicaid Forward plan. The resolve requires the office to submit a report to the Joint Standing Committee on Health Coverage, Insurance and Financial Services by January 1, 2026 detailing the office's study of and program design for the Medicaid Forward plan.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0455&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-04-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 1070)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0455&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-15", "action": "Work Session Held", "result": null}, {"date": "2025-04-15", "action": "Voted", "result": "ONTP"}, {"date": "2025-04-23", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-03-14", "chamber": "Senate", "action": "Received by the Secretary of the Senate on March 14, 2025 and REFERRED to the Committee on HEALTH AND HUMAN SERVICES pursuant to Joint Rule 308.2"}, {"date": "2025-03-21", "chamber": "Senate", "action": "CARRIED OVER, in the same posture, to the next special or regular session of the 132nd Legislature, pursuant to Joint Order SP 519."}, {"date": "2025-04-15", "chamber": "J", "action": "Work Session Held"}, {"date": "2025-04-15", "chamber": "J", "action": "Voted: ONTP"}, {"date": "2025-04-23", "chamber": "J", "action": "Reported Out: ONTP"}, {"date": "2025-04-29", "chamber": "Senate", "action": "Pursuant to Joint Rule 310.3 Placed in Legislative Files (DEAD)"}], "roll_calls": [], "hearing": {"date": "2025-04-09", "time": "1:00 PM", "location": "Cross Building, Room 209", "committee_code": "HHS", "testimony_count": 11}, "tags": ["Medicaid", "Providers"], "affected_statutes": [], "testimony": [{"id": "188853", "name": "Ann Woloson", "organization": "Consumers for Affordable Health Care", "town": null, "position": "support", "position_source": "inferred", "date": "2025-04-09", "hearing_date": "2025-04-09", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=188853", "has_text": true}, {"id": "10042261", "name": "Daniel Bryant", "organization": "Cape Elizabeth", "town": null, "position": "support", "position_source": "inferred", "date": "2025-04-09", "hearing_date": "2025-04-09", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=10042261", "has_text": true}, {"id": "10043229", "name": "Harris Van Pate", "organization": "Maine Policy Institute", "town": null, "position": "oppose", "position_source": "inferred", "date": "2025-04-09", "hearing_date": "2025-04-09", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=10043229", "has_text": true}, {"id": "188852", "name": "Henk Goorhuis", "organization": "Auburn", "town": null