{"ld": 812, "paper": "HP519", "session": "132", "title": "An Act to Provide State Recognition of the Kineo St. John Tribe", "sponsor_id": "h-poirier-jennifer", "cosponsor_ids": ["h-boyer-david", "h-morris-joshua", "h-perkins-chad", "h-rudnicki-shelley"], "committee_code": "JUD", "committee_name": "Judiciary", "summary": {"text": "This bill provides for state recognition of the Kineo St. John Tribe as a Native American tribe. Recognition does not create, extend or form the basis of any right or claim to land or real estate in the State or any right to conduct gambling activities prohibited by law. The Kineo St. John Tribe and the individual members of the tribe remain subject to all the laws of the State.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0519&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2025-05-07", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 812)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0519&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-03-19", "action": "Work Session Held", "result": null}, {"date": "2025-03-19", "action": "Voted", "result": "Divided Report"}, {"date": "2025-05-02", "action": "Reported Out", "result": "ONTP/OTP"}], "committee_reports": [{"label": "Majority report", "recommendation": "Ought Not To Pass", "signer_count": 11, "signers": ["Senator Anne Carney (Chair)", "Representative Amy Kuhn (Chair)", "Representative Mark Babin", "Representative Elizabeth Caruso", "Representative Rachel Henderson", "Representative Adam Lee", "Representative Dani O'Halloran", "Representative Dylan Pugh", "Representative Ellie Sato", "Representative David Sinclair", "Senator Rachel Talbot Ross"], "signer_ids": ["s-carney-anne", "