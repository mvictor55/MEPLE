{"ld": 2233, "paper": "HP1509", "session": "132", "title": "An Act to Combine the Board of Licensure in Medicine and Board of Osteopathic Licensure into a Single Licensing Board for All Physicians and Physician Associates", "sponsor_id": "h-mathieson-kristi", "cosponsor_ids": [], "committee_code": "HCIFS", "committee_name": "Health Coverage, Insurance and Financial Services", "summary": {"text": "This bill is reported out by the Joint Standing Committee on Health Coverage, Insurance and Financial Services pursuant to Joint Order 2025, H.P. 1486. The joint standing committee has not taken a position on the substance of this bill. By reporting this bill out, the joint standing committee is not suggesting and does not intend to suggest that it agrees or disagrees with any aspect of this bill; instead, the joint standing committee is reporting the bill out for the sole purpose of having a bill printed that can be referred to a joint standing committee for an appropriate public hearing and subsequent processing in the normal course. The joint standing committee is taking this action to ensure clarity and transparency in the legislative review of the proposals contained in the bill.\n\nBased on the recommendations of a working group, the bill combines the Board of Licensure in Medicine and Board of Osteopathic Medicine into a single licensing board, known as the Maine Board of Medicine, for all physicians and physician associates effective January 1, 2027. The bill also requires the Board of Licensure in Medicine and Board of Osteopathic Medicine to report on the planning completed by the boards prior to the establishment of the Maine Board of Medicine, including recommendations for any suggested legislation necessary to further implement the merger, to the Governor and to the joint standing committee of the Legislature having jurisdiction over professional licensing board matters no later than January 31, 2027. The bill authorizes the committee to report out a bill based on the report to the 133rd Legislature in 2027.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1509&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2026-04-16", "governor_action": "Signed", "governor_action_date": "2026-04-16"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 2233)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1509&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-1025)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1509&item=2&snum=132", "item": 2}, {"label": "Amendment S-A to C-A (S-659)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1509&item=4&snum=132", "item": 4}], "amendments": [{"id": "C-A (H-1025)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1509&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN223302.pdf"}, {"id": "S-A to C-A (S-659)", "description": null, "sponsor": "Senator Bailey", "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1509&item=4&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN223304.pdf"}], "committee_actions": [{"date": "2026-03-25", "action": "Work Session Held", "result": null}, {"date": "2026-03-25", "action": "Voted", "result": "OTP-AM"}, {"date": "2026-04-08", "action": "Reported Out", "result": "OTP-AM"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought to Pass as Amended", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2026-03-12", "chamber": "House", "action": "Representative MATHIESON for the Joint Standing Committee on Health Coverage, Insurance and