{"ld": 1118, "paper": "HP737", "session": "132", "title": "An Act to Establish a Permanent Free Community College Program for Maine", "sponsor_id": "h-sargent-holly", "cosponsor_ids": ["s-carney-anne", "s-larsen-daughtry-matthea", "h-dodge-janice", "h-fecteau-ryan", "h-gattine-andrew", "s-lawrence-mark", "h-mitchell-christina", "h-murphy-kelly", "s-rafferty-joseph"], "committee_code": "EDU", "committee_name": "Education and Cultural Affairs", "summary": {"text": "This bill establishes the Maine Free Community College Program, which directs the Maine Community College System to issue a waiver for the payment of tuition and mandatory fees for students who are eligible for the program. The bill also establishes eligibility criteria and directs the Maine Community College System to submit an annual report to the Governor and the joint standing committee of the Legislature having jurisdiction over education matters and the joint standing committee of the Legislature having jurisdiction over appropriations and financial affairs.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0737&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-06", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 1118)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0737&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-28", "action": "Work Session Held", "result": null}, {"date": "2025-04-28", "action": "Voted", "result": "ONTP"}, {"date": "2025-04-29", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [