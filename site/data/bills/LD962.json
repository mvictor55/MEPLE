{"ld": 962, "paper": "HP621", "session": "132", "title": "An Act to Establish the Offense of Aggravated Operating Under the Influence Resulting in the Death of a Pet", "sponsor_id": "h-white-russell", "cosponsor_ids": ["h-bishop-steven", "h-cloutier-kristen", "h-friedmann-gary", "s-grohoski-nicole", "h-mcintyre-mathew", "h-sayre-daniel", "h-smith-katrina", "h-swallow-gregory"], "committee_code": "CJPS", "committee_name": "Criminal Justice and Public Safety", "summary": {"text": "This bill creates the offense of aggravated operating under the influence resulting in the death of a pet and provides that it is a Class C crime with a mandatory fine, a period of incarceration, a court-ordered suspension of a driver's license and mandatory community service related to animal welfare. The bill also requires the offender to provide restitution to the owner of the pet, including veterinary costs, the market value of the pet and a sum for emotional distress.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0621&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-04-15", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 962)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0621&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-09", "action": "Work Session Held", "result": null}, {"date": "2025-04-09", "action": "Voted", "result": "ONTP"}, {"date": "2025-04-14", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-03-06", "chamber": "House", "action": "Received by the Clerk of