{"ld": 1410, "paper": "HP932", "session": "132", "title": "An Act to Provide Due Process in Confiscation and Destruction of Personal Items of Unhoused Persons", "sponsor_id": "h-rana-ambureen", "cosponsor_ids": ["s-beebe-center-anne", "h-golek-cheryl", "h-sato-eleanor", "h-sinclair-david", "s-talbot-ross-rachel"], "committee_code": "JUD", "committee_name": "Judiciary", "summary": {"text": "This bill sets out due process requirements for state, county and local government entities that confiscate or destroy personal property belonging to persons without a home. The bill provides that such due process requirements include a hearing that conforms to the Maine Administrative Procedure Act's provisions on adjudicatory proceedings.\n\nThe bill provides that if a person without a home does not attend a hearing, the person's property must be stored at a secure location for no less than 90 days and notice must be provided to the person of the address of the location and the procedure for retrieving the personal property.\n\nThe bill also provides exceptions to the due process and storage requirements for personal property with respect to which there is an objectively reasonable belief that the property is abandoned, presents an immediate threat to public health or safety or is evidence of a crime or is contraband.\n\nThe bill further provides for remedies when a public entity fails to comply, in the form of damages and injunctive relief.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0932&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-06-03", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "fiscal_note_url": null, "documents": [{"label": "Bill text (LD 1410)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0932&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-09", "action": "Work Session Held", "result": "TABLED"}, {"date": "2025-05-27", "action": "Work Session Held", "result": null}, {"date": "2025-05-27", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-29", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-04-01", "chamber": "House", "action": "Committee on Judiciary suggested and ordered printed."}, {"date": "2025-04-01", "chamber": "House", "action": "The Bill was REFERRED to the Committee on JUDICIARY."}, {"date": "2025-04-01", "chamber": "House", "action": "Sent for concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-04-01", "chamber": "Senate", "action": "The Bill was REFERRED to the Committee on JUDICIARY  in concurrence"}, {"date": "2025-06-03", "chamber": "Senate", "action": "Pursuant to Joint Rule 310.3 Placed in Legislative Files (DEAD)"}], "roll_calls": [], "hearing": {"date": "2025-04-28", "time": "10:00 AM", "location": "State House, Room 438", "committee_code": "JUD", "testimony_count": 19}, "heard_with": [], "tags": ["Civil Procedure", "Trespass"], "affected_statutes": [], "testimony": [{"id": "191849", "name": "Alicia Rea", "organization": "American Civil Liberties Union of Maine", "town": null, "position": "support", "position_source": "inferred", "date": "2025-04-28", "hearing_date": "2025-04-28", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=191849", "has_text": true, "shared_with": [], "person_profile_id": null, "org_profile_id": "org-american-civil-liberties-union-of-maine"}, {"id": "191848", "name": "Ambureen Rana", "organization": "Maine State Legislature", "town": null, "position": "support", "position_source": "inferred", "date": "2025-04-28", "hearing_date": "2025-04-28", "url": "https://l