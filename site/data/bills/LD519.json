{"ld": 519, "paper": "HP337", "session": "132", "title": "An Act to Address the Long-term Sustainability of the Maine Guaranteed Access Reinsurance Association (TITLE CHANGE)", "sponsor_id": "h-morris-joshua", "cosponsor_ids": ["h-cimino-marygrace", "h-flynn-paul", "h-foley-robert", "s-haggan-david", "h-olsen-rolf"], "committee_code": "HCIFS", "committee_name": "Health Coverage, Insurance and Financial Services", "summary": {"text": "This bill repeals the provisions of the Maine Insurance Code that establish a pooled market for individual and small group health plans, removing the requirement that those types of plans must be offered through a pooled market. The bill also eliminates related provisions that require the Maine Guaranteed Access Reinsurance Association to operate a retrospective reinsurance program providing coverage to member insurers for all individual and small group health plans issued in any plan year in which a pooled market is operating.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0337&item=1&snum=132"}, "status": "died", "status_label": "Died On Adjournment", "final_disposition": {"label": "Died On Adjournment", "date": "2026-04-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 519)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0337&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-954)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0337&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-954)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0337&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN051902.pdf"}], "committee_actions": [{"date": "2025-03-12", "action": "Work Session Held",