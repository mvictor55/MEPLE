{"ld": 1632, "paper": "HP1086", "session": "132", "title": "An Act to Provide Incentives and Amend Laws Regarding Access to Protect Rural Highway Capacity and Promote Long-term Economic Development", "sponsor_id": "h-gere-traci", "cosponsor_ids": ["h-ankeles-daniel", "s-curry-glenn", "h-doudera-victoria", "h-eaton-holly", "h-montell-karen", "s-pierce-teresa"], "committee_code": "TRA", "committee_name": "Transportation", "summary": {"text": "This bill reinstates that all state highways, rather than only controlled access highways, are subject to Department of Transportation access management rules. The bill stipulates that the department may waive access management rules and issue a permit for a driveway only if the property is located within a locally designated growth area identified in a state- approved comprehensive plan.\n\nThe bill also reestablishes the program within the Department of Transportation, which is to be funded on a pilot project basis, to provide technical assistance and incentive grants to municipalities to prevent new development along state highways and reduce the cost of future highway improvement projects. The bill specifies an incentive funding grant may be used to purchase rural lands adjacent to the highways to secure access rights and to plan the development of a public way or a town way within a municipality.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1086&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-22", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1632)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1086&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-15", "action": "Work Session Held", "result": null}, {"date": "2025-05-15", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-20", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-04-11", "chamber": "House", "action": "Received by the Clerk of the House on April 11, 2025."}, {"date": "2025-04-11", "chamber": "House", "action": "The Bill was REFERRED to the Committee on TRANSPORTATION pursuant to Joint Rule 308.2 and ordered printed pursuant to Joint Rule 401."}, {"date": "2025-05-15", "chamber": "J", "action": "Work Session Held"}, {"date": "2025-05-15", "chamber": "J", "action": "Voted: ONTP"}, {"date": "2025-05-20", "chamber": "J", "action": "Reported Out: ONTP"}, {"date": "2025-05-22", "chamber": "Senate", "action": "Pursuant to Joint Rule 310.3 Placed in Legislative Files (DEAD)"}], "roll_calls": [], "hearing": {"date": "2025-05-01", "time": "9:00 AM", "location": "State House, Room 126", "committee_code": "TRA", "testimony_count": 7}, "heard_with": [], "tags": ["Transportation Department", "Planning"], "affected_statutes": [], "testimony": [{"id": "10047697", "name": "Abraham Dailey", "organization": "Raymond", "town": null, "position": "support", "position_source": "inferred", "date": "2025-05-01", "hearing_date": "2025-05-01", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=10047697", "has_text": true, "shared_with": []}, {"id": "10047746", "name": "Jennie Franceschi", "organization": "Westbrook", "town": null, "position": null, "position_source": null, "date": "2025-05-01", "hearing_date": "2025-05-01", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=10047746", "has_text": true, "shared_with": []}, {"id": "192204", "name": "Jennifer Grant", "organization": "Department of Transportation", "town": null, "position": "oppose", "position_source": "inferred