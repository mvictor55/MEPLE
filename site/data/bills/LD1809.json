{"ld": 1809, "paper": "HP1210", "session": "132", "title": "An Act to Further Stabilize Highway Fund Revenue", "sponsor_id": "h-ankeles-daniel", "cosponsor_ids": ["h-eaton-holly", "h-montell-karen", "h-ray-d"], "committee_code": "TRA", "committee_name": "Transportation", "summary": {"text": "This bill provides 3 additional sources of revenue for the Highway Fund:\n\n1. A $1 surcharge imposed by the Maine Turnpike Authority on any noncommercial passenger vehicle that uses the turnpike and is not registered in this State; 2. An annual registration fee of $200 imposed on the registration of battery electric vehicles and $100 imposed on plug-in hybrid electric vehicles; and 3. A delivery fee of 50 cents per delivery imposed and collected at the time of a sale of at least $100 of tangible personal property tax that is subject to sales tax. All revenue from the surcharge, registration fee and delivery charge is required to be deposited in the Highway Fund.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1210&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-22", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1809)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1210&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-14", "action": "Work Session Held", "result": null}, {"date": "2025-05-14", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-20", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-04-25", "chamber": "House", "action": "Received by the