{"ld": 1394, "paper": "HP916", "session": "132", "title": "An Act to Support Maine's Electric Vehicle Adoption Goals by Providing an Exclusion for Electric Vehicles from Certain Requirements of the Right to Repair Law", "sponsor_id": "h-roberts-lovell-tiffany", "cosponsor_ids": ["h-collamore-amanda"], "committee_code": "HED", "committee_name": "Housing and Economic Development", "summary": {"text": "This bill amends the motor vehicle right to repair law to provide an exclusion from certain telematics systems requirements for electric vehicles sold by a motor vehicle manufacturer if the manufacturer annually certifies to the Department of Environmental Protection that the electric vehicle's telematics system complies with applicable security and privacy standards of the Federal Trade Commission and the United States Department of Transportation, National Highway Traffic Safety Administration and the manufacturer meets the electric vehicle availability threshold established in department rule. The threshold must set forth a minimum number of electric vehicles that must be annually delivered for sale or lease to all motor vehicle dealers in the State by a manufacturer of motor vehicles or a minimum percentage of electric vehicles out of the total number of all vehicles of that manufacturer that are delivered for sale or lease to all dealers. By January 15, 2026, and annually thereafter, the Department of Environmental Protection must submit to the joint standing committee of the Legislature having jurisdiction over environment and natural resources matters a report providing information regarding the number of electric vehicle exclusions reviewed and approved or denied; an assessment of the effect of those exclusions on electric vehicle adoption and on consumer safety, data privacy and the availability of diagnostic, service and repair information; and recommendations, including proposed legislation, for necessary amendments to the exclusion. After reviewing the report, the committee may report out related legislation.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0916&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2025-06-18", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1394)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0916&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-763)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0916&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-763)", "description": "Change Title", "sponsor": null, "status": null, "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0916&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN139402.pdf"}], "committee_actions": [{"date": "2025-05-15", "action": "Work Session Held", "result": null}, {"date": "2025-05-15", "action": "Voted", "result": "Divided Report"}, {"date": "2025-06-17", "action": "Reported Out", "result": "ONTP/OTP-AM"}], "committee_reports": [{"label": "Majority report", "recommendation": "Ought Not To Pass", "signer_count": 8, "signers": ["Senator Chip Curry (Chair)", "Representative Traci Gere (Chair)", "Senator Donna Bailey", "Senator Richard Bennett", "Representative John Eder", "Representative Cheryl Golek", "Representative Marc Malon", "Representative Yusuf Yusuf"], "signer_ids": ["s-curry-glenn", "h-gere-traci", "s-bailey-donna", "s-bennett-richard", "h-eder-john", "h-golek-cheryl", "h-malon-marc", "h-yusuf-yusuf"]}, {"label": "Minority report", "recommendation": "Ought To Pass As Amended", "signer_count": 4, "signers": ["Representative Amanda Collamore", "Representative Arthur Mingo", "Representative Tiffany Roberts", "Representative Mark Wal