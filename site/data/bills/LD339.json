{"ld": 339, "paper": "HP239", "session": "132", "title": "Resolve, to Provide Funds to the Maine Indian Education School District to Develop a Wabanaki-centered Curriculum", "sponsor_id": "h-brennan-michael", "cosponsor_ids": ["h-dana-aaron", "h-dodge-janice", "h-gramlich-lori", "h-lookner-grayson", "h-murphy-kelly", "h-sachs-melanie", "h-sargent-holly"], "committee_code": "EDU", "committee_name": "Education and Cultural Affairs", "summary": {"text": "This resolve provides $100,000 for each year in the 2026-2027 biennium to the Maine Indian Education school district to develop and implement a Wabanaki-centered curriculum for Native American high school students. It requires the Maine Indian Education school district to administer a pilot program in coordination with state-approved high schools throughout the State. The funds will be used for curriculum development, staff, transportation and support services.\n\nThe resolve also directs the Department of Education to coordinate with the Maine Indian Education school district to make available and disseminate, as appropriate, any Wabanaki-centered curriculum for Native American high school students to state-approved schools throughout the State. It requires the department and the superintendent to report to the Joint Standing Committee on Education and Cultural Affairs on the dissemination of the curriculum and use of funds.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0239&item=1&snum=132"}, "status": "died", "status_label": "Accepted Minority (ONTP) Report", "final_disposition": {"label": "Accepted Minority (ONTP) Report", "date": "2025-06-04", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 339)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0239&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-316)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0239&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-316)", "description": null, "sponsor": null, "status": null, "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0239&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN033902.pdf"}], "committee_actions": [{"date": "2025-05-13", "action": "Work Session Held", "result": null}, {"date": "2025-05-13", "action": "Voted", "result": "Divided Report"}, {"date": "2025-05-28", "action": "Reported Out", "result": "OTP-AM/ONTP"}], "committee_reports": [{"label": "Majority report", "recommendation": "Ought To Pass As Amended", "signer_count": 8, "signers": ["Representative Kelly Murphy (Chair)", "Senator Joseph Rafferty (Chair)", "Representative Michael Brennan", "Representative Ed Crockett", "Representative Jan Dodge", "Representative Christina Mitchell", "Senator Teresa Pierce", "Representative Holly Sargent"], "signer_ids": ["h-murphy-kelly", "s-rafferty-joseph", "h-brennan-michael", "h-crockett-edward", "h-dodge-janice", "h-mitchell-christina", "s-pierce-teresa", "h-sargent-holly"]}, {"label": "Minority report", "recommendation": "Ought Not To Pass", "signer_count": 5, "signers": ["Representative Barbara Bagshaw", "Representative Nathan Carlow", "Representative Kimberly Haggan", "Senator James Libby", "Representative Sheila Lyman"], "signer_ids": ["h-bagshaw-barbara", "h-carlow-nathan", "h-haggan-kimberly", "s-libby-james", "h-lyman-sheila"]}], "chamber_actions": [{"date": "2025-01-30", "chamber": "House", "action": "Received by the Clerk of the House on January 30, 2025."}, {"date": "2025-01-30", "chamber": "House", "action": "The Resolve was REFERRED to the Committee on EDUCATION AND CULTURAL AFFAIRS pursuant to Joint Rule 308.2 and ordered printed pursuant to Joint Rule 401."}, {"date": "2025-03-21", "chamber": "House", "action": "Carried over, in the same posture, to the next special or regular session of the 13