{"ld": 1555, "paper": "HP1013", "session": "132", "title": "An Act to Establish an Employer Tax Credit for Qualifying Child Care Costs", "sponsor_id": "h-hasenfus-tavis", "cosponsor_ids": [], "committee_code": "TAX", "committee_name": "Taxation", "summary": {"text": "This bill repeals the prior employer-assisted day care tax credit program under the Maine Revised Statutes, Title 36, section 5217. It establishes a new tax credit program that authorizes a refundable tax credit for an employer that pays for or provides in-kind resources for child care for the children of its employees. The amount of the annual credit is 50% of the amount expended up to a maximum of $8,000 per child or a total annual credit of $80,000, whichever is lower. The credit is available for tax years beginning on or after January 1, 2026. The bill also provides that the credit is subject to ongoing legislative review beginning in 2030.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1013&item=1&snum=132"}, "status": "died", "status_label": "Died On Adjournment", "final_disposition": {"label": "Died On Adjournment", "date": "2026-04-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1555)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1013&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-570)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1013&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-570)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1013&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN155502.pdf"}], "committee_actions": [{"date": "2025-04-29", "action": "Work Session Held", "result": null}, {"date": "2025-04-29", "action":