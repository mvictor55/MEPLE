{"ld": 1475, "paper": "HP967", "session": "132", "title": "Resolve, to Establish the Commission to Study the Taxation of Digital Assets", "sponsor_id": "h-lookner-grayson", "cosponsor_ids": ["h-faircloth-sean", "h-golek-cheryl", "h-macias-rafael", "h-mastraccio-anne-marie", "h-matlack-ann", "h-osher-laurie", "h-sayre-daniel", "h-skold-charles", "s-tipping-michael"], "committee_code": "TAX", "committee_name": "Taxation", "summary": {"text": "This resolve establishes the Commission on the Taxation of Digital Assets. The commission is composed of 10 members, including Legislators, members with experience in taxation and members representing the business community. The commission must review and evaluate tax policies in other states and recommend possible policy approaches for the taxation of digital assets in this State, including cryptocurrency and nonfungible tokens.\n\nThe commission must report its findings and recommendations to the Joint Standing Committee on Taxation by December 3, 2025. The joint standing committee has authority to report out legislation related to the report to the Second Regular Session of the 132nd Legislature.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0967&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-21", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1475)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0967&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-07", "action": "Work Session Held", "result": "TABLED"}, {"date": "2025-05-15", "action": "Work Session Held", "result": null}, {"date": "2025-05-15", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-20", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-04-03", "chamber": "House", "action": "Committee on Taxation suggested and ordered printed."}, {"date": "2025-04-03", "chamber": "House", "action": "The Resolve was REFERRED to the Committee on TAXATION."}, {"date": "2025-04-03", "chamber": "House", "action": "Sent for concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-04-08", "chamber": "Senate", "action": "The Bill was REFERRED to the Committee on TAXATION  in concurrence"}, {"date": "2025-05-21", "chamber": "Senate", "action": "Pursuant to Joint Rule 310.3 Placed in Legislative Files (DEAD)"}], "roll_calls": [], "hearing": {"date": "2025-04-23", "time": "1:00 PM", "location": "State House, Room 127", "committee_code": "TAX", "testimony_count": 5}, "heard_with": [], "tags": ["Sales And Use Tax", "Items Taxed"], "affected_statutes": [], "testimony": [{"id": "10045916", "name": "Brianna January", "organization": "McLean", "town": null, "position": "support", "position_source": "inferred", "date": "2025-04-23", "hearing_date": "2025-04-23", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=10045916", "has_text": true, "shared_with": [], "person_profile_id": null, "org_profile_id": "org-mclean"}, {"id": "10045253", "name": "Eleanor Weisman", "organization": null, "town": "Knox", "position": "support", "position_source": "inferred", "date": "2025-04-23", "hearing_date": "2025-04-23", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=10045253", "has_text": true, "shared_with": [], "person_profile_id": null, "org_profile_id": null}, {"id": "10045843", "name": "Harris Van Pate", "organization": "Maine Policy Institute", "town": null, "position": "oppose", "position_source": "inferred", "date": "2025-04-23", "hearing_date": "2025-04-23", "url": "https://legislature.ma