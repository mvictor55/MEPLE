{"ld": 863, "paper": "HP549", "session": "132", "title": "An Act to Allow a Person or Organization Conducting a Raffle to Use an Approved Payment Management System (TITLE CHANGE)", "sponsor_id": "h-white-james", "cosponsor_ids": ["h-ankeles-daniel", "h-bishop-steven", "s-farrin-bradlee", "h-mason-richard", "h-montell-karen", "h-parry-wayne", "h-ray-d", "h-rudnicki-shelley", "h-white-russell"], "committee_code": "VLA", "committee_name": "Veterans and Legal Affairs", "summary": {"text": "This bill removes the prohibition on an agricultural society, nonprofit organization, volunteer fire department or their auxiliaries to conduct Internet raffles in which the total value of the prize offered to the holder of the winning chance does not exceed $2,500 or, if there are multiple winning chances, the total value of all prizes offered do not exceed a value of $2,500 without being required to register with the Department of Public Safety, Gambling Control Unit.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0549&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-10", "governor_action": "Unsigned", "governor_action_date": "2025-06-10"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 863)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0549&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-226)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0549&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-226)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0549&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN086302.pdf"}], "committee_actions": [{"date": "2025-03-24", "action": "Work Session Held", "result": nu