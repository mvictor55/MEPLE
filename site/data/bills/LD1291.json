{"ld": 1291, "paper": "SP521", "session": "132", "title": "Resolve, to Establish the Commission to Study the Apportionment of Service Revenue", "sponsor_id": "s-bickford-bruce", "cosponsor_ids": ["h-perkins-chad"], "committee_code": "TAX", "committee_name": "Taxation", "summary": {"text": "This resolve establishes the Commission to Study the Apportionment of Service Revenue, which is directed to study the apportionment of service revenue for Maine corporate income tax purposes, including the need for fair representation of taxpayers' business activities in the State, the effect of adopting look-through apportionment for certain types of services and the availability of reasonable approximation safe harbor provisions. The commission is required to submit a report and suggested legislation by December 3, 2025 to the Joint Standing Committee on Taxation, which is authorized to report out legislation based on the report to the Second Regular Session of the 132nd Legislature.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0521&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-21", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1291)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0521&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-24", "action": "Work Session Held", "result": "TABLED"}, {"date": "2025-05-08", "action": "Work Session Held", "result": "TABLED"}, {"date": "2025-05-15", "action": "Work Session Held", "result": null}, {"date": "2025-05-15", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-20", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendatio