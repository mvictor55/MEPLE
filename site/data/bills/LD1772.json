{"ld": 1772, "paper": "SP690", "session": "132", "title": "An Act to Establish the Fund for a Healthy Maine Stabilization Fund (EMERGENCY) (TITLE CHANGE)", "sponsor_id": "s-bennett-richard", "cosponsor_ids": ["h-ducharme-john", "h-graham-anne", "s-rotundo-margaret"], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This bill establishes the Trust for a Healthy Maine to receive money paid to the State pursuant to the tobacco settlement and from other sources and to distribute that money to state agencies or designated agents of the State to fund tobacco use prevention and addiction disease control, ensure adequate resources for other disease prevention efforts, promote public health, plan and deliver public health and prevention programs and services, support accreditation of the Department of Health and Human Services, Maine Center for Disease Control and Prevention and support public health workforce development. The trust is governed by a 15-member board of trustees composed of the Director of the Maine Center for Disease Control and Prevention and 14 members appointed by the Governor.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0690&item=1&snum=132"}, "status": "enacted", "status_label": "Emergency Enacted", "final_disposition": {"label": "Emergency Enacted", "date": "2026-04-06", "governor_action": "Emergency Signed", "governor_action_date": "2026-04-06"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1772)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0690&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-548)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0690&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-548)", "description": "Emergency", "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?pa