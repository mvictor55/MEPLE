{"ld": 512, "paper": "SP230", "session": "132", "title": "An Act to Provide Educational Opportunities for Students in Secondary Schools with 200 or Fewer Students", "sponsor_id": "s-guerin-stacey", "cosponsor_ids": ["h-bagshaw-barbara", "h-haggan-kimberly", "h-lyman-sheila"], "committee_code": "EDU", "committee_name": "Education and Cultural Affairs", "summary": {"text": "This bill provides that a secondary student whose parents reside in a school administrative unit with a secondary school with a total resident student count of 200 or fewer may enroll in another school administrative unit's secondary school upon acceptance from that school. The student's parents must notify the resident school of the intent to enroll in another school by April 1st and provide the resident school administrative unit with an acceptance letter from the receiving school by May 1st. The receiving school administrative unit must invoice the resident school administrative unit for payment at the per-pupil rate, which may not exceed the state maximum allowable tuition rate.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0230&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2025-05-07", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN051201.pdf", "documents": [{"label": "Bill text (LD 512)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0230&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-37)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0230&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-37)", "description": null, "sponsor": null, "status": null, "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0230&item=2