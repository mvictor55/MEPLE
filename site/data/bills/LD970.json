{"ld": 970, "paper": "HP630", "session": "132", "title": "An Act to Support Affordable Housing Development (TITLE CHANGE)", "sponsor_id": "h-malon-marc", "cosponsor_ids": ["s-bennett-richard", "h-collamore-amanda", "s-curry-glenn", "h-fecteau-ryan", "h-gere-traci", "h-golek-cheryl", "h-mingo-arthur", "h-roberts-lovell-tiffany", "h-yusuf-yusuf"], "committee_code": "HED", "committee_name": "Housing and Economic Development", "summary": {"text": "This bill provides time frames within which a municipal licensing authority and the Department of Environmental Protection must make decisions on permit applications for the construction of affordable housing for which funding or credits from the Maine State Housing Authority are being sought. Under the bill, a municipal licensing authority must provide notice to an applicant as to the completeness of the application within 30 days after receipt. If no notice is provided to the applicant, the application is considered complete. Once the application is complete, the municipality must approve or disapprove the application within 120 days. Further, the bill requires the Department of Environmental Protection to approve or disapprove site location of development permits for such affordable housing construction within 30 days after receipt of the permit application.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0630&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-11", "governor_action": "Signed", "governor_action_date": "2025-06-11"}, "fiscal_status": "Not Yet Determined", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN097002.pdf", "documents": [{"label": "Bill text (LD 970)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0630&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-449)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0630&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-449)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0630&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN097002.pdf"}], "committee_actions": [{"date": "2025-05-06", "action": "Work Session Held", "result": "TABLED"}, {"date": "2025-05-16", "action": "Work Session Held", "result": null}, {"date": "2025-05-16", "action": "Voted", "result": "OTP-AM"}, {"date": "2025-06-03", "action": "Reported Out", "result": "OTP-AM"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought to Pass as Amended", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-03-07", "chamber": "House", "action": "Received by the Clerk of the House on March 7, 2025."}, {"date": "2025-03-07", "chamber": "House", "action": "The Bill was REFERRED to the Committee on HOUSING AND ECONOMIC DEVELOPMENT pursuant to Joint Rule 308.2 and ordered printed pursuant to Joint Rule 401."}, {"date": "2025-03-21", "chamber": "House", "action": "Carried over, in the same posture, to the next special or regular session of the 132nd Legislature, pursuant to Joint Order SP 519."}, {"date": "2025-06-03", "chamber": "House", "action": "CONSENT CALENDAR - FIRST DAY"}, {"date": "2025-06-03", "chamber": "House", "action": "Under suspension of the rules CONSENT CALENDAR - SECOND DAY."}, {"date": "2025-06-03", "chamber": "House", "action": "The Bill was PASSED TO BE ENGROSSED as Amended by Committee Amendment \"A\" (H-449)."}, {"date": "2025-06-03", "chamber": "House", "action": "Sent for concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-06-03", "chamber": "Senate", "action": "Report READ and ACCEPTED, in concurrence."}, {"date": "2025-06-03", "chamber": "Senate", "action": "READ ONCE."}, {"date": "2025-06-03", "chamber