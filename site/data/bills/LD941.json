{"ld": 941, "paper": "HP606", "session": "132", "title": "An Act Requiring Employers to Disclose Wage Ranges in Job Postings", "sponsor_id": "h-archer-marshall", "cosponsor_ids": ["h-julia-cassie", "h-macias-rafael", "h-roeder-amy", "s-tipping-michael"], "committee_code": "LAB", "committee_name": "Labor", "summary": {"text": "This bill requires an employer that employs 10 or more employees to include a wage range in any job posting for a position of employment in the State. An employer acting in good faith may pay an employee a wage different than the wage range based upon factors such as market conditions or the experience or education of the employee.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0606&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-04-08", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "fiscal_note_url": null, "documents": [{"label": "Bill text (LD 941)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0606&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-01", "action": "Work Session Held", "result": null}, {"date": "2025-04-01", "action": "Voted", "result": "ONTP"}, {"date": "2025-04-04", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-03-05", "chamber": "House", "action": "Received by the Clerk of the House on March 5, 2025."}, {"date": "2025-03-05", "chamber": "House", "action": "The Bill was REFERRED to the Committee on LABOR pursuant to Joint Rule 308.2 and ordered printed pursuant to Joint Rule 401."}, {"date": "2025-03-21", "chamber": "House", "action": "Carr