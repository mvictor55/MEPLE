{"ld": 489, "paper": "HP318", "session": "132", "title": "An Act to Provide for a Vessel Breakdown License Exception for Commercial Halibut Fishing License Holders (EMERGENCY)", "sponsor_id": "h-strout-tiffany", "cosponsor_ids": ["h-drinkwater-gary", "h-lyman-sheila", "s-moore-marianne", "h-quint-tracy", "s-reny-cameron", "h-tuell-william"], "committee_code": "MAR", "committee_name": "Marine Resources", "summary": {"text": "This bill provides that the holder of a commercial halibut fishing license may fish for, take, possess, ship, transport or sell halibut that the holder has taken using only the vessel named on the license. The bill also provides an exception to this provision. It allows a commercial halibut fishing license holder to request authorization from the Commissioner of Marine Resources to use a vessel other than the vessel identified on that license holder's license when that license holder's vessel is temporarily inoperable.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0318&item=1&snum=132"}, "status": "enacted", "status_label": "Emergency Enacted", "final_disposition": {"label": "Emergency Enacted", "date": "2025-05-09", "governor_action": "Emergency Signed", "governor_action_date": "2025-05-09"}, "fiscal_status": "Not Yet Determined", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN048902.pdf", "documents": [{"label": "Bill text (LD 489)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0318&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-74)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0318&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-74)", "description": "Emergency", "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0318&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_13