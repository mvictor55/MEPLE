{"ld": 126, "paper": "SP54", "session": "132", "title": "An Act to Expand the Use of the Veterans' Homelessness Prevention Partnership Fund", "sponsor_id": "s-hickman-craig", "cosponsor_ids": [], "committee_code": "VLA", "committee_name": "Veterans and Legal Affairs", "summary": {"text": "This bill removes the requirement for the Director of the Maine Bureau of Veterans' Services within the Department of Defense, Veterans and Emergency Management to establish a program of partnerships with human services-based volunteer organizations in order to make disbursements from the Veterans' Homelessness Prevention Partnership Fund. The bill allows the director to make disbursements directly to organizations, businesses, landlords or other entities to prevent homelessness among veterans.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0054&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-04-30", "governor_action": "Signed", "governor_action_date": "2025-04-30"}, "fiscal_status": "No Fiscal Impact", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN012601.pdf", "documents": [{"label": "Bill text (LD 126)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0054&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-15)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0054&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-15)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0054&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN012602.pdf"}], "committee_actions": [{"date": "2025-02-26", "action": "Work Session Held", "result": null}, {"date": "2025-02-26", "action": "Voted", "result": "OTP-AM"}, {"date": "2025