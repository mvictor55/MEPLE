{"ld": 217, "paper": "HP140", "session": "132", "title": "An Act to Require Schools to Provide Access to Free Condoms for Students in Grades 9 to 12 in the School Nurse's Office", "sponsor_id": "h-dodge-janice", "cosponsor_ids": ["h-boyer-michelle", "s-brenner-stacy", "h-cloutier-kristen", "h-crafts-lydia", "h-mccabe-julia", "h-murphy-kelly", "h-pluecker-william", "h-roeder-amy", "h-stover-holly"], "committee_code": "EDU", "committee_name": "Education and Cultural Affairs", "summary": {"text": "This bill requires that schools provide access to condoms free of charge to all students enrolled in grades 9 to 12. A school is subject to this provision if the school serves students in grades 9 to 12 and is a public school or a private school approved for receipt of public funds for tuition purposes and at least 60% of the students it serves are publicly funded students. Condoms may be administered only in the nurse's office by the school nurse. Before administering condoms to students, a school is required to plan for the contingency of a student with an allergy to latex.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0140&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-06", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 217)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0140&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-28", "action": "Work Session Held", "result": null}, {"date": "2025-04-28", "action": "Voted", "result": "ONTP"}, {"date": "2025-04-29", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [