{"ld": 2146, "paper": "SP864", "session": "132", "title": "An Act to Increase Access to Critical Vaccinations", "sponsor_id": "s-larsen-daughtry-matthea", "cosponsor_ids": ["s-bailey-donna", "h-fecteau-ryan", "s-ingwersen-henry", "h-mathieson-kristi", "h-zager-samuel"], "committee_code": "HCIFS", "committee_name": "Health Coverage, Insurance and Financial Services", "summary": {"text": "This bill requires the Maine Vaccine Board to consider vaccines that are recommended by and available through the Northeast Public Health Collaborative or its successor organization when making its annual determination of vaccines that must be made available through the Universal Immunization Program. If federal funding is not available for certain vaccines under the United States Department of Health and Human Services, Centers for Disease Control and Prevention, Vaccines for Children Program, the bill also authorizes the Maine Vaccine Board to request state funding to cover the costs of vaccines for children who qualify for vaccines under the Vaccines for Children Program for those vaccines that are recommended by the Department of Health and Human Services or the Northeast Public Health Collaborative or its successor organization.\n\nThe bill provides a pharmacist licensed in this State with immunity from liability for negligence for administering a vaccine that is outside the guidelines recommended by the United States Department of Health and Human Services, Centers for Disease Control and Prevention Advisory Committee on Immunization Practices, or its successor organization, as long as the administration of the vaccine is in accordance with guidelines recommended by the State or the Northeast Public Health Collaborative or its successor organization.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0864&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2026-04-15", "governor_action": "Signed", "governor_action_date": "2026-04-15"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 2146)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0864&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-611)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0864&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-611)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0864&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN214602.pdf"}], "committee_actions": [{"date": "2026-02-17", "action": "Work Session Held", "result": null}, {"date": "2026-02-17", "action": "Voted", "result": "Divided Report"}, {"date": "2026-04-01", "action": "Reported Out", "result": "OTP-AM/ONTP"}], "committee_reports": [{"label": "Majority report", "recommendation": "Ought To Pass As Amended", "signer_count": 11, "signers": ["Senator Donna Bailey (Chair)", "Representative Kristi Mathieson (Chair)", "Representative Poppy Arford", "Senator Joseph Baldacci", "Representative Michelle Boyer", "Representative Sally Cluchey", "Representative Paul Flynn", "Representative Robert Foley", "Senator David Haggan", "Representative Anne-Marie Mastraccio", "Representative Rolf Olsen"], "signer_ids": ["s-bailey-donna", "h-mathieson-kristi", "h-arford-poppy", "s-baldacci-joseph", "h-boyer-michelle", "h-cluchey-sally", "h-flynn-paul", "h-foley-robert", "s-haggan-david", "h-mastraccio-anne-marie", "h-olsen-rolf"]}, {"label": "Minority report", "recommendation": "Ought Not To Pass", "signer_count": 2, "signers": ["Representative Marygrace Cimino", "Representative Joshua Morris"], "signer_ids": ["h-cimino-marygrace", "h-morris-joshua"]}], "chamber_actions": [{"date": "2026-01-07", "chamber": "Senate", "action": "Committee on HEALTH AND HUMAN SERV