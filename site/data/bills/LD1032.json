{"ld": 1032, "paper": "HP661", "session": "132", "title": "An Act Regarding Court Security", "sponsor_id": "h-white-james", "cosponsor_ids": ["h-chapman-quentin", "h-collins-alicia", "h-doudera-victoria", "h-drinkwater-gary", "h-nutting-robert", "h-parry-wayne", "h-perkins-chad", "s-stewart-harold", "h-wood-peter"], "committee_code": "JUD", "committee_name": "Judiciary", "summary": {"text": "This bill requires the State Court Administrator to contract for the services of qualified individuals to perform court security-related functions and services at a court if court operations at that court have been adversely affected by a lack of available court security for more than 2% of scheduled court time in a month at that court. It provides that, when the State Court Administrator contracts for the services of qualified individuals to perform court security-related functions and services, the State Court Administrator must first offer the contract to the appropriate sheriff's office before the contract is offered to another party.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0661&item=1&snum=132"}, "status": "died", "status_label": "Died Between Houses", "final_disposition": {"label": "Died Between Houses", "date": "2025-06-11", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1032)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0661&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-467)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0661&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-467)", "description": null, "sponsor": null, "status": "Adopted by House", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0661&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN103202.pdf"}], "committee_ac