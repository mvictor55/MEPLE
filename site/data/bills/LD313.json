{"ld": 313, "paper": "HP213", "session": "132", "title": "An Act to Improve Voter Confidence in Electronic Ballot Counting by Requiring Ballots to Contain Unique Identifiers", "sponsor_id": "h-foster-steven", "cosponsor_ids": ["h-babin-mark", "h-flynn-paul", "h-guerrette-timothy", "s-haggan-david", "h-mcintyre-mathew", "h-paul-reagan"], "committee_code": "VLA", "committee_name": "Veterans and Legal Affairs", "summary": {"text": "This bill requires each ballot prepared by the Secretary of State to contain a unique identifier, except for sample ballots. Voting devices used in the conduct of state elections must be able to record the unique identifier assigned to each ballot and any votes cast for any person, or any question, on that ballot. The clerk of a municipality is required to post on the municipality's publicly accessible website, as soon as practicable after the election return is prepared, a list of votes cast, organized by unique identifier. This provision does not apply to paper ballots counted using other methods.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0213&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-03-18", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN031301.pdf", "documents": [{"label": "Bill text (LD 313)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0213&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-02-24", "action": "Work Session Held", "result": null}, {"date": "2025-02-24", "action": "Voted", "result": "ONTP"}, {"date": "2025-03-12", "action": "Work Session Reconsidered", "result": null}, {"date": "2025-03-12", "action": "Voted", "result": "ONTP"