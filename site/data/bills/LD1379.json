{"ld": 1379, "paper": "HP901", "session": "132", "title": "An Act to Require Public Health Warnings to Be Posted and Provided by Firearm Dealers and Gunsmiths", "sponsor_id": "h-stover-holly", "cosponsor_ids": ["h-arford-poppy", "h-brennan-michael", "h-graham-anne", "h-gramlich-lori", "h-kuhn-amy", "h-meyer-michele", "h-moonen-matthew", "h-zager-samuel"], "committee_code": "JUD", "committee_name": "Judiciary", "summary": {"text": "This bill requires firearm dealers and gunsmiths to post public health warning signs on their business premises and provide public health warning brochures to purchasers and transferees of firearms stating the significant risk of firearms to public health and safety and that access to firearms increases the risk of suicide, domestic violence fatalities and unintentional deaths, particularly among children. The bill authorizes the Department of Health and Human Services to enforce these provisions and to develop standardized public health warning signs and brochures.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0901&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-06-13", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1379)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0901&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-15", "action": "Work Session Held", "result": null}, {"date": "2025-05-15", "action": "Voted", "result": "ONTP"}, {"date": "2025-06-12", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-04-01", "ch