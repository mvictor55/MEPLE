{"ld": 238, "paper": "SP104", "session": "132", "title": "An Act to Protect Emergency Medical Services Persons' Right to Work in Multiple Health Care Settings", "sponsor_id": "s-farrin-bradlee", "cosponsor_ids": ["s-beebe-center-anne", "h-cloutier-kristen", "s-cyrway-scott", "h-salisbury-suzanne", "s-talbot-ross-rachel"], "committee_code": "HCIFS", "committee_name": "Health Coverage, Insurance and Financial Services", "summary": {"text": "This bill provides that the Maine Emergency Medical Services Act of 1982 may not be construed to prohibit a person licensed as an emergency medical services person from rendering medical services in a hospital or other health care facility setting if those services are rendered in the person's capacity as an employee, volunteer or contracted agent of the hospital or health care facility and certain other conditions are met. Current law requires such a person to render those services in the person's capacity as an employee of the hospital or health care facility in order for the exemption provision to apply.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0104&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-05-13", "governor_action": "Unsigned", "governor_action_date": "2025-05-13"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 238)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0104&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-22)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0104&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-22)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0104&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN023802.pdf"}]