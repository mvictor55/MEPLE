{"ld": 83, "paper": "HP47", "session": "132", "title": "An Act Concerning the Filing of Marriage Licenses and the Recording of Intentions as Part of the Electronic Vital Records System", "sponsor_id": "h-kuhn-amy", "cosponsor_ids": [], "committee_code": "JUD", "committee_name": "Judiciary", "summary": {"text": "This bill clarifies requirements for parties applying for and filing marriage licenses, including registrations that have been delayed and for which there is no record, and aligns current practices by requiring electronic filing of those parties' intentions in the State's vital records system. The bill also specifies that municipal clerks are no longer required to give to all marrying parties the Department of Health and Human Services' brochure about the effects of alcohol and drugs on a fetus.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0047&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-05-29", "governor_action": "Signed", "governor_action_date": "2025-05-29"}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 83)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0047&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-198)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0047&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-198)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0047&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN008302.pdf"}], "committee_actions": [{"date": "2025-01-08", "action": "Work Session Held", "result": null}, {"date": "2025-01-08", "action": "Voted", "result": "REFERRED"}, {"date": "2025-01-15", "action": "Reported Out", "result": "REF TO JUD"}, {"date": "202