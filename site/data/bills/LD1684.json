{"ld": 1684, "paper": "HP1119", "session": "132", "title": "An Act to Implement Additional Criteria and Processes for the Supervised Community Confinement Program (TITLE CHANGE)", "sponsor_id": "h-doudera-victoria", "cosponsor_ids": [], "committee_code": "CJPS", "committee_name": "Criminal Justice and Public Safety", "summary": {"text": "This bill amends the provisions of law governing community confinement monitoring programs and supervised community confinement monitoring programs available to inmates of county jails and prisoners of the Department of Corrections, respectively. The bill provides that transfer to a community confinement monitoring program or supervised community confinement monitoring program is not available to an inmate or prisoner who is serving a sentence for domestic violence aggravated assault, domestic violence elevated aggravated assault or domestic violence elevated aggravated assault on a pregnant person.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1119&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-18", "governor_action": "Signed", "governor_action_date": "2025-06-18"}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 1684)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1119&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-665)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1119&item=3&snum=132", "item": 3}], "amendments": [{"id": "C-A (H-665)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1119&item=3&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN168403.pdf"}], "committee_actions": [{"date": "2025-05-05", "action": "Work Session Held", "result": "TABLED"}, {"date": "2025-0