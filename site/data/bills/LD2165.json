{"ld": 2165, "paper": "HP1454", "session": "132", "title": "An Act to Change Supervisory Authority over the Capitol Police (GOVERNOR'S BILL)", "sponsor_id": "h-fecteau-ryan", "cosponsor_ids": ["s-larsen-daughtry-matthea"], "committee_code": "CJPS", "committee_name": "Criminal Justice and Public Safety", "summary": {"text": "This bill transfers the supervision duties of the Chief of the Bureau of Capitol Police within the Department of Public Safety to the Chief of the State Police and replaces the position of Chief of the Bureau of Capitol Police with a State Police Lieutenant position. The bill provides rule-making authority regarding security at the capitol area to a designee of the Commissioner of Public Safety and requires that rules adopted governing security at the legislative offices and other offices within the capitol complex include consultation with both the Commissioner of Public Safety and the Chief of the State Police. The bill also requires that the Chief of the State Police replace a Capitol Police officer position that is vacated with a state police officer position, contingent upon the funding of the reclassification of that position.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1454&item=1&snum=132"}, "status": "died", "status_label": "Died Between Houses", "final_disposition": {"label": "Died Between Houses", "date": "2026-04-08", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 2165)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1454&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-971)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1454&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-971)", "description": null, "sponsor": null, "status": "Adopted by Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1454&item=2&s