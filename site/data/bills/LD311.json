{"ld": 311, "paper": "HP211", "session": "132", "title": "An Act to Improve Efficiency of Meat and Poultry Processing Facilities by Requiring the Designation of State Inspectors as Essential", "sponsor_id": "h-foster-steven", "cosponsor_ids": ["h-albert-roger", "h-cray-dean", "h-dana-aaron", "s-guerin-stacey", "h-guerrette-timothy", "h-hall-randall", "s-hickman-craig", "h-quint-tracy", "h-shagoury-daniel"], "committee_code": "ACF", "committee_name": "Agriculture, Conservation and Forestry", "summary": {"text": "This bill requires the Commissioner of Agriculture, Conservation and Forestry to designate state inspectors authorized to perform inspection functions under the laws governing meat and poultry inspections essential to the operations of establishments at which inspection of the slaughter of livestock or poultry or the preparation of livestock products or poultry products occurs.\n\nThe bill also directs the commissioner to require, rather than authorize as in current law, inspection to continue at such an establishment on state holidays or beyond the regular work shift or workweek for state inspectors as long as the necessary inspectors are available and the establishment pays all overtime salaries for inspections necessary to keep the plant open and other expenses caused by the overtime employment.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0211&item=1&snum=132"}, "status": "died", "status_label": "Died On Adjournment", "final_disposition": {"label": "Died On Adjournment", "date": "2026-04-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 311)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0211&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-54)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0211&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-54)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0211&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN031102.pdf"}], "committee_actions": [{"date": "2025-03-18", "action": "Work Session Held", "result": null}, {"date": "2025-03-18", "action": "Voted", "result": "OTP-AM"}, {"date": "2025-04-15", "action": "Reported Out", "result": "OTP-AM"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought to Pass as Amended", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-01-30", "chamber": "House", "action": "Received by the Clerk of the House on January 30, 2025."}, {"date": "2025-01-30", "chamber": "House", "action": "The Bill was REFERRED to the Committee on AGRICULTURE, CONSERVATION AND FORESTRY pursuant to Joint Rule 308.2 and ordered printed pursuant to Joint Rule 401."}, {"date": "2025-03-18", "chamber": "J", "action": "Work Session Held"}, {"date": "2025-03-18", "chamber": "J", "action": "Voted: OTP-AM"}, {"date": "2025-03-21", "chamber": "House", "action": "Carried over, in the same posture, to the next special or regular session of the 132nd Legislature, pursuant to Joint Order SP 519."}, {"date": "2025-04-15", "chamber": "J", "action": "Reported Out: OTP-AM"}, {"date": "2025-04-17", "chamber": "House", "action": "CONSENT CALENDAR - FIRST DAY"}, {"date": "2025-04-17", "chamber": "House", "action": "Under suspension of the rules CONSENT CALENDAR - SECOND DAY."}, {"date": "2025-04-17", "chamber": "House", "action": "The Bill was PASSED TO BE ENGROSSED as Amended by Committee Amendment \"A\" (H-54)."}, {"date": "2025-04-17", "chamber": "House", "action": "Sent for concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-04-17", "chamber": "Senate", "action": "Report READ and ACCEPTED, in concurrence."}, {"date": "2025-04-17", "chamber": "Senate",