{"ld": 1627, "paper": "HP1081", "session": "132", "title": "An Act Regarding Workforce Development, Education Reform and Talent Retention", "sponsor_id": "h-white-russell", "cosponsor_ids": ["h-bishop-steven", "h-fredericks-ann", "h-mcintyre-mathew", "h-mingo-arthur", "h-rudnicki-shelley", "h-simmons-abden"], "committee_code": "EDU", "committee_name": "Education and Cultural Affairs", "summary": {"text": "This bill requires that students complete an internship prior to graduating from high school beginning January 1, 2027. The bill also requires the Department of Education to: 1. Develop and implement a career exploration module for middle school and high school students; 2. Require school administrative units to track and report post-graduation outcomes and examine metrics that incentivize school administrative units to guide students toward 4-year degree programs; 3. Provide training on career counseling standards, including professional development for school counselors regarding career pathways in high-demand fields; 4. Mandate that all high school students receive information on a variety of post-graduation options, including apprenticeships, certification programs and local employment opportunities in high demand; 5. Redirect infrastructure funds to upgrade career and technical education facilities and equipment to meet industry standards; 6. Expand access to extended learning opportunity program coordinators, prioritizing underserved and rural areas; 7. Establish a competitive grant program for employers to partner with schools, career and technical education centers and the Maine Community College System to create new training opportunities to address workforce gaps; 8. Fund innovative pilot programs, such as mobile training units; 9. Develop, in consultation with the Department of Administrative and Financial Services, Bureau of Revenue Services, employer tax incentives for workforce investments; 10. Coordinate with the Department of Labor to address labor shortages in underserved regions by offering temporary housing and commuting or relocation stipends; 11. Conduct audits of workforce education to identify inefficient programs and, upon discovery, reallocate the funds to initiatives with measurable outcomes; and 12. Submit a report no later than December 3, 2025 to the Joint Standing Committee on Education and Cultural Affairs with suggested legislation.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1081&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-20", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "fiscal_note_url": null, "documents": [{"label": "Bill text (LD 1627)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1081&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-08", "action": "Work Session Held", "result": null}, {"date": "2025-05-08", "action": "Voted", "result": "Divided Report"}, {"date": "2025-05-12", "action": "Work Session Reconsidered", "result": null}, {"date": "2025-05-12", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-15", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-04-11", "chamber": "House", "action": "Received by the Clerk of the House on April 11, 2025."}, {"date": "2025-04-11", "chamber": "House", "action": "The Bill was REFERRED to the Committee on EDUCATION AND CULTURAL AFFAIRS pursuant to Joint Rule 308.2 and ordered printed pursuant to Joint Rule 401."}, {"date": "2025-05-20", "chamber": "Senate", "action": "Pursuant to Joint Rule 310.3 Placed in Legislative Files (DEAD)"}], "roll_call