{"ld": 183, "paper": "HP116", "session": "132", "title": "An Act to Cap Publicly Owned Land Area at No More than 50 Percent of Any County", "sponsor_id": "h-faulkingham-william", "cosponsor_ids": ["h-mcintyre-mathew", "h-mingo-arthur", "s-moore-marianne", "h-quint-tracy", "h-strout-tiffany", "h-tuell-william"], "committee_code": "ACF", "committee_name": "Agriculture, Conservation and Forestry", "summary": {"text": "This bill limits publicly owned land in the State to no more than 50% of the land area in any county. The bill also allows the State, a county or a municipality to exceed the limits with the approval of 2/3 of each House of the Legislature.\n\nThe Department of Agriculture, Conservation and Forestry is required to report biannually beginning April 15, 2026 to the joint standing committee of the Legislature having jurisdiction over public lands matters on the percentage of federal, state, county and municipal property ownership statewide and by county.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0116&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-04-01", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 183)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0116&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-03-25", "action": "Work Session Held", "result": null}, {"date": "2025-03-25", "action": "Voted", "result": "ONTP"}, {"date": "2025-03-27", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-01-14", "chamber": "House", "action": "Commit