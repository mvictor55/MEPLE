{"ld": 787, "paper": "SP347", "session": "132", "title": "An Act to Clarify Residency Requirements for the Maine School of Science and Mathematics (TITLE CHANGE)", "sponsor_id": "s-grohoski-nicole", "cosponsor_ids": ["h-babin-mark", "h-carlow-nathan", "h-dodge-janice", "h-frost-sharon", "h-gere-traci", "s-libby-james", "h-murphy-kelly", "s-rafferty-joseph", "h-sargent-holly"], "committee_code": "EDU", "committee_name": "Education and Cultural Affairs", "summary": {"text": "Current law requires that state funding for a student who applies to the Maine School of Science and Mathematics is available only if the student resided in Maine for at least 6 months prior to applying to the school. This bill instead requires that the student reside in 4304 Maine at the start of the academic year for which state funds are appropriated. This bill 4315 also provides ongoing funds to the Maine School of Science and Mathematics to support administrative operations and allow the administration to give financial support to in-state students who demonstrate a financial need related to paying room and board expenses.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0347&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-07-01", "governor_action": "Signed", "governor_action_date": "2025-07-01"}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 787)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0347&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-160)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0347&item=2&snum=132", "item": 2}, {"label": "Amendment C-B (S-161)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0347&item=3&snum=132", "item": 3}, {"label": "Amendment S-A to C-A (S-226)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0347&i