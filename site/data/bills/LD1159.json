{"ld": 1159, "paper": "HP764", "session": "132", "title": "An Act to Prohibit Governmental Entities That Charge a Fee for In-person Credit Card Purchases from Refusing to Accept Cash (TITLE CHANGE)", "sponsor_id": "h-rollins-david", "cosponsor_ids": ["h-babin-mark", "s-duson-jill", "h-sinclair-david", "h-supica-laura"], "committee_code": "HED", "committee_name": "Housing and Economic Development", "summary": {"text": "This bill requires a person offering goods or services at retail in person to accept cash for sales of less than $2,000 and prohibits the person from accepting payment by only an electronic method. These provisions do not apply to transactions conducted remotely by telephone, mail or the Internet. The bill also prohibits a person offering goods or services at retail from posting any sign stating that cash payments are not accepted and from charging a higher price to customers paying with cash instead of by an electronic method.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0764&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-09", "governor_action": "Signed", "governor_action_date": "2025-06-09"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1159)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0764&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-222)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0764&item=2&snum=132", "item": 2}, {"label": "Amendment C-B (H-223)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0764&item=3&snum=132", "item": 3}], "amendments": [{"id": "C-A (H-222)", "description": "Change Title", "sponsor": null, "status": null, "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0764&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/f