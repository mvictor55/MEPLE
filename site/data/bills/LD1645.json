{"ld": 1645, "paper": "SP653", "session": "132", "title": "An Act to Improve Legislative Access to Public Information", "sponsor_id": "s-tipping-michael", "cosponsor_ids": ["h-friedmann-gary", "h-sayre-daniel"], "committee_code": "JUD", "committee_name": "Judiciary", "summary": {"text": "This bill amends the Freedom of Access Act by requiring a request submitted by 3 or more Legislators to be complied with within 20 working days as long as at least 3 of the Legislators are members of the Legislature's government oversight committee and one of those 3 members is one of the chairs of that committee. Current law requires the agency or official receiving the request to make a good faith effort to comply with the request within a nonbinding estimate of time provided by the agency or official.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0653&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-28", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1645)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0653&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-06", "action": "Work Session Held", "result": null}, {"date": "2025-05-06", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-27", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-04-11", "chamber": "Senate", "action": "Received by the Secretary of the Senate on April 11, 2025 and REFERRED to the Committee on JUDICIARY pursuant to Joint Rule 308.2"}, {"date": "2025-05-06", "chamber": "J", "action"