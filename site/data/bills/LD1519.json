{"ld": 1519, "paper": "HP1004", "session": "132", "title": "An Act to Create a Stewardship Program for Electronic Smoking Devices and Related Products", "sponsor_id": "h-gramlich-lori", "cosponsor_ids": ["h-bell-arthur", "h-bridgeo-william", "h-doudera-victoria", "h-osher-laurie", "h-rielly-morgan", "s-tepler-denise"], "committee_code": "ENR", "committee_name": "Environment and Natural Resources", "summary": {"text": "This bill requires that, on or before November 1, 2026, a producer of electronic smoking devices, individually, collectively or through a stewardship organization, must submit to the Department of Environmental Protection for review and approval a plan for the establishment of a stewardship program to manage unwanted electronic smoking devices sold by the producer at the end of the device's life. One hundred eighty days after a stewardship plan is approved by the department, a producer of electronic smoking devices may not sell or offer for sale in the State an electronic smoking device unless the producer participates, individually, collectively or through a stewardship organization, in an approved electronic smoking device stewardship program.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1004&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2026-04-23", "governor_action": "Signed", "governor_action_date": "2026-04-23"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1519)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1004&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-412)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1004&item=2&snum=132", "item": 2}, {"label": "Amendment S-A (S-292)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1004&item=4&snum=132", "item": 4}, {"label": "Amendment S-A to C-A (S-682)", "url"