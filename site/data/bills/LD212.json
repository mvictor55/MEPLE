{"ld": 212, "paper": "HP135", "session": "132", "title": "An Act to Require the Valuation of Energy Produced by Hydropower Dams and Exploration of Alternative Ownership Options Before They Are Removed", "sponsor_id": "h-campbell-richard", "cosponsor_ids": ["h-bishop-steven", "s-haggan-david", "h-soboleski-michael"], "committee_code": "ENR", "committee_name": "Environment and Natural Resources", "summary": {"text": "This bill amends the law governing hydropower projects to require an applicant for a permit to remove a dam that is part of a hydropower project to provide to the Department of Environmental Protection or to the Maine Land Use Planning Commission, as applicable, an evaluation of the monetary value of the electrical or mechanical power that the dam is capable of generating. The applicant must also demonstrate to the department or commission that the applicant made all reasonable efforts to sell the dam and was unable to reach an agreement on a sale with an alternative owner. The department or commission is authorized to adopt routine technical rules to implement these requirements.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0135&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-04-24", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 212)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0135&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-01-30", "action": "Refer Approved by Chairs/Leads", "result": "REFER TO OTHER"}, {"date": "2025-01-30", "action": "Reported Out", "result": "REFER TO OTHER"}, {"date": "2025-04-16", "action": "Work Session Held", "result": null}, {"date": "2025-04-16", "action": "Voted", "result": 