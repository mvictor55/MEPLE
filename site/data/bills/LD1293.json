{"ld": 1293, "paper": "SP523", "session": "132", "title": "An Act to Prohibit Coyote-killing Contests in Maine", "sponsor_id": "s-beebe-center-anne", "cosponsor_ids": ["h-boyer-michelle", "s-brenner-stacy", "h-dodge-janice", "h-friedmann-gary", "h-kuhn-amy", "s-lawrence-mark", "h-pugh-dylan", "s-rafferty-joseph"], "committee_code": "IFW", "committee_name": "Inland Fisheries and Wildlife", "summary": {"text": "This bill prohibits coyote-killing contests. It provides that a person who arranges, provides a venue for, entices a person to knowingly take part in or knowingly takes part in a coyote-killing contest commits a Class E crime. It specifies that the law prohibiting coyote-killing contests may not be construed to prohibit the defense of a person or property or a government employee's sanctioned culling of coyotes.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0523&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-27", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 1293)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0523&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-16", "action": "Work Session Held", "result": null}, {"date": "2025-04-16", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-22", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-03-25", "chamber": "Senate", "action": "Committee on INLAND FISHERIES AND WILDLIFE suggested and ordered printed REFERENCE to the Committee on INLAND FISHERIES AND WILDLIFE Ordered sent down fort