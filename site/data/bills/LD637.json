{"ld": 637, "paper": "HP405", "session": "132", "title": "Resolve, Directing the Department of Health and Human Services to Evaluate the Municipal General Assistance Program Database", "sponsor_id": "h-henderson-rachel", "cosponsor_ids": ["h-collins-alicia", "h-daigle-lucien", "h-haggan-kimberly", "h-lyman-sheila", "h-quint-tracy"], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This resolve directs the Department of Health and Human Services to issue a report to the Joint Standing Committee on Health and Human Services on an evaluation of the feasibility of upgrading the database for the municipal general assistance program to allow the determination of whether a disqualified applicant is seeking assistance in another municipality. If the department determines that the current database cannot be upgraded, the department is to research a suitable replacement database that fulfills the criterion. The department is directed to provide the committee a timeline for implementation of the upgrade or new database.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0405&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-22", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 637)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0405&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-24", "action": "Work Session Held", "result": null}, {"date": "2025-04-24", "action": "Voted", "result": "OTP-AM"}, {"date": "2025-05-15", "action": "Work Session Reconsidered", "result": null}, {"date": "2025-05-15", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-21", "action": "Reported Out", "result": "ONTP"}