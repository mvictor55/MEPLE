{"ld": 1473, "paper": "HP965", "session": "132", "title": "An Act to Require Gas Utilities to Assess for Natural Gas Leaks and to Require Reporting of Gas Leak Information (TITLE CHANGE)", "sponsor_id": "h-warren-sophia", "cosponsor_ids": ["h-faircloth-sean", "h-geiger-valli", "h-webb-kilton"], "committee_code": "EUT", "committee_name": "Energy, Utilities and Technology", "summary": {"text": "This bill directs gas utilities to monitor the utilities' natural gas meters for leaks and report annually to the Public Utilities Commission on the number of leaks identified and any action taken to address the leaks. The bill requires the Public Utilities Commission to contract a qualified impartial 3rd party to periodically assess utility compliance with the monitoring and reporting requirements. The bill directs the Public Utilities Commission to adopt routine technical rules to carry out the purposes of the provisions of the bill.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0965&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-09", "governor_action": "Signed", "governor_action_date": "2025-06-09"}, "fiscal_status": "Not Yet Determined", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN147302.pdf", "documents": [{"label": "Bill text (LD 1473)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0965&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-321)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0965&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-321)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0965&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN147302.pdf"}], "committee_action