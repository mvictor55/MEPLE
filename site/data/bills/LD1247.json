{"ld": 1247, "paper": "HP822", "session": "132", "title": "An Act to Restrict Municipal Ordinance Requirements Regarding Housing Developments", "sponsor_id": "h-gere-traci", "cosponsor_ids": ["h-ankeles-daniel", "h-julia-cassie", "h-malon-marc", "h-mastraccio-anne-marie", "h-roeder-amy"], "committee_code": "HED", "committee_name": "Housing and Economic Development", "summary": {"text": "This bill provides restrictions on municipal ordinance requirements related to minimum lot size in areas where water and sewer infrastructure are available. For a housing development that is served by a public, special district or other centrally managed water system and a public, special district or other comparable sewer system and that is located in an area in which dwelling units are allowed, a municipality must allow a dwelling unit on a lot with a minimum size of 5,000 square feet. The bill also provides limits to ordinance provisions relating to lot coverage, road frontage and setback requirements.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0822&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2026-01-20", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1247)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0822&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-09", "action": "Work Session Held", "result": "TABLED"}, {"date": "2025-05-16", "action": "Work Session Held", "result": "TABLED"}, {"date": "2025-05-19", "action": "Carry Over Requested", "result": null}, {"date": "2025-05-19", "action": "Carry Over Approved", "result": null}, {"date": "2026-01-06", "action": "Work Session Held", "result": null}, {"date": "2026-01-06", "action":