{"ld": 399, "paper": "HP253", "session": "132", "title": "An Act to Amend the Laws Regarding the Retention of Proceeds from Municipal Foreclosures", "sponsor_id": "h-mcintyre-mathew", "cosponsor_ids": [], "committee_code": "TAX", "committee_name": "Taxation", "summary": {"text": "This bill provides that if the former owner of property that was foreclosed upon by a municipality, after notification by that municipality, fails to claim the excess sale proceeds within 30 days of the final published notice, the municipality must retain the excess sale proceeds. Current law requires the municipality to transfer the excess sale proceeds to the Unclaimed Property Fund.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0253&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-04-01", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 399)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0253&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-03-18", "action": "Work Session Held", "result": null}, {"date": "2025-03-18", "action": "Voted", "result": "ONTP"}, {"date": "2025-03-27", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-02-04", "chamber": "House", "action": "Committee on Taxation suggested and ordered printed."}, {"date": "2025-02-04", "chamber": "House", "action": "The Bill was REFERRED to the Committee on TAXATION."}, {"date": "2025-02-04", "chamber": "House", "action": "Sent for concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-02-04", "chamber": "Senate", "