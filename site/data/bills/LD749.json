{"ld": 749, "paper": "HP491", "session": "132", "title": "An Act to Ensure That the Will of the Voters Is Reflected in Interim Appointments of United States Senators", "sponsor_id": "h-boyer-david", "cosponsor_ids": ["h-chapman-quentin", "h-drinkwater-gary", "h-frost-sharon", "s-grohoski-nicole", "s-haggan-david", "h-henderson-rachel", "s-hickman-craig", "h-perkins-chad", "h-warren-sophia"], "committee_code": "SLG", "committee_name": "State and Local Government", "summary": {"text": "This bill provides that if there is a vacancy in the office of United States Senator and the person who vacated the office was enrolled in a political party at the time of that person's last election to that office, the qualified person appointed to fill the vacancy must have been enrolled in that party at the time of the most recent election and at the time the office was vacated and must be enrolled in that party at the time the qualified person is appointed. If the person who vacated the office was not enrolled in a political party at the time of that person's last election to that office, the qualified person appointed to fill the vacancy may not have been enrolled in a political party at the time of the most recent election and at the time the office was vacated and may not be enrolled in a political party at the time the qualified person is appointed.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0491&item=1&snum=132"}, "status": "died", "status_label": "Died On Adjournment", "final_disposition": {"label": "Died On Adjournment", "date": "2025-06-25", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 749)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0491&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-09", "action": "Work Session Held", "result": null}, {"date": "2025-04-09", "ac