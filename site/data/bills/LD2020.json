{"ld": 2020, "paper": "HP1350", "session": "132", "title": "An Act to Update Department of Education Reporting Requirements", "sponsor_id": "h-murphy-kelly", "cosponsor_ids": [], "committee_code": "EDU", "committee_name": "Education and Cultural Affairs", "summary": {"text": "This bill updates various provisions of law that require the Department of Education to make annual reports to the Legislature. The bill changes the reporting dates of several required annual reports. It also changes the type of information the department must include in:\n\n1. Its report concerning the Child Development Services System; 2. Its report during the period in which school administrative units are transitioning to take over responsibility of child find activities and for ensuring a free, appropriate public education for children eligible under Part B, Section 619 of the federal Individuals with Disabilities Education Act; and 3. Its reports related to educator workforce preparation and postsecondary retention and graduation rates.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1350&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2026-03-26", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN202001.pdf", "documents": [{"label": "Bill text (LD 2020)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1350&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2026-01-29", "action": "Work Session Held", "result": "TABLED"}, {"date": "2026-03-12", "action": "Work Session Held", "result": null}, {"date": "2026-03-12", "action": "Voted", "result": "ONTP"}, {"date": "2026-03-24", "action": "Reported Out", "result": "ONTP"}], "c