{"ld": 1910, "paper": "SP751", "session": "132", "title": "An Act to Strengthen Housing Stability Services by Increasing Support and Outreach (EMERGENCY)", "sponsor_id": "s-talbot-ross-rachel", "cosponsor_ids": ["s-curry-glenn", "h-golek-cheryl", "h-julia-cassie", "h-malon-marc", "h-yusuf-yusuf"], "committee_code": "HED", "committee_name": "Housing and Economic Development", "summary": {"text": "4303 This bill requires the Department of Health and Human Services to contract with 4314 community-based nonprofit organizations through a request for proposals process for 9 outreach caseworkers and 9 housing stability workers. The outreach caseworkers and housing stability workers provide housing and supportive services to individuals who are unhoused and chronically homeless, as well as ensuring that the individuals are in safe indoor environments while awaiting permanent housing. The contracted workers are distributed around the State and targeted to areas with higher populations of individuals who are homeless. The bill requires ongoing appropriations of $800,000 each year for outreach caseworkers and $900,000 each year for housing stability workers.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0751&item=1&snum=132"}, "status": "died", "status_label": "Died On Adjournment", "final_disposition": {"label": "Died On Adjournment", "date": "2026-04-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN191001.pdf", "documents": [{"label": "Bill text (LD 1910)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0751&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-322)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0751&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-322)", "description": "Emergency", "sponsor": null, "status": "