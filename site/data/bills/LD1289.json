{"ld": 1289, "paper": "SP518", "session": "132", "title": "An Act to Amend the Election Recount Process", "sponsor_id": "s-pierce-teresa", "cosponsor_ids": ["s-duson-jill", "s-hickman-craig", "h-supica-laura"], "committee_code": "VLA", "committee_name": "Veterans and Legal Affairs", "summary": {"text": "This bill reduces by half the vote percentage difference or amount of votes in an election used to determine the deposit required for a recount. The bill also includes in the actual cost of the recount that the candidate requesting the recount is required to pay the payroll costs of the state workers necessary to conduct the recount. The bill requires a refund to be provided to the requesting candidate if the deposit paid is more than the actual cost of the recount and requires the requesting candidate to pay the difference if the actual cost of the recount is more than the deposit paid.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0518&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-04-30", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 1289)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0518&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-24", "action": "Work Session Held", "result": null}, {"date": "2025-04-24", "action": "Voted", "result": "ONTP"}, {"date": "2025-04-29", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-03-25", "chamber": "Senate", "action": "Committee on VETERANS AND LEGAL AFFAIRS suggested and ordered printed REFERENCE to t