{"ld": 902, "paper": "SP391", "session": "132", "title": "An Act to Establish the Medical Debt Relief Program", "sponsor_id": "s-baldacci-joseph", "cosponsor_ids": [], "committee_code": "HCIFS", "committee_name": "Health Coverage, Insurance and Financial Services", "summary": {"text": "This bill establishes the Medical Debt Relief Program to be administered by the Department of Professional and Financial Regulation, Bureau of Consumer Credit Protection for the purchase, cancellation and forgiveness of medical debt for residents of the State whose federal adjusted gross income is not more than 400% of the federal poverty level and who meet other specified conditions. The bill provides that cancelled or forgiven debt may not be included the individual's taxable income.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0391&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-04-08", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 902)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0391&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-02", "action": "Work Session Held", "result": null}, {"date": "2025-04-02", "action": "Voted", "result": "ONTP"}, {"date": "2025-04-04", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-03-05", "chamber": "Senate", "action": "Received by the Secretary of the Senate on March 5, 2025 and REFERRED to the Committee on HEALTH COVERAGE, INSURANCE AND FINANCIAL SERVICES pursuant to Joint Rule 308.2"}, {"date": "2025-03-21", "chamber"