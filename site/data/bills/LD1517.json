{"ld": 1517, "paper": "HP1002", "session": "132", "title": "An Act to Replace Participation Thresholds with Approval Thresholds in Certain School, Municipal and County Measures", "sponsor_id": "h-sato-eleanor", "cosponsor_ids": ["h-bridgeo-william", "h-debrito-flavia", "h-dhalac-deqa", "h-murphy-kelly"], "committee_code": "SLG", "committee_name": "State and Local Government", "summary": {"text": "Current law requires the total number of votes cast for certain school, municipal or county measures to be at least equal to or exceed a percentage of votes cast in the municipality or county, as relevant, in the last gubernatorial election in order for the result of the vote to be valid. This bill reduces the needed percentage of votes cast in the last gubernatorial election for the result to be considered valid but requires that percentage to be in favor of the measure being considered.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1002&item=1&snum=132"}, "status": "died", "status_label": "Died Between Houses", "final_disposition": {"label": "Died Between Houses", "date": "2025-06-16", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 1517)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1002&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-578)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1002&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-578)", "description": null, "sponsor": null, "status": "Adopted by House", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1002&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN151702.pdf"}], "committee_actions": [{"date": "2025-05-12", "action": "Work Session Held", "result": null}, {"date": "2025-05-12", "action": "Voted", "result": "Divided Report"},