{"ld": 181, "paper": "HP114", "session": "132", "title": "An Act to Modify the Calculation of Pupil Counts Used for Determination of School Administrative Unit Operating Costs", "sponsor_id": "h-tuell-william", "cosponsor_ids": ["s-moore-marianne", "h-sargent-holly", "h-strout-tiffany"], "committee_code": "EDU", "committee_name": "Education and Cultural Affairs", "summary": {"text": "This bill amends the calculation of the pupil count used for determination of operating costs for school administrative units to provide that, beginning in fiscal year 2026-27, the pupil count includes the greater of the average of the pupil counts for October 1st of the 3 most recent calendar years prior to the year of funding and the most recent October 1st pupil count. The bill corrects cross-references to these provisions of law as necessary. The bill also repeals outdated language that is no longer used in calculating the pupil count.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0114&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-04-01", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 181)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0114&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-03-05", "action": "Work Session Held", "result": null}, {"date": "2025-03-05", "action": "Voted", "result": "OTP-AM"}, {"date": "2025-03-19", "action": "Work Session Reconsidered", "result": null}, {"date": "2025-03-19", "action": "Voted", "result": "ONTP"}, {"date": "2025-03-26", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-01-14", "chamber": "House", "action": "Committee on Education and Cultural Affairs suggested and ordered printed."}, {"date": "2025-01-14", "chamber": "House", "action": "The Bill was REFERRED to the Committee on EDUCATION AND CULTURAL AFFAIRS."}, {"date": "2025-01-14", "chamber": "House", "action": "Sent for concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-01-14", "chamber": "Senate", "action": "The Bill was REFERRED to the Committee on EDUCATION AND CULTURAL AFFAIRS  in concurrence"}, {"date": "2025-03-05", "chamber": "J", "action": "Work Session Held"}, {"date": "2025-03-05", "chamber": "J", "action": "Voted: OTP-AM"}, {"date": "2025-03-19", "chamber": "J", "action": "Work Session Reconsidered"}, {"date": "2025-03-19", "chamber": "J", "action": "Voted: ONTP"}, {"date": "2025-03-21", "chamber": "House", "action": "Carried over, in the same posture, to the next special or regular session of the 132nd Legislature, pursuant to Joint Order SP 519."}, {"date": "2025-03-26", "chamber": "J", "action": "Reported Out: ONTP"}, {"date": "2025-04-01", "chamber": "Senate", "action": "Pursuant to Joint Rule 310.3 Placed in Legislative Files (DEAD)"}], "roll_calls": [], "hearing": {"date": "2025-02-26", "time": "10:00 AM", "location": "Cross Building, Room 208", "committee_code": "EDU", "testimony_count": 4}, "heard_with": [], "tags": ["School Funding Formula", "Essential Programs And Services"], "affected_statutes": [], "testimony": [{"id": "184252", "name": "Robbie Feinberg", "organization": "Maine School Management Association", "town": null, "position": "support", "position_source": "inferred", "date": "2025-02-26", "hearing_date": "2025-02-26", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=184252", "has_text": true, "shared_with": []}, {"id": "184253", "name": "Scott Porter", "organization": "AOS 96", "town": null, "position": null, "position_source": null, "date": "2025-02-26", "hearing_date