{"ld": 1606, "paper": "HP1060", "session": "132", "title": "An Act to Require Data Collection and Major Substantive Rulemaking for the Lifespan Waiver Providing Home and Community-based Services for Individuals with Intellectual and Developmental Disabilities, Autism Spectrum Disorder or Other Related Conditions (EMERGENCY)", "sponsor_id": "h-boyer-michelle", "cosponsor_ids": ["h-arford-poppy", "s-carney-anne", "h-cluchey-sally", "h-hepler-allison", "s-moore-marianne", "h-salisbury-suzanne", "s-tepler-denise"], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This bill requires the rulemaking for the lifespan waiver to be major substantive. Current law requires only the initial rulemaking to be major substantive. The bill also requires the Department of Health and Human Services to collect data related to unmet needs identified in individuals' personal plans and related to residential transitions between group homes, shared living and self-directed residential arrangements. The department is required to publish an annual report with the data on its publicly accessible website and submit the report to the joint standing committee of the Legislature having jurisdiction over health and human services matters.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1060&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-20", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 1606)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1060&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-14", "action": "Work Session Held", "result": null}, {"date": "2025-05-14", "action": "Voted", "result": "ONTP"}, {"date