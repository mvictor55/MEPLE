{"ld": 1462, "paper": "HP954", "session": "132", "title": "An Act to Promote Artisans and the Creative Economy", "sponsor_id": "h-hepler-allison", "cosponsor_ids": ["s-beebe-center-anne", "h-brennan-michael", "h-carlow-nathan", "h-crockett-edward", "h-dill-james", "h-morris-joshua"], "committee_code": "SLG", "committee_name": "State and Local Government", "summary": {"text": "This bill provides that a municipality may not adopt or enforce any ordinance or regulation that prohibits the vending of expressive matter, except a municipality may adopt restrictions regulating the time, place and manner of the vending of expressive matter if the restrictions meet certain conditions. \"Expressive matter\" is defined as materials or objects created by a vendor with expressive content, including written material, such as newspapers, books or writings, and visual art, such as paintings, prints, photography or sculpture.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0954&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-15", "governor_action": "Unsigned", "governor_action_date": "2025-06-15"}, "fiscal_status": "No Fiscal Impact", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN146201.pdf", "documents": [{"label": "Bill text (LD 1462)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0954&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-30", "action": "Work Session Held", "result": null}, {"date": "2025-04-30", "action": "Voted", "result": "Divided Report"}, {"date": "2025-05-22", "action": "Reported Out", "result": "OTP/ONTP"}], "committee_reports": [{"label": "Report A", "recommendation": "Ought To Pass", "signer_count": 6, "signers": ["Senator Joseph Baldacci (Chair)", "Representative Suzanne Salisbury (Chair)", "Representative Lynn Copeland", "Rep