{"ld": 1521, "paper": "HP1006", "session": "132", "title": "An Act to Require All State Agencies to Provide a Zero-based Budget Once Every 10 Years", "sponsor_id": "h-ducharme-john", "cosponsor_ids": ["h-arata-amy", "s-bickford-bruce", "h-flynn-paul", "h-hasenfus-tavis", "h-mcintyre-mathew", "h-rudnicki-shelley", "s-stewart-harold"], "committee_code": "AFA", "committee_name": "Appropriations and Financial Affairs", "summary": {"text": "The bill requires the development of a new budgeting system in which agencies would be subject to zero-based budgeting every 10 years and in the interim years be subject to review and alternative budget requirements. The bill also requires the Department of Administrative and Financial Services to submit legislation facilitating a zero-based budget to the Joint Standing Committee on Appropriations and Financial Affairs and authorizes the committee to report out a bill based on the department's submission.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1006&item=1&snum=132"}, "status": "died", "status_label": "Died On Adjournment", "final_disposition": {"label": "Died On Adjournment", "date": "2026-04-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1521)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1006&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-06-25", "action": "Carry Over Approved", "result": null}, {"date": "2025-12-15", "action": "Work Session Held", "result": "TABLED"}], "committee_reports": [], "chamber_actions": [{"date": "2025-04-08", "chamber": "House", "action": "Committee on Appropriations and Financial Affairs suggested and ordered printed."}, {"date": "2025-04-08", "chamber": "House", "action": "The Bill was REFERRED to the Committee on APPROPRIATIONS AND FINANCIAL AFFAIRS."}, {"date": "2025-04-08", "chamber":