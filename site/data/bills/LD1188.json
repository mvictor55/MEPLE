{"ld": 1188, "paper": "HP793", "session": "132", "title": "An Act to Amend the Law Governing Facilities Approved by the State Harness Racing Commission to Sell Pari-mutuel Pools and Common Pari-mutuel Pools for Simulcast Racing (EMERGENCY) (TITLE CHANGE)", "sponsor_id": "h-cooper-mark", "cosponsor_ids": ["s-black-russell", "h-cray-dean", "h-frost-sharon", "h-guerrette-timothy", "h-hall-randall", "h-perkins-chad"], "committee_code": "VLA", "committee_name": "Veterans and Legal Affairs", "summary": {"text": "This bill allows for the sale of pari-mutuel pools by persons who are licensed by the Maine State Harness Racing Commission as commercial racetracks at facilities also licensed by the Department of Public Safety, Gambling Control Unit for sports wagering. It repeals a provision of law that restricts where persons licensed to conduct harness horse racing with pari-mutuel betting may sell pari-mutuel pools for simulcast races that otherwise would be repealed on January 1, 2026.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0793&item=1&snum=132"}, "status": "enacted", "status_label": "Emergency Enacted", "final_disposition": {"label": "Emergency Enacted", "date": "2025-06-12", "governor_action": "Emergency Signed", "governor_action_date": "2025-06-12"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1188)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0793&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-413)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0793&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-413)", "description": "Emergency", "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0793&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN118802.pdf"}], "committee_actions": [{"d