{"ld": 1132, "paper": "SP453", "session": "132", "title": "An Act to Further Protect Low-impact Landscaping", "sponsor_id": "s-larsen-daughtry-matthea", "cosponsor_ids": ["h-ankeles-daniel", "h-dodge-janice", "h-doudera-victoria", "h-henderson-rachel", "s-hickman-craig", "s-ingwersen-henry", "h-sato-eleanor"], "committee_code": "JUD", "committee_name": "Judiciary", "summary": {"text": "This bill prohibits any instrument, such as a deed or bylaw, governing activities on real estate within a condominium or real estate subject to common ownership from prohibiting low-impact landscaping on any portion of a condominium or real estate subject to common ownership, including limited common elements. It also prohibits the application of pesticides on limited common elements or land within 50 feet of a unit without the express permission of the unit owner.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0453&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-04-17", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 1132)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0453&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-10", "action": "Work Session Held", "result": null}, {"date": "2025-04-10", "action": "Voted", "result": "ONTP"}, {"date": "2025-04-15", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-03-18", "chamber": "Senate", "action": "Committee on JUDICIARY suggested and ordered printed REFERENCE to the Committee on JUDICIARY Ordered sent down forthwith f