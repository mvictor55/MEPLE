{"ld": 1598, "paper": "HP1056", "session": "132", "title": "An Act to Provide Relocation Assistance to Crime Victims (TITLE CHANGE)", "sponsor_id": "h-stover-holly", "cosponsor_ids": ["h-gramlich-lori", "h-meyer-michele", "h-pluecker-william", "h-rana-ambureen", "s-reny-cameron", "h-sato-eleanor"], "committee_code": "JUD", "committee_name": "Judiciary", "summary": {"text": "This bill provides that a victim of a domestic violence crime or a sexual assault or trafficking crime is eligible to receive up to $3,000 in compensation from the Victims' Compensation Board for actual and unreimbursed relocation expenses to escape an unsafe environment directly related to the underlying crime or to alleviate a threat of future violence associated with the ongoing investigation and criminal prosecution of the underlying crime. If the victim is the victim of one or more subsequent domestic violence crimes or sexual assault or trafficking crimes, the board may award additional relocation assistance as long as the total lifetime relocation assistance the victim receives from the board does not exceed $5,000.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1056&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-05-30", "governor_action": "Signed", "governor_action_date": "2025-05-30"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1598)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1056&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-195)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1056&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-195)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1056&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.g