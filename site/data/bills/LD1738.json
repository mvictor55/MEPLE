{"ld": 1738, "paper": "HP1156", "session": "132", "title": "An Act to Establish the Biohazard Waste Disposal Grant Program to Support Public Health Efforts in the State", "sponsor_id": "h-rana-ambureen", "cosponsor_ids": ["h-daigle-lucien", "h-debrito-flavia", "h-graham-anne", "s-ingwersen-henry", "h-mccabe-julia", "s-moore-marianne", "h-shagoury-daniel", "h-zager-samuel"], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This bill establishes the Biohazard Waste Disposal Grant Program within the Department of Health and Human Services, Maine Center for Disease Control and Prevention.\n\nThe purpose of the program is to disseminate grant funds to community organizations seeking to develop or enhance community hypodermic apparatus mitigation and disposal efforts. The center is required to establish grant guidelines and selection requirements, as well as to submit an annual report to the Legislature.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1156&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2026-01-11", "governor_action": "Unsigned", "governor_action_date": "2026-01-11"}, "fiscal_status": "Not Yet Determined", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN173802.pdf", "documents": [{"label": "Bill text (LD 1738)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1156&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-484)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1156&item=2&snum=132", "item": 2}, {"label": "Amendment S-A to C-A (S-489)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1156&item=9&snum=132", "item": 9}], "amendments": [{"id": "C-A (H-484)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/b