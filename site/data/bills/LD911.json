{"ld": 911, "paper": "SP401", "session": "132", "title": "An Act to Clarify Procedures for When a Candidate Withdraws from an Election Determined by Ranked-choice Voting or When a Candidate Dies or Becomes Disqualified in an Election Determined by Ranked-choice Voting (TITLE CHANGE)", "sponsor_id": "s-tipping-michael", "cosponsor_ids": [], "committee_code": "VLA", "committee_name": "Veterans and Legal Affairs", "summary": {"text": "This bill modifies the ranked-choice voting procedures. In instances where a candidate or a candidate for nomination in an election determined by ranked-choice voting withdraws from the election but the candidate's name remains on the election ballot, a vote for the candidate that has withdrawn may not be counted in any round and instead the next highest- ranked continuing candidate must be counted. Each subsequent round must be adjusted in the same manner.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0401&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-18", "governor_action": "Signed", "governor_action_date": "2025-06-18"}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 911)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0401&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-333)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0401&item=2&snum=132", "item": 2}, {"label": "Amendment S-A to C-A (S-378)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0401&item=4&snum=132", "item": 4}], "amendments": [{"id": "C-A (S-333)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0401&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN091102.pdf"}, {"id": "S-A to 