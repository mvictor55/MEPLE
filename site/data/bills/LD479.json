{"ld": 479, "paper": "HP308", "session": "132", "title": "An Act to Facilitate Expansion of the State's Recycling Efforts Under the Beverage Container Redemption Program", "sponsor_id": "h-chapman-quentin", "cosponsor_ids": [], "committee_code": "ENR", "committee_name": "Environment and Natural Resources", "summary": {"text": "This bill requires the Department of Environmental Protection to include an evaluation and recommendations regarding the inclusion within the beverage container redemption program of additional container sizes and types used to contain beverages or other consumer products that are not beverages in its annual report to the joint standing committee of the Legislature having jurisdiction over environment and natural resources matters on the status of the program that is due February 15, 2026, and for each subsequent report. The bill also specifically requires the department, in the report that is due February 15, 2026, to evaluate and provide recommendations regarding the inclusion under the beverage container redemption program of clear glass containers that contain consumer products that are not beverages.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0308&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-04-01", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 479)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0308&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-03-26", "action": "Work Session Held", "result": null}, {"date": "2025-03-26", "action": "Voted", "result": "ONTP"}, {"date": "2025-03-31", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "reco