{"ld": 1687, "paper": "HP1122", "session": "132", "title": "An Act to Clarify and Increase Access to HIV Prevention Medications", "sponsor_id": "h-moonen-matthew", "cosponsor_ids": ["h-boyer-michelle", "h-cluchey-sally", "h-fecteau-ryan", "h-mastraccio-anne-marie", "h-mathieson-kristi"], "committee_code": "HCIFS", "committee_name": "Health Coverage, Insurance and Financial Services", "summary": {"text": "This bill clarifies, with respect to insurance coverage for HIV prevention medication, that each long-acting injectable drug with a different duration constitutes a separate method of administration. The bill clarifies that pharmacists are allowed to dispense HIV preventive oral medication under current law, allows pharmacists to dispense injectable medication of any duration in certain circumstances and requires insurance carriers to treat pharmacists dispensing HIV drugs in a manner equivalent to how the insurance carriers treat physicians and allow pharmacists to bill the carriers and receive payment directly. The bill also provides reimbursement under the MaineCare program to pharmacists for prescribing, dispensing and administering HIV prevention drugs.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1122&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-07-01", "governor_action": "Signed", "governor_action_date": "2025-07-01"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1687)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1122&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-642)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1122&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-642)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1122&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN168702.pdf"}], "committee_actions": [{"date": "2025-05-08", "action": "Work Session Held", "result": null}, {"date": "2025-05-08", "action": "Voted", "result": "OTP-AM"}, {"date": "2025-06-11", "action": "Reported Out", "result": "OTP-AM"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought to Pass as Amended", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-04-17", "chamber": "House", "action": "Committee on Health Coverage, Insurance and Financial Services suggested and ordered printed."}, {"date": "2025-04-17", "chamber": "House", "action": "The Bill was REFERRED to the Committee on HEALTH COVERAGE, INSURANCE AND FINANCIAL SERVICES."}, {"date": "2025-04-17", "chamber": "House", "action": "Sent for concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-04-17", "chamber": "Senate", "action": "The Bill was REFERRED to the Committee on HEALTH COVERAGE, INSURANCE AND FINANCIAL SERVICES  in concurrence"}, {"date": "2025-05-08", "chamber": "J", "action": "Work Session Held"}, {"date": "2025-05-08", "chamber": "J", "action": "Voted: OTP-AM"}, {"date": "2025-06-11", "chamber": "J", "action": "Reported Out: OTP-AM"}, {"date": "2025-06-11", "chamber": "House", "action": "CONSENT CALENDAR - FIRST DAY"}, {"date": "2025-06-11", "chamber": "House", "action": "Under suspension of the rules CONSENT CALENDAR - SECOND DAY."}, {"date": "2025-06-11", "chamber": "House", "action": "The Bill was PASSED TO BE ENGROSSED as Amended by Committee Amendment \"A\" (H-642)."}, {"date": "2025-06-11", "chamber": "House", "action": "Sent for concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-06-11", "chamber": "Senate", "action": "Report READ and ACCEPTED, in concurrence."}, {"date": "2025-06-11", "chamber": "Senate", "action": "READ ONCE."}, {"date": "2025-06-11", "chamber": "Senate", "action": "Committee Amendment \