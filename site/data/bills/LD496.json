{"ld": 496, "paper": "HP325", "session": "132", "title": "An Act Regarding the Issuance of Silver Alerts (TITLE CHANGE)", "sponsor_id": "h-milliken-nina", "cosponsor_ids": ["s-curry-glenn", "h-dodge-janice", "h-supica-laura"], "committee_code": "CJPS", "committee_name": "Criminal Justice and Public Safety", "summary": {"text": "This bill amends the provisions of law governing the Silver Alert Program to clarify that a person reported missing from a group home, mental hospital, psychiatric ward or other facility or division of a facility providing inpatient mental health services in the State is automatically considered a missing endangered person and a Silver Alert must be issued for that person.\n\nThe bill requires that Silver Alerts be issued immediately to all police departments statewide and to all hospitals, homeless shelters, soup kitchens and public libraries in the State within 24 hours. When a person who is the subject of a Silver Alert is not located, the alert must be reissued after 2 weeks and every 2 weeks thereafter.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0325&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2026-04-15", "governor_action": "Signed", "governor_action_date": "2026-04-15"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 496)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0325&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-331)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0325&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-331)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0325&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN049602.pdf"}], "committ