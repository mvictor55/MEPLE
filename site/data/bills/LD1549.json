{"ld": 1549, "paper": "SP633", "session": "132", "title": "RESOLUTION, Proposing an Amendment to the Constitution of Maine Regarding the Use and Oversight of Transportation-related Revenues", "sponsor_id": "s-farrin-bradlee", "cosponsor_ids": ["h-albert-roger", "h-mason-richard", "h-parry-wayne", "h-white-james"], "committee_code": "TRA", "committee_name": "Transportation", "summary": {"text": "This resolution proposes to amend the Constitution of Maine to provide that, beginning July 1, 2027, at least 60% of automobile-related sales and use tax revenue must be transferred to the Highway Fund and must be expended solely for costs of all modes of transportation, including public highways, bridges, aviation, transit, railroads, ferries, ports and other marine infrastructure, trails, pedestrian infrastructure and bicycle facilities and related appurtenances. The resolution also provides that, beginning July 1, 2027, the joint standing committee of the Legislature having jurisdiction over transportation matters has jurisdiction over all financial matters related to the Highway Fund.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0633&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2025-06-03", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 1549)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0633&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-181)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0633&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-181)", "description": null, "sponsor": null, "status": null, "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0633&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/