{"ld": 38, "paper": "SP61", "session": "132", "title": "An Act Requiring Photographic Identification for Voting", "sponsor_id": "s-timberlake-jeffrey", "cosponsor_ids": ["s-farrin-bradlee", "s-libby-james", "h-lyman-sheila", "s-stewart-harold"], "committee_code": "VLA", "committee_name": "Veterans and Legal Affairs", "summary": {"text": "This bill requires the presentation of proof of identity in the form of a photograph identification document when voting in person. Acceptable forms of photograph identification are a current and valid driver's license or nondriver identification card issued in this State, a United States passport, a military identification or a permit to carry a concealed handgun issued in this State if that permit includes a photograph. An identification issued by a college or university may not be accepted for voter identification. The bill also allows a person who does not possess a photograph identification document to request a free special voter photograph identification card from the Secretary of State.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0061&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2025-06-05", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 38)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0061&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-267)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0061&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-267)", "description": null, "sponsor": null, "status": null, "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0061&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN003802.pdf"}], "committ