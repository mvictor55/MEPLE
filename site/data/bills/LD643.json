{"ld": 643, "paper": "HP411", "session": "132", "title": "Resolve, to Study the Effects of Artificial Intelligence, Cellular Telephones and Social Media on Public Education", "sponsor_id": "h-brennan-michael", "cosponsor_ids": ["h-cloutier-kristen", "h-dodge-janice", "h-gramlich-lori", "h-lookner-grayson", "h-murphy-kelly", "s-pierce-teresa", "s-rafferty-joseph", "h-salisbury-suzanne", "h-sargent-holly"], "committee_code": "EDU", "committee_name": "Education and Cultural Affairs", "summary": {"text": "This resolve directs the Department of Education to establish a working group to study and make recommendations regarding the use of artificial intelligence, cellular telephones and social media within public school settings. The Commissioner of Education is directed to select members of the working group and include relevant stakeholders. The working group is required, no later than December 3, 2025, to submit a report that includes its findings and recommendations, including suggested legislation, for presentation to the Joint Standing Committee on Education and Cultural Affairs. The joint standing committee is authorized to report out a bill related to the report to the Second Regular Session of the 132nd Legislature.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0411&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-13", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "fiscal_note_url": null, "documents": [{"label": "Bill text (LD 643)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0411&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-02", "action": "Work Session Held", "result": null}, {"date": "2025-05-02", "action": "Voted", "result": "ONTP"}, {"date": 