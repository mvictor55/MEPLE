{"ld": 1117, "paper": "HP736", "session": "132", "title": "An Act to Strengthen Maine's Workforce Through Certified Preapprenticeship Training Programs", "sponsor_id": "h-webb-kilton", "cosponsor_ids": [], "committee_code": "LAB", "committee_name": "Labor", "summary": {"text": "This bill provides that preapprenticeship training programs may use grants from the Maine Apprenticeship Program for membership fees and costs, tools and personal protective equipment; for assistance to address obstacles to and to identify and access services necessary for an individual's successful participation in a preapprenticeship program; and for facilitating an individual's readiness to commence on-the-job learning in a registered apprenticeship program. At least 51% of total grant funding must support preapprenticeship training programs that have demonstrated successful engagement and enrollment of and completion by individuals from historically marginalized communities in registered apprenticeship programs; that have consistently placed individuals in registered apprenticeship programs that lead to jobs that pay a total package value of no less than $35 per hour, indexed for inflation; and that have demonstrated the provision of strong, comprehensive support services essential to ensure success.\n\nThe bill provides that certified preapprenticeship training programs that cannot prove that graduates are employed in the field of their preapprenticeship or are represented by a labor organization are ineligible for grants. It provides that any funds provided to support preapprenticeship training programs must be administered and awarded to programs with strong direct entry links with registered apprenticeship programs through a competitive process administered by the Department of Labor through the Maine Apprenticeship Program. These funds must be directed to preapprenticeship training programs that train individuals for priority sectors for high-wage, in-demand jobs and may be used for program development, support and staffing for grantees.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0736&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-13", "governor_action": "Signed", "governor_action_date": "2025-06-13"}, "fiscal_status": "Not Yet Determined", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN111702.pdf", "documents": [{"label": "Bill text (LD 1117)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0736&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-388)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0736&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-388)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0736&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN111702.pdf"}], "committee_actions": [{"date": "2025-04-16", "action": "Work Session Held", "result": "TABLED"}, {"date": "2025-04-22", "action": "Work Session Held", "result": "TABLED"}, {"date": "2025-05-06", "action": "Work Session Held", "result": null}, {"date": "2025-05-06", "action": "Voted", "result": "Divided Report"}, {"date": "2025-05-30", "action": "Reported Out", "result": "OTP-AM/ONTP"}], "committee_reports": [{"label": "Majority report", "recommendation": "Ought To Pass As Amended", "signer_count": 7, "signers": ["Senator Michael Tipping (Chair)", "Representative Marshall Archer", "Representative Matthew Beck", "Representative Valli Geiger", "Representative Rafael Macias", "Senator Joseph Rafferty", "Representative Amy Roeder"], "signer_ids": ["s-tipping-michael", "h-archer-marshall", "h-beck-matthew", "h-geiger-valli", "h-macias-rafael", "s-rafferty-joseph", "h-roeder-amy"]}, {"label": 