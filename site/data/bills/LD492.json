{"ld": 492, "paper": "HP321", "session": "132", "title": "RESOLUTION, Proposing an Amendment to the Constitution of Maine to Provide for Parental Rights", "sponsor_id": "h-poirier-jennifer", "cosponsor_ids": ["h-ducharme-john", "h-gifford-irene", "h-griffin-abigail", "s-haggan-david", "h-haggan-kimberly", "h-lyman-sheila", "h-quint-tracy", "h-thorne-james", "h-wadsworth-nathan"], "committee_code": "JUD", "committee_name": "Judiciary", "summary": {"text": "This resolution proposes to amend the Constitution of Maine to provide that the natural, inherent and unalienable rights of minor children are held by their parents or guardians until the age of majority or a grant of emancipation and that this State, its political subdivisions and all governmental entities may not infringe on the authority of parents to direct the upbringing, education and care for the physical, mental and spiritual health of their children, absent abuse or neglect by the parent or guardian or criminal acts by the minor.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0321&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2025-05-20", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 492)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0321&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-146)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0321&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-146)", "description": "Change Title", "sponsor": null, "status": null, "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0321&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN049202.pdf"}], "committee_actions": [{"date": "2025