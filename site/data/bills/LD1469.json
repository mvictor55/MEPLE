{"ld": 1469, "paper": "HP961", "session": "132", "title": "An Act to Clarify the Quality Rating System for Child Care Services in Maine", "sponsor_id": "h-collamore-amanda", "cosponsor_ids": ["s-bennett-richard", "h-crockett-edward", "h-dill-james", "h-fecteau-ryan", "s-haggan-david", "h-haggan-kimberly"], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "Current law requires the Department of Health and Human Services to establish a child care quality rating system as part of the department's quality differential rate payments. This bill specifies that child care providers accredited by the National Association for the Education of Young Children, the National Association for Family Child Care or the Council on Accreditation or a Head Start program that meets national Head Start standards must receive the highest rating under the child care quality rating system.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0961&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-10", "governor_action": "Signed", "governor_action_date": "2025-06-10"}, "fiscal_status": "Fiscal Impact", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN146901.pdf", "documents": [{"label": "Bill text (LD 1469)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0961&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-372)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0961&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-372)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0961&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN146902.pdf"}], "committee_actions": [{"date": "2025-05-