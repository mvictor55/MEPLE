{"ld": 708, "paper": "HP447", "session": "132", "title": "An Act to Allow for Rescission of a Site Location of Development Permit When a Development Is Decommissioned", "sponsor_id": "h-bridgeo-william", "cosponsor_ids": [], "committee_code": "ENR", "committee_name": "Environment and Natural Resources", "summary": {"text": "Under current law, if a permittee requests the Commissioner of Environmental Protection to rescind a site location of development permit for a development that is not a subdivision, the commissioner must rescind the permit if, among other things, the development has not been constructed or operated by the permittee. This bill requires the commissioner to rescind such a permit if the development has been fully decommissioned to the department's satisfaction. The bill also defines \"fully decommissioned.\"", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0447&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-04-25", "governor_action": "Signed", "governor_action_date": "2025-04-25"}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 708)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0447&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-03-19", "action": "Work Session Held", "result": null}, {"date": "2025-03-19", "action": "Voted", "result": "Divided Report"}, {"date": "2025-04-03", "action": "Reported Out", "result": "OTP/ONTP"}], "committee_reports": [{"label": "Majority report", "recommendation": "Ought To Pass", "signer_count": 11, "signers": ["Representative Victoria Doudera (Chair)", "Senator Denise Tepler (Chair)", "Representative Dan Ankeles", "Representative Art Bell", "Senator Stacy Brenner", "Representative William Bridgeo", "Senator Joseph Martin", "Representative Laurie Osher", "Representative Morgan Rielly", "Representative Mike Soboleski", "Representative David Woodsome"], "signer_ids": ["h-doudera-victoria", "s-tepler-denise", "h-ankeles-daniel", "h-bell-arthur", "s-brenner-stacy", "h-bridgeo-william", "s-martin-joseph", "h-osher-laurie", "h-rielly-morgan", "h-soboleski-michael", "h-woodsome-david"]}, {"label": "Minority report", "recommendation": "Ought Not To Pass", "signer_count": 2, "signers": ["Representative Dick Campbell", "Representative Tammy Schmersal-Burgess"], "signer_ids": ["h-campbell-richard", "h-schmersal-burgess-tammy"]}], "chamber_actions": [{"date": "2025-02-20", "chamber": "House", "action": "Received by the Clerk of the House on February 20, 2025."}, {"date": "2025-02-20", "chamber": "House", "action": "The Bill was REFERRED to the Committee on ENVIRONMENT AND NATURAL RESOURCES pursuant to Joint Rule 308.2 and ordered printed pursuant to Joint Rule 401."}, {"date": "2025-03-19", "chamber": "J", "action": "Work Session Held"}, {"date": "2025-03-19", "chamber": "J", "action": "Voted: Divided Report"}, {"date": "2025-03-21", "chamber": "House", "action": "Carried over, in the same posture, to the next special or regular session of the 132nd Legislature, pursuant to Joint Order SP 519."}, {"date": "2025-04-03", "chamber": "J", "action": "Reported Out: OTP/ONTP"}, {"date": "2025-04-08", "chamber": "House", "action": "Reports READ."}, {"date": "2025-04-08", "chamber": "House", "action": "On motion of Representative DOUDERA of Camden, the Majority Ought to Pass Report was ACCEPTED."}, {"date": "2025-04-08", "chamber": "House", "action": "The Bill was READ ONCE."}, {"date": "2025-04-08", "chamber": "House", "action": "Under suspension of the rules, the Bill was given its SECOND READING without REFERENCE to the Committee on Bills in the Second Reading."}, {"date": "2025-04-08", "chamber": "House", "action": "The Bill was PASSED TO BE ENGROSSED."}, {"date": "2025-04-08", "chamber": "House", "action": "Sent for concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-04-10", "ch