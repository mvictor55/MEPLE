{"ld": 222, "paper": "HP145", "session": "132", "title": "An Act to Establish a Take-back and Disposal Program for Firefighting and Fire-suppressing Foam to Which Perfluoroalkyl and Polyfluoroalkyl Substances Have Been Added", "sponsor_id": "h-ankeles-daniel", "cosponsor_ids": ["h-arford-poppy", "h-campbell-richard", "s-larsen-daughtry-matthea", "h-doudera-victoria", "h-golek-cheryl", "h-gramlich-lori", "h-soboleski-michael", "h-stover-holly", "s-tepler-denise"], "committee_code": "ENR", "committee_name": "Environment and Natural Resources", "summary": {"text": "This bill requires the Department of Environmental Protection, in consultation with the Department of Public Safety, Office of the State Fire Marshal, to design and, by July 1, 2027, implement a take-back and disposal program for firefighting and fire-suppressing foam to which perfluoroalkyl and polyfluoroalkyl substances have been intentionally added that is located in the State and that is in the possession of a person located in the State. The program must provide for the collection of such firefighting or fire-suppressing foam from a person that voluntarily requests collection and for the safe and contained disposal of the collected foam. The department may contract with a 3rd-party entity to implement and administer the program and may adopt rules as necessary for the implementation and administration of the program.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0145&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2026-01-11", "governor_action": "Unsigned", "governor_action_date": "2026-01-11"}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 222)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0145&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-160)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0145&item=2&snum=132", "item": 2}, {"label": "Amendment S-A to C-A (S-451)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0145&item=8&snum=132", "item": 8}], "amendments": [{"id": "C-A (H-160)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0145&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN022202.pdf"}, {"id": "S-A to C-A (S-451)", "description": null, "sponsor": "Senator Rotundo", "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0145&item=8&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN022208.pdf"}], "committee_actions": [{"date": "2025-03-05", "action": "Work Session Held", "result": null}, {"date": "2025-03-05", "action": "Voted", "result": "OTP-AM"}, {"date": "2025-05-15", "action": "Reported Out", "result": "OTP-AM"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought to Pass as Amended", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-01-16", "chamber": "House", "action": "Received by the Clerk of the House on January 16, 2025."}, {"date": "2025-01-16", "chamber": "House", "action": "The Bill was REFERRED to the Committee on ENVIRONMENT AND NATURAL RESOURCES pursuant to Joint Rule 308.2 and ordered printed pursuant to Joint Rule 401."}, {"date": "2025-03-05", "chamber": "J", "action": "Work Session Held"}, {"date": "2025-03-05", "chamber": "J", "action": "Voted: OTP-AM"}, {"date": "2025-03-21", "chamber": "House", "action": "Carried over, in the same posture, to the next special or regular session of the 132nd Legislature, pursuant to Joint Order SP 519."}, {"date": "2025-05-15", "chamber": "J", "action": "Reported Out: OTP-AM"}, {"date": "2025-05-20", "chamber": "House", "action": "CONSENT CALENDAR -