{"ld": 1215, "paper": "SP504", "session": "132", "title": "An Act Regarding Residency Restrictions for Sex Offenders", "sponsor_id": "s-moore-marianne", "cosponsor_ids": [], "committee_code": "CJPS", "committee_name": "Criminal Justice and Public Safety", "summary": {"text": "This bill amends the Sex Offender Registration and Notification Act of 1999 and the Sex Offender Registration and Notification Act of 2013 by requiring that offenders under the Acts comply with municipal residency restriction ordinances adopted pursuant to the Maine Revised Statutes, Title 30-A, section 3014, subsection 2. The bill also directs the Sex Offender Management and Risk Assessment Advisory Commission to conduct a study and develop recommendations regarding a statewide residency restriction for sex offenders. The commission is directed to submit a report containing its findings and proposed legislation to the Joint Standing Committee on Criminal Justice and Public Safety no later than December 3, 2025. The committee may report out legislation relating to the report to the Second Regular Session of the 132nd Legislature.\n\nDRAFT DRAFT DRAFT Page 1 - DRAFT DRAFT DRAFT", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0504&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-13", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 1215)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0504&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-16", "action": "Work Session Held", "result": "TABLED"}, {"date": "2025-05-07", "action": "Work Session Held", "result": null}, {"date": "2025-05-07", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-12", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-03-20", "chamber": "Senate", "action": "Committee on CRIMINAL JUSTICE AND PUBLIC SAFETY suggested and ordered printed REFERENCE to the Committee on CRIMINAL JUSTICE AND PUBLIC SAFETY Ordered sent down forthwith for concurrence"}, {"date": "2025-03-20", "chamber": "House", "action": "The Bill was REFERRED to the Committee on CRIMINAL JUSTICE AND PUBLIC SAFETY."}, {"date": "2025-03-20", "chamber": "House", "action": "In concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-03-21", "chamber": "Senate", "action": "CARRIED OVER, in the same posture, to the next special or regular session of the 132nd Legislature, pursuant to Joint Order SP 519."}, {"date": "2025-04-16", "chamber": "J", "action": "Work Session Held: TABLED"}, {"date": "2025-05-07", "chamber": "J", "action": "Work Session Held"}, {"date": "2025-05-07", "chamber": "J", "action": "Voted: ONTP"}, {"date": "2025-05-12", "chamber": "J", "action": "Reported Out: ONTP"}, {"date": "2025-05-13", "chamber": "Senate", "action": "Pursuant to Joint Rule 310.3 Placed in Legislative Files (DEAD)"}], "roll_calls": [], "hearing": {"date": "2025-04-07", "time": "1:00 PM", "location": "State House, Room 436", "committee_code": "CJPS", "testimony_count": 10}, "heard_with": [], "tags": ["Crimes", "Sex Offenses"], "affected_statutes": [], "testimony": [{"id": "10042558", "name": "Jason Moen", "organization": "Maine Chiefs of Police Association", "town": null, "position": "support", "position_source": "inferred", "date": "2025-04-07", "hearing_date": "2025-04-07", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=10042558", "has_text": true, "shared_with": [], "person_profile_id": null, "org_profile_id": "org-maine-chiefs-of-police-association"}, {"id": "10040876", "name": "Jay Criswell", "o