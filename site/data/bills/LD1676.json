{"ld": 1676, "paper": "HP1111", "session": "132", "title": "Resolve, to Study Ways to Improve Recruitment and Retention of Rural Emergency Medical Services Personnel Through Access to Health Insurance", "sponsor_id": "h-eaton-holly", "cosponsor_ids": ["h-bishop-steven", "h-crockett-edward", "h-golek-cheryl", "h-graham-anne", "s-grohoski-nicole", "h-ray-d", "s-talbot-ross-rachel", "s-tepler-denise", "h-webb-kilton"], "committee_code": "CJPS", "committee_name": "Criminal Justice and Public Safety", "summary": {"text": "This resolve requires the Commissioner of Public Safety to convene a commission to study ways to improve recruitment and retention of rural emergency medical services personnel through access to health insurance. By December 3, 2025, the commissioner must submit a report related to the study to the Joint Standing Committee on Criminal Justice and Public Safety and the joint standing committee may report out a bill related to the report to the Second Regular Session of the 132nd Legislature.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1111&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2025-06-10", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN167602.pdf", "documents": [{"label": "Bill text (LD 1676)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1111&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-598)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1111&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-598)", "description": "Change Title", "sponsor": null, "status": null, "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1111&item=2&snum=132", "fiscal_note_url":