{"ld": 2059, "paper": "SP852", "session": "132", "title": "An Act to Provide Required Funding for the Reimbursement of Assigned Counsel (EMERGENCY) (TITLE CHANGE)", "sponsor_id": "s-carney-anne", "cosponsor_ids": ["s-bennett-richard", "s-duson-jill", "h-moonen-matthew", "h-sinclair-david"], "committee_code": "JUD", "committee_name": "Judiciary", "summary": {"text": "This bill provides one-time funding to the Maine Commission on Public Defense Services to address the shortfall in funding available to compensate constitutionally and statutorily required assigned counsel in fiscal years 2025-26 and 2026-27. It also funds the establishment of a public defender office beginning April 1, 2026, designed to serve 30% of the criminal defendants entitled to indigent legal services in Cumberland County.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0852&item=1&snum=132"}, "status": "enacted", "status_label": "Emergency Enacted", "final_disposition": {"label": "Emergency Enacted", "date": "2026-03-19", "governor_action": "Emergency Signed", "governor_action_date": "2026-03-19"}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 2059)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0852&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-506)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0852&item=2&snum=132", "item": 2}, {"label": "Amendment C-B (S-507)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0852&item=3&snum=132", "item": 3}, {"label": "Amendment H-A to C-A (H-824)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0852&item=5&snum=132", "item": 5}], "amendments": [{"id": "C-A (S-506)", "description": "Emergency", "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0852&item=2&snum=132", "fiscal_note_url": "https://legislat