{"ld": 1328, "paper": "HP863", "session": "132", "title": "An Act to Create Culturally Appropriate and Trauma-informed Housing and Recovery Services (TITLE CHANGE)", "sponsor_id": "h-osher-laurie", "cosponsor_ids": ["s-beebe-center-anne", "h-golek-cheryl", "s-hickman-craig", "h-milliken-nina", "h-moonen-matthew", "h-rana-ambureen", "h-sato-eleanor", "h-supica-laura", "s-tipping-michael"], "committee_code": "HED", "committee_name": "Housing and Economic Development", "summary": {"text": "This bill requires the Maine State Housing Authority to contract for the operation of at least 3 certified recovery residences that are led and governed by people in recovery from substance use disorder that identify as LGBTQIA+ and provide services to LGBTQIA+ individuals recovering from substance use disorder and other individuals recovering from substance use disorder, regardless of sexual orientation or gender identity, that meet the criteria established by the Maine State Housing Authority. The bill establishes requirements based on population for the location of the contracted certified recovery residences and staffing requirements and establishes the LGBTQIA+ Recovery Residence Fund within the Maine State Housing Authority.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0863&item=1&snum=132"}, "status": "vetoed", "status_label": "Veto Sustained", "final_disposition": {"label": "Veto Sustained", "date": "2025-06-25", "governor_action": "Veto", "governor_action_date": "2025-06-23"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1328)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0863&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-626)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0863&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-626)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url"