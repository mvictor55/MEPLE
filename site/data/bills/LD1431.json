{"ld": 1431, "paper": "HP940", "session": "132", "title": "An Act to Implement an Interstate Voter Registration Cross-check Program", "sponsor_id": "h-bagshaw-barbara", "cosponsor_ids": ["h-boyer-david", "h-cimino-marygrace", "h-haggan-kimberly", "h-hepler-allison", "h-lance-michael", "s-libby-james", "s-martin-joseph", "h-smith-katrina", "s-stewart-harold"], "committee_code": "VLA", "committee_name": "Veterans and Legal Affairs", "summary": {"text": "This bill authorizes the Secretary of State to collaborate and cross-check voter registration data with other states to identify voters who may have moved out of the State and registered in another state. The bill also authorizes the Secretary of State to contract with a private sector data system provider to support a program for maintenance of voter registration. The bill also ensures that the personally identifying data and other information of the voters of the State are protected when exchanging data with other states and with a private sector data provider.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0940&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2025-06-03", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 1431)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0940&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-386)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0940&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-386)", "description": "Change Title", "sponsor": null, "status": null, "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0940&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN143102.pdf"}], "committee_act