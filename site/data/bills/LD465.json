{"ld": 465, "paper": "SP200", "session": "132", "title": "An Act to Update Waste Discharge License Fees", "sponsor_id": "s-grohoski-nicole", "cosponsor_ids": [], "committee_code": "ENR", "committee_name": "Environment and Natural Resources", "summary": {"text": "This bill adds marine finfish aquaculture facilities and general permit coverage for municipal separate storm sewer systems as waste discharge license groups and establishes the basis for the annual fees for those license groups. It changes the basis for the annual fee for the general permit coverage for the marine aquaculture facilities waste discharge license group and increases the median fee for that license group. It also clarifies that the fish-rearing facility waste discharge license group covers terrestrial fish-rearing facilities.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0200&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-05-09", "governor_action": "Signed", "governor_action_date": "2025-05-09"}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 465)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0200&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-24)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0200&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-24)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0200&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN046502.pdf"}], "committee_actions": [{"date": "2025-03-05", "action": "Work Session Held", "result": null}, {"date": "2025-03-05", "action": "Voted", "result": "OTP-AM"}, {"date": "2025-04-23", "action": "Reported Out", "result": "OTP-AM"}], "committee_reports": [{"lab