{"ld": 258, "paper": "SP125", "session": "132", "title": "Resolve, to Establish a Program to Recruit and Retain Behavioral Health Clinicians", "sponsor_id": "s-stewart-harold", "cosponsor_ids": ["s-bennett-richard", "s-martin-joseph", "h-morris-joshua", "s-timberlake-jeffrey"], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This resolve directs the Department of Health and Human Services to develop and implement a program to provide a $25,000 recruitment and retention incentive to behavioral health clinicians in the State during fiscal year 2025-26. It directs the department to establish criteria regarding participation in the program and to submit a report regarding the program to the Joint Standing Committee on Health and Human Services in 2025.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0125&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-03-27", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 258)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0125&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-03-19", "action": "Work Session Held", "result": null}, {"date": "2025-03-19", "action": "Voted", "result": "ONTP"}, {"date": "2025-03-25", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-01-28", "chamber": "Senate", "action": "Received by the Secretary of the Senate on January 23, 2025 and REFERRED to the Committee on HEALTH AND HUMAN SERVICES pursuant to Joint Rule 308.2"}, {"date": "2025-03-19", "cha