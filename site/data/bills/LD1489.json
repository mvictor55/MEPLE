{"ld": 1489, "paper": "SP604", "session": "132", "title": "Resolve, to Provide Stability to Long-term Care Facility Funding (EMERGENCY)", "sponsor_id": "s-grohoski-nicole", "cosponsor_ids": ["s-bennett-richard", "h-collamore-amanda", "h-eaton-holly", "h-friedmann-gary", "h-milliken-nina", "s-moore-marianne", "s-stewart-harold", "h-strout-tiffany", "s-tipping-michael"], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This bill requires the Department of Health and Human Services to provide a cost-of- living adjustment for residential care facilities and apply that adjustment retroactively to January 1, 2025. The bill also requires the department to conduct a rate study and determine rates for residential care facility services no later than January 1, 2026.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0604&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-04-30", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "fiscal_note_url": null, "documents": [{"label": "Bill text (LD 1489)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0604&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-25", "action": "Work Session Held", "result": null}, {"date": "2025-04-25", "action": "Voted", "result": "ONTP"}, {"date": "2025-04-28", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-04-08", "chamber": "Senate", "action": "Committee on HEALTH AND HUMAN SERVICES suggested and ordered printed REFERENCE to the Committee on HEALTH AND HUMAN SERVICES Ordered sent down f