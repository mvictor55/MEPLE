{"ld": 1954, "paper": "SP762", "session": "132", "title": "An Act to Update the Sales Tax Fairness Credit (TITLE CHANGE)", "sponsor_id": "s-larsen-daughtry-matthea", "cosponsor_ids": ["s-curry-glenn", "h-debrito-flavia", "h-faulkingham-william", "h-henderson-rachel", "h-hymes-benjamin", "h-lee-adam", "s-martin-joseph", "s-nangle-timothy", "h-skold-charles"], "committee_code": "TAX", "committee_name": "Taxation", "summary": {"text": "This bill exempts from the sales tax, when sold in a grocery store, items for nourishment or products for internal human consumption such as prepared foods, including sandwiches and salads; supplemental meal items, such as pretzels, cheese sticks and dips; fruit bars and granola bars; nuts and seeds; and meat sticks. Liquor, water, medicine, dietary substitutes, candy, dessert and bakery items and cannabis remain subject to tax, regardless of where sold.\n\n\"Grocery store\" is defined to be a store primarily engaged in the retail sale of canned food, dry goods, fresh fruits and vegetables, fresh meats, fish and poultry and includes a convenience store, but does not include a separately owned eating establishment located within a grocery store.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0762&item=1&snum=132"}, "status": "died", "status_label": "Died On Adjournment", "final_disposition": {"label": "Died On Adjournment", "date": "2026-04-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1954)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0762&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-615)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0762&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-615)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bill