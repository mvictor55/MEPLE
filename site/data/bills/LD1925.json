{"ld": 1925, "paper": "HP1286", "session": "132", "title": "An Act to Improve Access to Grant Funding for the Maine Farms for the Future Program", "sponsor_id": "h-osher-laurie", "cosponsor_ids": ["s-brenner-stacy", "h-flynn-paul", "h-friedmann-gary", "h-hall-randall", "h-pluecker-william", "h-rana-ambureen", "s-talbot-ross-rachel", "h-white-james"], "committee_code": "ACF", "committee_name": "Agriculture, Conservation and Forestry", "summary": {"text": "This bill amends eligibility criteria for the Maine Farms for the Future Program to ensure that farmers who lease rather than own land and those who farm on land that is already protected by an agricultural conservation agreement are able to receive grants in the program. The bill also allows the Department of Agriculture, Conservation and Forestry to grant exceptions to eligibility criteria to allow for more flexibility for business plan development and investment support for farms. Lastly, the bill increases the maximum allowable amounts for grants and agricultural marketing loans awarded through the program.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1286&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-10", "governor_action": "Signed", "governor_action_date": "2025-06-10"}, "fiscal_status": "Not Yet Determined", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN192502.pdf", "documents": [{"label": "Bill text (LD 1925)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1286&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-349)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1286&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-349)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1286&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN192502.pdf"}], "committee_actions": [{"date": "2025-05-15", "action": "Work Session Held", "result": null}, {"date": "2025-05-15", "action": "Voted", "result": "OTP-AM"}, {"date": "2025-05-29", "action": "Reported Out", "result": "OTP-AM"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought to Pass as Amended", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-05-06", "chamber": "House", "action": "Committee on Agriculture, Conservation and Forestry suggested and ordered printed."}, {"date": "2025-05-06", "chamber": "House", "action": "The Bill was REFERRED to the Committee on AGRICULTURE, CONSERVATION AND FORESTRY."}, {"date": "2025-05-06", "chamber": "House", "action": "Sent for concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-05-06", "chamber": "Senate", "action": "The Bill was REFERRED to the Committee on AGRICULTURE, CONSERVATION AND FORESTRY  in concurrence"}, {"date": "2025-06-02", "chamber": "House", "action": "CONSENT CALENDAR - FIRST DAY"}, {"date": "2025-06-02", "chamber": "House", "action": "Under suspension of the rules CONSENT CALENDAR - SECOND DAY."}, {"date": "2025-06-02", "chamber": "House", "action": "The Bill was PASSED TO BE ENGROSSED as Amended by Committee Amendment \"A\" (H-349)."}, {"date": "2025-06-02", "chamber": "House", "action": "Sent for concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-06-02", "chamber": "Senate", "action": "Report READ and ACCEPTED, in concurrence."}, {"date": "2025-06-02", "chamber": "Senate", "action": "READ ONCE."}, {"date": "2025-06-02", "chamber": "Senate", "action": "Committee Amendment \"A\" (H-349) READ and ADOPTED, in concurrence."}, {"date": "2025-06-02", "chamber": "Senate", "action": "Under suspension of the Rules, READ A SECOND TIME and PASSED TO BE ENGROSSED AS AMENDED BY Committee Amendment \"A\" (H-349), in concurrenc