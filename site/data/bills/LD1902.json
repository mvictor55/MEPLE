{"ld": 1902, "paper": "SP742", "session": "132", "title": "An Act to Support Nonprofit Organizations by Authorizing the Operation of Electronic Lucky Seven Devices and Similar Sealed Ticket Games", "sponsor_id": "s-hickman-craig", "cosponsor_ids": ["h-chapman-quentin", "s-larsen-daughtry-matthea", "h-faulkingham-william", "h-supica-laura"], "committee_code": "VLA", "committee_name": "Veterans and Legal Affairs", "summary": {"text": "This bill authorizes the Department of Public Safety, Gambling Control Unit to issue licenses to operate electronic lucky seven devices to eligible organizations. The bill provides restrictions on the number, location and operation of electronic lucky seven devices and requires licensees to operate at least one kiosk for the redemption of electronic lucky seven vouchers. It also requires distributors of electronic lucky seven devices to be licensed. The bill also makes other necessary changes to the charitable gaming laws.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0742&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2026-04-08", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN190202.pdf", "documents": [{"label": "Bill text (LD 1902)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0742&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-614)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0742&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-614)", "description": "Change Title", "sponsor": null, "status": null, "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0742&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132