{"ld": 1296, "paper": "SP526", "session": "132", "title": "An Act to Amend the Law Governing Watercraft Franchisor Warranty Reimbursements (EMERGENCY)", "sponsor_id": "s-reny-cameron", "cosponsor_ids": ["s-curry-glenn", "h-hepler-allison", "s-ingwersen-henry", "s-moore-marianne", "h-parry-wayne", "h-strout-tiffany", "s-timberlake-jeffrey", "s-tipping-michael", "h-wood-peter"], "committee_code": "HED", "committee_name": "Housing and Economic Development", "summary": {"text": "This bill amends the law governing watercraft franchisor warranty reimbursements by requiring the franchisor to compensate the franchisee for parts used by the franchisee to conduct a specific warranty repair and, for a part provided by the franchiser, the difference between the cost of a part and the retail price of a part, which may not exceed 100% of the reimbursement cost of the labor to perform the repair. The bill also requires that labor billed by a franchisee to perform a warranty repair be reasonable and supported by the franchisee's records.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0526&item=1&snum=132"}, "status": "enacted", "status_label": "Emergency Enacted", "final_disposition": {"label": "Emergency Enacted", "date": "2025-06-12", "governor_action": "Emergency Signed", "governor_action_date": "2025-06-12"}, "fiscal_status": "Not Yet Determined", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN129602.pdf", "documents": [{"label": "Bill text (LD 1296)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0526&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-245)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0526&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-245)", "description": "Emergency", "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0526&