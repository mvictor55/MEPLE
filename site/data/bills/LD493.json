{"ld": 493, "paper": "HP322", "session": "132", "title": "An Act to Expand Testing for Perfluoroalkyl and Polyfluoroalkyl Substances to Private Drinking Water Wells", "sponsor_id": "h-osher-laurie", "cosponsor_ids": ["s-bennett-richard", "h-dhalac-deqa", "h-doudera-victoria", "h-gramlich-lori", "s-ingwersen-henry", "h-rana-ambureen", "s-tepler-denise", "h-zager-samuel"], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This bill requires testing of well water for perfluoroalkyl and polyfluoroalkyl substances by a landlord of a residential building supplied by a private drinking water well. Under the bill, for residential property that uses a private water supply, the seller of that property is required to disclose a water test that indicates the presence of perfluoroalkyl and polyfluoroalkyl substances. The bill also adds perfluoroalkyl and polyfluoroalkyl substances to the list of contaminants in the Department of Health and Human Services uniform testing recommendations for private drinking water wells.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0322&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2026-04-16", "governor_action": "Signed", "governor_action_date": "2026-04-16"}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 493)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0322&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-300)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0322&item=2&snum=132", "item": 2}, {"label": "Amendment S-A to C-A (S-669)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0322&item=4&snum=132", "item": 4}, {"label": "Amendment H-A to C-A (H-1052)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0322&item=6&snum=132", "item": 6}], "amendments