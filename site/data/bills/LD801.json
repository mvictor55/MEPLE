{"ld": 801, "paper": "HP508", "session": "132", "title": "An Act to Prevent Consumer-generated Electricity from Being Used by Anyone Other than That Consumer", "sponsor_id": "h-cimino-marygrace", "cosponsor_ids": [], "committee_code": "EUT", "committee_name": "Energy, Utilities and Technology", "summary": {"text": "This bill replaces the provision of law that allows the Public Utilities Commission to adopt rules providing that unused kilowatt-hour credits accumulated by a residential customer participating in a net energy billing arrangement may expire with a provision that prohibits the expiration of unused kilowatt-hour credits. The bill also prohibits a transmission and distribution utility from charging a customer a fee related to unused kilowatt-hour credits.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0508&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-04-08", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 801)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0508&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-03-26", "action": "Work Session Held", "result": null}, {"date": "2025-03-26", "action": "Voted", "result": "ONTP"}, {"date": "2025-04-03", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-02-27", "chamber": "House", "action": "Received by the Clerk of the House on February 27, 2025."}, {"date": "2025-02-27", "chamber": "House", "action": "The Bill was REFERRED to the Committee on ENERGY, UTILITIES AND TECHNOLOGY pursuant to Joint Rule