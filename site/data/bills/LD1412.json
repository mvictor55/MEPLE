{"ld": 1412, "paper": "HP934", "session": "132", "title": "An Act to Increase Contingency Reserves for Maine's Consumer-owned Electric Transmission and Distribution Utilities", "sponsor_id": "h-ducharme-john", "cosponsor_ids": ["h-albert-roger", "s-bernard-susan", "h-foster-steven", "s-rafferty-joseph", "h-sayre-daniel", "s-stewart-harold", "h-swallow-gregory"], "committee_code": "EUT", "committee_name": "Energy, Utilities and Technology", "summary": {"text": "Under current law, a consumer-owned transmission and distribution utility may keep a contingency reserve fund for capital purposes to reflect up to a 25% addition to yearly revenues over the amount required to operate the utility, not including any purchased power supply costs.\n\nThis bill increases the amount that a consumer-owned transmission and distribution utility may keep in a contingency reserve fund to reflect up to a 50% addition to yearly revenues over the amount required to operate the utility. The bill removes the language that excludes any purchased power supply costs from this formula.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0934&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-09", "governor_action": "Signed", "governor_action_date": "2025-06-09"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1412)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0934&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-286)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0934&item=2&snum=132", "item": 2}, {"label": "Amendment C-B (H-287)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0934&item=3&snum=132", "item": 3}], "amendments": [{"id": "C-A (H-286)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov