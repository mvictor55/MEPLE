{"ld": 1178, "paper": "HP783", "session": "132", "title": "An Act to Expedite the Process Involving Municipalities That Illegally Move a Person to Avoid Responsibility for General Assistance Support", "sponsor_id": "h-salisbury-suzanne", "cosponsor_ids": ["h-cloutier-kristen", "h-moonen-matthew", "h-roeder-amy"], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This bill decreases from 30 to 15 working days the period for the Department of Health and Human Services to determine if a municipality has illegally moved an individual to avoid responsibility for general assistance support. The bill reduces the appeals period from 30 to 15 days after the determination is made. The bill also provides for interest on unreimbursed amounts to be paid by the offending municipality and a penalty of up to $10,000 for a repeat violation within a 12-month period and creates the rebuttable presumption that if a municipality moves a person to another municipality, the municipality did so to avoid paying general assistance to that person.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0783&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-04-30", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 1178)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0783&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-24", "action": "Work Session Held", "result": null}, {"date": "2025-04-24", "action": "Voted", "result": "ONTP"}, {"date": "2025-04-28", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [],