{"ld": 859, "paper": "HP545", "session": "132", "title": "Resolve, Directing the Treasurer of State to Review and Develop Options for Meeting the Banking Needs of the Cannabis Industry", "sponsor_id": "h-cluchey-sally", "cosponsor_ids": [], "committee_code": "VLA", "committee_name": "Veterans and Legal Affairs", "summary": {"text": "This resolve directs the Treasurer of State to review options for meeting the banking needs of individuals and businesses involved in the adult use cannabis and medical cannabis industries in the State, including examining banking solutions in other states that have legalized cannabis use, banking solution efforts under way at the federal level and actions the Legislature can take to encourage federal action on banking solutions. The treasurer is required to submit a report based on the review by December 3, 2025 to the Joint Standing Committee on Veterans and Legal Affairs, which is authorized to submit legislation based on the report to the Second Regular Session of the 132nd Legislature.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0545&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-04-08", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "fiscal_note_url": null, "documents": [{"label": "Bill text (LD 859)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0545&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-03-26", "action": "Work Session Held", "result": null}, {"date": "2025-03-26", "action": "Voted", "result": "ONTP"}, {"date": "2025-04-01", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], 