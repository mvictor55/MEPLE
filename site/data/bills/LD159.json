{"ld": 159, "paper": "HP92", "session": "132", "title": "An Act to Require Motor Vehicle Certificates of Registration to Include a Space to List an Emergency Contact (TITLE CHANGE)", "sponsor_id": "h-perkins-chad", "cosponsor_ids": ["h-ardell-donald", "h-babin-mark", "h-bishop-steven", "s-bradstreet-richard", "h-eder-john", "h-mingo-arthur", "h-nutting-robert", "h-quint-tracy", "h-white-james"], "committee_code": "TRA", "committee_name": "Transportation", "summary": {"text": "This bill adds to the required information requested by the Secretary of State on a vehicle registration application the requirement that a registrant, if an individual, include the legal name and address of the registrant's next of kin. The bill requires a vehicle certificate of registration to include the legal name and address of the vehicle owner's next of kin.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0092&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-05-29", "governor_action": "Signed", "governor_action_date": "2025-05-29"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 159)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0092&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-153)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0092&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-153)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0092&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN015902.pdf"}], "committee_actions": [{"date": "2025-03-25", "action": "Work Session Held", "result": null}, {"date": "2025-03-25", "action": "Voted", "result": "OTP-AM"}, {"date": "2025-05-14", "action": "Reported Out", "r