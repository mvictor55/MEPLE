{"ld": 1946, "paper": "HP1305", "session": "132", "title": "An Act to Clarify the Eligibility of Certified Recovery Residences for Bridging Rental Assistance Program Housing Vouchers", "sponsor_id": "h-warren-sophia", "cosponsor_ids": ["s-beebe-center-anne", "h-cluchey-sally", "h-dhalac-deqa", "h-dodge-janice", "h-golek-cheryl", "h-malon-marc", "h-rana-ambureen", "h-yusuf-yusuf"], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This bill provides that certified recovery residences that are certified pursuant to the requirements established in the Maine Revised Statutes, Title 5, section 20005, subsection 22 are eligible to accept housing vouchers under the Bridging Rental Assistance Program as long as they meet all applicable program standards and conditions. It also provides that individuals residing in certified recovery residences are eligible to apply for Bridging Rental Assistance Program housing vouchers as long as they meet all applicable program standards and conditions.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1305&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-25", "governor_action": "Unsigned", "governor_action_date": "2025-06-25"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1946)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1305&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-644)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1305&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-644)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1305&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN194602.pdf"}], "committee_act