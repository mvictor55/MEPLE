{"ld": 978, "paper": "HP638", "session": "132", "title": "An Act to Increase General Assistance Reimbursement for Municipalities and Indian Tribes", "sponsor_id": "h-zager-samuel", "cosponsor_ids": ["h-arata-amy", "s-moore-marianne", "s-talbot-ross-rachel"], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This bill increases, from 70% to 90%, the amount of state reimbursement for the costs of general assistance incurred by each municipality and Indian tribe. The bill incrementally increases state reimbursement, reaching 90% of the direct costs incurred by that municipality or tribe by July 1, 2030, for the 6 municipalities or Indian tribes receiving the highest amount of state reimbursement for the period beginning July 1, 2021 and ending June 30, 2025. For other municipalities and tribes, it increases state reimbursement to 90% of the direct costs incurred by that municipality or tribe for costs incurred on or after July 1, 2026.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0638&item=1&snum=132"}, "status": "died", "status_label": "Died On Adjournment", "final_disposition": {"label": "Died On Adjournment", "date": "2026-04-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 978)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0638&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-753)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0638&item=2&snum=132", "item": 2}, {"label": "Amendment C-B (H-754)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0638&item=3&snum=132", "item": 3}, {"label": "Amendment C-C (H-928)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0638&item=5&snum=132", "item": 5}, {"label": "Amendment C-D (H-929)", "url": "https://legislature.maine.gov/legis/bills/getPDF.a