{"ld": 385, "paper": "SP154", "session": "132", "title": "An Act to Protect Communications by Alleged Victims Regarding Sexual Assault, Sexual Harassment, Sexual Misconduct, Cyberbullying or Discrimination from Litigation", "sponsor_id": "s-brenner-stacy", "cosponsor_ids": ["s-carney-anne", "h-dhalac-deqa", "h-doudera-victoria", "h-sato-eleanor"], "committee_code": "JUD", "committee_name": "Judiciary", "summary": {"text": "This bill amends the Uniform Public Expression Protection Act by protecting from causes of action a communication made by a person without malice, regarding an incident of sexual assault, sexual harassment, sexual misconduct, cyberbullying or discrimination experienced by the person, who has or at any time had a reasonable basis to file a complaint concerning the sexual assault, sexual harassment, sexual misconduct, cyberbullying or discrimination, whether the complaint was filed or not. For purposes of this bill, \"discrimination\" includes subjecting to harassment; failing to prevent an act of discrimination; aiding, abetting, inciting, compelling or coercing an act of discrimination; or retaliating against a person for reporting an act of discrimination.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0154&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-22", "governor_action": "Unsigned", "governor_action_date": "2025-06-22"}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 385)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0154&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-13", "action": "Work Session Held", "result": null}, {"date": "2025-05-13", "action": "Voted", "result": "Divided Report"}, {"date": "2025-06-03", "action": "Reported Out", "result": "OTP/ONTP"}], "committee_reports": [{"label": "Majority report", "reco