{"ld": 1795, "paper": "SP697", "session": "132", "title": "An Act to Change the Calculation for Municipal Service Charges for Tax-exempt Organizations", "sponsor_id": "s-moore-marianne", "cosponsor_ids": ["h-mingo-arthur", "h-strout-tiffany", "h-tuell-william"], "committee_code": "TAX", "committee_name": "Taxation", "summary": {"text": "This bill expands the liability of certain tax-exempt institution and organization property owners to municipalities for service charges on that property. The limitation of the municipality's service charge authority is changed from 2% of the institution's or organization's gross revenue to 20% of the property's assessed value. These provisions take effect January 1, 2027.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0697&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-28", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1795)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0697&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-20", "action": "Work Session Held", "result": null}, {"date": "2025-05-20", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-27", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-04-24", "chamber": "Senate", "action": "Committee on TAXATION suggested and ordered printed REFERENCE to the Committee on TAXATION Ordered sent down forthwith for concurrence"}, {"date": "2025-04-24", "chamber": "House", "action": "The Bill was REFERRED to the Committee on TAXATION."}, {"date": "2025-04