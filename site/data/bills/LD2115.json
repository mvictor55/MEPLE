{"ld": 2115, "paper": "HP1430", "session": "132", "title": "An Act to Protect Private Wells from Hazardous Substances", "sponsor_id": "h-ankeles-daniel", "cosponsor_ids": ["h-arford-poppy", "s-larsen-daughtry-matthea", "h-golek-cheryl", "s-ingwersen-henry", "s-tepler-denise"], "committee_code": "ENR", "committee_name": "Environment and Natural Resources", "summary": {"text": "This bill changes the name of the Land Application Contaminant Monitoring Fund to the Well Contamination Response Fund and changes the activities for which funding may be used. It provides funding for private drinking water wells impacted by hazardous substances, including perfluoroalkyl and polyfluoroalkyl substances. Funding may be used for testing, remediation, the installation and maintenance of filter treatment systems, connection to local water district networks and the provision of bottled drinking water. The bill also directs the Department of Environmental Protection to determine eligibility requirements for the funding through rulemaking.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1430&item=1&snum=132"}, "status": "died", "status_label": "Died On Adjournment", "final_disposition": {"label": "Died On Adjournment", "date": "2026-04-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 2115)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1430&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-805)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1430&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-805)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1430&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN211502.pdf"}], "committee