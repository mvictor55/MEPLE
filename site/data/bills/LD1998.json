{"ld": 1998, "paper": "SP811", "session": "132", "title": "An Act to Authorize Registration of Certain Cash-dispensing Machines Through the Nationwide Mortgage Licensing System and Registry and to Limit the Use of Certain Cash-dispensing Machines as Virtual Currency Kiosks", "sponsor_id": "s-bailey-donna", "cosponsor_ids": [], "committee_code": "HCIFS", "committee_name": "Health Coverage, Insurance and Financial Services", "summary": {"text": "This bill authorizes the Superintendent of Consumer Credit Protection within the Department of Professional and Financial Regulation to require registration of certain cash- dispensing machines through the nationwide mortgage licensing system and registry. In all cases, whether registration is through the nationwide mortgage licensing system and registry or otherwise, the bill authorizes the superintendent to establish, by rule, requirements for registration of certain cash-dispensing machines. The bill provides that certain cash-dispensing machines may not operate as virtual currency kiosks unless the virtual currency kiosk operator is licensed as a money transmitter.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0811&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2026-03-03", "governor_action": "Signed", "governor_action_date": "2026-03-03"}, "fiscal_status": "Fiscal Impact", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN199801.pdf", "documents": [{"label": "Bill text (LD 1998)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0811&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2026-01-13", "action": "Work Session Held", "result": null}, {"date": "2026-01-13", "action": "Voted", "result": "OTP"}, {"date": "2026-01-28", "action": "Reported Out", "result": "OTP"}], "committee_reports": [{"label": "Committee