{"ld": 2221, "paper": "SP905", "session": "132", "title": "An Act to Amend the Composition of the Landowners and Land Users Relations Advisory Board", "sponsor_id": "s-baldacci-joseph", "cosponsor_ids": [], "committee_code": "IFW", "committee_name": "Inland Fisheries and Wildlife", "summary": {"text": "This bill is reported out by the Joint Standing Committee on Inland Fisheries and Wildlife pursuant to Resolve 2025, chapter 82. The bill amends the composition of the Landowners and Land Users Relations Advisory Board. It increases the number of outdoor recreationists on the board and adds specificity about the requisite experience of these members. It also adds a representative of an organization managing recreational access to the North Maine Woods. Finally, it adds 5 nonvoting members to the board: two representatives of the Department of Inland Fisheries and Wildlife, Bureau of Warden Service, one representative of the Department of Economic and Community Development and 2 representatives of the Department of Agriculture, Conservation and Forestry.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0905&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2026-04-03", "governor_action": "Signed", "governor_action_date": "2026-04-03"}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 2221)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0905&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-557)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0905&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-557)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0905&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN222102.