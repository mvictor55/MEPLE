{"ld": 1393, "paper": "HP915", "session": "132", "title": "An Act to Require Continuing Education for Licensed Architects", "sponsor_id": "h-roberts-lovell-tiffany", "cosponsor_ids": ["h-archer-marshall", "h-geiger-valli", "h-roeder-amy"], "committee_code": "LAB", "committee_name": "Labor", "summary": {"text": "This bill requires a licensed architect to complete continuing education requirements each year, as established by rules adopted by the Maine State Board for Licensure of Architects, Landscape Architects and Interior Designers, prior to the renewal of that architect's license. The bill requires a minimum of 12 health, safety and welfare credits to satisfy the requirement. The bill also exempts architects who are retired from active practice and creates a 2-year delay for the requirement for newly licensed architects.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0915&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-15", "governor_action": "Unsigned", "governor_action_date": "2025-06-15"}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 1393)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0915&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-218)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0915&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-218)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0915&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN139302.pdf"}], "committee_actions": [{"date": "2025-04-16", "action": "Work Session Held", "result": null}, {"date": "2025-04-16", "action": "Voted", "result": "Divided Report"}, {"date": "2025-05-20", "action": "Reported Out", "result":