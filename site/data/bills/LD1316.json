{"ld": 1316, "paper": "SP546", "session": "132", "title": "An Act to Amend the Mandated Reporter Laws Regarding Medical Records, Additional Information and Immunity", "sponsor_id": "s-moore-marianne", "cosponsor_ids": ["s-bailey-donna", "h-faulkingham-william"], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This bill clarifies that mandated reporters are not required to document suspected abuse, neglect or exploitation in the subject's medical record or report shared to 3rd parties. Reports must still be made to the Department of Health and Human Services. If suspected abuse, neglect or exploitation is documented in a medical record or other report that is shared with a 3rd party outside of the reporter's office or place of business and the reporter subsequently discovers information that may dispute or counter a report of suspected abuse, neglect or exploitation, the reporter is required to add the subsequent information to the medical record or other report and forward the amended medical record or other report to every 3rd party who received the initial medical record or other report. If a reporter discovers information that disputes or counters a report of abuse, neglect or exploitation provided to the Department of Health and Human Services, the reporter is required to forward the subsequent information to the department within 48 hours of discovery of the subsequent information. This bill excepts from immunity persons who violate the reporting laws or provide 3rd parties an unverified diagnosis or subjective opinion of abuse, neglect or exploitation.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0546&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-20", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 1316)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0546&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-14", "action": "Work Session Held", "result": null}, {"date": "2025-05-14", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-16", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-03-27", "chamber": "Senate", "action": "Committee on HEALTH AND HUMAN SERVICES suggested and ordered printed REFERENCE to the Committee on HEALTH AND HUMAN SERVICES Ordered sent down forthwith for concurrence"}, {"date": "2025-03-27", "chamber": "House", "action": "The Bill was REFERRED to the Committee on HEALTH AND HUMAN SERVICES."}, {"date": "2025-03-27", "chamber": "House", "action": "In concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-05-14", "chamber": "J", "action": "Work Session Held"}, {"date": "2025-05-14", "chamber": "J", "action": "Voted: ONTP"}, {"date": "2025-05-16", "chamber": "J", "action": "Reported Out: ONTP"}, {"date": "2025-05-20", "chamber": "Senate", "action": "Pursuant to Joint Rule 310.3 Placed in Legislative Files (DEAD)"}], "roll_calls": [], "hearing": {"date": "2025-04-09", "time": "10:00 AM", "location": "Cross Building, Room 209", "committee_code": "HHS", "testimony_count": 10}, "tags": ["Children And Families", "Abuse And Neglect"], "affected_statutes": [], "testimony": [{"id": "10042936", "name": "Andrea Knapp", "organization": "Franklin", "town": null, "position": "support", "position_source": "inferred", "date": "2025-04-09", "hearing_date": "2025-04-09", "url": "https://legislature.maine.gov/legis/bills/getTestimonyDoc.asp?id=10042936", "has_text": true}, {"id": "188873", "name": "Jeffrey Austin", "organization": "Maine Hospital Ass