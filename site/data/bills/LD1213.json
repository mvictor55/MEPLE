{"ld": 1213, "paper": "SP502", "session": "132", "title": "An Act Regarding Apportionment of Stipends to Agricultural Fairs (TITLE CHANGE)", "sponsor_id": "s-hickman-craig", "cosponsor_ids": ["s-bennett-richard", "s-black-russell", "h-cooper-mark", "h-cray-dean", "h-guerrette-timothy", "h-hall-randall", "h-jackson-caldwell", "s-stewart-harold", "h-wadsworth-nathan"], "committee_code": "ACF", "committee_name": "Agriculture, Conservation and Forestry", "summary": {"text": "This bill modifies the provisions of law governing distribution of stipends to persons or entities licensed to hold an agricultural fair.\n\nUnder current law, after certain distributions are made from the Stipend Fund pursuant to the Maine Revised Statutes, Title 7, section 86, the amount remaining is distributed among fair licensees meeting certain requirements. Distributions are based on premiums and gratuities actually paid by the licensees. The current law limits the use of premiums and gratuities for determination of apportionment to premiums and gratuities paid for certain specified activities and events.\n\nThe bill broadens the activities and events that may be considered in the calculation of apportionment for stipends by specifying that, in addition to the activities and events considered under current law, any other agricultural event approved by the Commissioner of Agriculture, Conservation and Forestry may be used to determine the apportionment.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0502&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-05-30", "governor_action": "Signed", "governor_action_date": "2025-05-30"}, "fiscal_status": "Not Yet Determined", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN121302.pdf", "documents": [{"label": "Bill text (LD 1213)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0502&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-135)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0502&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-135)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0502&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN121302.pdf"}], "committee_actions": [{"date": "2025-04-08", "action": "Work Session Held", "result": null}, {"date": "2025-04-08", "action": "Voted", "result": "OTP-AM"}, {"date": "2025-04-22", "action": "Work Session Reconsidered", "result": null}, {"date": "2025-04-22", "action": "Voted", "result": "OTP-AM"}, {"date": "2025-05-21", "action": "Reported Out", "result": "OTP-AM"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought to Pass as Amended", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-03-20", "chamber": "Senate", "action": "Committee on AGRICULTURE, CONSERVATION AND FORESTRY suggested and ordered printed REFERENCE to the Committee on AGRICULTURE, CONSERVATION AND FORESTRY Ordered sent down forthwith for concurrence"}, {"date": "2025-03-20", "chamber": "House", "action": "The Bill was REFERRED to the Committee on AGRICULTURE, CONSERVATION AND FORESTRY."}, {"date": "2025-03-20", "chamber": "House", "action": "In concurrence. ORDERED SENT FORTHWITH."}, {"date": "2025-03-21", "chamber": "Senate", "action": "CARRIED OVER, in the same posture, to the next special or regular session of the 132nd Legislature, pursuant to Joint Order SP 519."}, {"date": "2025-05-22", "chamber": "Senate", "action": "Report READ and ACCEPTED."}, {"date": "2025-05-22", "chamber": "Senate", "action": "READ ONCE."}, {"date": "2025-05-22", "chamber": "Senate", "action": "Committee Amendment \"A\" (S-135) READ and ADOPTED."}, {"date": "2025-05-2