{"ld": 1895, "paper": "HP1266", "session": "132", "title": "An Act to Require the Removal from a Property Tax Lien the Name of a Previous Owner Who Paid Prorated Property Taxes", "sponsor_id": "h-arata-amy", "cosponsor_ids": ["h-blier-mark", "s-bradstreet-richard", "h-drinkwater-gary", "h-farrin-wayne", "h-frost-sharon", "h-lee-adam", "h-morris-joshua", "h-roeder-amy", "s-tipping-michael"], "committee_code": "TAX", "committee_name": "Taxation", "summary": {"text": "This bill addresses the situation when, following the sale or other conveyance of real estate, a tax lien is placed on the real estate in the name of the seller. This bill requires the municipal treasurer to prepare and record a discharge of the tax lien against the seller if the seller provides proof of payment of the seller's pro rata share of all taxes owed by the seller. The discharge is only for the seller; the lien remains against the real estate.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1266&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-18", "governor_action": "Signed", "governor_action_date": "2025-06-18"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1895)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1266&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-619)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1266&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-619)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1266&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN189502.pdf"}], "committee_actions": [{"date": "2025-05-21", "action": "Work Session Held", "result": null}, {"date": "2025-05-21", "action": "