{"ld": 3, "paper": "SP12", "session": "132", "title": "An Act to Adopt Eastern Daylight Time Year-round Contingent on Federal Approval", "sponsor_id": "s-bennett-richard", "cosponsor_ids": ["s-baldacci-joseph", "h-kessler-christopher"], "committee_code": "SLG", "committee_name": "State and Local Government", "summary": {"text": "Current law provides that the standard time year-round for the State is the time commonly known as eastern daylight time, if federal law permits the year-round observation of eastern daylight time and all the states in the eastern time zone and the District of Columbia observe eastern daylight time year-round. This bill removes the prerequisite that all the states in the eastern time zone and the District of Columbia observe eastern daylight time, which will allow Maine to observe eastern daylight time year-round if federal law or regulation permits it.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0012&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-09", "governor_action": "Signed", "governor_action_date": "2025-06-09"}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 3)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0012&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-180)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0012&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-180)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0012&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN000302.pdf"}], "committee_actions": [{"date": "2025-03-03", "action": "Work Session Held", "result": null}, {"date": "2025-03-03", "action": "Voted", "result": "Divided Report"}, {"dat