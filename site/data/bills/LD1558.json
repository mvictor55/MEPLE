{"ld": 1558, "paper": "HP1016", "session": "132", "title": "Resolve, Establishing the Commission to Update Maine's Public Policy on Higher Education (EMERGENCY)", "sponsor_id": "h-sargent-holly", "cosponsor_ids": ["h-debrito-flavia", "h-dodge-janice", "s-libby-james", "h-mitchell-christina", "h-murphy-kelly", "s-pierce-teresa", "s-rafferty-joseph"], "committee_code": "EDU", "committee_name": "Education and Cultural Affairs", "summary": {"text": "This resolve establishes the Commission to Update Maine's Public Policy on Higher Education to review all related laws and rules addressing the State's public policy on higher education and make recommendations for potential legislative changes. The commission is directed to submit a report to the Joint Standing Committee on Education and Cultural Affairs no later than December 3, 2025 with findings and recommendations, including suggested legislation.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1016&item=1&snum=132"}, "status": "enacted", "status_label": "Emergency Finally Passed", "final_disposition": {"label": "Emergency Finally Passed", "date": "2026-01-11", "governor_action": "Emergency Unsigned", "governor_action_date": "2026-01-11"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1558)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1016&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-629)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1016&item=2&snum=132", "item": 2}, {"label": "Amendment S-A (S-442)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1016&item=4&snum=132", "item": 4}], "amendments": [{"id": "C-A (H-629)", "description": "Emergency", "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1016&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bi