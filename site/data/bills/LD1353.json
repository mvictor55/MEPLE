{"ld": 1353, "paper": "HP876", "session": "132", "title": "An Act Regarding Required Landings in the Menhaden Fishery", "sponsor_id": "h-faulkingham-william", "cosponsor_ids": ["h-farrin-wayne", "h-golek-cheryl", "s-moore-marianne", "h-rielly-morgan", "h-thorne-james"], "committee_code": "MAR", "committee_name": "Marine Resources", "summary": {"text": "This bill authorizes the Commissioner of Marine Resources to issue a 2026 resident commercial menhaden fishing license or a 2026 nonresident commercial menhaden fishing license to an individual if that individual reported legal landings of menhaden of 20,000 pounds or more in at least one of the following years, 2019, 2020, 2021 or 2022. The individual must also have possessed a license to fish commercially for menhaden in at least 2 of the following years, 2019, 2020, 2021 or 2022.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0876&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2026-04-16", "governor_action": "Signed", "governor_action_date": "2026-04-16"}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1353)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0876&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-873)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0876&item=2&snum=132", "item": 2}, {"label": "Amendment H-A to C-A (H-1039)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0876&item=4&snum=132", "item": 4}, {"label": "Amendment H-B to C-A (H-1049)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0876&item=5&snum=132", "item": 5}, {"label": "Amendment H-C to C-A (H-1067)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0876&item=6&snum=132", "item": 6}], "amendments": [{"id": "C-A (H-873)", "description": null, "sponsor": null, "sta