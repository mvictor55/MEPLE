{"ld": 513, "paper": "SP232", "session": "132", "title": "An Act to Allow the Spouse of a School Board Member to Serve as a Stipend Employee Within the School Board's Jurisdiction", "sponsor_id": "s-moore-marianne", "cosponsor_ids": ["h-mcintyre-mathew", "h-quint-tracy", "h-sayre-daniel", "h-strout-tiffany", "h-tuell-william"], "committee_code": "EDU", "committee_name": "Education and Cultural Affairs", "summary": {"text": "This bill provides that a school board may permit a school board member's spouse to serve as a stipend employee and a volunteer. A school board may adopt a written policy on nepotism that includes hiring practices for school-sanctioned stipend positions, discourages favoritism and political patronage, considers the needs of the school system and provides that all qualified applicants or volunteers have a fair and equal opportunity to be selected on merit, with priority consideration given to the best interest of students without restrictions based solely on family association. The bill's provisions include a repeal date of July 1, 2028.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0232&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2025-05-07", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 513)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0232&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-03-25", "action": "Work Session Held", "result": "TABLED"}, {"date": "2025-04-17", "action": "Work Session Held", "result": null}, {"date": "2025-04-17", "action": "Voted", "result": "Divided Report"}, {"date": "2025-04-30", "action": "Reported Out", "result": "ONTP/OTP"}], "committee_reports": [{"label": "Majority report", "recommendation": 