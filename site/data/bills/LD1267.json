{"ld": 1267, "paper": "HP842", "session": "132", "title": "Resolve, Directing the Department of Labor to Convene a Task Force to Examine and Study Issues Relating to the Gap Between the Economic Output and Wages of Workers in the State", "sponsor_id": "h-pugh-dylan", "cosponsor_ids": ["h-dhalac-deqa", "h-henderson-rachel", "h-macias-rafael", "h-roeder-amy", "h-supica-laura", "s-tipping-michael"], "committee_code": "LAB", "committee_name": "Labor", "summary": {"text": "This resolve directs the Department of Labor to convene a task force to examine and study the gap between the economic output of workers in the State and the wages those workers receive in return and report on the task force's findings to the Joint Standing Committee on Labor by December 3, 2025. The joint standing committee is authorized to report out legislation based on the subject matter of the report to the Second Regular Session of the 132nd Legislature.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0842&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-06", "governor_action": null, "governor_action_date": null}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 1267)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0842&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-04-22", "action": "Work Session Held", "result": null}, {"date": "2025-04-22", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-06", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-03-25", "chamber": "House", "action": "Committee on Labor suggested and ordered pri