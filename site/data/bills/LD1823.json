{"ld": 1823, "paper": "SP710", "session": "132", "title": "An Act to Promote Transparency in the Criminal Justice System by Requiring the Posting of Criminal Case Decisions", "sponsor_id": "s-harrington-matthew", "cosponsor_ids": ["s-cyrway-scott", "h-faulkingham-william", "s-haggan-david", "h-smith-katrina", "s-stewart-harold"], "committee_code": "JUD", "committee_name": "Judiciary", "summary": {"text": "This bill requires the Attorney General to post to the publicly accessible website of the Office of the Attorney General the final decision of a criminal case decided within the State within 60 days of the case's final disposition. The bill requires the clerks of the District Court and clerks of the Superior Court to post to those clerks' publicly accessible websites the final decision of a criminal case decided within that prosecutorial district within 60 days of the case's final disposition. The bill also requires the clerk of the Unified Criminal Docket to post on the clerk's publicly accessible website the final decision of a criminal case decided within the State within 60 days of the case's final disposition.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0710&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2025-06-10", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1823)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0710&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-327)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0710&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-327)", "description": null, "sponsor": null, "status": null, "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0710&item=2&snum=132", "fiscal_note_