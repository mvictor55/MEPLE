{"ld": 867, "paper": "HP553", "session": "132", "title": "An Act Regarding Pre-need Funeral Insurance", "sponsor_id": "h-morris-joshua", "cosponsor_ids": ["s-baldacci-joseph", "h-flynn-paul", "s-haggan-david", "h-mastraccio-anne-marie"], "committee_code": "HCIFS", "committee_name": "Health Coverage, Insurance and Financial Services", "summary": {"text": "This bill provides for a type of insurance for prearranged funeral services or plans. The bill:\n\n1. Defines pre-need insurance and permits its sale in the State; 2. Permits a funeral director to sell pre-need insurance to a consumer who has approached a funeral home to preplan a funeral as long as the funeral director is licensed as an insurance producer; 3. Prohibits so-called cold-calling to solicit prearranged funeral agreements; 4. Requires that the proceeds of pre-need insurance may not exceed the goods and services contracted for in a prearranged funeral service or plan agreement; 5. Requires certain disclosures to applicants with regard to the sale of pre-need insurance; and 6. Authorizes the payment of commissions in connection with the sale of pre-need insurance.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0553&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-09", "governor_action": "Signed", "governor_action_date": "2025-06-09"}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 867)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0553&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-274)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0553&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-274)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0553&item=2&snum=132", "fiscal_note_url": "h