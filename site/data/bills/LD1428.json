{"ld": 1428, "paper": "HP937", "session": "132", "title": "An Act to Increase Access to Child Care for Maine Families", "sponsor_id": "h-fecteau-ryan", "cosponsor_ids": ["h-archer-marshall", "h-collamore-amanda", "h-debrito-flavia", "h-eaton-holly", "h-hasenfus-tavis", "h-lee-adam", "h-mccabe-julia", "s-reny-cameron", "h-webb-kilton"], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This bill allows child care facilities and family child care providers to operate without an outdoor recreational space if the operation is within one-quarter of a mile of an outdoor public recreational space. The bill requires municipalities to allow child care facilities and family child care providers to operate in an area that is zoned for residential purposes. The bill also requires the Maine State Housing Authority to amend its rules governing low- income housing tax credits to allow the community rooms that are required as part of the projects built using the credits to be used as child care facilities or family child care providers.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0937&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-06-12", "governor_action": "Signed", "governor_action_date": "2025-06-12"}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 1428)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0937&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-508)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0937&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-508)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0937&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpd