{"ld": 1087, "paper": "HP709", "session": "132", "title": "An Act to Increase the State's Share of Major Capital School Construction Costs", "sponsor_id": "h-boyer-michelle", "cosponsor_ids": ["s-carney-anne", "h-mccabe-julia", "h-mitchell-christina", "s-pierce-teresa"], "committee_code": "EDU", "committee_name": "Education and Cultural Affairs", "summary": {"text": "This bill provides that, beginning July 1, 2026, the State's share of the total cost of a school construction project is either 25% of the total cost of the school construction project or a percentage equal to the state share percentage of the school administrative unit's total cost of education as determined in the essential programs and services funding formula, whichever is greater. The bill also allows the State Board of Education to adopt or amend rules related to the State's share of the total cost of a school construction project.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0709&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2025-06-05", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 1087)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0709&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-434)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0709&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-434)", "description": null, "sponsor": null, "status": null, "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0709&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN108702.pdf"}], "committee_actions": [{"date": "2025-05-12", "action": "Work Session Held", "result": null}, {"date": "2025-05-12", "action": "Voted", "