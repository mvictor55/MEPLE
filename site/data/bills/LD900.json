{"ld": 900, "paper": "SP389", "session": "132", "title": "An Act to Protect State Retiree Pensions from Inflation", "sponsor_id": "s-baldacci-joseph", "cosponsor_ids": ["s-beebe-center-anne"], "committee_code": "LAB", "committee_name": "Labor", "summary": {"text": "This bill provides that for fiscal year 2026-27, the Board of Trustees of the Maine Public Employees Retirement System, whenever there is a percentage increase in the Consumer Price Index from July 1st to June 30th, must automatically make an equal percentage increase in retirement benefits up to a maximum annual increase of 4%. Beginning in fiscal year 2028-29, the board must automatically make an equal percentage increase up to a maximum annual increase of 5%. The bill provides that, effective July 1, 2026, cost-of-living increases for retired state employees and teachers and their beneficiaries apply to the first $40,000 of the retirement benefit. Effective July 1, 2028, the cost-of-living increases for retired state employees and teachers and their beneficiaries apply to the first $50,000 of the retirement benefit and must be increased in subsequent years by the same percentage adjustment.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0389&item=1&snum=132"}, "status": "died", "status_label": "Died On Adjournment", "final_disposition": {"label": "Died On Adjournment", "date": "2026-04-29", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 900)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0389&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-146)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0389&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-146)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=S