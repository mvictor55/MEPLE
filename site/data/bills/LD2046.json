{"ld": 2046, "paper": "SP839", "session": "132", "title": "An Act to Update Certain Duties Regarding Student Health Related to Communicable and Infectious Disease", "sponsor_id": "s-rafferty-joseph", "cosponsor_ids": [], "committee_code": "EDU", "committee_name": "Education and Cultural Affairs", "summary": {"text": "This bill clarifies the duties of school personnel, superintendents and parents with regard to reporting symptoms of communicable or infectious diseases. The bill also clarifies that the duty for school nurses to supervise and coordinate health-related activities must be carried out in accordance with the most recent school nursing practices and follow all applicable rules adopted by the State Board of Nursing. The bill also requires the guidelines on the provision of school health services and health-related activities to be based on state and national standards and updated at least every 3 years. The bill also updates the term \"epinephrine autoinjector\" to \"epinephrine automated device.\"", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0839&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2026-04-03", "governor_action": "Signed", "governor_action_date": "2026-04-03"}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 2046)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0839&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (S-560)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0839&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (S-560)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=SP0839&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN204602.pdf"}], "committee_actions": [{"date": "202