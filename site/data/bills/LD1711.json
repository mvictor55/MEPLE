{"ld": 1711, "paper": "HP1146", "session": "132", "title": "Resolve, to Allow Supplemental Nutrition Assistance Program Benefits to Be Used to Purchase Ready-to-cook Meals", "sponsor_id": "h-lanigan-lucas", "cosponsor_ids": ["h-collamore-amanda", "s-harrington-matthew"], "committee_code": "HHS", "committee_name": "Health and Human Services", "summary": {"text": "This resolve requires the Department of Health and Human Services to request a waiver from the United States Department of Agriculture to allow the State to allow the use of federal Supplemental Nutrition Assistance Program benefits for the purchase of ready-to-cook meals. The Department of Health and Human Services is directed to notify retailers and other providers of ready-to-cook meals of the rule change.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1146&item=1&snum=132"}, "status": "died", "status_label": "Ought Not to Pass Pursuant To Joint Rule 310", "final_disposition": {"label": "Ought Not to Pass Pursuant To Joint Rule 310", "date": "2025-05-14", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Fiscal Impact", "documents": [{"label": "Bill text (LD 1711)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1146&item=1&snum=132", "item": 1}], "amendments": [], "committee_actions": [{"date": "2025-05-08", "action": "Work Session Held", "result": null}, {"date": "2025-05-08", "action": "Voted", "result": "ONTP"}, {"date": "2025-05-12", "action": "Reported Out", "result": "ONTP"}], "committee_reports": [{"label": "Committee report", "recommendation": "Ought Not to Pass", "signer_count": null, "signers": [], "signer_ids": []}], "chamber_actions": [{"date": "2025-04-17", "chamber": "House", "action": "Committee on Health and Human Services suggested and ordered printed."}, {"date": "2025-04-17", "chamber": "House", "action": "The Resolve was REFERRED to the Committee on HEALTH AND HUMAN SERVICES."}, {"dat