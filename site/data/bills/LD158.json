{"ld": 158, "paper": "HP91", "session": "132", "title": "An Act to Establish a Date to Begin Voting by Absentee Ballot in the Presence of the Clerk (TITLE CHANGE)", "sponsor_id": "h-parry-wayne", "cosponsor_ids": ["h-boyer-david", "h-fredericks-ann", "h-hymes-benjamin", "h-smith-katrina", "s-timberlake-jeffrey", "h-white-james"], "committee_code": "VLA", "committee_name": "Veterans and Legal Affairs", "summary": {"text": "This bill requires the Secretary of State to establish by January 31st annually the dates by which all municipalities must begin issuing and accepting absentee ballots for each regular election for state offices and federal offices occurring in the election year. The bill also amends the definition of \"absentee voting period\" to reflect the Secretary of State's responsibility to establish dates for the furnishing and acceptance of absentee ballots.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0091&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2025-05-29", "governor_action": "Signed", "governor_action_date": "2025-05-29"}, "fiscal_status": "No Fiscal Impact", "documents": [{"label": "Bill text (LD 158)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0091&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-150)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0091&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-150)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0091&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN015802.pdf"}], "committee_actions": [{"date": "2025-02-10", "action": "Work Session Held", "result": null}, {"date": "2025-02-10", "action": "Voted", "result": "OTP-AM"}, {"date": "2025-05-13"