{"ld": 2203, "paper": "HP1482", "session": "132", "title": "An Act to Limit Rates Charged to Low-income Electricity Consumers", "sponsor_id": "h-sachs-melanie", "cosponsor_ids": [], "committee_code": "EUT", "committee_name": "Energy, Utilities and Technology", "summary": {"text": "This bill is reported out by the Joint Standing Committee on Energy, Utilities and Technology pursuant to Public Law 2025, chapter 123, section 3. The bill prohibits a competitive electricity provider from providing generation service to a residential electricity consumer receiving low-income assistance at a rate that is more than the standard-offer service rate. It authorizes the Public Utilities Commission to adopt routine technical rules to implement this provision.\n\nThe committee has not taken a position on the substance of this bill. By reporting this bill out, the committee is not suggesting and does not intend to suggest that it agrees or disagrees with any aspect of this bill. The committee is reporting the bill out for the sole purpose of having a bill printed that can be referred to the committee for an appropriate public hearing and subsequent processing in the normal course. The committee is taking this action to ensure clarity and transparency in the legislative review of the proposals contained in the bill.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1482&item=1&snum=132"}, "status": "enacted", "status_label": "Enacted", "final_disposition": {"label": "Enacted", "date": "2026-04-03", "governor_action": "Signed", "governor_action_date": "2026-04-03"}, "fiscal_status": "Not Yet Determined", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN220302.pdf", "documents": [{"label": "Bill text (LD 2203)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1482&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-845)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1482&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-845)", "description": null, "sponsor": null, "status": "Adopted by House & Senate", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP1482&item=2&snum=132", "fiscal_note_url": "https://legislature.maine.gov/legis/bills/bills_132nd/fiscalpdfs/FN220302.pdf"}], "committee_actions": [{"date": "2026-02-24", "action": "Work Session Held", "result": null}, {"date": "2026-02-24", "action": "Voted", "result": "Divided Report"}, {"date": "2026-03-12", "action": "Reported Out", "result": "OTP-AM/ONTP"}], "committee_reports": [{"label": "Majority report", "recommendation": "Ought To Pass As Amended", "signer_count": 11, "signers": ["Senator Mark Lawrence (Chair)", "Representative Melanie Sachs (Chair)", "Representative Valli Geiger", "Senator Nicole Grohoski", "Senator Matthew Harrington", "Representative Christopher Kessler", "Representative Mathew McIntyre", "Representative Walter Runte", "Representative Nathan Wadsworth", "Representative Sophia Warren", "Representative Kilton Webb"], "signer_ids": ["s-lawrence-mark", "h-sachs-melanie", "h-geiger-valli", "s-grohoski-nicole", "s-harrington-matthew", "h-kessler-christopher", "h-mcintyre-mathew", "h-runte-walter", "h-wadsworth-nathan", "h-warren-sophia", "h-webb-kilton"]}, {"label": "Minority report", "recommendation": "Ought Not To Pass", "signer_count": 2, "signers": ["Representative Steven Foster", "Representative Reagan Paul"], "signer_ids": ["h-foster-steven", "h-paul-reagan"]}], "chamber_actions": [{"date": "2026-02-10", "chamber": "House", "action": "Representative SACHS for the Joint Standing Committee on Energy, Utilities and Technology pursuant to Public Law 2025, chapter 123, section 3, subsection 2 reports that the Bill be REFERRED to the Committee on ENERGY, UTILITIES AND TECHNOLOGY and printed pursuant to Joint Rule 218."}, {"date": "2026-02-10", "chamber": "House", "action": "Report was READ and ACCEPTED."}, 