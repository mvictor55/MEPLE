{"ld": 1232, "paper": "HP807", "session": "132", "title": "An Act to Require Radon Testing for Certain Commercial and Residential Construction", "sponsor_id": "h-rudnicki-shelley", "cosponsor_ids": ["s-grohoski-nicole", "h-guerrette-timothy", "h-matlack-ann", "h-sayre-daniel", "h-white-russell"], "committee_code": "HED", "committee_name": "Housing and Economic Development", "summary": {"text": "This bill requires a radon permit for new commercial and residential construction and for improvements or alterations to a commercial structure requiring a building permit. A person registered by the Department of Health and Human Services to test radon must apply for the permit and conduct testing, and if it is determined that radon mitigation measures are required, the person designing and installing the radon mitigation measures must be registered by the department. Residential construction in a municipality without a building code or performed by a homeowner acting as a general contractor and who performs more than 50% of the framing and finishing of the structure are exempt from the permit requirements. Penalties for violations are $1,000 for commercial construction and $500 for residential construction.", "official": true, "source": "Bill text, https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0807&item=1&snum=132"}, "status": "died", "status_label": "Accepted Majority (ONTP) Report", "final_disposition": {"label": "Accepted Majority (ONTP) Report", "date": "2025-06-13", "governor_action": null, "governor_action_date": null}, "fiscal_status": "Not Yet Determined", "documents": [{"label": "Bill text (LD 1232)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0807&item=1&snum=132", "item": 1}, {"label": "Amendment C-A (H-687)", "url": "https://legislature.maine.gov/legis/bills/getPDF.asp?paper=HP0807&item=2&snum=132", "item": 2}], "amendments": [{"id": "C-A (H-687)", "description": "Change Title", "sponsor": null, "status": null, "url": "ht